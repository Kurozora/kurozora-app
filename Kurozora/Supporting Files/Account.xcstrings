    "onboarding.appleAuthenticationFailedMessage": {
      "comment": "Error message shown when Apple authentication fails.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Authentication failed by Apple. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificatie door Apple is mislukt. Probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المصادقة من قِبل Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo completar la autenticación. Vuelva a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi gagal oleh Apple. Harap coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleによる認証に失敗しました。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na autenticação pela Apple. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung durch Apple ist fehlgeschlagen. Bitte versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’authentification par Apple. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione non riuscita da parte di Apple. Riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 인증에 실패했습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnianie przez Apple nie powiodło się. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось пройти аутентификацию через Apple. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося пройти автентифікацію через Apple. Будь ласка, спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 验证失败。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 驗證失敗。請再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันตัวตนโดย Apple ล้มเหลว โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ile kimlik doğrulama başarısız oldu. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực bằng Apple thất bại. Vui lòng thử lại."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo completar la autenticación. Inténtelo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabigo ang pagpapatotoo ng Apple. Pakisubukang muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple द्वारा प्रमाणीकरण विफल रहा। कृपया पुनः प्रयास करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověření přes Apple selhalo. Zkuste to prosím znovu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "احراز هویت توسط Apple ناموفق بود. لطفاً دوباره تلاش کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האימות נכשל על ידי Apple. נא לנסות שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengesahan gagal oleh Apple. Sila cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea prin Apple a eșuat. Vă rugăm să încercați din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentiseringen misslyckades hos Apple. Försök igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταυτοποίηση από την Apple απέτυχε. Δοκιμάστε ξανά."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple দ্বারা অনুমোদন ব্যর্থ হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple மூலம் அங்கீகாரம் தோல்வியடைந்தது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ద్వారా ప్రామాణీకరణ విఫలమైంది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelsen mislykkedes hos Apple. Prøv venligst igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-todennus epäonnistui. Yrittäkää uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple-hitelesítés sikertelen volt. Kérjük, próbálja újra."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentiseringen mislyktes hos Apple. Prøv igjen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação pela Apple falhou. Tente novamente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple کی جانب سے تصدیق ناکام ہو گئی۔ براہِ کرم دوبارہ کوشش کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-ի կողմից նույնականացումը ձախողվեց։ Խնդրում ենք կրկին փորձել։"
          }
        }
      }
    },
    "onboarding.appleAuthenticationNotHandledMessage": {
      "comment": "Error message shown when Apple authentication was not handled properly.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "An error occurred and the authentication was not handled by Apple. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een fout opgetreden en de verificatie is niet door Apple afgehandeld. Probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ولم تتم معالجة المصادقة من قِبل Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se produjo un error y Apple no gestionó la autenticación. Vuelva a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan dan autentikasi tidak ditangani oleh Apple. Harap coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーが発生し、Appleによって認証が処理されませんでした。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro e a autenticação não foi processada pela Apple. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler ist aufgetreten und die Authentifizierung wurde von Apple nicht verarbeitet. Bitte versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite et l’authentification n’a pas été traitée par Apple. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore e l'autenticazione non è stata gestita da Apple. Riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류가 발생하여 Apple에서 인증이 처리되지 않았습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił błąd i uwierzytelnianie nie zostało obsłużone przez Apple. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Произошла ошибка, и аутентификация не была обработана Apple. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сталася помилка, і автентифікацію не було оброблено Apple. Будь ласка, спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生错误，Apple 未能完成验证。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生錯誤，Apple 未能妥善處理此驗證。請再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดและ Apple ไม่ได้จัดการการยืนยันตัวตน โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hata oluştu ve kimlik doğrulama Apple tarafından işlenmedi. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi và quá trình xác thực không được Apple xử lý. Vui lòng thử lại."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha producido un error y Apple no ha gestionado la autenticación. Inténtelo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May naganap na error at hindi naasikaso ng Apple ang pagpapatotoo. Pakisubukang muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक त्रुटि हुई और प्रमाणीकरण को Apple द्वारा ठीक से संभाला नहीं गया। कृपया पुनः प्रयास करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo k chybě a ověření nebylo zpracováno společností Apple. Zkuste to prosím znovu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خطایی رخ داد و احراز هویت توسط Apple به‌درستی پردازش نشد. لطفاً دوباره تلاش کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירעה שגיאה והאימות לא טופל על ידי Apple. נא לנסות שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralat berlaku dan pengesahan tidak dikendalikan oleh Apple. Sila cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A apărut o eroare, iar autentificarea nu a fost gestionată de Apple. Vă rugăm să încercați din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fel uppstod och autentiseringen hanterades inte av Apple. Försök igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκε σφάλμα και η ταυτοποίηση δεν διεκπεραιώθηκε από την Apple. Δοκιμάστε ξανά."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ত্রুটি ঘটেছে এবং অনুমোদনটি Apple দ্বারা সম্পন্ন হয়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பிழை ஏற்பட்டது, மேலும் அங்கீகாரம் Apple-ஆல் சரியாகக் கையாளப்படவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక లోపం సంభవించింది, ప్రామాణీకరణను Apple సరిగ్గా నిర్వహించలేదు. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der opstod en fejl, og godkendelsen blev ikke håndteret af Apple. Prøv venligst igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtui virhe, eikä Apple käsitellyt todennusta. Yrittäkää uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiba történt, és a hitelesítést az Apple nem kezelte. Kérjük, próbálja újra."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det oppstod en feil, og autentiseringen ble ikke håndtert av Apple. Prøv igjen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro e a autenticação não foi processada pela Apple. Tente novamente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک خرابی پیش آئی اور Apple کی جانب سے تصدیق کو سنبھالا نہیں گیا۔ براہِ کرم دوبارہ کوشش کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սխալ տեղի ունեցավ, և նույնականացումը Apple-ի կողմից չմշակվեց։ Խնդրում ենք կրկին փորձել։"
          }
        }
      }
    },
    "onboarding.appleInvalidResponseMessage": {
      "comment": "Error message shown when Apple returns an invalid authentication response.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The app received an invalid response from Apple. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app heeft een ongeldig antwoord van Apple ontvangen. Probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقّى التطبيق استجابة غير صالحة من Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La app recibió una respuesta no válida de Apple. Vuelva a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi menerima respons yang tidak valid dari Apple. Harap coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleから無効な応答を受信しました。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app recebeu uma resposta inválida da Apple. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat eine ungültige Antwort von Apple erhalten. Bitte versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app a reçu une réponse non valide d’Apple. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ha ricevuto una risposta non valida da Apple. Riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 Apple로부터 잘못된 응답을 받았습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja otrzymała nieprawidłową odpowiedź od Apple. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение получило недопустимый ответ от Apple. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок отримав недійсну відповідь від Apple. Будь ласка, спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用收到了来自 Apple 的无效响应。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 從 Apple 收到無效的回應。請再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปได้รับการตอบกลับที่ไม่ถูกต้องจาก Apple โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama Apple'dan geçersiz bir yanıt aldı. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã nhận được phản hồi không hợp lệ từ Apple. Vui lòng thử lại."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ha recibido una respuesta no válida de Apple. Inténtelo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatanggap ang app ng hindi wastong tugon mula sa Apple. Pakisubukang muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को Apple से एक अमान्य प्रतिक्रिया प्राप्त हुई। कृपया पुनः प्रयास करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace obdržela od Apple neplatnou odpověď. Zkuste to prosím znovu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه پاسخ نامعتبری از Apple دریافت کرد. لطفاً دوباره تلاش کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה קיבלה תגובה לא תקינה מ-Apple. נא לנסות שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi menerima respons tidak sah daripada Apple. Sila cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația a primit un răspuns nevalid de la Apple. Vă rugăm să încercați din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen fick ett ogiltigt svar från Apple. Försök igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή έλαβε μη έγκυρη απόκριση από την Apple. Δοκιμάστε ξανά."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি Apple থেকে একটি অবৈধ প্রতিক্রিয়া পেয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-இடமிருந்து செல்லாத பதிலை ஆப் பெற்றது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple నుండి యాప్‌కు చెల్లని ప్రతిస్పందన అందింది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen modtog et ugyldigt svar fra Apple. Prøv venligst igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus sai Applelta virheellisen vastauksen. Yrittäkää uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás érvénytelen választ kapott az Apple-től. Kérjük, próbálja újra."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen mottok et ugyldig svar fra Apple. Prøv igjen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação recebeu uma resposta inválida da Apple. Tente novamente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کو Apple کی جانب سے ایک غلط جواب موصول ہوا۔ براہِ کرم دوبارہ کوشش کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հավելվածը Apple-ից ստացավ անվավեր պատասխան։ Խնդրում ենք կրկին փորձել։"
          }
        }
      }
    },

    "onboarding.signUpAlertSubheadline": {
      "comment": "The subheadline string for sign up alert.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Account created successfully! Please check your email for confirmation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account aangemaakt! Controleer je e-mail voor de bevestiging."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء الحساب بنجاح! يُرجى التحقق من بريدك الإلكتروني للتأكيد."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¡La cuenta se creó correctamente! Revise su correo para confirmarla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun berhasil dibuat! Harap periksa email Anda untuk konfirmasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作成しました！確認のため、メールをご確認ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta criada com sucesso! Verifique seu e-mail para confirmação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto erfolgreich erstellt! Bitte überprüfen Sie Ihre E-Mails zur Bestätigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte créé avec succès ! Veuillez consulter votre e-mail pour confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Account creato correttamente! Controlla la tua email per la conferma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 성공적으로 생성되었습니다! 확인을 위해 이메일을 확인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto zostało pomyślnie utworzone! Sprawdź swoją skrzynkę e-mail, aby je potwierdzić."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись успешно создана! Проверьте почту для подтверждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис успішно створено! Будь ласка, перевірте свою електронну пошту для підтвердження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户创建成功！请查收您的电子邮件以完成确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號已成功建立！請查看您的電子郵件以完成確認。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างบัญชีสำเร็จแล้ว! โปรดตรวจสอบอีเมลของคุณเพื่อยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap başarıyla oluşturuldu! Onay için lütfen e-postanızı kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo tài khoản thành công! Vui lòng kiểm tra email của bạn để xác nhận."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Cuenta creada correctamente! Revise su correo para confirmarla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Matagumpay na nalikha ang account! Pakitingnan ang iyong email para sa kumpirmasyon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता सफलतापूर्वक बना दिया गया! कृपया पुष्टि के लिए अपना ईमेल जाँचें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet byl úspěšně vytvořen! Zkontrolujte si prosím e-mail kvůli potvrzení."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب با موفقیت ساخته شد! لطفاً برای تأیید، ایمیل خود را بررسی کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון נוצר בהצלחה! נא לבדוק את האימייל שלך לאישור."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun berjaya dicipta! Sila semak e-mel anda untuk pengesahan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul a fost creat cu succes! Verifică-ți emailul pentru confirmare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontot har skapats! Kolla din e-post för bekräftelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός δημιουργήθηκε με επιτυχία! Ελέγξτε το email σας για επιβεβαίωση."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট সফলভাবে তৈরি হয়েছে! নিশ্চিতকরণের জন্য অনুগ্রহ করে আপনার ইমেল দেখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணக்கு வெற்றிகரமாக உருவாக்கப்பட்டது! உறுதிப்படுத்தலுக்கு உங்கள் மின்னஞ்சலைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాతా విజయవంతంగా సృష్టించబడింది! నిర్ధారణ కోసం దయచేసి మీ ఇమెయిల్‌ను తనిఖీ చేయండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen blev oprettet! Tjek venligst din e-mail for bekræftelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tili luotiin onnistuneesti! Tarkistakaa sähköpostistanne vahvistus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiók sikeresen létrejött! Kérjük, ellenőrizze az e-mailjeit a megerősítéshez."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen ble opprettet! Sjekk e-posten din for bekreftelse."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta criada com sucesso! Verifique o seu e-mail para confirmação."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ کامیابی سے بن گیا! براہِ کرم تصدیق کے لیے اپنی ای میل چیک کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշիվը հաջողությամբ ստեղծվեց։ Հաստատման համար խնդրում ենք ստուգել ձեր էլ. փոստը։"
          }
        }
      }
    },

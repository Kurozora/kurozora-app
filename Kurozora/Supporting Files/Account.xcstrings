          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обирай з-поміж низки тем, щоб створити вигляд, який відображає твою індивідуальність і стиль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

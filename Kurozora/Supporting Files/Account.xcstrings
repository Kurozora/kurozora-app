    "There are no restorable purchases.\nOnly previously bought non-consumable products and auto-renewable subscriptions can be restored.": {
      "comment": "The message string for restoring IAP has failed.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen herstelbare aankopen.\nAlleen eerder gekochte niet-verbruikbare producten en automatisch verlengende abonnementen kunnen worden hersteld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مشتريات قابلة للاستعادة.\nيمكن استعادة المنتجات غير القابلة للاستهلاك والاشتراكات ذاتية التجديد التي تم شراؤها سابقًا فقط."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay compras restaurables.\nSolo se pueden restaurar los productos no consumibles comprados anteriormente y las suscripciones de renovación automática."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pembelian yang dapat dipulihkan.\nHanya produk non-konsumsi dan langganan perpanjangan otomatis yang dibeli sebelumnya yang dapat dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元可能な購入がありません。\n復元できるのは、以前に購入した非消耗型の製品と自動更新サブスクリプションのみです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há compras que possam ser restauradas.\nApenas produtos não consumíveis e assinaturas com renovação automática comprados anteriormente podem ser restaurados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine wiederherstellbaren Käufe.\nNur zuvor gekaufte nicht-verbrauchbare Produkte und automatisch verlängerbare Abonnements können wiederhergestellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat ne peut être restauré.\nSeuls les produits non consommables déjà achetés et les abonnements à renouvellement automatique peuvent être restaurés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono acquisti ripristinabili.\nÈ possibile ripristinare solo prodotti non consumabili e abbonamenti a rinnovo automatico acquistati in precedenza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 수 있는 구매 항목이 없습니다.\n이전에 구매한 비소모성 제품과 자동 갱신 구독만 복원할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zakupów do przywrócenia.\nPrzywrócić można tylko wcześniej kupione produkty niekonsumpcyjne oraz subskrypcje odnawiane automatycznie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет покупок, доступных для восстановления.\nВосстановить можно только ранее приобретённые непотребляемые продукты и автопродлеваемые подписки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可恢复的购买项目。\n仅可恢复此前购买的非消耗型产品和可自动续订的订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可回復的購買項目。\n僅能回復先前購買的非消耗性產品與自動續訂的訂閱。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการซื้อที่สามารถกู้คืนได้\nกู้คืนได้เฉพาะสินค้าแบบไม่สิ้นเปลืองและการสมัครสมาชิกแบบต่ออายุอัตโนมัติที่เคยซื้อไว้ก่อนหน้านี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklenebilecek satın alma yok.\nYalnızca daha önce satın alınmış tüketilemez ürünler ve otomatik yenilenen abonelikler geri yüklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає покупок, які можна відновити.\nВідновити можна лише раніше придбані неспоживні продукти та підписки з автоматичним поновленням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giao dịch mua nào có thể khôi phục.\nChỉ những sản phẩm không tiêu hao và gói đăng ký tự động gia hạn đã mua trước đó mới có thể được khôi phục."
          }
        }
      }
    },

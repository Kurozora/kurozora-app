    "onboarding.appleAuthenticationFailedMessage" : {
      "comment" : "Error message shown when Apple authentication fails.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت المصادقة من قِبل Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple দ্বারা অনুমোদন ব্যর্থ হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověření přes Apple selhalo. Zkuste to prosím znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkendelsen mislykkedes hos Apple. Prøv venligst igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Authentifizierung durch Apple ist fehlgeschlagen. Bitte versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ταυτοποίηση από την Apple απέτυχε. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Authentication failed by Apple. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no pudo completar la autenticación. Inténtelo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no pudo completar la autenticación. Vuelva a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احراز هویت توسط Apple ناموفق بود. لطفاً دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-todennus epäonnistui. Yrittäkää uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabigo ang pagpapatotoo ng Apple. Pakisubukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l’authentification par Apple. Veuillez réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האימות נכשל על ידי Apple. נא לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple द्वारा प्रमाणीकरण विफल रहा। कृपया पुनः प्रयास करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple-hitelesítés sikertelen volt. Kérjük, próbálja újra."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-ի կողմից նույնականացումը ձախողվեց։ Խնդրում ենք կրկին փորձել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentikasi gagal oleh Apple. Harap coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticazione non riuscita da parte di Apple. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleによる認証に失敗しました。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 인증에 실패했습니다. 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengesahan gagal oleh Apple. Sila cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentiseringen mislyktes hos Apple. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificatie door Apple is mislukt. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwierzytelnianie przez Apple nie powiodło się. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha na autenticação pela Apple. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A autenticação pela Apple falhou. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentificarea prin Apple a eșuat. Vă rugăm să încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось пройти аутентификацию через Apple. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentiseringen misslyckades hos Apple. Försök igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple மூலம் அங்கீகாரம் தோல்வியடைந்தது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ద్వారా ప్రామాణీకరణ విఫలమైంది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การยืนยันตัวตนโดย Apple ล้มเหลว โปรดลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ile kimlik doğrulama başarısız oldu. Lütfen tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося пройти автентифікацію через Apple. Будь ласка, спробуйте ще раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple کی جانب سے تصدیق ناکام ہو گئی۔ براہِ کرم دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác thực bằng Apple thất bại. Vui lòng thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 验证失败。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 驗證失敗。請再試一次。"

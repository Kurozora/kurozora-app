    "requestRefund.header.description" : {
      "comment" : "The description string for the Request Refund view.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع مشترياتك الأخيرة واطلب من Apple استرداد أي منها لم تعد ترغب فيه. تبتّ Apple في كل طلب، لذا فإن عمليات الاسترداد غير مضمونة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সাম্প্রতিক ক্রয়গুলো পর্যালোচনা করুন এবং যেগুলো আর চান না সেগুলো রিফান্ড করার জন্য Apple-কে অনুরোধ করুন। প্রতিটি অনুরোধের সিদ্ধান্ত Apple নেয়, তাই রিফান্ডের নিশ্চয়তা নেই।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projděte si své nedávné nákupy a požádejte Apple o vrácení peněz za ty, které již nechcete. O každé žádosti rozhoduje Apple, vrácení peněz proto není zaručeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå dine seneste køb, og bed Apple om at refundere dem, du ikke længere ønsker. Apple træffer afgørelse om hver enkelt anmodning, så refusioner kan ikke garanteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Ihre letzten Käufe und bitten Sie Apple um eine Erstattung für alles, was Sie nicht mehr möchten. Apple entscheidet über jede Anfrage, daher sind Erstattungen nicht garantiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τις πρόσφατες αγορές σας και ζητήστε από την Apple να επιστρέψει τα χρήματα για όσες δεν θέλετε πια. Η Apple αποφασίζει για κάθε αίτημα, επομένως οι επιστροφές χρημάτων δεν είναι εγγυημένες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Review your recent purchases and ask Apple to refund any you no longer want. Apple decides each request, so refunds aren't guaranteed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise sus compras recientes y solicite a Apple el reembolso de las que ya no desee. Apple decide cada solicitud, por lo que los reembolsos no están garantizados."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise sus compras recientes y solicite a Apple el reembolso de las que ya no desee. Apple decide cada solicitud, por lo que los reembolsos no están garantizados."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خریدهای اخیر خود را مرور کنید و از Apple بخواهید آن‌هایی را که دیگر نمی‌خواهید بازپرداخت کند. تصمیم درباره هر درخواست با Apple است، بنابراین بازپرداخت تضمین‌شده نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkastele viimeaikaisia ostojasi ja pyydä Applea hyvittämään ne, joita et enää halua. Apple päättää jokaisesta pyynnöstä, joten hyvityksiä ei taata."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang iyong mga kamakailang pagbili at hilingin sa Apple na i-refund ang mga hindi mo na gusto. Ang Apple ang magpapasya sa bawat kahilingan, kaya hindi garantisado ang mga refund."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en revue vos achats récents et demandez à Apple le remboursement de ceux dont vous ne voulez plus. Apple statue sur chaque demande, les remboursements ne sont donc pas garantis."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עברו על הרכישות האחרונות שלכם ובקשו מ-Apple החזר עבור כל רכישה שאינכם מעוניינים בה יותר. Apple מחליטה לגבי כל בקשה, ולכן החזרים אינם מובטחים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी हाल की खरीदारियों की समीक्षा करें और जो अब आप नहीं चाहते उनके रिफंड के लिए Apple से अनुरोध करें। हर अनुरोध पर निर्णय Apple लेता है, इसलिए रिफंड की गारंटी नहीं है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekintse át a legutóbbi vásárlásait, és kérje az Apple-től a visszatérítését azoknak, amelyekre már nincs szüksége. Minden kérelemről az Apple dönt, ezért a visszatérítés nem garantált."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Վերանայեք ձեր վերջին գնումները և խնդրեք Apple-ին վերադարձնել նրանց գումարը, որոնք այլևս չեք ցանկանում։ Յուրաքանչյուր հարցում որոշում է Apple-ը, ուստի գումարի վերադարձը երաշխավորված չէ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau pembelian terbaru Anda dan ajukan pengembalian dana kepada Apple untuk pembelian yang tidak lagi Anda inginkan. Apple yang memutuskan setiap permintaan, jadi pengembalian dana tidak dijamin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esamini i suoi acquisti recenti e chieda ad Apple il rimborso di quelli che non desidera più. Apple valuta ogni richiesta, quindi i rimborsi non sono garantiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の購入を確認し、不要になったものは Apple に返金を依頼できます。各依頼の可否は Apple が判断するため、返金は保証されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 구매 내역을 확인하고 더 이상 원하지 않는 항목에 대해 Apple에 환불을 요청하세요. 각 요청은 Apple이 결정하므로 환불이 보장되지는 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semak pembelian terkini anda dan minta Apple membayar balik mana-mana yang anda tidak mahukan lagi. Apple memutuskan setiap permintaan, jadi bayaran balik tidak dijamin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå gjennom de nylige kjøpene dine og be Apple om å refundere dem du ikke lenger ønsker. Apple avgjør hver forespørsel, så refusjoner kan ikke garanteres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk uw recente aankopen en vraag Apple om terugbetaling van wat u niet meer wilt. Apple beslist over elk verzoek, dus terugbetaling is niet gegarandeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzyj swoje ostatnie zakupy i poproś Apple o zwrot tych, których już nie chcesz. O każdym wniosku decyduje Apple, więc zwroty nie są gwarantowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise suas compras recentes e solicite à Apple o reembolso das que você não quer mais. A Apple decide cada solicitação, portanto os reembolsos não são garantidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja as suas compras recentes e peça à Apple o reembolso das que já não pretende. A Apple decide cada pedido, pelo que os reembolsos não são garantidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinați achizițiile dumneavoastră recente și solicitați Apple rambursarea celor pe care nu le mai doriți. Apple decide fiecare cerere, așa că rambursările nu sunt garantate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотрите ваши недавние покупки и попросите Apple вернуть средства за те, которые вам больше не нужны. Решение по каждому запросу принимает Apple, поэтому возврат средств не гарантирован."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska dina senaste köp och be Apple återbetala de du inte längre vill ha. Apple beslutar om varje begäran, så återbetalningar kan inte garanteras."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் சமீபத்திய கொள்முதல்களை மதிப்பாய்வு செய்து, நீங்கள் இனி விரும்பாதவற்றை திருப்பித்தருமாறு Apple-ஐக் கேட்கவும். ஒவ்வொரு கோரிக்கையையும் Apple முடிவு செய்வதால், பணத்திருப்பம் உறுதி செய்யப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ ఇటీవలి కొనుగోళ్లను సమీక్షించి, మీకు ఇకపై అవసరం లేని వాటిని రీఫండ్ చేయమని Apple ను అడగండి. ప్రతి అభ్యర్థనను Apple నిర్ణయిస్తుంది, కాబట్టి రీఫండ్‌లకు హామీ లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบรายการซื้อล่าสุดของคุณและขอให้ Apple คืนเงินสำหรับรายการที่คุณไม่ต้องการแล้ว Apple เป็นผู้พิจารณาคำขอแต่ละรายการ ดังนั้นการคืนเงินจึงไม่รับประกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son satın almalarınızı inceleyin ve artık istemediklerinizin geri ödemesini Apple'dan talep edin. Her talebe Apple karar verdiği için geri ödemeler garanti değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляньте свої нещодавні покупки та попросіть Apple повернути кошти за ті, які вам більше не потрібні. Apple розглядає кожен запит, тож повернення коштів не гарантується."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی حالیہ خریداریوں کا جائزہ لیں اور Apple سے جو بھی آپ نہیں چاہتے اُن کی رقم واپسی کی درخواست کریں۔ ہر درخواست کا فیصلہ Apple کرتا ہے، اس لیے رقم کی واپسی کی ضمانت نہیں ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại các giao dịch mua gần đây của bạn và yêu cầu Apple hoàn tiền cho những giao dịch bạn không còn muốn. Apple quyết định từng yêu cầu, vì vậy việc hoàn tiền không được đảm bảo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看您近期的购买项目，并就不再需要的项目向 Apple 申请退款。每项申请均由 Apple 决定，因此退款无法保证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看您近期的購買項目，並向 Apple 申請退款已不再需要的項目。每筆申請皆由 Apple 決定，因此退款無法保證。"
          }
        }
      }
    },

    "onboarding.signInSubheadline": {
      "comment": "The subheadline string for signing in.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sign in with your Kurozora Account to use the library and other Kurozora services."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met je Kurozora-account om de bibliotheek en andere Kurozora-diensten te gebruiken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول باستخدام حساب Kurozora الخاص بك لاستخدام المكتبة وخدمات Kurozora الأخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión con su Cuenta de Kurozora para usar la biblioteca y otros servicios de Kurozora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan Akun Kurozora Anda untuk menggunakan pustaka dan layanan Kurozora lainnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリやその他のKurozoraサービスを利用するには、Kurozoraアカウントでサインインしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão com sua Conta Kurozora para usar a biblioteca e outros serviços da Kurozora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich mit Ihrem Kurozora-Konto an, um die Bibliothek und andere Kurozora-Dienste zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre compte Kurozora pour utiliser la bibliothèque et les autres services Kurozora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo Account Kurozora per usare la libreria e gli altri servizi Kurozora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리와 그 밖의 Kurozora 서비스를 이용하려면 Kurozora 계정으로 로그인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na swoje konto Kurozora, aby korzystać z biblioteki i innych usług Kurozora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите с Учётной записью Kurozora, чтобы пользоваться библиотекой и другими сервисами Kurozora."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть зі своїм Обліковим записом Kurozora, щоб користуватися бібліотекою та іншими сервісами Kurozora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用您的 Kurozora 账户登录，以使用资料库及其他 Kurozora 服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的 Kurozora 帳號登入，即可使用圖庫與其他 Kurozora 服務。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ด้วยบัญชี Kurozora ของคุณเพื่อใช้คลังและบริการอื่นๆ ของ Kurozora"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığı ve diğer Kurozora hizmetlerini kullanmak için Kurozora Hesabınızla giriş yapın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng Tài Khoản Kurozora của bạn để sử dụng thư viện và các dịch vụ khác của Kurozora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión con su Cuenta de Kurozora para usar la biblioteca y otros servicios de Kurozora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in gamit ang iyong Kurozora Account upang magamit ang library at iba pang mga serbisyo ng Kurozora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी और अन्य Kurozora सेवाओं का उपयोग करने के लिए अपने Kurozora खाते से साइन इन करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se svým účtem Kurozora a využívejte knihovnu a další služby Kurozora."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده از کتابخانه و دیگر خدمات Kurozora، با حساب Kurozora خود وارد شوید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתחבר עם חשבון Kurozora שלך כדי להשתמש בספרייה ובשירותי Kurozora האחרים."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk dengan Akaun Kurozora anda untuk menggunakan pustaka dan perkhidmatan Kurozora yang lain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te cu Contul Kurozora pentru a folosi biblioteca și alte servicii Kurozora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med ditt Kurozora-konto för att använda biblioteket och andra Kurozora-tjänster."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε με τον Λογαριασμό Kurozora σας για να χρησιμοποιήσετε τη βιβλιοθήκη και τις άλλες υπηρεσίες του Kurozora."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইব্রেরি ও অন্যান্য Kurozora পরিষেবা ব্যবহার করতে আপনার Kurozora অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நூலகம் மற்றும் பிற Kurozora சேவைகளைப் பயன்படுத்த உங்கள் Kurozora கணக்குடன் உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైబ్రరీ ఇతర Kurozora సేవలను ఉపయోగించడానికి మీ Kurozora ఖాతాతో సైన్ ఇన్ చేయండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med din Kurozora-konto for at bruge biblioteket og andre Kurozora-tjenester."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautukaa sisään Kurozora-tilillänne käyttääksenne kirjastoa ja muita Kurozora-palveluita."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be a Kurozora fiókoddal, hogy használhasd a könyvtárat és a többi Kurozora szolgáltatást."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på med Kurozora-kontoen din for å bruke biblioteket og andre Kurozora-tjenester."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão com a sua Conta Kurozora para utilizar a biblioteca e outros serviços da Kurozora."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائبریری اور دیگر Kurozora خدمات استعمال کرنے کے لیے اپنے Kurozora اکاؤنٹ سے سائن اِن کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործեք ձեր Kurozora հաշվով՝ գրադարանն ու Kurozora-ի այլ ծառայություններն օգտագործելու համար։"
          }
        }
      }
    },

{
  "sourceLanguage": "en",
  "strings": {
    "%@ at %@mo. Save %@": {
      "comment": "The subscription saving description, where the placeholders are the billing period, the monthly price and the saved percentage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ at %2$@mo. Save %3$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ voor %2$@/mnd. Bespaar %3$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ شهريًا بسعر %2$@. وفّر %3$@"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a %2$@/mes. Ahorra %3$@"
          }
        },

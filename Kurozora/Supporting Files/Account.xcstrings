        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обліковий запис успішно створено! Будь ласка, перевірте свою електронну пошту для підтвердження."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکاؤنٹ کامیابی سے بن گیا! براہِ کرم تصدیق کے لیے اپنی ای میل چیک کریں۔"
          }
        },
        "vi" : {

    "Authentication could not continue because the user has been locked out of biometric authentication, due to failing authentication too many times.": {
      "comment": "The error shown when the user is locked out of biometric authentication.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticatie kon niet doorgaan omdat de gebruiker is buitengesloten van biometrische authenticatie, omdat de authenticatie te vaak is mislukt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت متابعة عملية التحقق لأن المستخدم قد تم حظره من المصادقة البيومترية بسبب فشل التحقق عددًا كبيرًا من المرات."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo continuar con la autenticación porque el usuario fue bloqueado de la autenticación biométrica tras fallar demasiadas veces."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi tidak dapat dilanjutkan karena pengguna telah terkunci dari autentikasi biometrik, akibat terlalu sering gagal melakukan autentikasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に何度も失敗したため、生体認証がロックアウトされており、認証を続行できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação não pôde continuar porque o usuário foi bloqueado da autenticação biométrica devido a tentativas malsucedidas em excesso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung konnte nicht fortgesetzt werden, da der Benutzer aufgrund zu vieler fehlgeschlagener Versuche von der biometrischen Authentifizierung ausgesperrt wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification n’a pas pu se poursuivre car l’utilisateur a été bloqué de l’authentification biométrique après un trop grand nombre d’échecs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile proseguire con l'autenticazione perché l'utente è stato bloccato dall'autenticazione biometrica a causa di troppi tentativi di autenticazione non riusciti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 너무 여러 번 실패하여 생체 인증이 잠겼기 때문에 인증을 계속할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można kontynuować uwierzytelniania, ponieważ uwierzytelnianie biometryczne zostało zablokowane z powodu zbyt wielu nieudanych prób."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось продолжить аутентификацию, так как биометрическая аутентификация заблокирована из-за слишком большого числа неудачных попыток."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося продовжити автентифікацію, оскільки користувача заблоковано для біометричної автентифікації через надто велику кількість невдалих спроб."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于验证失败次数过多，生物识别验证已被锁定，无法继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於驗證失敗次數過多，使用者已被鎖定無法使用生物辨識驗證，因此無法繼續驗證。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถดำเนินการยืนยันตัวตนต่อได้ เนื่องจากผู้ใช้ถูกล็อกออกจากการยืนยันตัวตนด้วยข้อมูลชีวมาตรจากการยืนยันตัวตนล้มเหลวหลายครั้งเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik doğrulama çok kez başarısız olduğundan, kullanıcı biyometrik kimlik doğrulamadan kilitlendiği için kimlik doğrulamaya devam edilemedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tiếp tục xác thực vì người dùng đã bị khóa khỏi xác thực sinh trắc học do xác thực thất bại quá nhiều lần."
          }
        }
      }
    },
    "Authentication could not start because the device does not support biometric authentication.": {
      "comment": "The error shown when the device does not support biometric authentication.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticatie kon niet starten omdat het apparaat geen biometrische authenticatie ondersteunt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء عملية التحقق لأن الجهاز لا يدعم المصادقة البيومترية."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la autenticación porque el dispositivo no admite la autenticación biométrica."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi tidak dapat dimulai karena perangkat tidak mendukung autentikasi biometrik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは生体認証に対応していないため、認証を開始できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação não pôde ser iniciada porque o dispositivo não oferece suporte à autenticação biométrica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung konnte nicht gestartet werden, da das Gerät keine biometrische Authentifizierung unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification n’a pas pu démarrer car l’appareil ne prend pas en charge l’authentification biométrique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare l'autenticazione perché il dispositivo non supporta l'autenticazione biometrica."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 생체 인증을 지원하지 않기 때문에 인증을 시작할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można rozpocząć uwierzytelniania, ponieważ urządzenie nie obsługuje uwierzytelniania biometrycznego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать аутентификацию, так как устройство не поддерживает биометрическую аутентификацию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розпочати автентифікацію, оскільки пристрій не підтримує біометричну автентифікацію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始验证，因为此设备不支持生物识别验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於此裝置不支援生物辨識驗證，因此無法開始驗證。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเริ่มการยืนยันตัวตนได้ เนื่องจากอุปกรณ์ไม่รองรับการยืนยันตัวตนด้วยข้อมูลชีวมาตร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt biyometrik kimlik doğrulamayı desteklemediği için kimlik doğrulama başlatılamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bắt đầu xác thực vì thiết bị không hỗ trợ xác thực sinh trắc học."
          }
        }
      }
    },
    "Authentication could not start because the user has not enrolled in biometric authentication.": {
      "comment": "The error shown when the user has not enrolled in biometric authentication.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticatie kon niet starten omdat de gebruiker zich niet heeft aangemeld voor biometrische authenticatie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء عملية التحقق لأن المستخدم لم يسجّل في المصادقة البيومترية."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la autenticación porque el usuario no ha configurado la autenticación biométrica."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi tidak dapat dimulai karena pengguna belum mendaftarkan autentikasi biometrik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生体認証が登録されていないため、認証を開始できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação não pôde ser iniciada porque o usuário não cadastrou a autenticação biométrica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung konnte nicht gestartet werden, da der Benutzer keine biometrische Authentifizierung eingerichtet hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification n’a pas pu démarrer car l’utilisateur n’a pas configuré l’authentification biométrique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare l'autenticazione perché l'utente non ha registrato l'autenticazione biometrica."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생체 인증이 등록되어 있지 않기 때문에 인증을 시작할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można rozpocząć uwierzytelniania, ponieważ użytkownik nie skonfigurował uwierzytelniania biometrycznego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать аутентификацию, так как биометрическая аутентификация не настроена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розпочати автентифікацію, оскільки користувач не налаштував біометричну автентифікацію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始验证，因为尚未设置生物识别验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於使用者尚未設定生物辨識驗證，因此無法開始驗證。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเริ่มการยืนยันตัวตนได้ เนื่องจากผู้ใช้ยังไม่ได้ลงทะเบียนการยืนยันตัวตนด้วยข้อมูลชีวมาตร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı biyometrik kimlik doğrulamaya kaydolmadığı için kimlik doğrulama başlatılamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bắt đầu xác thực vì người dùng chưa thiết lập xác thực sinh trắc học."
          }
        }
      }
    },
    "Authentication is required every time you return to the app.": {
      "comment": "The string for requiring authentication immediately.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificatie is vereist telkens wanneer u terugkeert naar de app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب التحقق في كل مرة تعود فيها إلى التطبيق."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere autenticación cada vez que regresa a la app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi diperlukan setiap kali Anda kembali ke aplikasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appに戻るたびに認証が必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação é exigida sempre que você retorna ao app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung ist jedes Mal erforderlich, wenn Sie zur App zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification est requise chaque fois que vous revenez dans l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autenticazione è richiesta ogni volta che torni nell'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱으로 돌아올 때마다 인증이 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnienie jest wymagane przy każdym powrocie do aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентификация требуется каждый раз при возврате в приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автентифікація потрібна щоразу, коли ви повертаєтеся до застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次返回应用时都需要验证身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次返回 App 時都需要進行驗證。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีการยืนยันตัวตนทุกครั้งที่คุณกลับเข้าสู่แอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaya her döndüğünüzde kimlik doğrulama gereklidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu xác thực mỗi khi bạn quay lại ứng dụng."
          }
        }
      }
    },
    "Authentication is required if the app remains in the background for more than %@.": {
      "comment": "The string for the 'Authentication Interval' settings description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificatie is vereist als de app langer dan %@ op de achtergrond blijft."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب التحقق إذا بقي التطبيق في الخلفية لأكثر من %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere autenticación si la app permanece en segundo plano por más de %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi diperlukan jika aplikasi tetap berada di latar belakang lebih dari %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appがバックグラウンドに%@を超えてとどまっている場合は、認証が必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação é exigida se o app permanecer em segundo plano por mais de %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung ist erforderlich, wenn die App länger als %@ im Hintergrund bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification est requise si l’app reste en arrière-plan pendant plus de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autenticazione è richiesta se l'app rimane in background per più di %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 %@ 넘게 백그라운드에 머무는 경우 인증이 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnienie jest wymagane, jeśli aplikacja pozostaje w tle dłużej niż %@."

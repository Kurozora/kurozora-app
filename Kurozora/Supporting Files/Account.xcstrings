          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur ini hanya dapat diakses oleh pengguna Kurozora+. Dana dari ini digunakan untuk mendukung pengembangan Kurozora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能は Kurozora+ ユーザーのみがご利用いただけます。その収益は Kurozora の開発支援に充てられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recurso está disponível apenas para usuários do Kurozora+. Os fundos arrecadados ajudam a financiar o desenvolvimento do Kurozora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktion steht nur Kurozora+ Nutzern zur Verfügung. Die Einnahmen daraus fließen in die Entwicklung von Kurozora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonctionnalité est réservée aux utilisateurs Kurozora+. Les fonds récoltés servent à soutenir le développement de Kurozora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa funzione è accessibile solo agli utenti Kurozora+. I proventi vengono destinati a sostenere lo sviluppo di Kurozora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능은 Kurozora+ 사용자만 이용할 수 있습니다. 여기서 발생한 수익은 Kurozora 개발 지원에 사용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta funkcja jest dostępna wyłącznie dla użytkowników Kurozora+. Środki z tego przeznaczane są na wspieranie rozwoju Kurozora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта функция доступна только пользователям Kurozora+. Полученные средства идут на поддержку разработки Kurozora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能仅向 Kurozora+ 用户开放。所得款项将用于支持 Kurozora 的开发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {

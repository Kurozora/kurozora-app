          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從多款主題中挑選，打造展現你個性與風格的外觀。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกจากธีมมากมายเพื่อสร้างรูปลักษณ์ที่สะท้อนบุคลิกและสไตล์ของคุณ"
          }
        },
        "tr": {

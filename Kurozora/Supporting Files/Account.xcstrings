    "Dive even deeper into discussions with an extended 1000 character limit for your feed messages.": {
      "comment": "The subscription feed-message character-limit product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duik nog dieper in discussies met een uitgebreide limiet van 1000 tekens voor je feedberichten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمّق أكثر في النقاشات بحدّ موسّع يبلغ 1000 حرف لرسائلك في التغذية."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundiza aún más en las conversaciones con un límite ampliado de 1000 caracteres en tus mensajes del feed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selami diskusi lebih dalam lagi dengan batas karakter yang diperluas hingga 1000 karakter untuk pesan feed kamu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードメッセージの文字数上限が1000文字に拡張され、もっと深く議論に入り込めるよ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergulhe ainda mais fundo nas discussões com um limite estendido de 1000 caracteres para suas mensagens no feed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauche noch tiefer in Diskussionen ein – mit einem erweiterten Limit von 1000 Zeichen für deine Feed-Nachrichten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plongez encore plus profondément dans les discussions avec une limite étendue de 1000 caractères pour vos messages de fil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immergiti ancora di più nelle discussioni con un limite esteso di 1000 caratteri per i tuoi messaggi nella timeline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드 메시지의 글자 수 제한이 1000자로 늘어나 토론에 더욱 깊이 빠져들 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanurz się jeszcze głębiej w dyskusjach dzięki rozszerzonemu limitowi 1000 znaków dla Twoich wiadomości w aktualnościach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погружайся в обсуждения ещё глубже с увеличенным лимитом в 1000 символов для сообщений в ленте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занурюйся ще глибше в обговорення з розширеним лімітом у 1000 символів для повідомлень у стрічці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态消息字数上限扩展至 1000 字，让你的讨论更尽兴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態訊息字數上限延長至 1000 字，讓你能更深入地參與討論。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำดิ่งสู่บทสนทนาให้ลึกยิ่งขึ้นด้วยขีดจำกัดข้อความฟีดที่ขยายเป็น 1000 ตัวอักษร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akış mesajların için 1000 karakterlik genişletilmiş bir sınırla tartışmalara daha da derinlemesine dal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đào sâu hơn vào các cuộc thảo luận với giới hạn 1000 ký tự mở rộng cho tin nhắn trên feed của bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundiza aún más en las conversaciones con un límite ampliado de 1000 caracteres para tus mensajes del timeline."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumisid pa nang mas malalim sa mga talakayan gamit ang pinalawak na 1000 character limit para sa iyong mga feed message."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ीड संदेशों के लिए विस्तारित 1000 वर्ण सीमा के साथ चर्चाओं में और भी गहराई से उतरो।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponoř se do diskuzí ještě hlouběji s rozšířeným limitem 1000 znaků pro tvé příspěvky na feedu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با محدودیت گسترش‌یافته ۱۰۰۰ نویسه برای پیام‌های فید خود، عمیق‌تر وارد بحث‌ها شوید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צללו עמוק עוד יותר אל תוך הדיונים עם מגבלת תווים מורחבת של 1000 תווים להודעות בפיד שלכם."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selami perbincangan dengan lebih mendalam menerusi had aksara dilanjutkan kepada 1000 untuk mesej suapan anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprofundează și mai mult discuțiile cu o limită extinsă de 1000 de caractere pentru mesajele tale din feed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyk ännu djupare i diskussioner med en utökad teckengräns på 1000 tecken för dina flödesmeddelanden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βυθίσου ακόμα πιο βαθιά στις συζητήσεις με ένα διευρυμένο όριο 1000 χαρακτήρων για τα μηνύματά σου στη ροή."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফিড মেসেজের জন্য বর্ধিত ১০০০ অক্ষরের সীমা নিয়ে আলোচনায় আরও গভীরে ডুব দিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் feed செய்திகளுக்கான விரிவாக்கப்பட்ட 1000 எழுத்து வரம்புடன் விவாதங்களில் இன்னும் ஆழமாக மூழ்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫీడ్ మెసేజ్‌లకు పెంచిన 1000 అక్షరాల పరిమితితో చర్చల్లో మరింత లోతుగా మునిగిపోండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyk endnu dybere ned i diskussionerne med en udvidet grænse på 1000 tegn til dine feed-beskeder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukella vielä syvemmälle keskusteluihin: syöteviesteissäsi on laajennettu 1000 merkin raja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Merülj el még mélyebben a beszélgetésekben a feedüzeneteid megnövelt, 1000 karakteres limitjével."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dykk enda dypere ned i diskusjonene med en utvidet grense på 1000 tegn for feed-meldingene dine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergulha ainda mais fundo nas discussões com um limite alargado de 1000 caracteres nas tuas mensagens da timeline."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے فیڈ پیغامات کے لیے 1000 حروف کی توسیع شدہ حد کے ساتھ گفتگو میں اور بھی گہرائی تک جائیں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սուզվիր էլ ավելի խորը քննարկումների մեջ՝ քո հոսքի հաղորդագրությունների համար 1000 նիշի ընդլայնված սահմանաչափով։"
          }
        }
      }
    },

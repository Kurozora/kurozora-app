    "Welcome back! Please authenticate to continue.": {
      "comment": "The biometric prompt reason shown when returning to the locked app.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom terug! Authenticeer om door te gaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بعودتك! يرجى المصادقة للمتابعة."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenido de nuevo! Por favor, autentíquese para continuar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang kembali! Silakan lakukan autentikasi untuk melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おかえりなさい！続けるには認証してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo de volta! Por favor, autentique-se para continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück! Bitte authentifizieren Sie sich, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour ! Veuillez vous authentifier pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentornato! Si autentichi per continuare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 오신 것을 환영합니다! 계속하려면 인증해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witamy ponownie! Uwierzytelnij się, aby kontynuować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С возвращением! Пожалуйста, пройдите аутентификацию, чтобы продолжить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎回来！请完成认证以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎回來！請完成驗證以繼續。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยินดีต้อนรับกลับมา! กรุณายืนยันตัวตนเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar hoş geldiniz! Devam etmek için lütfen kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З поверненням! Будь ласка, пройдіть автентифікацію, щоб продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng trở lại! Vui lòng xác thực để tiếp tục."
          }
        }
      }
    },
    "You are not authorized to make payments. In-App Purchases may be restricted on your device.": {
      "comment": "The message string for IAP is disabled.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U bent niet gemachtigd om betalingen te doen. In-app-aankopen zijn mogelijk beperkt op uw apparaat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير مخوّل لإجراء عمليات الدفع. قد تكون عمليات الشراء داخل التطبيق مقيّدة على جهازك."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No está autorizado a realizar pagos. Las compras dentro de la app podrían estar restringidas en su dispositivo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak diizinkan untuk melakukan pembayaran. Pembelian Dalam Aplikasi mungkin dibatasi di perangkat Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いを行う権限がありません。お使いのデバイスではアプリ内課金が制限されている可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está autorizado a fazer pagamentos. As compras dentro do app podem estar restritas no seu dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind nicht berechtigt, Zahlungen zu tätigen. In-App-Käufe sind auf Ihrem Gerät möglicherweise eingeschränkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes pas autorisé à effectuer des paiements. Les achats intégrés sont peut-être restreints sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è autorizzato a effettuare pagamenti. Gli acquisti in-app potrebbero essere limitati sul suo dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 권한이 없습니다. 회원님의 기기에서 앱 내 구입이 제한되어 있을 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz uprawnień do dokonywania płatności. Zakupy w aplikacji mogą być ograniczone na Twoim urządzeniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас нет разрешения на совершение платежей. Встроенные покупки могут быть ограничены на вашем устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无权进行付款。您设备上的应用内购买可能已受限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您未被授權進行付款。App 內購買項目在您的裝置上可能受到限制。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณไม่ได้รับอนุญาตให้ทำการชำระเงิน การซื้อภายในแอปอาจถูกจำกัดบนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme yapma yetkiniz yok. Uygulama İçi Satın Almalar cihazınızda kısıtlanmış olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не маєте дозволу здійснювати платежі. Покупки в застосунку можуть бути обмежені на вашому пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không được phép thực hiện thanh toán. Giao dịch mua trong ứng dụng có thể bị hạn chế trên thiết bị của bạn."
          }
        }
      }
    },
    "You've denied photo library access. You can change this in Settings.": {
      "comment": "The empty-state detail shown when photo access has been denied.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt toegang tot de fotobibliotheek geweigerd. Je kunt dit wijzigen in Instellingen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد رفضت الوصول إلى مكتبة الصور. يمكنك تغيير ذلك في الإعدادات."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Has denegado el acceso a la fototeca. Puedes cambiar esto en Ajustes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menolak akses pustaka foto. Anda dapat mengubahnya di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリへのアクセスを拒否しています。設定で変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você negou o acesso à fototeca. Você pode alterar isso em Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Zugriff auf die Fotomediathek verweigert. Du kannst das in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as refusé l’accès à la photothèque. Tu peux changer cela dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai negato l'accesso alla libreria foto. Puoi modificarlo nelle Impostazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함 접근을 거부하셨습니다. 설정에서 변경할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmówiono dostępu do biblioteki zdjęć. Możesz to zmienić w Ustawieniach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы запретили доступ к медиатеке. Изменить это можно в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已拒绝照片图库访问。您可在“设置”中更改此项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已拒絕照片圖庫的取用權限。你可以在「設定」中變更。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้ปฏิเสธการเข้าถึงคลังรูปภาพ คุณสามารถเปลี่ยนการตั้งค่านี้ได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf kitaplığı erişimini reddettiniz. Bunu Ayarlar'dan değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви заборонили доступ до медіатеки. Це можна змінити в Налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã từ chối quyền truy cập thư viện ảnh. Bạn có thể thay đổi điều này trong phần Cài đặt."
          }
        }
      }
    },
    "Your account was successfully created!": {
      "comment": "The welcome message shown after account setup completes.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is succesvol aangemaakt!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",

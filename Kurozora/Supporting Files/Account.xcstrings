    "All purchases have been restored.\nPlease remember that only previously bought non-consumable products and auto-renewable subscriptions can be restored." : {
      "comment" : "The message string for restoring IAP has succeeded.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة جميع المشتريات.\nيُرجى تذكّر أنه لا يمكن استعادة سوى المنتجات غير القابلة للاستهلاك والاشتراكات ذاتية التجديد التي تم شراؤها سابقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সমস্ত ক্রয় পুনরুদ্ধার করা হয়েছে।\nঅনুগ্রহ করে মনে রাখবেন, কেবল পূর্বে কেনা নন-কনজিউমেবল পণ্য এবং স্বয়ংক্রিয়ভাবে নবায়নযোগ্য সাবস্ক্রিপশনই পুনরুদ্ধার করা যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny nákupy byly obnoveny.\nUpozorňujeme, že obnovit lze pouze dříve zakoupené nespotřební produkty a automaticky obnovované předplatné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle køb er blevet gendannet.\nVær opmærksom på, at kun tidligere købte ikke-forbrugsvarer og automatisk fornyende abonnementer kan gendannes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Käufe wurden wiederhergestellt.\nBitte beachten Sie, dass nur zuvor erworbene nicht-verbrauchbare Produkte und automatisch verlängerbare Abonnements wiederhergestellt werden können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι αγορές αποκαταστάθηκαν.\nΈχετε υπόψη ότι μπορούν να αποκατασταθούν μόνο μη αναλώσιμα προϊόντα και αυτόματα ανανεούμενες συνδρομές που έχετε αγοράσει στο παρελθόν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han restaurado todas las compras.\nRecuerde que solo se pueden restaurar los productos no consumibles y las suscripciones de renovación automática adquiridos anteriormente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauraron todas las compras.\nRecuerde que solo se pueden restaurar los productos no consumibles y las suscripciones de renovación automática adquiridos anteriormente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام خریدها بازیابی شد.\nلطفاً به یاد داشته باشید که فقط محصولات مصرف‌نشدنی و اشتراک‌های با تمدید خودکار که قبلاً خریداری شده‌اند قابل بازیابی هستند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki ostot on palautettu.\nHuomaa, että vain aiemmin ostetut kertaluonteiset tuotteet ja automaattisesti uusiutuvat tilaukset voidaan palauttaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naibalik na ang lahat ng pagbili.\nPakitandaan na ang mga dating nabiling non-consumable na produkto at mga auto-renewable na subscription lamang ang maaaring ibalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les achats ont été restaurés.\nVeuillez noter que seuls les produits non consommables et les abonnements à renouvellement automatique précédemment achetés peuvent être restaurés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הרכישות שוחזרו.\nנא לזכור כי ניתן לשחזר רק מוצרים בלתי מתכלים ומינויים בחידוש אוטומטי שנרכשו בעבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी खरीदारियाँ पुनर्स्थापित कर दी गई हैं।\nकृपया ध्यान रखें कि केवल पहले से खरीदे गए नॉन-कंज़्यूमेबल उत्पाद और स्वतः-नवीकरणीय सदस्यताएँ ही पुनर्स्थापित की जा सकती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden vásárlás visszaállítva.\nKérjük, ne feledje, hogy csak a korábban megvásárolt, nem fogyasztható termékek és az automatikusan megújuló előfizetések állíthatók vissza."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բոլոր գնումները վերականգնվել են։\nԽնդրում ենք հիշել, որ վերականգնվում են միայն նախկինում ձեռք բերված ոչ սպառվող ապրանքները և ինքնավերականգնվող բաժանորդագրությունները։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua pembelian telah dipulihkan.\nHarap diingat bahwa hanya produk non-konsumtif dan langganan perpanjangan otomatis yang sebelumnya dibeli yang dapat dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli acquisti sono stati ripristinati.\nLe ricordiamo che è possibile ripristinare solo i prodotti non consumabili e gli abbonamenti con rinnovo automatico acquistati in precedenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての購入を復元しました。\n復元できるのは、以前に購入した非消耗型製品と自動更新サブスクリプションのみですのでご了承ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 구매 항목이 복원되었습니다.\n이전에 구매한 비소모성 제품과 자동 갱신 구독만 복원할 수 있다는 점을 기억해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua pembelian telah dipulihkan.\nSila ingat bahawa hanya produk tak boleh guna habis dan langganan auto-perbaharu yang dibeli sebelum ini boleh dipulihkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle kjøp er gjenopprettet.\nVær oppmerksom på at bare tidligere kjøpte ikke-forbruksvarer og automatisk fornyende abonnementer kan gjenopprettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle aankopen zijn hersteld.\nLet op: alleen eerder gekochte niet-verbruikbare producten en automatisch verlengende abonnementen kunnen worden hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie zakupy zostały przywrócone.\nProsimy pamiętać, że przywrócić można jedynie wcześniej zakupione produkty niezużywalne oraz subskrypcje odnawiane automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as compras foram restauradas.\nLembre-se de que somente produtos não consumíveis e assinaturas renováveis automaticamente que já foram adquiridos podem ser restaurados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as compras foram restauradas.\nLembre-se de que apenas os produtos não consumíveis e as subscrições com renovação automática adquiridos anteriormente podem ser restaurados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate achizițiile au fost restabilite.\nVă rugăm să rețineți că pot fi restabilite doar produsele neconsumabile și abonamentele cu reînnoire automată achiziționate anterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все покупки восстановлены.\nОбратите внимание, что восстановить можно только ранее приобретённые непотребляемые продукты и подписки с автопродлением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla köp har återställts.\nKom ihåg att endast tidigare köpta icke-förbrukningsbara produkter och automatiskt förnyade prenumerationer kan återställas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அனைத்து கொள்முதல்களும் மீட்டெடுக்கப்பட்டுள்ளன.\nமுன்னர் வாங்கிய நுகர்வு அல்லாத தயாரிப்புகள் மற்றும் தானியங்கி புதுப்பிப்பு சந்தாக்களை மட்டுமே மீட்டெடுக்க முடியும் என்பதை நினைவில் கொள்ளவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అన్ని కొనుగోళ్లు పునరుద్ధరించబడ్డాయి.\nదయచేసి గమనించండి, గతంలో కొనుగోలు చేసిన నాన్-కన్స్యూమబుల్ ఉత్పత్తులు మరియు ఆటో-రెన్యూవబుల్ సబ్‌స్క్రిప్షన్‌లను మాత్రమే పునరుద్ధరించవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืนการซื้อทั้งหมดเรียบร้อยแล้ว\nโปรดทราบว่าสามารถกู้คืนได้เฉพาะสินค้าแบบใช้ครั้งเดียวไม่ได้และการสมัครสมาชิกแบบต่ออายุอัตโนมัติที่เคยซื้อไว้ก่อนหน้านี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm satın alımlar geri yüklendi.\nLütfen yalnızca daha önce satın alınmış tüketilemez ürünlerin ve otomatik yenilenen aboneliklerin geri yüklenebileceğini unutmayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі покупки відновлено.\nЗверніть увагу, що відновити можна лише раніше придбані неспоживні товари та автоматично поновлювані підписки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام خریداریاں بحال کر دی گئی ہیں۔\nبراہِ کرم یاد رکھیں کہ صرف پہلے سے خریدی گئی نان-کنزیومیبل مصنوعات اور خودکار تجدید ہونے والی سبسکرپشنز ہی بحال کی جا سکتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả giao dịch mua đã được khôi phục.\nXin lưu ý rằng chỉ các sản phẩm không tiêu hao và các gói đăng ký tự động gia hạn đã mua trước đó mới có thể được khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有购买项目已恢复。\n请注意，仅可恢复此前购买的非消耗型项目和自动续期订阅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有購買項目皆已還原。\n請注意，僅先前購買的非消耗性產品與自動續訂的訂閱項目可供還原。"
          }
        }
      }
    },

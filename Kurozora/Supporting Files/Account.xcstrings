        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunasta koodisi laitteesi kameralla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Váltsd be a kódodat az eszköződ kamerájával."

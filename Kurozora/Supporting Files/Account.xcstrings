    "Sign in with Apple is the fast, easy way for you to sign in to Kurozora using the Apple ID you already have.": {
      "comment": "The subheadline string for the Sign in with Apple view.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met Apple is de snelle, makkelijke manier om in te loggen bij Kurozora met de Apple ID die u al hebt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول باستخدام Apple هو الطريقة السريعة والسهلة لتسجيل الدخول إلى Kurozora باستخدام Apple ID الذي تملكه بالفعل."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con Apple es la forma rápida y fácil de iniciar sesión en Kurozora usando el Apple ID que ya tiene."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple adalah cara cepat dan mudah untuk masuk ke Kurozora menggunakan Apple ID yang sudah Anda miliki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple は、お持ちの Apple ID を使って Kurozora にすばやく簡単にサインインできる方法です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar com a Apple é a forma rápida e fácil de você entrar no Kurozora usando o Apple ID que você já tem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Apple anmelden ist der schnelle, einfache Weg, sich mit Ihrer vorhandenen Apple-ID bei Kurozora anzumelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter avec Apple est le moyen rapide et simple de vous connecter à Kurozora avec l’Apple ID que vous possédez déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Apple è il modo facile e veloce per accedere a Kurozora usando l'Apple ID che hai già."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인은 이미 가지고 계신 Apple ID로 Kurozora에 빠르고 간편하게 로그인하는 방법입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się przez Apple to szybki i łatwy sposób na zalogowanie się do Kurozora przy użyciu posiadanego już Apple ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход с Apple — это быстрый и простой способ войти в Kurozora с помощью вашего существующего Apple ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 登录，可让您使用现有的 Apple ID 快速便捷地登录 Kurozora。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「透過 Apple 登入」是一種快速、簡便的方式，讓您使用既有的 Apple ID 登入 Kurozora。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple เป็นวิธีที่รวดเร็วและง่ายดายในการลงชื่อเข้าใช้ Kurozora โดยใช้ Apple ID ที่คุณมีอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ile Oturum Aç, halihazırda sahip olduğunuz Apple ID ile Kurozora'da oturum açmanın hızlı ve kolay yoludur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple — це швидкий і простий спосіб увійти в Kurozora за допомогою Apple ID, який у вас уже є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple là cách nhanh chóng, dễ dàng để bạn đăng nhập vào Kurozora bằng Apple ID mà bạn đã có."
          }
        }
      }
    },

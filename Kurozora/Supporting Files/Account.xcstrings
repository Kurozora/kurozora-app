    },
    "Your account was successfully created!": {
      "comment": "The welcome message shown after account setup completes.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is succesvol aangemaakt!"
          }
        }
      }

    "onboarding.signUpAlertSubheadline" : {
      "comment" : "The subheadline string for sign up alert.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

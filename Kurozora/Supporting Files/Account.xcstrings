    "onboarding.twoFactorExpiredMessage": {
      "comment": "Alert message shown when the two-factor authentication challenge expires.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your verification session has expired. Please sign in again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw verificatiesessie is verlopen. Log opnieuw in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلسة التحقق الخاصة بك. يرجى تسجيل الدخول مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión de verificación expiró. Por favor, inicie sesión de nuevo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi verifikasi Anda telah berakhir. Silakan masuk kembali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証セッションの有効期限が切れました。もう一度サインインしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão de verificação expirou. Por favor, entre novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Verifizierungssitzung ist abgelaufen. Bitte melden Sie sich erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session de vérification a expiré. Veuillez vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua sessione di verifica è scaduta. Effettui di nuovo l'accesso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 세션이 만료되었습니다. 다시 로그인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja weryfikacji wygasła. Zaloguj się ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия сессии проверки истёк. Пожалуйста, войдите снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的验证会话已过期，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的驗證工作階段已逾期，請重新登入。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันการยืนยันตัวตนของคุณหมดอายุแล้ว กรุณาลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama oturumunuzun süresi doldu. Lütfen tekrar oturum açın."

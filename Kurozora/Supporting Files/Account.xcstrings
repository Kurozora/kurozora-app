    "Choose from a range of themes to create a look that reflects your personality and style.": {
      "comment": "The 'dynamic themes' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies uit een reeks thema's om een look te maken die bij je persoonlijkheid en stijl past."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من بين مجموعة من السمات لإنشاء مظهر يعكس شخصيتك وأسلوبك."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre una variedad de temas para crear un aspecto que refleje tu personalidad y tu estilo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih dari berbagai tema untuk menciptakan tampilan yang mencerminkan kepribadian dan gaya kamu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "豊富なテーマから選んで、あなたの個性やスタイルを映す見た目に仕上げよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha entre uma variedade de temas para criar um visual que reflita sua personalidade e seu estilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus einer Vielzahl von Themes und gestalte einen Look, der deine Persönlichkeit und deinen Stil widerspiegelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez parmi une gamme de thèmes pour créer un style qui reflète votre personnalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra una vasta gamma di temi per creare un look che rispecchia la tua personalità e il tuo stile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다양한 테마 중에서 골라 당신의 개성과 스타일을 담은 분위기를 연출해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

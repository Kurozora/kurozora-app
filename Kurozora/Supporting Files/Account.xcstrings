        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 버튼으로 Kurozora 잠금을 해제하세요. 만약 남의 기기를 몰래 들여다보는 거라면 ⌘ + Q를 눌러 종료하세요 😤"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przycisku powyżej, aby odblokować Kurozora, a jeśli grzebiesz w cudzym urządzeniu, to naciśnij ⌘ + Q, aby wyjść 😤"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку выше, чтобы разблокировать Kurozora, а если вы шарите в чужом устройстве, то нажмите ⌘ + Q, чтобы выйти 😤"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用上方的按钮解锁 Kurozora，要是你在偷看别人的设备，那就按 ⌘ + Q 退出吧 😤"

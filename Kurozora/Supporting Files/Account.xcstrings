    "There are no restorable purchases.\nOnly previously bought non-consumable products and auto-renewable subscriptions can be restored.": {
      "comment": "The message string for restoring IAP has failed.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen herstelbare aankopen.\nAlleen eerder gekochte niet-verbruikbare producten en automatisch verlengende abonnementen kunnen worden hersteld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مشتريات قابلة للاستعادة.\nيمكن استعادة المنتجات غير القابلة للاستهلاك والاشتراكات ذاتية التجديد التي تم شراؤها سابقًا فقط."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay compras restaurables.\nSolo se pueden restaurar los productos no consumibles comprados anteriormente y las suscripciones de renovación automática."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pembelian yang dapat dipulihkan.\nHanya produk non-konsumsi dan langganan perpanjangan otomatis yang dibeli sebelumnya yang dapat dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元可能な購入がありません。\n復元できるのは、以前に購入した非消耗型の製品と自動更新サブスクリプションのみです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há compras que possam ser restauradas.\nApenas produtos não consumíveis e assinaturas com renovação automática comprados anteriormente podem ser restaurados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine wiederherstellbaren Käufe.\nNur zuvor gekaufte nicht-verbrauchbare Produkte und automatisch verlängerbare Abonnements können wiederhergestellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat ne peut être restauré.\nSeuls les produits non consommables déjà achetés et les abonnements à renouvellement automatique peuvent être restaurés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono acquisti ripristinabili.\nÈ possibile ripristinare solo prodotti non consumabili e abbonamenti a rinnovo automatico acquistati in precedenza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 수 있는 구매 항목이 없습니다.\n이전에 구매한 비소모성 제품과 자동 갱신 구독만 복원할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zakupów do przywrócenia.\nPrzywrócić można tylko wcześniej kupione produkty niekonsumpcyjne oraz subskrypcje odnawiane automatycznie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет покупок, доступных для восстановления.\nВосстановить можно только ранее приобретённые непотребляемые продукты и автопродлеваемые подписки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可恢复的购买项目。\n仅可恢复此前购买的非消耗型产品和可自动续订的订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可回復的購買項目。\n僅能回復先前購買的非消耗性產品與自動續訂的訂閱。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการซื้อที่สามารถกู้คืนได้\nกู้คืนได้เฉพาะสินค้าแบบไม่สิ้นเปลืองและการสมัครสมาชิกแบบต่ออายุอัตโนมัติที่เคยซื้อไว้ก่อนหน้านี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklenebilecek satın alma yok.\nYalnızca daha önce satın alınmış tüketilemez ürünler ve otomatik yenilenen abonelikler geri yüklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає покупок, які можна відновити.\nВідновити можна лише раніше придбані неспоживні продукти та підписки з автоматичним поновленням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giao dịch mua nào có thể khôi phục.\nChỉ những sản phẩm không tiêu hao và gói đăng ký tự động gia hạn đã mua trước đó mới có thể được khôi phục."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay compras que se puedan restaurar.\nSolo se pueden restaurar los productos no consumibles y las suscripciones de renovación automática adquiridos anteriormente."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang mga pagbiling maaaring ibalik.\nTanging mga dati nang biniling non-consumable na produkto at mga auto-renewable na subscription lamang ang maaaring ibalik."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्स्थापित करने योग्य कोई खरीद नहीं है।\nकेवल पहले से खरीदे गए नॉन-कंज़्यूमेबल प्रोडक्ट और स्वतः-नवीनीकरण योग्य सदस्यताएँ ही पुनर्स्थापित की जा सकती हैं।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsou k dispozici žádné obnovitelné nákupy.\nObnovit lze pouze dříve zakoupené nespotřebovatelné produkty a automaticky obnovovaná předplatná."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ خرید قابل بازیابی‌ای وجود ندارد.\nتنها محصولات غیرمصرفی و اشتراک‌های خودکارِ تمدیدشونده که قبلاً خریداری شده‌اند قابل بازیابی هستند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין רכישות שניתן לשחזר.\nניתן לשחזר רק מוצרים בלתי מתכלים ומינויים מתחדשים אוטומטית שנרכשו בעבר."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada pembelian yang boleh dipulihkan.\nHanya produk tak boleh guna habis dan langganan auto-pembaharuan yang dibeli sebelum ini boleh dipulihkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există achiziții care pot fi restabilite.\nDoar produsele neconsumabile cumpărate anterior și abonamentele cu reînnoire automată pot fi restabilite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga köp som kan återställas.\nEndast tidigare köpta icke-förbrukningsbara produkter och automatiskt förnyade prenumerationer kan återställas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν αγορές προς επαναφορά.\nΜόνο μη αναλώσιμα προϊόντα και αυτόματα ανανεούμενες συνδρομές που αγοράστηκαν στο παρελθόν μπορούν να επαναφερθούν."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরুদ্ধারযোগ্য কোনো ক্রয় নেই।\nশুধুমাত্র আগে কেনা নন-কনজিউমেবল প্রোডাক্ট এবং স্বয়ংক্রিয়ভাবে নবায়নযোগ্য সাবস্ক্রিপশন পুনরুদ্ধার করা যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்டமைக்கக்கூடிய கொள்முதல்கள் எதுவும் இல்லை.\nமுன்பு வாங்கிய நுகர்வுசாரா தயாரிப்புகள் மற்றும் தானாக-புதுப்பிக்கக்கூடிய சந்தாக்கள் மட்டுமே மீட்டமைக்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరుద్ధరించదగిన కొనుగోళ్లు ఏవీ లేవు.\nగతంలో కొనుగోలు చేసిన నాన్-కన్స్యూమబుల్ ఉత్పత్తులు మరియు ఆటో-రెన్యూవబుల్ చందాలను మాత్రమే పునరుద్ధరించవచ్చు."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen køb, der kan gendannes.\nKun tidligere købte ikke-forbrugsvarer og automatisk fornyende abonnementer kan gendannes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautettavia ostoja ei ole.\nVain aiemmin ostetut kuluvat tuotteet ja automaattisesti uusiutuvat tilaukset voidaan palauttaa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincsenek visszaállítható vásárlások.\nCsak a korábban megvásárolt, nem fogyasztható termékek és az automatikusan megújuló előfizetések állíthatók vissza."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen kjøp som kan gjenopprettes.\nKun tidligere kjøpte ikke-forbrukbare produkter og automatisk fornybare abonnementer kan gjenopprettes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não existem compras restauráveis.\nApenas é possível restaurar produtos não consumíveis e subscrições com renovação automática adquiridos anteriormente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بحال کی جا سکنے والی کوئی خریداری موجود نہیں ہے۔\nصرف پہلے سے خریدے گئے غیر صَرفی پراڈکٹس اور خودکار تجدید پذیر سبسکرپشنز بحال کی جا سکتی ہیں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերականգնելի գնումներ չկան։\nՎերականգնվել կարող են միայն նախկինում գնված ոչ-սպառվող ապրանքները և ինքնաշխատ երկարաձգվող բաժանորդագրությունները։"
          }
        }
      }
    },

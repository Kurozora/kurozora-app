    "Allow access to your photo library to choose a profile picture.": {
      "comment": "The empty-state detail prompting the user to grant photo access.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot je fotobibliotheek om een profielfoto te kiezen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى مكتبة صورك لاختيار صورة الملف الشخصي."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tu fototeca para elegir una foto de perfil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke pustaka foto Anda untuk memilih foto profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール写真を選ぶには、写真ライブラリへのアクセスを許可してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à sua galeria de fotos para escolher uma foto de perfil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf deine Fotomediathek, um ein Profilbild auszuwählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à votre photothèque pour choisir une photo de profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alla tua libreria foto per scegliere un'immagine del profilo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 사진을 선택하려면 사진 보관함 접근을 허용해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do biblioteki zdjęć, aby wybrać zdjęcie profilowe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к медиатеке, чтобы выбрать фото профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте доступ до вашої фотобібліотеки, щоб обрати фото профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许访问您的照片库以选择头像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許存取你的照片圖庫以選擇個人頭像。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงคลังรูปภาพของคุณเพื่อเลือกรูปโปรไฟล์"
          }
        },
        "tr": {

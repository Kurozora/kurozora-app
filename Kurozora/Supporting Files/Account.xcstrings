          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurozora আনলক করতে উপরের বোতামটি ব্যবহার করো, অথবা তুমি যদি অন্য কারো ডিভাইসে উঁকিঝুঁকি মারছ তাহলে বের হতে ⌘ + Q চাপো 😤"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použij tlačítko výše k odemknutí Kurozory, a pokud slídíš v cizím zařízení, tak stiskni ⌘ + Q pro ukončení 😤"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",

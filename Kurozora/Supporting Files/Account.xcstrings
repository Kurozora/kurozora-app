    "Dive even deeper into discussions with an extended 1000 character limit for your feed messages.": {
      "comment": "The subscription feed-message character-limit product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duik nog dieper in discussies met een uitgebreide limiet van 1000 tekens voor je feedberichten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمّق أكثر في النقاشات بحدّ موسّع يبلغ 1000 حرف لرسائلك في التغذية."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundiza aún más en las conversaciones con un límite ampliado de 1000 caracteres en tus mensajes del feed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selami diskusi lebih dalam lagi dengan batas karakter yang diperluas hingga 1000 karakter untuk pesan feed kamu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードメッセージの文字数上限が1000文字に拡張され、もっと深く議論に入り込めるよ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergulhe ainda mais fundo nas discussões com um limite estendido de 1000 caracteres para suas mensagens no feed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauche noch tiefer in Diskussionen ein – mit einem erweiterten Limit von 1000 Zeichen für deine Feed-Nachrichten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plongez encore plus profondément dans les discussions avec une limite étendue de 1000 caractères pour vos messages de fil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immergiti ancora di più nelle discussioni con un limite esteso di 1000 caratteri per i tuoi messaggi nella timeline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드 메시지의 글자 수 제한이 1000자로 늘어나 토론에 더욱 깊이 빠져들 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanurz się jeszcze głębiej w dyskusjach dzięki rozszerzonemu limitowi 1000 znaków dla Twoich wiadomości w aktualnościach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погружайся в обсуждения ещё глубже с увеличенным лимитом в 1000 символов для сообщений в ленте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занурюйся ще глибше в обговорення з розширеним лімітом у 1000 символів для повідомлень у стрічці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态消息字数上限扩展至 1000 字，让你的讨论更尽兴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態訊息字數上限延長至 1000 字，讓你能更深入地參與討論。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำดิ่งสู่บทสนทนาให้ลึกยิ่งขึ้นด้วยขีดจำกัดข้อความฟีดที่ขยายเป็น 1000 ตัวอักษร"

    "onboarding.twoFactorNetworkError": {
      "comment": "Inline error shown on the two-factor screen when the verification request fails due to a network error.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Network error. Check your connection and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerkfout. Controleer uw verbinding en probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ في الشبكة. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de red. Verifique su conexión e inténtelo de nuevo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan jaringan. Periksa koneksi Anda dan coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークエラーです。接続を確認してもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro de rede. Verifique sua conexão e tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkfehler. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur réseau. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di rete. Controlli la connessione e riprovi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 오류입니다. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błąd sieci. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка сети. Проверьте подключение и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络错误。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路錯誤。請檢查您的連線後再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดของเครือข่าย กรุณาตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ hatası. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка мережі. Перевірте з’єднання та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi mạng. Vui lòng kiểm tra kết nối và thử lại."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de red. Compruebe su conexión e inténtelo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May error sa network. Suriin ang iyong koneksyon at subukan muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क त्रुटि। अपना कनेक्शन जाँचें और दोबारा प्रयास करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba sítě. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خطای شبکه. اتصال خود را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שגיאת רשת. בדקו את החיבור ונסו שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralat rangkaian. Semak sambungan anda dan cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eroare de rețea. Verificați conexiunea și încercați din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätverksfel. Kontrollera din anslutning och försök igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σφάλμα δικτύου. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটওয়ার্ক ত্রুটি। আপনার সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிணைய பிழை. உங்கள் இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నెట్‌వర్క్ లోపం. మీ కనెక్షన్‌ను తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværksfejl. Tjek din forbindelse, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkovirhe. Tarkista yhteytesi ja yritä uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hálózati hiba. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksfeil. Kontroller tilkoblingen din og prøv igjen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro de rede. Verifique a sua ligação e tente novamente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیٹ ورک کی خرابی۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցանցային սխալ։ Ստուգեք ձեր կապը և նորից փորձեք։"
          }
        }
      }
    },

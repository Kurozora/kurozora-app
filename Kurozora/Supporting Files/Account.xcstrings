    "Photo Access Denied": {
      "comment": "The empty-state title shown when photo access has been denied.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fototoegang geweigerd"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى الصور"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a fotos denegado"
          }
        },
        "id": {
          "stringUnit": {

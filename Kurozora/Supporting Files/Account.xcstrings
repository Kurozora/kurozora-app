    "Make your home screen stand out with premium and limited time app icons.": {
      "comment": "The 'stylish app icons' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je beginscherm opvallen met premium app-symbolen voor beperkte tijd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل شاشتك الرئيسية مميزة بأيقونات تطبيق مدفوعة ومحدودة الوقت."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que tu pantalla de inicio destaque con iconos de app premium y por tiempo limitado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat layar utama kamu menonjol dengan ikon aplikasi premium dan edisi waktu terbatas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアムや期間限定のAppアイコンで、ホーム画面をひときわ目立たせよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaque sua tela de início com ícones de app premium e por tempo limitado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deinen Home-Bildschirm mit Premium- und zeitlich begrenzten App-Symbolen herausstechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarque ton écran d’accueil avec des icônes d’app premium et en édition limitée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai risaltare la tua schermata Home con icone dell'app premium e a tempo limitato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리미엄 및 한정 기간 앱 아이콘으로 홈 화면을 돋보이게 만들어 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraw, by Twój ekran główny się wyróżniał, dzięki ikonom aplikacji premium oraz tym dostępnym przez ograniczony czas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделай свой домашний экран особенным с премиальными и ограниченными по времени иконками приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вирізни свій головний екран преміальними та обмеженими в часі іконками застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用高级版和限时应用图标，让你的主屏幕脱颖而出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用尊榮與限時的 App 圖示，讓你的主畫面與眾不同。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้หน้าจอโฮมของคุณโดดเด่นด้วยไอคอนแอปแบบพรีเมียมและรุ่นลิมิเต็ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium ve sınırlı süreli uygulama simgeleriyle ana ekranını öne çıkar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm cho màn hình chính của bạn nổi bật với các biểu tượng ứng dụng cao cấp và phiên bản giới hạn thời gian."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que tu pantalla de inicio destaque con iconos de app premium y de tiempo limitado."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagandahin ang iyong home screen gamit ang premium at limited time na mga app icon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीमियम और सीमित समय के ऐप आइकनों के साथ अपनी होम स्क्रीन को खास बनाओ।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odliš svou domovskou obrazovku prémiovými a časově omezenými ikonami aplikace."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با نمادهای برنامه ویژه و محدود به زمان، صفحه اصلی خود را متمایز کن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרמו למסך הבית שלכם לבלוט עם אייקוני אפליקציה פרימיום ולזמן מוגבל."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Serikan skrin utama anda dengan ikon aplikasi premium dan edisi masa terhad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă-ți ecranul principal să iasă în evidență cu pictograme de aplicație premium și pe timp limitat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få din hemskärm att sticka ut med premium-appikoner och tidsbegränsade appikoner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε την αρχική σου οθόνη να ξεχωρίζει με premium και περιορισμένης διάρκειας εικονίδια εφαρμογής."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিমিয়াম ও সীমিত সময়ের অ্যাপ আইকন দিয়ে আপনার হোম স্ক্রিনকে আলাদা করে তুলুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிரீமியம் மற்றும் வரையறுக்கப்பட்ட கால ஆப் ஐகான்களுடன் உங்கள் முகப்புத் திரையைத் தனித்து நிற்க வையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రీమియం, పరిమిత కాలపు యాప్ ఐకాన్‌లతో మీ హోమ్ స్క్రీన్‌ను ప్రత్యేకంగా నిలబెట్టండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få din hjemmeskærm til at skille sig ud med premium-app-ikoner og ikoner i begrænset tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee aloitusnäytöstäsi näyttävä premium- ja rajoitetun ajan sovelluskuvakkeilla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd egyedivé a kezdőképernyődet prémium és limitált ideig elérhető app ikonokkal."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Få hjemskjermen din til å skille seg ut med eksklusive appikoner og appikoner for begrenset tid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca o teu ecrã principal com ícones de aplicação premium e por tempo limitado."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پریمیم اور محدود مدت کے ایپ آئیکنز کے ساتھ اپنی ہوم اسکرین کو نمایاں بنائیں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աչքի գցիր քո հիմնական էկրանը պրեմիում և սահմանափակ ժամանակով հասանելի հավելվածի պատկերակներով։"
          }
        }
      }
    },

    "Your contribution helps with maintaining the servers, paying for software licenses, and fund events and activities." : {
      "comment" : "The 'support the community' product feature description.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تساعد مساهمتك في صيانة الخوادم، ودفع تكاليف تراخيص البرامج، وتمويل الفعاليات والأنشطة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার অবদান সার্ভার রক্ষণাবেক্ষণে, সফটওয়্যার লাইসেন্সের খরচ মেটাতে এবং ইভেন্ট ও কার্যক্রমে অর্থায়নে সাহায্য করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj příspěvek pomáhá udržovat servery, platit softwarové licence a financovat akce a aktivity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bidrag hjælper med at vedligeholde serverne, betale for softwarelicenser og finansiere arrangementer og aktiviteter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Beitrag hilft dabei, die Server zu warten, Softwarelizenzen zu bezahlen und Events und Aktivitäten zu finanzieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνεισφορά σου βοηθά στη συντήρηση των διακομιστών, στην πληρωμή αδειών λογισμικού και στη χρηματοδότηση εκδηλώσεων και δραστηριοτήτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contribución ayuda a mantener los servidores, pagar las licencias de software y financiar eventos y actividades."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contribución ayuda a mantener los servidores, pagar las licencias de software y financiar eventos y actividades."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمک تو به نگه‌داری سرورها، پرداخت هزینه مجوزهای نرم‌افزاری و تأمین مالی رویدادها و فعالیت‌ها یاری می‌رساند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoksesi auttaa ylläpitämään palvelimia, maksamaan ohjelmistolisenssejä sekä rahoittamaan tapahtumia ja toimintaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakatulong ang iyong kontribusyon sa pagpapanatili ng mga server, pagbabayad ng mga software license, at pagpopondo ng mga event at aktibidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta contribution aide à entretenir les serveurs, à payer les licences logicielles et à financer des événements et des activités."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התרומה שלכם מסייעת בתחזוקת השרתים, בתשלום עבור רישיונות תוכנה ובמימון אירועים ופעילויות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका योगदान सर्वर बनाए रखने, सॉफ़्टवेयर लाइसेंस के भुगतान, और आयोजनों एवं गतिविधियों के वित्तपोषण में मदद करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzájárulásod segít a szerverek karbantartásában, a szoftverlicencek kifizetésében, valamint az események és tevékenységek finanszírozásában."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո ներդրումն օգնում է սերվերների սպասարկմանը, ծրագրային ապահովման լիցենզիաների վճարմանը և միջոցառումների ու գործունեության ֆինանսավորմանը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontribusimu membantu pemeliharaan server, pembayaran lisensi perangkat lunak, serta pendanaan acara dan kegiatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo contributo aiuta a mantenere i server, pagare le licenze software e finanziare eventi e attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erotu yhteisössä eksklusiivisella tilausmerkillä, joka kehittyy ajan myötä, kun jatkat Kurozoran tukemista!"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",

    "onboarding.siwaSubheadline": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Finish setting up your account and join the community."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond het instellen van je account af en word lid van de community."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل إعداد حسابك وانضم إلى المجتمع."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina de configurar tu cuenta y únete a la comunidad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan penyiapan akun Anda dan gabung dengan komunitas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの設定を完了してコミュニティに参加しよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine de configurar sua conta e junte-se à comunidade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Einrichtung deines Kontos ab und werde Teil der Community."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la configuration de votre compte et rejoignez la communauté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la configurazione del tuo account e unisciti alla community."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 설정을 마치고 커뮤니티에 참여하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokończ konfigurację konta i dołącz do społeczności."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите настройку аккаунта и присоединяйтесь к сообществу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成账户设置，加入社区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成帳號設定，加入社群吧。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าบัญชีของคุณให้เสร็จแล้วมาเข้าร่วมคอมมูนิตี้กัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabını kurmayı tamamla ve topluluğa katıl."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть налаштування свого акаунта та приєднайтеся до спільноти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất thiết lập tài khoản của bạn và tham gia cộng đồng."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina de configurar tu cuenta y únete a la comunidad."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapusin ang pag-set up ng iyong account at sumali sa komunidad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना खाता सेटअप पूरा करें और समुदाय से जुड़ें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokonči nastavení svého účtu a přidej se ke komunitě."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه‌اندازی حسابتان را کامل کنید و به جامعه بپیوندید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיימו להגדיר את החשבון שלכם והצטרפו לקהילה."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan penyediaan akaun anda dan sertai komuniti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizați configurarea contului și alăturați-vă comunității."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutför konfigurationen av ditt konto och gå med i communityt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκλήρωσε τη ρύθμιση του λογαριασμού σου και μπες στην κοινότητα."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট সেটআপ সম্পন্ন করুন এবং কমিউনিটিতে যোগ দিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கை அமைப்பதை முடித்து சமூகத்தில் இணையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతా సెటప్‌ను పూర్తి చేసి కమ్యూనిటీలో చేరండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Færdiggør opsætningen af din konto, og bliv en del af fællesskabet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeistele tilisi määritys ja liity yhteisöön."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejezze be a fiók beállítását, és csatlakozzon a közösséghez."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullfør oppsettet av kontoen din og bli med i fellesskapet."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine a configuração da sua conta e junte-se à comunidade."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا اکاؤنٹ ترتیب دینا مکمل کریں اور کمیونٹی میں شامل ہوں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավարտեք ձեր հաշվի կարգավորումը և միացեք համայնքին։"
          }
        }
      }
    },
    "onboarding.twoFactorExpiredMessage": {
      "comment": "Alert message shown when the two-factor authentication challenge expires.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your verification session has expired. Please sign in again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw verificatiesessie is verlopen. Log opnieuw in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلسة التحقق الخاصة بك. يرجى تسجيل الدخول مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión de verificación expiró. Por favor, inicie sesión de nuevo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi verifikasi Anda telah berakhir. Silakan masuk kembali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証セッションの有効期限が切れました。もう一度サインインしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão de verificação expirou. Por favor, entre novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Verifizierungssitzung ist abgelaufen. Bitte melden Sie sich erneut an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session de vérification a expiré. Veuillez vous reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua sessione di verifica è scaduta. Effettui di nuovo l'accesso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 세션이 만료되었습니다. 다시 로그인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja weryfikacji wygasła. Zaloguj się ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия сессии проверки истёк. Пожалуйста, войдите снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的验证会话已过期，请重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的驗證工作階段已逾期，請重新登入。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันการยืนยันตัวตนของคุณหมดอายุแล้ว กรุณาลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama oturumunuzun süresi doldu. Lütfen tekrar oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії сеансу підтвердження минув. Будь ласка, увійдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên xác minh của bạn đã hết hạn. Vui lòng đăng nhập lại."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión de verificación ha caducado. Vuelva a iniciar sesión."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire na ang iyong verification session. Mangyaring mag-sign in muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सत्यापन सत्र समाप्त हो गया है। कृपया दोबारा साइन इन करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost vašeho ověřovacího sezení vypršela. Přihlaste se prosím znovu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشست تأیید شما منقضی شده است. لطفاً دوباره وارد شوید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף סשן האימות פג. נא להתחבר שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi pengesahan anda telah tamat tempoh. Sila log masuk semula."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunea de verificare a expirat. Vă rugăm să vă autentificați din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din verifieringssession har upphört. Logga in igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεδρία επαλήθευσης έληξε. Παρακαλούμε συνδεθείτε ξανά."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার যাচাইকরণ সেশনের মেয়াদ শেষ হয়ে গেছে। অনুগ্রহ করে আবার সাইন ইন করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சரிபார்ப்பு அமர்வின் காலாவதியாகிவிட்டது. தயவுசெய்து மீண்டும் உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ధృవీకరణ సెషన్ గడువు ముగిసింది. దయచేసి మళ్లీ సైన్ ఇన్ చేయండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din verificeringssession er udløbet. Log venligst ind igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistusistuntosi on vanhentunut. Kirjaudu sisään uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ellenőrzési munkamenet lejárt. Kérjük, jelentkezzen be újra."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiseringsøkten din har utløpt. Vennligst logg inn på nytt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua sessão de verificação expirou. Inicie sessão novamente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا تصدیقی سیشن ختم ہو چکا ہے۔ براہ کرم دوبارہ سائن اِن کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հաստատման աշխատաշրջանի ժամկետը լրացել է։ Խնդրում ենք նորից մուտք գործել։"
          }
        }
      }
    },

    "Have more to say? Express yourself fully with a 500 character limit for your feed messages." : {
      "comment" : "The tip jar feed-message character-limit product feature description.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك المزيد لتقوله؟ عبّر عن نفسك بالكامل بحدّ يبلغ 500 حرف لرسائلك في التغذية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরও কিছু বলার আছে? আপনার ফিড মেসেজের জন্য ৫০০ অক্ষরের সীমা নিয়ে নিজেকে পুরোপুরি প্রকাশ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máš toho víc na srdci? Vyjádři se naplno s limitem 500 znaků pro tvé příspěvky na feedu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du mere på hjerte? Udtryk dig fuldt ud med en grænse på 500 tegn til dine feed-beskeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du mehr zu sagen? Bring dich voll zum Ausdruck – mit einem Limit von 500 Zeichen für deine Feed-Nachrichten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις περισσότερα να πεις; Εκφράσου ελεύθερα με όριο 500 χαρακτήρων για τα μηνύματά σου στη ροή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes más que decir? Exprésate sin límites con 500 caracteres para tus mensajes del timeline."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes más que decir? Exprésate a fondo con un límite de 500 caracteres en tus mensajes del feed."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",

    "This feature is only accessible to Kurozora+ users. Funds from this go to supporting Kurozora's development.": {
      "comment": "The alert message shown when a feature requires Kurozora+.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze functie is alleen beschikbaar voor Kurozora+-gebruikers. De opbrengst gaat naar de ontwikkeling van Kurozora."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الميزة متاحة لمستخدمي Kurozora+ فقط. تُستخدم الأموال المتأتية من ذلك في دعم تطوير Kurozora."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",

    "You are not authorized to make payments. In-App Purchases may be restricted on your device." : {
      "comment" : "The message string for IAP is disabled.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت غير مخوّل لإجراء عمليات الدفع. قد تكون عمليات الشراء داخل التطبيق مقيّدة على جهازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি পেমেন্ট করার জন্য অনুমোদিত নন। আপনার ডিভাইসে ইন-অ্যাপ পারচেজ সীমাবদ্ধ থাকতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemáte oprávnění provádět platby. Nákupy v aplikaci mohou být na vašem zařízení omezeny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er ikke autoriseret til at foretage betalinger. Køb i appen kan være begrænset på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind nicht berechtigt, Zahlungen zu tätigen. In-App-Käufe sind auf Ihrem Gerät möglicherweise eingeschränkt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε εξουσιοδότηση για πραγματοποίηση πληρωμών. Οι αγορές εντός εφαρμογής ενδέχεται να είναι περιορισμένες στη συσκευή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está autorizado a realizar pagos. Es posible que las compras dentro de la app estén restringidas en su dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está autorizado a realizar pagos. Las compras dentro de la app podrían estar restringidas en su dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما مجاز به انجام پرداخت نیستید. ممکن است خریدهای درون‌برنامه‌ای روی دستگاه شما محدود شده باشند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole oikeutta tehdä maksuja. Sovelluksen sisäiset ostot voivat olla rajoitettuja laitteellasi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala kang awtorisasyon na magbayad. Maaaring pinaghihigpitan ang In-App Purchases sa iyong device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’êtes pas autorisé à effectuer des paiements. Les achats intégrés sont peut-être restreints sur votre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אינכם מורשים לבצע תשלומים. ייתכן שרכישות בתוך האפליקציה מוגבלות במכשיר שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",

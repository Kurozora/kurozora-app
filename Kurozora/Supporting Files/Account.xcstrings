            "value": "החשבון שלכם נוצר בהצלחה!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun anda berjaya dicipta!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul dumneavoastră a fost creat cu succes!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt konto har skapats!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο λογαριασμός σας δημιουργήθηκε με επιτυχία!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট সফলভাবে তৈরি হয়েছে!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கு வெற்றிகரமாக உருவாக்கப்பட்டது!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఖాతా విజయవంతంగా సృష్టించబడింది!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto blev oprettet!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilisi luotiin onnistuneesti!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fiókja sikeresen létrejött!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen din ble opprettet!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua conta foi criada com sucesso!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اکاؤنٹ کامیابی سے بنا دیا گیا!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր հաշիվը հաջողությամբ ստեղծվեց։"
          }
        }
      }
    },
    "Your contribution helps with maintaining the servers, paying for software licenses, and fund events and activities.": {
      "comment": "The 'support the community' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bijdrage helpt bij het onderhouden van de servers, het betalen van softwarelicenties en het financieren van evenementen en activiteiten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد مساهمتك في صيانة الخوادم، ودفع تكاليف تراخيص البرامج، وتمويل الفعاليات والأنشطة."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contribución ayuda a mantener los servidores, pagar las licencias de software y financiar eventos y actividades."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontribusimu membantu pemeliharaan server, pembayaran lisensi perangkat lunak, serta pendanaan acara dan kegiatan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの支援は、サーバーの維持、ソフトウェアライセンスの支払い、イベントや活動の資金に役立ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua contribuição ajuda a manter os servidores, pagar licenças de software e financiar eventos e atividades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Beitrag hilft dabei, die Server zu warten, Softwarelizenzen zu bezahlen und Events und Aktivitäten zu finanzieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta contribution aide à entretenir les serveurs, à payer les licences logicielles et à financer des événements et des activités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo contributo aiuta a mantenere i server, pagare le licenze software e finanziare eventi e attività."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 후원은 서버 유지, 소프트웨어 라이선스 비용, 행사 및 활동 지원에 사용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój wkład pomaga w utrzymaniu serwerów, opłacaniu licencji na oprogramowanie oraz finansowaniu wydarzeń i aktywności."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш вклад помогает поддерживать серверы, оплачивать лицензии на программное обеспечение и финансировать мероприятия и активности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的贡献有助于维护服务器、支付软件许可费用，以及资助各类活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的貢獻有助於維護伺服器、支付軟體授權費用，以及資助各項活動。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนับสนุนของคุณช่วยในการดูแลเซิร์ฟเวอร์ จ่ายค่าลิขสิทธิ์ซอฟต์แวร์ และสนับสนุนกิจกรรมต่าง ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkın; sunucuların bakımına, yazılım lisanslarının ödenmesine ve etkinliklerin finanse edilmesine yardımcı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій внесок допомагає підтримувати сервери, оплачувати ліцензії на програмне забезпечення та фінансувати заходи й активності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng góp của bạn giúp duy trì máy chủ, chi trả cho giấy phép phần mềm và tài trợ cho các sự kiện cũng như hoạt động."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contribución ayuda a mantener los servidores, pagar las licencias de software y financiar eventos y actividades."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakakatulong ang iyong kontribusyon sa pagpapanatili ng mga server, pagbabayad ng mga software license, at pagpopondo ng mga event at aktibidad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका योगदान सर्वर बनाए रखने, सॉफ़्टवेयर लाइसेंस के भुगतान, और आयोजनों एवं गतिविधियों के वित्तपोषण में मदद करता है।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj příspěvek pomáhá udržovat servery, platit softwarové licence a financovat akce a aktivity."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کمک تو به نگه‌داری سرورها، پرداخت هزینه مجوزهای نرم‌افزاری و تأمین مالی رویدادها و فعالیت‌ها یاری می‌رساند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התרומה שלכם מסייעת בתחזוקת השרתים, בתשלום עבור רישיונות תוכנה ובמימון אירועים ופעילויות."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumbangan anda membantu menyelenggara pelayan, membayar lesen perisian, serta membiayai acara dan aktiviti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribuția ta ajută la întreținerea serverelor, plata licențelor software și finanțarea evenimentelor și activităților."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt bidrag hjälper till att underhålla servrarna, betala för programvarulicenser och finansiera evenemang och aktiviteter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνεισφορά σου βοηθά στη συντήρηση των διακομιστών, στην πληρωμή αδειών λογισμικού και στη χρηματοδότηση εκδηλώσεων και δραστηριοτήτων."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার অবদান সার্ভার রক্ষণাবেক্ষণে, সফটওয়্যার লাইসেন্সের খরচ মেটাতে এবং ইভেন্ট ও কার্যক্রমে অর্থায়নে সাহায্য করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பங்களிப்பு சேவையகங்களைப் பராமரிக்கவும், மென்பொருள் உரிமங்களுக்கு கட்டணம் செலுத்தவும், நிகழ்வுகள் மற்றும் செயல்பாடுகளுக்கு நிதியளிக்கவும் உதவுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సహకారం సర్వర్‌ల నిర్వహణకు, సాఫ్ట్‌వేర్ లైసెన్స్‌ల చెల్లింపుకు, ఈవెంట్‌లు మరియు కార్యకలాపాల నిధులకు ఉపయోగపడుతుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bidrag hjælper med at vedligeholde serverne, betale for softwarelicenser og finansiere arrangementer og aktiviteter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoksesi auttaa ylläpitämään palvelimia, maksamaan ohjelmistolisenssejä sekä rahoittamaan tapahtumia ja toimintaa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzájárulásod segít a szerverek karbantartásában, a szoftverlicencek kifizetésében, valamint az események és tevékenységek finanszírozásában."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidraget ditt hjelper med å vedlikeholde serverne, betale for programvarelisenser og finansiere arrangementer og aktiviteter."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua contribuição ajuda a manter os servidores, a pagar licenças de software e a financiar eventos e atividades."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا تعاون سرورز کی دیکھ بھال، سافٹ ویئر لائسنسز کی ادائیگی، اور تقریبات و سرگرمیوں کی مالی معاونت میں مدد کرتا ہے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո ներդրումն օգնում է սերվերների սպասարկմանը, ծրագրային ապահովման լիցենզիաների վճարմանը և միջոցառումների ու գործունեության ֆինանսավորմանը։"
          }
        }
      }
    },

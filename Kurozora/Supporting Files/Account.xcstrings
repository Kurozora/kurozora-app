    "Upgrade your profile with a gif image that captures your unique style.": {
      "comment": "The 'get animated' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfraai je profiel met een gif die je unieke stijl vastlegt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طوّر ملفك الشخصي بصورة gif تجسّد أسلوبك الفريد."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tu perfil con una imagen gif que capture tu estilo único."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkatkan profilmu dengan gambar gif yang menangkap gayamu yang unik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたならではのスタイルを表現する gif 画像で、プロフィールをアップグレードしよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprimore seu perfil com uma imagem gif que capture o seu estilo único."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte dein Profil mit einem GIF auf, das deinen einzigartigen Stil einfängt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliore ton profil avec un gif qui capture ton style unique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliora il tuo profilo con una gif che cattura il tuo stile unico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 개성을 담은 gif 이미지로 프로필을 업그레이드하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulepsz swój profil obrazkiem gif, który oddaje Twój niepowtarzalny styl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Украсьте свой профиль gif-изображением, передающим ваш уникальный стиль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一张展现你独特风格的 gif 图片升级你的个人资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用一張展現你獨特風格的 gif 圖片，為你的個人檔案升級。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกระดับโปรไฟล์ของคุณด้วยภาพ gif ที่บ่งบอกสไตล์เฉพาะตัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendine özgü tarzını yansıtan bir gif görseliyle profilini yükselt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покращ свій профіль зображенням у форматі gif, яке передає твій унікальний стиль."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng cấp hồ sơ của bạn với một ảnh gif thể hiện phong cách độc đáo của riêng bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tu perfil con una imagen gif que capte tu estilo único."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-upgrade ang iyong profile gamit ang isang gif image na kumukuha ng iyong natatanging istilo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी अनूठी शैली को दर्शाने वाली एक gif इमेज के साथ अपनी प्रोफ़ाइल को अपग्रेड करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vylepši svůj profil gif obrázkem, který vystihuje tvůj jedinečný styl."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایه‌ات را با یک تصویر gif که سبک منحصربه‌فردت را به نمایش می‌گذارد ارتقا بده."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שדרגו את הפרופיל שלכם עם תמונת gif שלוכדת את הסגנון הייחודי שלכם."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Naik taraf profil anda dengan imej gif yang menyerlahkan gaya unik anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îmbunătățește-ți profilul cu o imagine gif care îți surprinde stilul unic."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgradera din profil med en gif-bild som fångar din unika stil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναβάθμισε το προφίλ σου με μια εικόνα gif που αποτυπώνει το μοναδικό σου στιλ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার অনন্য স্টাইল ফুটিয়ে তোলে এমন একটি gif ছবি দিয়ে তোমার প্রোফাইল আপগ্রেড করো।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தனித்துவமான பாணியைப் பிடிக்கும் gif படத்துடன் உங்கள் சுயவிவரத்தை மேம்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ప్రత్యేక శైలిని ప్రతిబింబించే gif ఇమేజ్‌తో మీ ప్రొఫైల్‌ను అప్‌గ్రేడ్ చేయండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgrader din profil med et gif-billede, der fanger din helt egen stil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä profiilisi gif-kuvalla, joka vangitsee ainutlaatuisen tyylisi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobd fel a profilodat egy gif képpel, amely megragadja az egyedi stílusodat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgrader profilen din med et gif-bilde som fanger din helt egne stil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhora o teu perfil com uma imagem gif que capta o teu estilo único."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے پروفائل کو ایک gif تصویر کے ساتھ بہتر بنائیں جو آپ کے منفرد انداز کو ظاہر کرے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարելավիր քո պրոֆիլը gif պատկերով, որը կարտացոլի քո յուրահատուկ ոճը։"
          }
        }
      }
    },
    "Use the button above to unlock Kurozora or if you're snooping around someone else's device then exit the app 😤": {
      "comment": "The subtext on the unlock screen on iOS.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de knop hierboven om Kurozora te ontgrendelen, of als je in het apparaat van iemand anders aan het snuffelen bent, sluit dan de app 😤"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الزر أعلاه لإلغاء قفل Kurozora، أو إذا كنت تتطفل على جهاز شخص آخر فاخرج من التطبيق 😤"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de arriba para desbloquear Kurozora o, si estás husmeando en el dispositivo de alguien más, entonces sal de la app 😤"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol di atas untuk membuka Kurozora atau jika kamu sedang mengintip perangkat orang lain, keluar saja dari aplikasi 😤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のボタンで Kurozora のロックを解除してね。もし他人のデバイスをこっそり覗いてるなら、アプリを閉じて 😤"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão acima para desbloquear o Kurozora ou, se você está bisbilhotando o dispositivo de outra pessoa, então saia do app 😤"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Taste oben, um Kurozora zu entsperren – oder wenn du auf dem Gerät von jemand anderem herumschnüffelst, dann verlasse die App 😤"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le bouton ci-dessus pour déverrouiller Kurozora, ou si tu fouines sur l’appareil de quelqu’un d’autre, quitte l’app 😤"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il pulsante qui sopra per sbloccare Kurozora oppure, se stai curiosando nel dispositivo di qualcun altro, esci dall'app 😤"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 버튼으로 Kurozora 잠금을 해제하세요. 만약 남의 기기를 몰래 들여다보는 거라면 앱을 종료하세요 😤"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj przycisku powyżej, aby odblokować Kurozora, a jeśli grzebiesz w cudzym urządzeniu, to wyjdź z aplikacji 😤"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку выше, чтобы разблокировать Kurozora, а если вы шарите в чужом устройстве, то выйдите из приложения 😤"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用上方的按钮解锁 Kurozora，要是你在偷看别人的设备，那就退出应用吧 😤"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用上方的按鈕來解鎖 Kurozora，要是你是在偷翻別人的裝置，那就退出 App 吧 😤"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มด้านบนเพื่อปลดล็อก Kurozora หรือถ้าคุณกำลังแอบดูเครื่องของคนอื่นอยู่ ก็ออกจากแอปซะ 😤"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora'nın kilidini açmak için yukarıdaki düğmeyi kullan, eğer başkasının cihazını kurcalıyorsan uygulamadan çık 😤"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайся кнопкою вище, щоб розблокувати Kurozora, або, якщо ти нишпориш у чужому пристрої, вийди із застосунку 😤"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng nút phía trên để mở khóa Kurozora, còn nếu bạn đang lén lút trên thiết bị của người khác thì hãy thoát ứng dụng đi 😤"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de arriba para desbloquear Kurozora o, si estás fisgoneando en el dispositivo de otra persona, sal de la app 😤"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang button sa itaas para i-unlock ang Kurozora o kung nanunungaw ka sa device ng ibang tao ay umalis ka na sa app 😤"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora अनलॉक करने के लिए ऊपर दिए बटन का उपयोग करें या अगर आप किसी और के डिवाइस में ताक-झाँक कर रहे हैं तो ऐप से बाहर निकल जाएँ 😤"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použij tlačítko výše k odemknutí Kurozory, a pokud slídíš v cizím zařízení, tak appku ukonči 😤"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از دکمه بالا برای باز کردن قفل Kurozora استفاده کن یا اگر داری تو دستگاه یکی دیگه فضولی می‌کنی، از برنامه خارج شو 😤"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו בכפתור שלמעלה כדי לפתוח את Kurozora, ואם אתם מחטטים במכשיר של מישהו אחר אז צאו מהאפליקציה 😤"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna butang di atas untuk membuka kunci Kurozora atau jika anda mengintai peranti orang lain, keluar dari aplikasi 😤"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește butonul de mai sus pentru a debloca Kurozora sau, dacă scotocești prin dispozitivul altcuiva, atunci ieși din aplicație 😤"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd knappen ovan för att låsa upp Kurozora, eller om du snokar runt på någon annans enhet, lämna appen 😤"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το παραπάνω κουμπί για να ξεκλειδώσεις το Kurozora ή, αν χαζεύεις στη συσκευή κάποιου άλλου, βγες από την εφαρμογή 😤"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora আনলক করতে উপরের বোতামটি ব্যবহার করো, অথবা তুমি যদি অন্য কারো ডিভাইসে উঁকিঝুঁকি মারছ তাহলে অ্যাপ থেকে বেরিয়ে যাও 😤"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora-வைத் திறக்க மேலே உள்ள பொத்தானைப் பயன்படுத்துங்கள், அல்லது நீங்கள் வேறொருவரின் சாதனத்தில் ஒளிந்து பார்த்துக்கொண்டிருந்தால் பயன்பாட்டிலிருந்து வெளியேறுங்கள் 😤"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora అన్‌లాక్ చేయడానికి పైన ఉన్న బటన్‌ను ఉపయోగించు, లేదా నువ్వు వేరొకరి పరికరంలో తొంగి చూస్తుంటే యాప్ నుండి బయటకు వెళ్లిపో 😤"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug knappen ovenfor til at låse Kurozora op, eller hvis du snager rundt på en andens enhed, så luk appen 😤"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Kurozora yllä olevalla painikkeella, tai jos nuuskit jonkun toisen laitetta, poistu sovelluksesta 😤"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd a fenti gombot a Kurozora feloldásához, vagy ha valaki más eszközén kotorászol, akkor lépj ki az appból 😤"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk knappen ovenfor for å låse opp Kurozora, eller hvis du snoker rundt på enheten til noen andre, så avslutt appen 😤"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o botão acima para desbloquear o Kurozora ou, se estiveres a bisbilhotar o dispositivo de outra pessoa, sai da app 😤"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora کھولنے کے لیے اوپر دیا گیا بٹن استعمال کریں، یا اگر آپ کسی اور کے ڈیوائس میں تاک جھانک کر رہے ہیں تو ایپ سے باہر نکل جائیں 😤"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգտագործիր վերևի կոճակը Kurozora-ն ապակողպելու համար, իսկ եթե փնտրտուքով զբաղված ես ուրիշի սարքում, ապա դուրս արի հավելվածից 😤"
          }
        }
      }
    },
    "Use the button above to unlock Kurozora or if you're snooping around someone else's device then press ⌘ + Q to quit 😤": {
      "comment": "The subtext on the unlock screen on Mac Catalyst.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de knop hierboven om Kurozora te ontgrendelen, of als je in het apparaat van iemand anders aan het snuffelen bent, druk dan op ⌘ + Q om af te sluiten 😤"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الزر أعلاه لإلغاء قفل Kurozora، أو إذا كنت تتطفل على جهاز شخص آخر فاضغط على ⌘ + Q للخروج 😤"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el botón de arriba para desbloquear Kurozora o, si estás husmeando en el dispositivo de alguien más, entonces presiona ⌘ + Q para salir 😤"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol di atas untuk membuka Kurozora atau jika kamu sedang mengintip perangkat orang lain, tekan ⌘ + Q untuk keluar 😤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のボタンで Kurozora のロックを解除してね。もし他人のデバイスをこっそり覗いてるなら、⌘ + Q を押して終了して 😤"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão acima para desbloquear o Kurozora ou, se você está bisbilhotando o dispositivo de outra pessoa, então pressione ⌘ + Q para sair 😤"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die Taste oben, um Kurozora zu entsperren – oder wenn du auf dem Gerät von jemand anderem herumschnüffelst, dann drücke ⌘ + Q zum Beenden 😤"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le bouton ci-dessus pour déverrouiller Kurozora, ou si tu fouines sur l’appareil de quelqu’un d’autre, appuie sur ⌘ + Q pour quitter 😤"

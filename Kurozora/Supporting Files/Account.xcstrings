        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य सेवाओं से Kurozora पर आसानी से आ जाएँ। किसी भी URL में 'kurozora.app' जोड़ें और हमें अपने सारे anime डेटा को एक जगह लाने दें।"

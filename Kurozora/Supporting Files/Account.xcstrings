    "Choose from a range of themes to create a look that reflects your personality and style." : {
      "comment" : "The 'dynamic themes' product feature description.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر من بين مجموعة من السمات لإنشاء مظهر يعكس شخصيتك وأسلوبك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ব্যক্তিত্ব ও রুচির ছাপ ফুটিয়ে তোলে এমন একটি লুক তৈরি করতে নানা ধরনের থিম থেকে বেছে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber si z řady motivů a vytvoř si vzhled, který vystihuje tvou osobnost a styl."
          }
        },
        "da" : {
          "stringUnit" : {

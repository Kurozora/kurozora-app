          "stringUnit": {
            "state": "translated",
            "value": "%1$@（月額%2$@）。%3$@お得"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@/mês. Economize %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ für %2$@/Mon. Spare %3$@"
          }
        },

    "onboarding.genericSignInErrorMessage": {
      "comment": "Generic error message shown when sign-in fails for an unknown reason.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "An error occurred while trying to sign in. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een fout opgetreden bij het inloggen. Probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ أثناء محاولة تسجيل الدخول. يُرجى المحاولة مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se produjo un error al intentar iniciar sesión. Vuelva a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat mencoba masuk. Harap coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中にエラーが発生しました。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao tentar iniciar sessão. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite lors de la tentative de connexion. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore durante il tentativo di accesso. Riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하는 중에 오류가 발생했습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas próby logowania wystąpił błąd. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При попытке входа произошла ошибка. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час спроби входу сталася помилка. Будь ласка, спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时发生错误。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試登入時發生錯誤。請再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดขณะพยายามลงชื่อเข้าใช้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yapmaya çalışırken bir hata oluştu. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi khi cố gắng đăng nhập. Vui lòng thử lại."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha producido un error al iniciar sesión. Inténtelo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May naganap na error habang sinusubukang mag-sign in. Pakisubukang muli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने का प्रयास करते समय एक त्रुटि हुई। कृपया पुनः प्रयास करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při pokusu o přihlášení došlo k chybě. Zkuste to prosím znovu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام تلاش برای ورود خطایی رخ داد. لطفاً دوباره تلاش کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירעה שגיאה בעת ניסיון ההתחברות. נא לנסות שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralat berlaku semasa cuba log masuk. Sila cuba lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A apărut o eroare la încercarea de conectare. Vă rugăm să încercați din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fel uppstod vid inloggningen. Försök igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκε σφάλμα κατά την προσπάθεια σύνδεσης. Δοκιμάστε ξανά."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন ইন করার চেষ্টা করার সময় একটি ত্রুটি ঘটেছে। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைய முயற்சிக்கும்போது ஒரு பிழை ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సైన్ ఇన్ చేయడానికి ప్రయత్నించేటప్పుడు ఒక లోపం సంభవించింది. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der opstod en fejl under forsøget på at logge ind. Prøv venligst igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisäänkirjautumisessa tapahtui virhe. Yrittäkää uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiba történt a bejelentkezés során. Kérjük, próbálja újra."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det oppstod en feil under påloggingen. Prøv igjen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao tentar iniciar sessão. Tente novamente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن اِن کرنے کی کوشش کے دوران ایک خرابی پیش آئی۔ براہِ کرم دوبارہ کوشش کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործելու ընթացքում սխալ տեղի ունեցավ։ Խնդրում ենք կրկին փորձել։"
          }
        }
      }
    },
    "onboarding.onboardingDescription": {
      "comment": "The description string shown below onboarding options.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your Kurozora Account lets you access your library, favorites, reminders, reviews, and more on your devices, automatically."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met je Kurozora-account heb je automatisch toegang tot je bibliotheek, favorieten, herinneringen, recensies en meer op al je apparaten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك حساب Kurozora الوصول إلى مكتبتك ومفضّلاتك وتذكيراتك ومراجعاتك والمزيد على أجهزتك، تلقائيًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Cuenta de Kurozora te permite acceder a tu biblioteca, favoritos, recordatorios, reseñas y más en tus dispositivos, de forma automática."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Kurozora Anda memungkinkan Anda mengakses pustaka, favorit, pengingat, ulasan, dan lainnya di perangkat Anda, secara otomatis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozoraアカウントがあれば、ライブラリ、お気に入り、リマインダー、レビューなどに、お使いのデバイスから自動でアクセスできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Conta Kurozora permite acessar sua biblioteca, favoritos, lembretes, avaliações e muito mais nos seus dispositivos, automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Kurozora-Konto greifst du automatisch auf all deinen Geräten auf deine Bibliothek, Favoriten, Erinnerungen, Reviews und mehr zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Kurozora vous permet d’accéder automatiquement à votre bibliothèque, vos favoris, vos rappels, vos critiques et plus encore sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Account Kurozora ti permette di accedere automaticamente alla tua libreria, ai preferiti, ai promemoria, alle recensioni e molto altro su tutti i tuoi dispositivi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora 계정이 있으면 라이브러리, 즐겨찾기, 알림, 리뷰 등을 모든 기기에서 자동으로 이용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto Kurozora zapewnia Ci automatyczny dostęp do biblioteki, ulubionych, przypomnień, recenzji i wielu innych na wszystkich Twoich urządzeniach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись Kurozora даёт доступ к вашей библиотеке, избранному, напоминаниям, отзывам и многому другому на всех ваших устройствах — автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій Обліковий запис Kurozora дає тобі доступ до бібліотеки, обраного, нагадувань, відгуків та іншого на всіх твоїх пристроях, автоматично."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有了 Kurozora 账户，你的资料库、收藏、提醒、评论等内容都能在你的各台设备上自动同步访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Kurozora 帳號讓你能在各裝置上自動存取你的圖庫、最愛、提醒、評論等內容。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี Kurozora ของคุณให้คุณเข้าถึงคลัง รายการโปรด การแจ้งเตือน รีวิว และอื่นๆ บนอุปกรณ์ของคุณได้โดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora Hesabınız; kitaplığınıza, favorilerinize, hatırlatıcılarınıza, incelemelerinize ve daha fazlasına aygıtlarınızdan otomatik olarak erişmenizi sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài Khoản Kurozora cho phép bạn truy cập thư viện, mục yêu thích, lời nhắc, đánh giá và nhiều thứ khác trên các thiết bị của bạn, một cách tự động."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Cuenta de Kurozora te permite acceder a tu biblioteca, favoritos, recordatorios, reseñas y mucho más en todos tus dispositivos, de forma automática."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinahayaan ka ng iyong Kurozora Account na ma-access ang iyong library, mga paborito, mga paalala, mga review, at higit pa sa iyong mga device, awtomatiko."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारा Kurozora खाता तुम्हें अपने सभी डिवाइसों पर अपनी लाइब्रेरी, पसंदीदा, रिमाइंडर, समीक्षाओं और बहुत कुछ तक अपने-आप पहुँचने देता है।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S účtem Kurozora máš automaticky přístup ke své knihovně, oblíbeným, připomínkám, recenzím a dalšímu na všech svých zařízeních."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Kurozora شما به شما امکان می‌دهد به‌طور خودکار روی همه دستگاه‌هایتان به کتابخانه، علاقه‌مندی‌ها، یادآورها، نقدها و موارد بیشتر دسترسی داشته باشید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבון Kurozora שלך מאפשר לך לגשת לספרייה, למועדפים, לתזכורות, לביקורות ועוד במכשירים שלך, באופן אוטומטי."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akaun Kurozora anda membolehkan anda mengakses pustaka, kegemaran, peringatan, ulasan, dan banyak lagi pada peranti anda, secara automatik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul Kurozora îți permite să accesezi biblioteca, favoritele, memento-urile, recenziile și multe altele pe dispozitivele tale, automat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ditt Kurozora-konto kommer du automatiskt åt ditt bibliotek, dina favoriter, påminnelser, recensioner och mycket mer på alla dina enheter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Λογαριασμός Kurozora σας επιτρέπει να αποκτάτε πρόσβαση στη βιβλιοθήκη, τα αγαπημένα, τις υπενθυμίσεις, τις κριτικές σας και πολλά άλλα, αυτόματα σε όλες τις συσκευές σας."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Kurozora অ্যাকাউন্ট আপনাকে আপনার লাইব্রেরি, পছন্দের তালিকা, রিমাইন্ডার, রিভিউ এবং আরও অনেক কিছু আপনার সব ডিভাইসে স্বয়ংক্রিয়ভাবে অ্যাক্সেস করতে দেয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Kurozora கணக்கு உங்கள் சாதனங்களில் உங்கள் நூலகம், பிடித்தவை, நினைவூட்டல்கள், விமர்சனங்கள் மற்றும் பலவற்றைத் தானாகவே அணுக உதவுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Kurozora ఖాతా మీ లైబ్రరీ, ఇష్టమైనవి, రిమైండర్‌లు, రివ్యూలు ఇంకా మరెన్నో మీ పరికరాల్లో ఆటోమేటిక్‌గా యాక్సెస్ చేసుకోవడానికి అనుమతిస్తుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Kurozora-konto giver dig automatisk adgang til dit bibliotek, dine favoritter, påmindelser, anmeldelser og meget mere på alle dine enheder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora-tililläsi pääset käsiksi kirjastoosi, suosikkeihisi, muistutuksiisi, arvosteluihisi ja muuhun kaikilla laitteillasi automaattisesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kurozora fiókoddal automatikusan elérheted a könyvtáradat, a kedvenceidet, az emlékeztetőidet, az értékeléseidet és sok mást is az eszközeiden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Kurozora-kontoen din får du automatisk tilgang til biblioteket, favorittene, påminnelsene, anmeldelsene dine og mer på alle enhetene dine."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua Conta Kurozora permite-te aceder automaticamente à tua biblioteca, favoritos, lembretes, críticas e muito mais em todos os teus dispositivos."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا Kurozora اکاؤنٹ آپ کو اپنے آلات پر اپنی لائبریری، پسندیدہ، یاد دہانیاں، جائزے اور بہت کچھ تک خودکار طور پر رسائی دیتا ہے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Քո Kurozora հաշիվը թույլ է տալիս ավտոմատ կերպով մուտք գործել քո գրադարան, ֆավորիտներ, հիշեցումներ, գրախոսություններ և ավելին՝ քո սարքերում։"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি %@-এর বেশি সময় ব্যাকগ্রাউন্ডে থাকলে অনুমোদন প্রয়োজন হবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் %@-க்கும் மேலாக பின்னணியில் இருந்தால் அங்கீகாரம் தேவைப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ %@ కంటే ఎక్కువసేపు బ్యాక్‌గ్రౌండ్‌లో ఉంటే ప్రామాణీకరణ అవసరం."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kræves godkendelse, hvis appen forbliver i baggrunden i mere end %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todennus vaaditaan, jos sovellus on taustalla pidempään kuin %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitelesítés szükséges, ha az alkalmazás %@-nál hosszabb ideig marad a háttérben."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisering kreves hvis appen blir værende i bakgrunnen i mer enn %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária autenticação se a aplicação permanecer em segundo plano durante mais de %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر ایپ %@ سے زیادہ پسِ منظر میں رہے تو تصدیق درکار ہوتی ہے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նույնականացում է պահանջվում, եթե հավելվածը ֆոնում մնում է ավելի քան %@։"
          }
        }
      }
    },

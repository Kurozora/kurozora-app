    "onboarding.appleAuthenticationFailedMessage": {
      "comment": "Error message shown when Apple authentication fails.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Authentication failed by Apple. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificatie door Apple is mislukt. Probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المصادقة من قِبل Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo completar la autenticación. Vuelva a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi gagal oleh Apple. Harap coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleによる認証に失敗しました。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na autenticação pela Apple. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung durch Apple ist fehlgeschlagen. Bitte versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’authentification par Apple. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione non riuscita da parte di Apple. Riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 인증에 실패했습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnianie przez Apple nie powiodło się. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось пройти аутентификацию через Apple. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося пройти автентифікацію через Apple. Будь ласка, спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 验证失败。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 驗證失敗。請再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันตัวตนโดย Apple ล้มเหลว โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ile kimlik doğrulama başarısız oldu. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực bằng Apple thất bại. Vui lòng thử lại."
          }
        }
      }
    },
    "onboarding.appleAuthenticationNotHandledMessage": {
      "comment": "Error message shown when Apple authentication was not handled properly.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "An error occurred and the authentication was not handled by Apple. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een fout opgetreden en de verificatie is niet door Apple afgehandeld. Probeer het opnieuw."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ولم تتم معالجة المصادقة من قِبل Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se produjo un error y Apple no gestionó la autenticación. Vuelva a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan dan autentikasi tidak ditangani oleh Apple. Harap coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーが発生し、Appleによって認証が処理されませんでした。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro e a autenticação não foi processada pela Apple. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fehler ist aufgetreten und die Authentifizierung wurde von Apple nicht verarbeitet. Bitte versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite et l’authentification n’a pas été traitée par Apple. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore e l'autenticazione non è stata gestita da Apple. Riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류가 발생하여 Apple에서 인증이 처리되지 않았습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił błąd i uwierzytelnianie nie zostało obsłużone przez Apple. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Произошла ошибка, и аутентификация не была обработана Apple. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сталася помилка, і автентифікацію не було оброблено Apple. Будь ласка, спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生错误，Apple 未能完成验证。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生錯誤，Apple 未能妥善處理此驗證。請再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดและ Apple ไม่ได้จัดการการยืนยันตัวตน โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hata oluştu ve kimlik doğrulama Apple tarafından işlenmedi. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi và quá trình xác thực không được Apple xử lý. Vui lòng thử lại."
          }
        }
      }
    },
    "onboarding.appleInvalidResponseMessage": {

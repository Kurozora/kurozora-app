        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயனர் பயோமெட்ரிக் அங்கீகாரத்தில் பதிவு செய்யாததால் அங்கீகாரத்தைத் தொடங்க முடியவில்லை."

        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มด้านบนเพื่อปลดล็อก Kurozora หรือถ้าคุณกำลังแอบดูเครื่องของคนอื่นอยู่ ก็กด ⌘ + Q เพื่อออกซะ 😤"

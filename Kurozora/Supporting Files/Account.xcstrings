    "onboarding.appleAuthenticationNotHandledMessage" : {
      "comment" : "Error message shown when Apple authentication was not handled properly.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ ولم تتم معالجة المصادقة من قِبل Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি ত্রুটি ঘটেছে এবং অনুমোদনটি Apple দ্বারা সম্পন্ন হয়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Došlo k chybě a ověření nebylo zpracováno společností Apple. Zkuste to prosím znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der opstod en fejl, og godkendelsen blev ikke håndteret af Apple. Prøv venligst igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fehler ist aufgetreten und die Authentifizierung wurde von Apple nicht verarbeitet. Bitte versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρουσιάστηκε σφάλμα και η ταυτοποίηση δεν διεκπεραιώθηκε από την Apple. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An error occurred and the authentication was not handled by Apple. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha producido un error y Apple no ha gestionado la autenticación. Inténtelo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se produjo un error y Apple no gestionó la autenticación. Vuelva a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطایی رخ داد و احراز هویت توسط Apple به‌درستی پردازش نشد. لطفاً دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapahtui virhe, eikä Apple käsitellyt todennusta. Yrittäkää uudelleen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May naganap na error at hindi naasikaso ng Apple ang pagpapatotoo. Pakisubukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s’est produite et l’authentification n’a pas été traitée par Apple. Veuillez réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אירעה שגיאה והאימות לא טופל על ידי Apple. נא לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक त्रुटि हुई और प्रमाणीकरण को Apple द्वारा ठीक से संभाला नहीं गया। कृपया पुनः प्रयास करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiba történt, és a hitelesítést az Apple nem kezelte. Kérjük, próbálja újra."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սխալ տեղի ունեցավ, և նույնականացումը Apple-ի կողմից չմշակվեց։ Խնդրում ենք կրկին փորձել։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terjadi kesalahan dan autentikasi tidak ditangani oleh Apple. Harap coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore e l'autenticazione non è stata gestita da Apple. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エラーが発生し、Appleによって認証が処理されませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오류가 발생하여 Apple에서 인증이 처리되지 않았습니다. 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ralat berlaku dan pengesahan tidak dikendalikan oleh Apple. Sila cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det oppstod en feil, og autentiseringen ble ikke håndtert av Apple. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een fout opgetreden en de verificatie is niet door Apple afgehandeld. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystąpił błąd i uwierzytelnianie nie zostało obsłużone przez Apple. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro e a autenticação não foi processada pela Apple. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro e a autenticação não foi processada pela Apple. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A apărut o eroare, iar autentificarea nu a fost gestionată de Apple. Vă rugăm să încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произошла ошибка, и аутентификация не была обработана Apple. Повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett fel uppstod och autentiseringen hanterades inte av Apple. Försök igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு பிழை ஏற்பட்டது, மேலும் அங்கீகாரம் Apple-ஆல் சரியாகக் கையாளப்படவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక లోపం సంభవించింది, ప్రామాణీకరణను Apple సరిగ్గా నిర్వహించలేదు. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกิดข้อผิดพลาดและ Apple ไม่ได้จัดการการยืนยันตัวตน โปรดลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hata oluştu ve kimlik doğrulama Apple tarafından işlenmedi. Lütfen tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сталася помилка, і автентифікацію не було оброблено Apple. Будь ласка, спробуйте ще раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک خرابی پیش آئی اور Apple کی جانب سے تصدیق کو سنبھالا نہیں گیا۔ براہِ کرم دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra lỗi và quá trình xác thực không được Apple xử lý. Vui lòng thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发生错误，Apple 未能完成验证。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發生錯誤，Apple 未能妥善處理此驗證。請再試一次。"
          }
        }
      }
    },

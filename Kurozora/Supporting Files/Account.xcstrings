          }
        }
      }
    },
    "Your contribution helps with maintaining the servers, paying for software licenses, and fund events and activities.": {
      "comment": "The 'support the community' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bijdrage helpt bij het onderhouden van de servers, het betalen van softwarelicenties en het financieren van evenementen en activiteiten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد مساهمتك في صيانة الخوادم، ودفع تكاليف تراخيص البرامج، وتمويل الفعاليات والأنشطة."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu contribución ayuda a mantener los servidores, pagar las licencias de software y financiar eventos y actividades."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontribusimu membantu pemeliharaan server, pembayaran lisensi perangkat lunak, serta pendanaan acara dan kegiatan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの支援は、サーバーの維持、ソフトウェアライセンスの支払い、イベントや活動の資金に役立ちます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua contribuição ajuda a manter os servidores, pagar licenças de software e financiar eventos e atividades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Beitrag hilft dabei, die Server zu warten, Softwarelizenzen zu bezahlen und Events und Aktivitäten zu finanzieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta contribution aide à entretenir les serveurs, à payer les licences logicielles et à financer des événements et des activités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo contributo aiuta a mantenere i server, pagare le licenze software e finanziare eventi e attività."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 후원은 서버 유지, 소프트웨어 라이선스 비용, 행사 및 활동 지원에 사용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój wkład pomaga w utrzymaniu serwerów, opłacaniu licencji na oprogramowanie oraz finansowaniu wydarzeń i aktywności."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш вклад помогает поддерживать серверы, оплачивать лицензии на программное обеспечение и финансировать мероприятия и активности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的贡献有助于维护服务器、支付软件许可费用，以及资助各类活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的貢獻有助於維護伺服器、支付軟體授權費用，以及資助各項活動。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนับสนุนของคุณช่วยในการดูแลเซิร์ฟเวอร์ จ่ายค่าลิขสิทธิ์ซอฟต์แวร์ และสนับสนุนกิจกรรมต่าง ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkın; sunucuların bakımına, yazılım lisanslarının ödenmesine ve etkinliklerin finanse edilmesine yardımcı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій внесок допомагає підтримувати сервери, оплачувати ліцензії на програмне забезпечення та фінансувати заходи й активності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",

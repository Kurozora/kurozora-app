          }
        }
      }
    },
    "You've denied photo library access. You can change this in Settings.": {
      "comment": "The empty-state detail shown when photo access has been denied.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt toegang tot de fotobibliotheek geweigerd. Je kunt dit wijzigen in Instellingen."

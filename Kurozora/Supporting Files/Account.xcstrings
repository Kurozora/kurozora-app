          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sessão com a Apple é a forma rápida e fácil de iniciar sessão no Kurozora usando o Apple ID que já tem."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple آپ کے پاس پہلے سے موجود Apple ID کے ذریعے Kurozora میں سائن اِن کرنے کا تیز اور آسان طریقہ ہے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple-ը արագ ու հեշտ եղանակ է Kurozora մուտք գործելու՝ օգտագործելով ձեր արդեն ունեցած Apple ID-ն։"

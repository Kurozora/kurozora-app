            "value": "Під час спроби входу сталася помилка. Будь ласка, спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时发生错误。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試登入時發生錯誤。請再試一次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดขณะพยายามลงชื่อเข้าใช้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yapmaya çalışırken bir hata oluştu. Lütfen tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi khi cố gắng đăng nhập. Vui lòng thử lại."
          }
        }
      }
    },
    "onboarding.onboardingDescription": {
      "comment": "The description string shown below onboarding options.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your Kurozora Account lets you access your library, favorites, reminders, reviews, and more on your devices, automatically."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met je Kurozora-account heb je automatisch toegang tot je bibliotheek, favorieten, herinneringen, recensies en meer op al je apparaten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك حساب Kurozora الوصول إلى مكتبتك ومفضّلاتك وتذكيراتك ومراجعاتك والمزيد على أجهزتك، تلقائيًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Cuenta de Kurozora te permite acceder a tu biblioteca, favoritos, recordatorios, reseñas y más en tus dispositivos, de forma automática."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Kurozora Anda memungkinkan Anda mengakses pustaka, favorit, pengingat, ulasan, dan lainnya di perangkat Anda, secara otomatis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozoraアカウントがあれば、ライブラリ、お気に入り、リマインダー、レビューなどに、お使いのデバイスから自動でアクセスできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Conta Kurozora permite acessar sua biblioteca, favoritos, lembretes, avaliações e muito mais nos seus dispositivos, automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Kurozora-Konto greifst du automatisch auf all deinen Geräten auf deine Bibliothek, Favoriten, Erinnerungen, Reviews und mehr zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Kurozora vous permet d’accéder automatiquement à votre bibliothèque, vos favoris, vos rappels, vos critiques et plus encore sur tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Account Kurozora ti permette di accedere automaticamente alla tua libreria, ai preferiti, ai promemoria, alle recensioni e molto altro su tutti i tuoi dispositivi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora 계정이 있으면 라이브러리, 즐겨찾기, 알림, 리뷰 등을 모든 기기에서 자동으로 이용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto Kurozora zapewnia Ci automatyczny dostęp do biblioteki, ulubionych, przypomnień, recenzji i wielu innych na wszystkich Twoich urządzeniach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись Kurozora даёт доступ к вашей библиотеке, избранному, напоминаниям, отзывам и многому другому на всех ваших устройствах — автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій Обліковий запис Kurozora дає тобі доступ до бібліотеки, обраного, нагадувань, відгуків та іншого на всіх твоїх пристроях, автоматично."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有了 Kurozora 账户，你的资料库、收藏、提醒、评论等内容都能在你的各台设备上自动同步访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Kurozora 帳號讓你能在各裝置上自動存取你的圖庫、最愛、提醒、評論等內容。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี Kurozora ของคุณให้คุณเข้าถึงคลัง รายการโปรด การแจ้งเตือน รีวิว และอื่นๆ บนอุปกรณ์ของคุณได้โดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora Hesabınız; kitaplığınıza, favorilerinize, hatırlatıcılarınıza, incelemelerinize ve daha fazlasına aygıtlarınızdan otomatik olarak erişmenizi sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài Khoản Kurozora cho phép bạn truy cập thư viện, mục yêu thích, lời nhắc, đánh giá và nhiều thứ khác trên các thiết bị của bạn, một cách tự động."
          }
        }
      }
    },

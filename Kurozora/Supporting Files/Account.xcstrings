    "Switch things up every now an then with a fresh username that truly represents you.": {
      "comment": "The 'change your identity' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gooi het af en toe over een andere boeg met een nieuwe gebruikersnaam die echt bij je past."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر الأجواء بين الحين والآخر باسم مستخدم جديد يمثّلك حقًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia las cosas de vez en cuando con un nuevo nombre de usuario que realmente te represente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti suasana sesekali dengan username baru yang benar-benar mewakili dirimu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ときどき気分を変えて、本当のあなたを表す新しいユーザー名にしよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude as coisas de vez em quando com um novo nome de usuário que realmente represente você."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring ab und zu frischen Wind rein mit einem neuen Benutzernamen, der wirklich zu dir passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change un peu de temps en temps avec un nouveau nom d’utilisateur qui te représente vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia ogni tanto con un nuovo nome utente che ti rappresenta davvero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔은 진짜 나를 보여주는 새로운 사용자 이름으로 분위기를 바꿔보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj coś od czasu do czasu dzięki świeżej nazwie użytkownika, która naprawdę Cię odzwierciedla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время от времени меняйте обстановку — выберите новое имя пользователя, которое по-настоящему отражает вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时不时换个全新的用户名，让它真正代表你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偶爾換個全新、真正代表你的使用者名稱，讓一切煥然一新。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนบรรยากาศบ้างเป็นครั้งคราวด้วยชื่อผู้ใช้ใหม่ที่บ่งบอกความเป็นตัวคุณอย่างแท้จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni gerçekten yansıtan yepyeni bir kullanıcı adıyla arada bir tarzını değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час від часу змінюй щось, обираючи нове ім’я користувача, яке справді відображає тебе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thỉnh thoảng đổi mới với một tên người dùng thật sự đại diện cho bạn."
          }
        }
      }
    },

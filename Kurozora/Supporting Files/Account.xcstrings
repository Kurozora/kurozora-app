        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாதனத்தில் உள்ள கேமராவைப் பயன்படுத்தி உங்கள் குறியீட்டை மீட்டெடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పరికరంలోని కెమెరాను ఉపయోగించి మీ కోడ్‌ను రిడీమ్ చేయండి."
          }
        },
        "da": {
          "stringUnit": {

        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih dari berbagai tema untuk menciptakan tampilan yang mencerminkan kepribadian dan gaya kamu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "豊富なテーマから選んで、あなたの個性やスタイルを映す見た目に仕上げよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha entre uma variedade de temas para criar um visual que reflita sua personalidade e seu estilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus einer Vielzahl von Themes und gestalte einen Look, der deine Persönlichkeit und deinen Stil widerspiegelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez parmi une gamme de thèmes pour créer un style qui reflète votre personnalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra una vasta gamma di temi per creare un look che rispecchia la tua personalità e il tuo stile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다양한 테마 중에서 골라 당신의 개성과 스타일을 담은 분위기를 연출해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybieraj spośród wielu motywów, aby stworzyć wygląd odzwierciedlający Twoją osobowość i styl."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирай из множества тем оформления и создавай образ, который отражает твою индивидуальность и стиль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обирай з-поміж низки тем, щоб створити вигляд, який відображає твою індивідуальність і стиль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从多款主题中挑选，打造彰显你个性与风格的外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從多款主題中挑選，打造展現你個性與風格的外觀。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกจากธีมมากมายเพื่อสร้างรูปลักษณ์ที่สะท้อนบุคลิกและสไตล์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişiliğinizi ve tarzınızı yansıtan bir görünüm oluşturmak için çeşitli temalar arasından seçim yapın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn từ nhiều chủ đề để tạo nên diện mạo thể hiện cá tính và phong cách của bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre una gran variedad de temas para crear un aspecto que refleje tu personalidad y tu estilo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili mula sa iba't ibang theme upang makalikha ng hitsurang sumasalamin sa iyong personalidad at istilo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने व्यक्तित्व और शैली को दर्शाने वाला लुक बनाने के लिए कई थीम में से चुनें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber si z řady motivů a vytvoř si vzhled, který vystihuje tvou osobnost a styl."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از میان مجموعه‌ای از پوسته‌ها انتخاب کنید تا ظاهری بسازید که بازتاب شخصیت و سبک شماست."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מתוך מגוון ערכות נושא כדי ליצור מראה שמשקף את האישיות והסגנון שלכם."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih daripada pelbagai tema untuk mencipta rupa yang menggambarkan personaliti dan gaya anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege dintr-o gamă de teme pentru a crea un aspect care reflectă personalitatea și stilul tău."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj bland ett utbud av teman för att skapa ett utseende som speglar din personlighet och stil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε ανάμεσα σε ένα πλήθος θεμάτων για να δημιουργήσεις μια εμφάνιση που αντικατοπτρίζει την προσωπικότητα και το στιλ σου."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যক্তিত্ব ও রুচির ছাপ ফুটিয়ে তোলে এমন একটি লুক তৈরি করতে নানা ধরনের থিম থেকে বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஆளுமையையும் பாணியையும் பிரதிபலிக்கும் தோற்றத்தை உருவாக்க பல்வேறு தீம்களில் இருந்து தேர்வு செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వ్యక్తిత్వాన్ని, శైలిని ప్రతిబింబించే రూపాన్ని తయారు చేసుకోవడానికి రకరకాల థీమ్‌ల నుండి ఎంచుకోండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg mellem en række temaer og skab et udtryk, der afspejler din personlighed og stil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse useista teemoista ja luo ilme, joka kuvastaa persoonaasi ja tyyliäsi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz a témák széles kínálatából, és alakíts ki egy megjelenést, amely tükrözi a személyiségedet és a stílusodat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg blant et utvalg temaer for å skape et uttrykk som gjenspeiler personligheten og stilen din."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe entre uma variedade de temas para criar um visual que reflete a tua personalidade e estilo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی شخصیت اور انداز کی عکاسی کرنے والا روپ بنانے کے لیے متعدد تھیمز میں سے انتخاب کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրիր թեմաների շարքից՝ ստեղծելու տեսք, որն արտացոլում է քո անհատականությունն ու ոճը։"
          }
        }
      }
    },

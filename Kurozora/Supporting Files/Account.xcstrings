    "Immerse yourself in the world of anime from the very start with serene chimes and iconic anime sounds.": {
      "comment": "The 'startup chimes' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompel jezelf vanaf het begin onder in de wereld van anime met serene startgeluiden en iconische animageluiden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انغمس في عالم anime من البداية مع نغمات هادئة وأصوات anime أيقونية."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumérgete en el mundo del anime desde el primer momento con tonos serenos y sonidos icónicos del anime."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Larutkan dirimu dalam dunia anime sejak awal dengan dentingan menenangkan dan suara anime yang ikonik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかなチャイムや象徴的なanimeサウンドで、最初からanimeの世界にどっぷり浸ろう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergulhe no mundo do anime desde o início com toques serenos e sons icônicos de anime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauche von Anfang an in die Welt des anime ein – mit beruhigenden Klängen und ikonischen anime-Sounds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plonge dans l’univers de l’anime dès le départ avec des carillons sereins et des sons d’anime emblématiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immergiti nel mondo degli anime fin dal primo istante con melodie rilassanti e suoni iconici degli anime."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔잔한 차임과 상징적인 anime 사운드로 시작부터 anime의 세계에 흠뻑 빠져보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanurz się w świecie anime od samego początku dzięki kojącym dźwiękom i kultowym odgłosom anime."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Погрузись в мир anime с самого начала под умиротворяющие переливы и культовые anime-звуки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занурюйся у світ anime із самого початку завдяки спокійним передзвонам і культовим anime-звукам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用悠扬的提示音和经典的 anime 音效，从一开始就沉浸在 anime 的世界里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用悠揚的提示音與經典的 anime 音效，從一開始就沉浸在 anime 的世界裡。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มด่ำไปกับโลกของ anime ตั้งแต่เริ่มต้นด้วยเสียงระฆังอันสงบและเสียง anime อันเป็นเอกลักษณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huzurlu çan sesleri ve ikonik anime sesleriyle ta en baştan kendini anime dünyasına kaptır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đắm chìm vào thế giới anime ngay từ đầu với những giai điệu êm dịu và âm thanh anime mang tính biểu tượng."
          }
        }
      }
    },

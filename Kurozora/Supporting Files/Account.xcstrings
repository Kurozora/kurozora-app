    "requestRefund.header.description": {
      "comment": "The description string for the Request Refund view.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Review your recent purchases and ask Apple to refund any you no longer want. Apple decides each request, so refunds aren't guaranteed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk uw recente aankopen en vraag Apple om terugbetaling van wat u niet meer wilt. Apple beslist over elk verzoek, dus terugbetaling is niet gegarandeerd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع مشترياتك الأخيرة واطلب من Apple استرداد أي منها لم تعد ترغب فيه. تبتّ Apple في كل طلب، لذا فإن عمليات الاسترداد غير مضمونة."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise sus compras recientes y solicite a Apple el reembolso de las que ya no desee. Apple decide cada solicitud, por lo que los reembolsos no están garantizados."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau pembelian terbaru Anda dan ajukan pengembalian dana kepada Apple untuk pembelian yang tidak lagi Anda inginkan. Apple yang memutuskan setiap permintaan, jadi pengembalian dana tidak dijamin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の購入を確認し、不要になったものは Apple に返金を依頼できます。各依頼の可否は Apple が判断するため、返金は保証されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise suas compras recentes e solicite à Apple o reembolso das que você não quer mais. A Apple decide cada solicitação, portanto os reembolsos não são garantidos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre letzten Käufe und bitten Sie Apple um eine Erstattung für alles, was Sie nicht mehr möchten. Apple entscheidet über jede Anfrage, daher sind Erstattungen nicht garantiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez en revue vos achats récents et demandez à Apple le remboursement de ceux dont vous ne voulez plus. Apple statue sur chaque demande, les remboursements ne sont donc pas garantis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamini i suoi acquisti recenti e chieda ad Apple il rimborso di quelli che non desidera più. Apple valuta ogni richiesta, quindi i rimborsi non sono garantiti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 구매 내역을 확인하고 더 이상 원하지 않는 항목에 대해 Apple에 환불을 요청하세요. 각 요청은 Apple이 결정하므로 환불이 보장되지는 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj swoje ostatnie zakupy i poproś Apple o zwrot tych, których już nie chcesz. O każdym wniosku decyduje Apple, więc zwroty nie są gwarantowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите ваши недавние покупки и попросите Apple вернуть средства за те, которые вам больше не нужны. Решение по каждому запросу принимает Apple, поэтому возврат средств не гарантирован."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看您近期的购买项目，并就不再需要的项目向 Apple 申请退款。每项申请均由 Apple 决定，因此退款无法保证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看您近期的購買項目，並向 Apple 申請退款已不再需要的項目。每筆申請皆由 Apple 決定，因此退款無法保證。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบรายการซื้อล่าสุดของคุณและขอให้ Apple คืนเงินสำหรับรายการที่คุณไม่ต้องการแล้ว Apple เป็นผู้พิจารณาคำขอแต่ละรายการ ดังนั้นการคืนเงินจึงไม่รับประกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son satın almalarınızı inceleyin ve artık istemediklerinizin geri ödemesini Apple'dan talep edin. Her talebe Apple karar verdiği için geri ödemeler garanti değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте свої нещодавні покупки та попросіть Apple повернути кошти за ті, які вам більше не потрібні. Apple розглядає кожен запит, тож повернення коштів не гарантується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại các giao dịch mua gần đây của bạn và yêu cầu Apple hoàn tiền cho những giao dịch bạn không còn muốn. Apple quyết định từng yêu cầu, vì vậy việc hoàn tiền không được đảm bảo."
          }
        }
      }
    },

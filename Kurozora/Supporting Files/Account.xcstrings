    "Resume the %@ purchase you started in the App Store." : {
      "comment" : "The alert message prompting the user to resume a promoted purchase.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استئناف عملية شراء %@ التي بدأتها في App Store."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store-এ আপনি যে %@ ক্রয় শুরু করেছিলেন তা পুনরায় শুরু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračujte v nákupu %@, který jste zahájili v App Store."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genoptag det %@-køb, du påbegyndte i App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzen Sie den Kauf von %@ fort, den Sie im App Store begonnen haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίστε την αγορά %@ που ξεκινήσατε στο App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanude la compra de %@ que inició en el App Store."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanude la compra de %@ que inició en el App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خرید %@ را که در App Store آغاز کردید ادامه دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka %@-ostoa, jonka aloitit App Storessa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipagpatuloy ang pagbili ng %@ na sinimulan mo sa App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez l’achat %@ que vous avez commencé sur l’App Store."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המשיכו את רכישת %@ שהתחלתם ב-App Store."
          }
        },
        "hi" : {

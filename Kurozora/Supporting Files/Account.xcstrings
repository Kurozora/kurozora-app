    "Welcome back! Please authenticate to continue.": {
      "comment": "The biometric prompt reason shown when returning to the locked app.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom terug! Authenticeer om door te gaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بعودتك! يرجى المصادقة للمتابعة."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenido de nuevo! Por favor, autentíquese para continuar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang kembali! Silakan lakukan autentikasi untuk melanjutkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おかえりなさい！続けるには認証してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo de volta! Por favor, autentique-se para continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück! Bitte authentifizieren Sie sich, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour ! Veuillez vous authentifier pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentornato! Si autentichi per continuare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 오신 것을 환영합니다! 계속하려면 인증해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witamy ponownie! Uwierzytelnij się, aby kontynuować."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С возвращением! Пожалуйста, пройдите аутентификацию, чтобы продолжить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎回来！请完成认证以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎回來！請完成驗證以繼續。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยินดีต้อนรับกลับมา! กรุณายืนยันตัวตนเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar hoş geldiniz! Devam etmek için lütfen kimliğinizi doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З поверненням! Будь ласка, пройдіть автентифікацію, щоб продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng trở lại! Vui lòng xác thực để tiếp tục."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenido de nuevo! Autentíquese para continuar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maligayang pagbabalik! Mangyaring mag-authenticate para magpatuloy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापसी पर स्वागत है! जारी रखने के लिए कृपया प्रमाणीकरण करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vítejte zpět! Pro pokračování se prosím ověřte."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خوش آمدید! لطفاً برای ادامه احراز هویت کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוכים השבים! נא לבצע אימות כדי להמשיך."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat kembali! Sila sahkan untuk meneruskan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bine ați revenit! Vă rugăm să vă autentificați pentru a continua."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen tillbaka! Autentisera dig för att fortsätta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλώς ορίσατε ξανά! Παρακαλούμε επαληθεύστε την ταυτότητά σας για να συνεχίσετε."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিরে আসায় স্বাগতম! চালিয়ে যেতে অনুগ্রহ করে অথেনটিকেট করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் வரவேற்கிறோம்! தொடர தயவுசெய்து அங்கீகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తిరిగి స్వాగతం! కొనసాగించడానికి దయచేసి ప్రామాణీకరించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen tilbage! Godkend venligst for at fortsætte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervetuloa takaisin! Tunnistaudu jatkaaksesi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üdvözöljük újra! A folytatáshoz hitelesítse magát."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen tilbake! Vennligst autentiser deg for å fortsette."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo de volta! Autentique-se para continuar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خوش آمدید! جاری رکھنے کے لیے براہ کرم اپنی توثیق کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բարի վերադարձ։ Շարունակելու համար խնդրում ենք անցնել նույնականացում։"
          }
        }
      }
    },
    "You are not authorized to make payments. In-App Purchases may be restricted on your device.": {
      "comment": "The message string for IAP is disabled.",
      "localizations": {
        "nl": {
          "stringUnit": {

    "Authentication could not continue because the user has been locked out of biometric authentication, due to failing authentication too many times.": {
      "comment": "The error shown when the user is locked out of biometric authentication.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticatie kon niet doorgaan omdat de gebruiker is buitengesloten van biometrische authenticatie, omdat de authenticatie te vaak is mislukt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت متابعة عملية التحقق لأن المستخدم قد تم حظره من المصادقة البيومترية بسبب فشل التحقق عددًا كبيرًا من المرات."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo continuar con la autenticación porque el usuario fue bloqueado de la autenticación biométrica tras fallar demasiadas veces."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi tidak dapat dilanjutkan karena pengguna telah terkunci dari autentikasi biometrik, akibat terlalu sering gagal melakukan autentikasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に何度も失敗したため、生体認証がロックアウトされており、認証を続行できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação não pôde continuar porque o usuário foi bloqueado da autenticação biométrica devido a tentativas malsucedidas em excesso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung konnte nicht fortgesetzt werden, da der Benutzer aufgrund zu vieler fehlgeschlagener Versuche von der biometrischen Authentifizierung ausgesperrt wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification n’a pas pu se poursuivre car l’utilisateur a été bloqué de l’authentification biométrique après un trop grand nombre d’échecs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile proseguire con l'autenticazione perché l'utente è stato bloccato dall'autenticazione biometrica a causa di troppi tentativi di autenticazione non riusciti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 너무 여러 번 실패하여 생체 인증이 잠겼기 때문에 인증을 계속할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można kontynuować uwierzytelniania, ponieważ uwierzytelnianie biometryczne zostało zablokowane z powodu zbyt wielu nieudanych prób."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось продолжить аутентификацию, так как биометрическая аутентификация заблокирована из-за слишком большого числа неудачных попыток."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося продовжити автентифікацію, оскільки користувача заблоковано для біометричної автентифікації через надто велику кількість невдалих спроб."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于验证失败次数过多，生物识别验证已被锁定，无法继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於驗證失敗次數過多，使用者已被鎖定無法使用生物辨識驗證，因此無法繼續驗證。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถดำเนินการยืนยันตัวตนต่อได้ เนื่องจากผู้ใช้ถูกล็อกออกจากการยืนยันตัวตนด้วยข้อมูลชีวมาตรจากการยืนยันตัวตนล้มเหลวหลายครั้งเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik doğrulama çok kez başarısız olduğundan, kullanıcı biyometrik kimlik doğrulamadan kilitlendiği için kimlik doğrulamaya devam edilemedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tiếp tục xác thực vì người dùng đã bị khóa khỏi xác thực sinh trắc học do xác thực thất bại quá nhiều lần."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo continuar con la autenticación porque el usuario ha sido bloqueado de la autenticación biométrica tras fallar demasiadas veces."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maipagpatuloy ang pagpapatotoo dahil na-lock out ang gumagamit sa biometric na pagpapatotoo, sanhi ng paulit-ulit na pagkabigo sa pagpapatotoo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणीकरण जारी नहीं रखा जा सका क्योंकि बहुत अधिक बार प्रमाणीकरण विफल होने के कारण उपयोगकर्ता को बायोमेट्रिक प्रमाणीकरण से लॉक कर दिया गया है।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V ověřování nelze pokračovat, protože biometrické ověřování bylo zablokováno kvůli příliš mnoha neúspěšným pokusům."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به دلیل تعداد زیاد دفعات ناموفق در احراز هویت، کاربر از احراز هویت زیستی منع شده است و فرایند نمی‌تواند ادامه یابد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להמשיך באימות מכיוון שהמשתמש ננעל מחוץ לאימות הביומטרי, עקב כשלים רבים מדי באימות."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengesahan tidak dapat diteruskan kerana pengguna telah dikunci daripada pengesahan biometrik akibat terlalu kerap gagal mengesahkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea nu a putut continua deoarece utilizatorul a fost blocat de la autentificarea biometrică, din cauza prea multor încercări nereușite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentiseringen kunde inte fortsätta eftersom användaren har låsts ute från biometrisk autentisering på grund av för många misslyckade autentiseringsförsök."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταυτοποίηση δεν μπόρεσε να συνεχιστεί, επειδή ο χρήστης έχει αποκλειστεί από τη βιομετρική ταυτοποίηση λόγω πολλών αποτυχημένων προσπαθειών."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বহুবার অনুমোদন ব্যর্থ হওয়ার কারণে ব্যবহারকারীকে বায়োমেট্রিক অনুমোদন থেকে লক করে দেওয়া হয়েছে, তাই অনুমোদন চালিয়ে যাওয়া যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல முறை அங்கீகாரம் தோல்வியடைந்ததால் பயனர் பயோமெட்ரிக் அங்கீகாரத்திலிருந்து தடுக்கப்பட்டுள்ளதால் அங்கீகாரத்தைத் தொடர முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాలాసార్లు ప్రామాణీకరణ విఫలమైనందున, వినియోగదారు బయోమెట్రిక్ ప్రామాణీకరణ నుండి లాక్ చేయబడ్డారు, కాబట్టి ప్రామాణీకరణ కొనసాగలేకపోయింది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelsen kunne ikke fortsætte, fordi brugeren er blevet låst ude af biometrisk godkendelse på grund af for mange mislykkede forsøg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todennusta ei voitu jatkaa, koska käyttäjä on lukittu pois biometrisestä todennuksesta liian monen epäonnistuneen todennusyrityksen vuoksi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hitelesítés nem folytatható, mert a túl sok sikertelen próbálkozás miatt a biometrikus hitelesítés zárolásra került."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentiseringen kunne ikke fortsette fordi brukeren er utestengt fra biometrisk autentisering på grunn av for mange mislykkede forsøk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível continuar a autenticação porque o utilizador foi bloqueado da autenticação biométrica, por ter falhado a autenticação demasiadas vezes."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدیق جاری نہیں رہ سکی کیونکہ بار بار ناکام تصدیق کی وجہ سے صارف کو بایومیٹرک تصدیق سے باہر کر دیا گیا ہے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նույնականացումը չհաջողվեց շարունակել, քանի որ օգտատերը արգելափակվել է կենսաչափական նույնականացումից՝ չափազանց շատ անգամ նույնականացման ձախողման պատճառով։"
          }
        }
      }
    },

    "onboarding.signInSubheadline" : {
      "comment" : "The subheadline string for signing in.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول باستخدام حساب Kurozora الخاص بك لاستخدام المكتبة وخدمات Kurozora الأخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইব্রেরি ও অন্যান্য Kurozora পরিষেবা ব্যবহার করতে আপনার Kurozora অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se svým účtem Kurozora a využívejte knihovnu a další služby Kurozora."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind med din Kurozora-konto for at bruge biblioteket og andre Kurozora-tjenester."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich mit Ihrem Kurozora-Konto an, um die Bibliothek und andere Kurozora-Dienste zu nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε με τον Λογαριασμό Kurozora σας για να χρησιμοποιήσετε τη βιβλιοθήκη και τις άλλες υπηρεσίες του Kurozora."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sign in with your Kurozora Account to use the library and other Kurozora services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sesión con su Cuenta de Kurozora para usar la biblioteca y otros servicios de Kurozora."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sesión con su Cuenta de Kurozora para usar la biblioteca y otros servicios de Kurozora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای استفاده از کتابخانه و دیگر خدمات Kurozora، با حساب Kurozora خود وارد شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautukaa sisään Kurozora-tilillänne käyttääksenne kirjastoa ja muita Kurozora-palveluita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-sign in gamit ang iyong Kurozora Account upang magamit ang library at iba pang mga serbisyo ng Kurozora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte Kurozora pour utiliser la bibliothèque et les autres services Kurozora."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להתחבר עם חשבון Kurozora שלך כדי להשתמש בספרייה ובשירותי Kurozora האחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइब्रेरी और अन्य Kurozora सेवाओं का उपयोग करने के लिए अपने Kurozora खाते से साइन इन करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelentkezz be a Kurozora fiókoddal, hogy használhasd a könyvtárat és a többi Kurozora szolgáltatást."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մուտք գործեք ձեր Kurozora հաշվով՝ գրադարանն ու Kurozora-ի այլ ծառայություններն օգտագործելու համար։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan Akun Kurozora Anda untuk menggunakan pustaka dan layanan Kurozora lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo Account Kurozora per usare la libreria e gli altri servizi Kurozora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリやその他のKurozoraサービスを利用するには、Kurozoraアカウントでサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리와 그 밖의 Kurozora 서비스를 이용하려면 Kurozora 계정으로 로그인해 주세요."

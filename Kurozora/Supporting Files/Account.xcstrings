    "authenticate to disable app lock.": {
      "comment": "The biometric prompt reason shown when disabling app lock on Mac.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "authenticeer om appvergrendeling uit te schakelen."
          }
        },

    "Make your home screen stand out with premium and limited time app icons.": {
      "comment": "The 'stylish app icons' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je beginscherm opvallen met premium app-symbolen voor beperkte tijd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل شاشتك الرئيسية مميزة بأيقونات تطبيق مدفوعة ومحدودة الوقت."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que tu pantalla de inicio destaque con iconos de app premium y por tiempo limitado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat layar utama kamu menonjol dengan ikon aplikasi premium dan edisi waktu terbatas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアムや期間限定のAppアイコンで、ホーム画面をひときわ目立たせよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaque sua tela de início com ícones de app premium e por tempo limitado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deinen Home-Bildschirm mit Premium- und zeitlich begrenzten App-Symbolen herausstechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarque ton écran d’accueil avec des icônes d’app premium et en édition limitée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai risaltare la tua schermata Home con icone dell'app premium e a tempo limitato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리미엄 및 한정 기간 앱 아이콘으로 홈 화면을 돋보이게 만들어 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraw, by Twój ekran główny się wyróżniał, dzięki ikonom aplikacji premium oraz tym dostępnym przez ograniczony czas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделай свой домашний экран особенным с премиальными и ограниченными по времени иконками приложения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вирізни свій головний екран преміальними та обмеженими в часі іконками застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用高级版和限时应用图标，让你的主屏幕脱颖而出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用尊榮與限時的 App 圖示，讓你的主畫面與眾不同。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้หน้าจอโฮมของคุณโดดเด่นด้วยไอคอนแอปแบบพรีเมียมและรุ่นลิมิเต็ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium ve sınırlı süreli uygulama simgeleriyle ana ekranını öne çıkar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm cho màn hình chính của bạn nổi bật với các biểu tượng ứng dụng cao cấp và phiên bản giới hạn thời gian."
          }
        }
      }
    },
    "Manage Subscriptions": {
      "comment": "The string for the 'manage subscriptions' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",

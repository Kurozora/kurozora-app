        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անխափան անցեք այլ ծառայություններից Kurozora։ Ավելացրեք «kurozora.app»-ը ցանկացած URL-ի և թույլ տվեք մեզ հավաքել ձեր ամբողջ anime տվյալները մեկ տեղում։"
          }
        }

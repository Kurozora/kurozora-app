    "Found a Kurozora code in the wild? This is the place to redeem it!": {
      "comment": "The subheadline string for the Redeem view.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Kurozora-code gevonden? Hier kun je hem inwisselen!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجدت رمز Kurozora في مكان ما؟ هذا هو المكان المناسب لاستبداله!"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Encontraste un código de Kurozora por ahí? ¡Este es el lugar para canjearlo!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan kode Kurozora di luar sana? Di sinilah tempatnya untuk menukarkannya!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozoraのコードを見つけた？ここで引き換えよう！"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrou um código Kurozora por aí? Este é o lugar para resgatá-lo!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Kurozora-Code in freier Wildbahn gefunden? Hier kannst du ihn einlösen!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as trouvé un code Kurozora dans la nature ? C’est ici qu’on l’utilise !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai trovato un codice Kurozora in giro? Questo è il posto giusto per riscattarlo!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어딘가에서 Kurozora 코드를 발견하셨나요? 여기서 사용하시면 돼요!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafiłeś gdzieś na kod Kurozora? To miejsce, gdzie możesz go zrealizować!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нашёл код Kurozora? Самое время его активировать!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайшов код Kurozora десь у природі? Саме тут його можна активувати!"
          }
        },
        "zh-Hans": {

    "onboarding.forgotPasswordAlertSubheadline": {
      "comment": "The subheadline string for resetting password alert.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "If an account exists with this Kurozora Account, you should receive an email with your reset link shortly."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er een account bestaat met dit Kurozora-account, ontvang je binnenkort een e-mail met je resetlink."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان هناك حساب مرتبط بحساب Kurozora هذا، فستتلقّى رسالة بريد إلكتروني تتضمن رابط إعادة التعيين قريبًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta asociada a esta Cuenta de Kurozora, pronto recibirá un correo con su enlace de restablecimiento."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ada akun dengan Akun Kurozora ini, Anda akan segera menerima email berisi tautan pengaturan ulang Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このKurozoraアカウントが存在する場合は、まもなくリセットリンクが記載されたメールが届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se existir uma conta com esta Conta Kurozora, você deverá receber em breve um e-mail com seu link de redefinição."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls ein Konto mit diesem Kurozora-Konto existiert, erhalten Sie in Kürze eine E-Mail mit Ihrem Link zum Zurücksetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe avec ce compte Kurozora, vous devriez recevoir sous peu un e-mail contenant votre lien de réinitialisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esiste un account associato a questo Account Kurozora, a breve riceverai un'email con il link per il reimpostare la password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Kurozora 계정으로 등록된 계정이 있다면 곧 재설정 링크가 담긴 이메일을 받게 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli istnieje konto powiązane z tym kontem Kurozora, wkrótce powinieneś otrzymać e-mail z linkiem do resetu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если учётная запись с этой Учётной записью Kurozora существует, вы вскоре получите письмо со ссылкой для сброса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо обліковий запис із цим Обліковим записом Kurozora існує, ви незабаром отримаєте електронний лист із посиланням для скидання."

    "Resume the %@ purchase you started in the App Store.": {
      "comment": "The alert message prompting the user to resume a promoted purchase.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervat de aankoop van %@ die u in de App Store bent begonnen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استئناف عملية شراء %@ التي بدأتها في App Store."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanude la compra de %@ que inició en el App Store."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan pembelian %@ yang Anda mulai di App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store で開始した %@ の購入を再開します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome a compra de %@ que você iniciou na App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie den Kauf von %@ fort, den Sie im App Store begonnen haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez l’achat %@ que vous avez commencé sur l’App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprenda l'acquisto di %@ che ha iniziato sull'App Store."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 시작한 %@ 구매를 이어서 진행하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznów zakup %@ rozpoczęty w App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите покупку %@, начатую в App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续您在 App Store 发起的 %@ 购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續您在 App Store 開始的 %@ 購買。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการซื้อ %@ ที่คุณเริ่มไว้ใน App Store ต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store'da başlattığınız %@ satın alma işlemine devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть покупку %@, яку ви розпочали в App Store."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục giao dịch mua %@ mà bạn đã bắt đầu trên App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanude la compra de %@ que inició en el App Store."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipagpatuloy ang pagbili ng %@ na sinimulan mo sa App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store में आपके द्वारा शुरू की गई %@ खरीद को फिर से शुरू करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračujte v nákupu %@, který jste zahájili v App Store."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خرید %@ را که در App Store آغاز کردید ادامه دهید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשיכו את רכישת %@ שהתחלתם ב-App Store."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambung semula pembelian %@ yang anda mulakan di App Store."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reluați achiziția %@ pe care ați început-o în App Store."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återuppta köpet av %@ som du påbörjade i App Store."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε την αγορά %@ που ξεκινήσατε στο App Store."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-এ আপনি যে %@ ক্রয় শুরু করেছিলেন তা পুনরায় শুরু করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store-இல் நீங்கள் தொடங்கிய %@ கொள்முதலைத் தொடரவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు App Store లో ప్రారంభించిన %@ కొనుగోలును కొనసాగించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoptag det %@-køb, du påbegyndte i App Store."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka %@-ostoa, jonka aloitit App Storessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytassa a(z) %@ vásárlást, amelyet az App Store-ban kezdett el."
          }

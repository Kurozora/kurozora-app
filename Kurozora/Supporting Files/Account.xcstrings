        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tűnj ki a közösségben egy exkluzív előfizetői jelvénnyel, amely idővel fejlődik, ahogy továbbra is támogatod a Kurozorát!"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Աչքի ընկիր համայնքում բացառիկ բաժանորդագրության կրծքանշանով, որը ժամանակի ընթացքում զարգանում է, քանի դեռ շարունակում ես աջակցել Kurozora-ին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampil menonjol di komunitas dengan lencana langganan eksklusif yang berkembang seiring waktu selama kamu terus mendukung Kurozora!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distinguiti nella community con un badge di abbonamento esclusivo che si evolve nel tempo mentre continui a supportare Kurozora!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurozora を応援し続けることで時間とともに進化する、限定のサブスクリプションバッジでコミュニティで目立っちゃおう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurozora를 계속 후원하면서 시간이 지날수록 진화하는 전용 구독 배지로 커뮤니티에서 돋보이세요!"

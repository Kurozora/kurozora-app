          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта функция доступна только пользователям Kurozora+. Полученные средства идут на поддержку разработки Kurozora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能仅向 Kurozora+ 用户开放。所得款项将用于支持 Kurozora 的开发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能僅開放給 Kurozora+ 使用者。所得款項將用於支持 Kurozora 的開發。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีเจอร์นี้ใช้งานได้สำหรับผู้ใช้ Kurozora+ เท่านั้น รายได้จากส่วนนี้จะนำไปสนับสนุนการพัฒนา Kurozora"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özellik yalnızca Kurozora+ kullanıcılarına açıktır. Buradan elde edilen gelir, Kurozora'nın geliştirilmesini desteklemek için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця функція доступна лише користувачам Kurozora+. Кошти від цього йдуть на підтримку розробки Kurozora."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng này chỉ dành cho người dùng Kurozora+. Số tiền thu được sẽ dùng để hỗ trợ phát triển Kurozora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función solo está disponible para los usuarios de Kurozora+. Los fondos obtenidos se destinan a apoyar el desarrollo de Kurozora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang feature na ito ay naa-access lamang ng mga Kurozora+ user. Ang pondong mula rito ay napupunta sa pagsuporta sa pagpapaunlad ng Kurozora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सुविधा केवल Kurozora+ उपयोगकर्ताओं के लिए उपलब्ध है। इससे मिलने वाली राशि Kurozora के विकास में सहायता हेतु जाती है।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato funkce je dostupná pouze uživatelům Kurozora+. Výtěžek jde na podporu vývoje Kurozory."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ویژگی تنها برای کاربران Kurozora+ در دسترس است. درآمد حاصل از آن صرف پشتیبانی از توسعه Kurozora می‌شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תכונה זו זמינה למשתמשי Kurozora+ בלבד. הכספים מכך מסייעים לתמוך בפיתוח של Kurozora."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciri ini hanya boleh diakses oleh pengguna Kurozora+. Dana daripada ini digunakan untuk menyokong pembangunan Kurozora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această funcție este accesibilă doar utilizatorilor Kurozora+. Fondurile obținute din aceasta merg către susținerea dezvoltării Kurozora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här funktionen är endast tillgänglig för Kurozora+-användare. Intäkterna från detta går till att stötta utvecklingen av Kurozora."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η λειτουργία είναι διαθέσιμη μόνο στους χρήστες Kurozora+. Τα έσοδα από αυτό στηρίζουν την ανάπτυξη του Kurozora."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফিচারটি শুধুমাত্র Kurozora+ ব্যবহারকারীদের জন্য উপলব্ধ। এর অর্থ Kurozora-এর উন্নয়নে সহায়তা করতে ব্যবহৃত হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அம்சம் Kurozora+ பயனர்களுக்கு மட்டுமே அணுகக்கூடியது. இதிலிருந்து வரும் நிதி Kurozora-வின் மேம்பாட்டை ஆதரிக்கப் பயன்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫీచర్ Kurozora+ వినియోగదారులకు మాత్రమే అందుబాటులో ఉంటుంది. దీని నుండి వచ్చే నిధులు Kurozora అభివృద్ధికి మద్దతుగా ఉపయోగపడతాయి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne funktion er kun tilgængelig for Kurozora+-brugere. Indtægterne herfra går til at støtte udviklingen af Kurozora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ominaisuus on vain Kurozora+-käyttäjien käytettävissä. Tuotot käytetään Kurozoran kehityksen tukemiseen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a funkció csak a Kurozora+ felhasználók számára érhető el. Az ebből származó bevétel a Kurozora fejlesztését támogatja."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne funksjonen er kun tilgjengelig for Kurozora+-brukere. Midlene fra dette går til å støtte utviklingen av Kurozora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta funcionalidade está acessível apenas aos utilizadores Kurozora+. Os fundos provenientes desta contribuem para apoiar o desenvolvimento do Kurozora."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ خصوصیت صرف Kurozora+ صارفین کے لیے دستیاب ہے۔ اس سے حاصل ہونے والی رقم Kurozora کی ترقی کی حمایت میں صرف ہوتی ہے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հնարավորությունը հասանելի է միայն Kurozora+ օգտատերերին։ Դրանից ստացված միջոցներն ուղղվում են Kurozora-ի զարգացմանն աջակցելուն։"
          }
        }
      }
    },

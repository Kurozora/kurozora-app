        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентификация требуется, если приложение находится в фоновом режиме дольше %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автентифікація потрібна, якщо застосунок залишається у фоновому режимі понад %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

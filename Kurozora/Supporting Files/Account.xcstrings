    "onboarding.forgotPasswordAlertSubheadline": {
      "comment": "The subheadline string for resetting password alert.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "If an account exists with this Kurozora Account, you should receive an email with your reset link shortly."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er een account bestaat met dit Kurozora-account, ontvang je binnenkort een e-mail met je resetlink."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان هناك حساب مرتبط بحساب Kurozora هذا، فستتلقّى رسالة بريد إلكتروني تتضمن رابط إعادة التعيين قريبًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta asociada a esta Cuenta de Kurozora, pronto recibirá un correo con su enlace de restablecimiento."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ada akun dengan Akun Kurozora ini, Anda akan segera menerima email berisi tautan pengaturan ulang Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このKurozoraアカウントが存在する場合は、まもなくリセットリンクが記載されたメールが届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se existir uma conta com esta Conta Kurozora, você deverá receber em breve um e-mail com seu link de redefinição."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls ein Konto mit diesem Kurozora-Konto existiert, erhalten Sie in Kürze eine E-Mail mit Ihrem Link zum Zurücksetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe avec ce compte Kurozora, vous devriez recevoir sous peu un e-mail contenant votre lien de réinitialisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esiste un account associato a questo Account Kurozora, a breve riceverai un'email con il link per il reimpostare la password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Kurozora 계정으로 등록된 계정이 있다면 곧 재설정 링크가 담긴 이메일을 받게 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli istnieje konto powiązane z tym kontem Kurozora, wkrótce powinieneś otrzymać e-mail z linkiem do resetu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если учётная запись с этой Учётной записью Kurozora существует, вы вскоре получите письмо со ссылкой для сброса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо обліковий запис із цим Обліковим записом Kurozora існує, ви незабаром отримаєте електронний лист із посиланням для скидання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果存在使用此 Kurozora 账户的账号，您稍后将收到一封含有重置链接的电子邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若有帳號使用此 Kurozora 帳號，您應該很快會收到一封含有重設連結的電子郵件。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีบัญชีที่ใช้บัญชี Kurozora นี้อยู่ คุณจะได้รับอีเมลพร้อมลิงก์รีเซ็ตในไม่ช้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Kurozora Hesabıyla bir hesap varsa, kısa süre içinde sıfırlama bağlantınızı içeren bir e-posta almanız gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu có một tài khoản tồn tại với Tài Khoản Kurozora này, bạn sẽ sớm nhận được email kèm liên kết đặt lại mật khẩu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta con esta Cuenta de Kurozora, recibirá en breve un correo con el enlace para restablecerla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung may umiiral na account sa Kurozora Account na ito, dapat kang makatanggap ng email na may iyong reset link sa lalong madaling panahon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि इस Kurozora खाते के साथ कोई खाता मौजूद है, तो आपको शीघ्र ही अपने रीसेट लिंक के साथ एक ईमेल प्राप्त होगा।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud s tímto účtem Kurozora existuje účet, měl by vám brzy přijít e-mail s odkazem pro obnovení hesla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر حسابی با این حساب Kurozora وجود داشته باشد، به‌زودی ایمیلی حاوی پیوند بازنشانی دریافت خواهید کرد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם קיים חשבון עם חשבון Kurozora זה, אמור להגיע אליך בקרוב אימייל עם קישור לאיפוס."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika akaun wujud dengan Akaun Kurozora ini, anda sepatutnya menerima e-mel dengan pautan tetap semula anda sebentar lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă există un cont asociat acestui Cont Kurozora, ar trebui să primiți în scurt timp un email cu linkul de resetare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det finns ett konto med detta Kurozora-konto bör du strax få ett e-postmeddelande med din återställningslänk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν υπάρχει λογαριασμός με αυτόν τον Λογαριασμό Kurozora, θα λάβετε σύντομα ένα email με τον σύνδεσμο επαναφοράς σας."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Kurozora অ্যাকাউন্ট দিয়ে কোনো অ্যাকাউন্ট থাকলে, আপনি শীঘ্রই আপনার রিসেট লিঙ্কসহ একটি ইমেল পাবেন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Kurozora கணக்குடன் ஒரு கணக்கு இருந்தால், உங்கள் மீட்டமைப்பு இணைப்புடன் கூடிய மின்னஞ்சல் விரைவில் உங்களுக்குக் கிடைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Kurozora ఖాతాతో ఒక ఖాతా ఉన్నట్లయితే, మీ రీసెట్ లింక్‌తో కూడిన ఇమెయిల్ మీకు త్వరలో అందుతుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis der findes en konto med denne Kurozora-konto, modtager du snart en e-mail med dit nulstillingslink."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos tällä Kurozora-tilillä on olemassa oleva tili, saatte pian sähköpostiviestin, jossa on palautuslinkkinne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha létezik fiók ezzel a Kurozora fiókkal, hamarosan e-mailt kap a visszaállítási hivatkozással."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det finnes en konto med denne Kurozora-kontoen, skal du snart motta en e-post med tilbakestillingslenken din."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se existir uma conta associada a esta Conta Kurozora, deverá receber em breve um e-mail com a sua hiperligação de reposição."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اس Kurozora اکاؤنٹ کے ساتھ کوئی اکاؤنٹ موجود ہے، تو آپ کو جلد ہی اپنے ری سیٹ لنک کے ساتھ ایک ای میل موصول ہونی چاہیے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե այս Kurozora հաշվով գոյություն ունի հաշիվ, շուտով կստանաք էլ. նամակ՝ ձեր վերականգնման հղումով։"
          }
        }
      }
    },

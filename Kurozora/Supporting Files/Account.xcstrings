          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若 App 於背景停留超過 %@，則需要進行驗證。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีการยืนยันตัวตนหากแอปอยู่ในเบื้องหลังนานกว่า %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama %@ süresinden uzun süre arka planda kalırsa kimlik doğrulama gereklidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu xác thực nếu ứng dụng ở chế độ nền lâu hơn %@."
          }
        }
      }
    },

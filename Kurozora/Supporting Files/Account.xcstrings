    "Switch things up every now an then with a fresh username that truly represents you.": {
      "comment": "The 'change your identity' product feature description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gooi het af en toe over een andere boeg met een nieuwe gebruikersnaam die echt bij je past."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر الأجواء بين الحين والآخر باسم مستخدم جديد يمثّلك حقًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia las cosas de vez en cuando con un nuevo nombre de usuario que realmente te represente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti suasana sesekali dengan username baru yang benar-benar mewakili dirimu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ときどき気分を変えて、本当のあなたを表す新しいユーザー名にしよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude as coisas de vez em quando com um novo nome de usuário que realmente represente você."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring ab und zu frischen Wind rein mit einem neuen Benutzernamen, der wirklich zu dir passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change un peu de temps en temps avec un nouveau nom d’utilisateur qui te représente vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia ogni tanto con un nuovo nome utente che ti rappresenta davvero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔은 진짜 나를 보여주는 새로운 사용자 이름으로 분위기를 바꿔보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniaj coś od czasu do czasu dzięki świeżej nazwie użytkownika, która naprawdę Cię odzwierciedla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время от времени меняйте обстановку — выберите новое имя пользователя, которое по-настоящему отражает вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时不时换个全新的用户名，让它真正代表你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偶爾換個全新、真正代表你的使用者名稱，讓一切煥然一新。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนบรรยากาศบ้างเป็นครั้งคราวด้วยชื่อผู้ใช้ใหม่ที่บ่งบอกความเป็นตัวคุณอย่างแท้จริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni gerçekten yansıtan yepyeni bir kullanıcı adıyla arada bir tarzını değiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час від часу змінюй щось, обираючи нове ім’я користувача, яке справді відображає тебе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thỉnh thoảng đổi mới với một tên người dùng thật sự đại diện cho bạn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de aires de vez en cuando con un nuevo nombre de usuario que de verdad te represente."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baguhin ang mga bagay paminsan-minsan gamit ang isang sariwang username na tunay na kumakatawan sa iyo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी-कभी एक नए username के साथ चीज़ें बदलते रहें जो सचमुच आपको दर्शाता हो।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Občas to oživ novým uživatelským jménem, které tě opravdu vystihuje."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر از گاهی با یک نام کاربری تازه که واقعاً معرف خودت باشد، تغییری ایجاد کن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנו מדי פעם את העניינים עם שם משתמש רענן שמייצג אתכם באמת."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah suasana sekali-sekala dengan username baharu yang benar-benar mewakili diri anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă lucrurile din când în când cu un nume de utilizator nou, care te reprezintă cu adevărat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt upp det då och då med ett nytt användarnamn som verkligen representerar dig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε τα πράγματα πού και πού με ένα φρέσκο όνομα χρήστη που σε αντιπροσωπεύει πραγματικά."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাঝে মাঝে নতুন একটি ইউজারনেম দিয়ে কিছুটা বদল আনো, যা সত্যিকারভাবে তোমাকে প্রকাশ করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களை உண்மையாகப் பிரதிபலிக்கும் புதிய பயனர்பெயருடன் அவ்வப்போது மாற்றிக்கொள்ளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిజంగా మీకు ప్రాతినిధ్యం వహించే తాజా username తో అప్పుడప్పుడు మార్పు తెచ్చుకోండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift det ud en gang imellem med et nyt brugernavn, der virkelig repræsenterer dig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piristä silloin tällöin tunnelmaa uudella käyttäjänimellä, joka todella edustaa sinua."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobd fel néha a dolgokat egy új felhasználónévvel, amely igazán téged tükröz."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift det opp innimellom med et nytt brukernavn som virkelig representerer deg."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda as coisas de vez em quando com um novo nome de utilizador que te represente verdadeiramente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتاً فوقتاً ایک نئے یوزرنیم کے ساتھ تبدیلی لائیں جو واقعی آپ کی نمائندگی کرے۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ժամանակ առ ժամանակ փոխիր ամեն ինչ նոր օգտանունով, որը իսկապես ներկայացնում է քեզ։"
          }
        }
      }
    },

            "state": "translated",
            "value": "poster கலை இல்லாதபோது மட்டுமே தலைப்பைக் காட்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోస్టర్ ఆర్ట్ అందుబాటులో లేనప్పుడు మాత్రమే టైటిల్‌ను చూపిస్తుంది"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kun titel, når plakatkunst ikke er tilgængelig"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää nimen vain, kun julistekuvaa ei ole saatavilla"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címet csak akkor jeleníti meg, ha nincs elérhető poszter"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser tittel bare når plakatbilde ikke er tilgjengelig"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o título apenas quando não há póster disponível"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان صرف اُس وقت دکھاتا ہے جب پوسٹر آرٹ دستیاب نہ ہو"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ցույց է տալիս վերնագիրը միայն, երբ պաստառ չկա"
          }
        }
      }
    },

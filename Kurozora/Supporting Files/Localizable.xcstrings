        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการออกจากระบบ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumu kapatmak istediğinizden emin misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn đăng xuất không?"

          "stringUnit": {
            "state": "translated",
            "value": "Sigur doriți să vă deconectați?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill logga ut?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu se chcete odhlásit?"
          }
        },
        "el": {
          "stringUnit": {

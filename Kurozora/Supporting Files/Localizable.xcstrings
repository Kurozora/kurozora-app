    "languagePicker.description" : {
      "comment" : "Explanatory text shown above the language picker to clarify that the setting changes content language, not the app's interface language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your preferred language is used for the information shown throughout Kurozora, such as titles, descriptions, and metadata. It does not change the language of the app's interface.\n\nThese changes take effect anywhere you are signed in with your Kurozora Account.\n\nIf information cannot be shown in your preferred language, English will be used instead."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je voorkeurstaal wordt gebruikt voor de informatie die overal in Kurozora wordt getoond, zoals titels, beschrijvingen en metadata. Het wijzigt de taal van de interface van de app niet.\n\nDeze wijzigingen gelden overal waar je bent ingelogd met je Kurozora-account.\n\nAls informatie niet in je voorkeurstaal kan worden getoond, wordt Engels gebruikt."
          }
        }
      }
    },

            "value": "النوع"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipe"
          }
        },
        "ja": {
          "stringUnit": {

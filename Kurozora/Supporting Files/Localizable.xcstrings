    "timezonePicker.description": {
      "comment": "Explanatory text shown above the timezone picker to clarify what the setting affects.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The selected timezone will be used to display all dates and times, including premiere dates, broadcasts, and schedules."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde tijdzone wordt gebruikt om alle datums en tijden weer te geven, waaronder premièredata, uitzendingen en schema's."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستخدَم المنطقة الزمنية المحددة لعرض جميع التواريخ والأوقات، بما في ذلك تواريخ العرض الأول والبث والجداول."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona horaria seleccionada se usará para mostrar todas las fechas y horas, incluyendo fechas de estreno, transmisiones y programaciones."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona waktu yang dipilih akan digunakan untuk menampilkan semua tanggal dan waktu, termasuk tanggal tayang perdana, siaran, dan jadwal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したタイムゾーンは、プレミア日、放送、スケジュールなど、すべての日付と時刻の表示に使用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fuso horário selecionado será usado para exibir todas as datas e horários, incluindo datas de estreia, transmissões e programações."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Zeitzone wird verwendet, um alle Daten und Uhrzeiten anzuzeigen, einschließlich Premierendaten, Ausstrahlungen und Zeitpläne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fuseau horaire sélectionné sera utilisé pour afficher toutes les dates et heures, y compris les dates de première, les diffusions et les programmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fuso orario selezionato verrà utilizzato per visualizzare tutte le date e gli orari, comprese le date di prima messa in onda, le trasmissioni e i palinsesti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간대는 방영일, 방송, 일정을 포함한 모든 날짜와 시간을 표시하는 데 사용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana strefa czasowa będzie używana do wyświetlania wszystkich dat i godzin, w tym dat premier, emisji i harmonogramów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный часовой пояс будет использоваться для отображения всех дат и времени, включая даты премьер, трансляции и расписания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний часовий пояс використовуватиметься для відображення всіх дат і часу, зокрема дат прем’єр, трансляцій і розкладів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时区将用于显示所有日期和时间，包括首播日期、播出和时间表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選時區將用於顯示所有日期與時間，包括首播日期、播放時段與排程。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขตเวลาที่เลือกจะถูกใช้ในการแสดงวันที่และเวลาทั้งหมด รวมถึงวันที่ฉายรอบปฐมทัศน์ การออกอากาศ และกำหนดการต่าง ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen saat dilimi; prömiyer tarihleri, yayınlar ve programlar dahil tüm tarih ve saatleri göstermek için kullanılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Múi giờ đã chọn sẽ được dùng để hiển thị tất cả ngày và giờ, bao gồm ngày phát hành, lịch phát sóng và lịch chiếu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona horaria seleccionada se usará para mostrar todas las fechas y horas, incluidas las fechas de estreno, las emisiones y los calendarios."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagamitin ang napiling timezone upang ipakita ang lahat ng petsa at oras, kabilang ang mga petsa ng premiere, broadcast, at iskedyul."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना गया टाइम ज़ोन सभी तारीखों और समयों को दिखाने के लिए उपयोग किया जाएगा, जिसमें प्रीमियर तारीखें, प्रसारण और शेड्यूल शामिल हैं।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منطقه زمانی انتخاب‌شده برای نمایش تمام تاریخ‌ها و زمان‌ها، از جمله تاریخ‌های اکران، پخش‌ها و زمان‌بندی‌ها استفاده می‌شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזור הזמן הנבחר ישמש להצגת כל התאריכים והשעות, כולל מועדי בכורה, שידורים ולוחות זמנים."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Zon masa yang dipilih akan digunakan untuk memaparkan semua tarikh dan masa, termasuk tarikh tayangan perdana, siaran dan jadual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusul orar selectat va fi folosit pentru a afișa toate datele și orele, inclusiv datele de premieră, difuzările și programele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda tidszonen används för att visa alla datum och tider, inklusive premiärdatum, sändningar och scheman."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrané časové pásmo se použije pro zobrazení všech dat a časů, včetně dat premiér, vysílání a rozvrhů."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλεγμένη ζώνη ώρας θα χρησιμοποιηθεί για την εμφάνιση όλων των ημερομηνιών και ωρών, συμπεριλαμβανομένων των ημερομηνιών πρεμιέρας, των μεταδόσεων και των προγραμμάτων."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত টাইম জোন সব তারিখ ও সময় দেখাতে ব্যবহার করা হবে, যার মধ্যে প্রিমিয়ার তারিখ, সম্প্রচার এবং সময়সূচি অন্তর্ভুক্ত।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கப்பட்ட நேர மண்டலம், முதற்காட்சித் தேதிகள், ஒளிபரப்புகள் மற்றும் அட்டவணைகள் உள்ளிட்ட அனைத்துத் தேதிகளையும் நேரங்களையும் காட்டப் பயன்படுத்தப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న టైమ్ జోన్ ప్రీమియర్ తేదీలు, ప్రసారాలు మరియు షెడ్యూల్‌లతో సహా అన్ని తేదీలు మరియు సమయాలను చూపించడానికి ఉపయోగించబడుతుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte tidszone bruges til at vise alle datoer og tidspunkter, herunder premieredatoer, udsendelser og tidsplaner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittua aikavyöhykettä käytetään kaikkien päivämäärien ja kellonaikojen näyttämiseen, mukaan lukien ensi-iltapäivät, lähetykset ja aikataulut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiválasztott időzóna szolgál minden dátum és időpont megjelenítéséhez, beleértve a premierdátumokat, sugárzásokat és ütemterveket."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte tidssonen brukes til å vise alle datoer og klokkeslett, inkludert premieredatoer, sendinger og tidsplaner."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O fuso horário selecionado será utilizado para apresentar todas as datas e horas, incluindo datas de estreia, transmissões e agendas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کردہ ٹائم زون تمام تاریخوں اور اوقات کو دکھانے کے لیے استعمال ہوگا، بشمول پریمیئر کی تاریخیں، نشریات اور شیڈولز۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրված ժամային գոտին կօգտագործվի բոլոր ամսաթվերն ու ժամերը ցուցադրելու համար, ներառյալ պրեմիերաների ամսաթվերը, հեռարձակումները և ժամանակացույցերը։"
          }
        }
      }
    },

            "value": "Tem certeza de que deseja sair?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie sich wirklich abmelden?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment vous déconnecter ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero disconnetterti?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하시겠습니까?"
          }

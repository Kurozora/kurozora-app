    "timezonePicker.description": {
      "comment": "Explanatory text shown above the timezone picker to clarify what the setting affects.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The selected timezone will be used to display all dates and times, including premiere dates, broadcasts, and schedules."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde tijdzone wordt gebruikt om alle datums en tijden weer te geven, waaronder premièredata, uitzendingen en schema's."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستخدَم المنطقة الزمنية المحددة لعرض جميع التواريخ والأوقات، بما في ذلك تواريخ العرض الأول والبث والجداول."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona horaria seleccionada se usará para mostrar todas las fechas y horas, incluyendo fechas de estreno, transmisiones y programaciones."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona waktu yang dipilih akan digunakan untuk menampilkan semua tanggal dan waktu, termasuk tanggal tayang perdana, siaran, dan jadwal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したタイムゾーンは、プレミア日、放送、スケジュールなど、すべての日付と時刻の表示に使用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fuso horário selecionado será usado para exibir todas as datas e horários, incluindo datas de estreia, transmissões e programações."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Zeitzone wird verwendet, um alle Daten und Uhrzeiten anzuzeigen, einschließlich Premierendaten, Ausstrahlungen und Zeitpläne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fuseau horaire sélectionné sera utilisé pour afficher toutes les dates et heures, y compris les dates de première, les diffusions et les programmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fuso orario selezionato verrà utilizzato per visualizzare tutte le date e gli orari, comprese le date di prima messa in onda, le trasmissioni e i palinsesti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간대는 방영일, 방송, 일정을 포함한 모든 날짜와 시간을 표시하는 데 사용됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana strefa czasowa będzie używana do wyświetlania wszystkich dat i godzin, w tym dat premier, emisji i harmonogramów."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный часовой пояс будет использоваться для отображения всех дат и времени, включая даты премьер, трансляции и расписания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний часовий пояс використовуватиметься для відображення всіх дат і часу, зокрема дат прем’єр, трансляцій і розкладів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时区将用于显示所有日期和时间，包括首播日期、播出和时间表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選時區將用於顯示所有日期與時間，包括首播日期、播放時段與排程。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขตเวลาที่เลือกจะถูกใช้ในการแสดงวันที่และเวลาทั้งหมด รวมถึงวันที่ฉายรอบปฐมทัศน์ การออกอากาศ และกำหนดการต่าง ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen saat dilimi; prömiyer tarihleri, yayınlar ve programlar dahil tüm tarih ve saatleri göstermek için kullanılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Múi giờ đã chọn sẽ được dùng để hiển thị tất cả ngày và giờ, bao gồm ngày phát hành, lịch phát sóng và lịch chiếu."
          }
        }
      }
    },

        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que desea cerrar sesión?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurado ka bang gusto mong mag-sign out?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई साइन आउट करना चाहते हैं?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا مطمئن هستید که می‌خواهید از حساب خود خارج شوید؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",

    "Are you sure you want to sign out?": {
      "comment": "The body string for the sign-out confirmation alert.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je je wilt afmelden?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من رغبتك في تسجيل الخروج؟"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está seguro de que desea cerrar sesión?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin keluar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトしてもよろしいですか？"

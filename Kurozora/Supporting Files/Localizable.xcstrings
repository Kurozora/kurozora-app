    "Just to confirm, you wanted ‘%@’?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even bevestigen, je bedoelde '%@'?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتأكيد فقط، هل كنت تقصد ‘%@’؟"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para confirmar, ¿querías ‘%@’?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekadar memastikan, kamu mau ‘%@’?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "念のため確認ですが、‘%@’でいいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pra confirmar, você queria ‘%@’?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Sicherheit, du wolltest ‘%@’?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste pour confirmer, tu voulais ‘%@’ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giusto per confermare, volevi ‘%@’?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할게요, ‘%@’이(가) 맞나요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chodziło Ci o ‘%@’?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточним: вы хотели ‘%@’?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认一下，你想要的是‘%@’吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再確認一下，你想要的是「%@」嗎？"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอยืนยันอีกครั้ง คุณต้องการ ‘%@’ ใช่ไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin olmak için soruyorum, ‘%@’ mı istemiştin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто для підтвердження, ти мав на увазі «%@»?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận lại nhé, bạn muốn ‘%@’ phải không?"
          }
        }
      }
    },

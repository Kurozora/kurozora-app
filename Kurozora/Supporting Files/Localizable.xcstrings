    "tvRatingPicker.description": {
      "comment": "Explanatory text shown above the TV rating picker to clarify how tiered TV ratings affect visible content.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "TV ratings are tiered. Depending on the chosen TV rating some shows might be hidden.\n\nFor example, selecting R15+ will show you all anime up to a TV rating of R15+."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-classificaties zijn gelaagd. Afhankelijk van de gekozen TV-classificatie worden sommige series mogelijk verborgen.\n\nAls je bijvoorbeeld R15+ kiest, zie je alle anime tot en met de TV-classificatie R15+."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصنيفات العمرية متدرّجة. وبحسب التصنيف العمري المختار قد تُخفى بعض العروض.\n\nعلى سبيل المثال، اختيار R15+ سيعرض لك كل anime حتى التصنيف العمري R15+."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las clasificaciones de TV son escalonadas. Según la clasificación de TV elegida, algunas series podrían ocultarse.\n\nPor ejemplo, al seleccionar R15+ verás todo el anime hasta una clasificación de TV de R15+."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating TV berjenjang. Bergantung pada rating TV yang dipilih, beberapa tayangan mungkin disembunyikan.\n\nMisalnya, memilih R15+ akan menampilkan semua anime hingga rating TV R15+."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴年齢制限は段階的に設定されています。選択した制限によっては、一部の作品が非表示になる場合があります。\n\nたとえば、R15+を選択すると、R15+までのすべてのanimeが表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As classificações indicativas são em níveis. Dependendo da classificação escolhida, alguns shows podem ficar ocultos.\n\nPor exemplo, ao selecionar R15+, você verá todos os animes até a classificação R15+."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-Freigaben sind gestaffelt. Je nach gewählter TV-Freigabe werden einige Shows möglicherweise ausgeblendet.\n\nWenn du zum Beispiel R15+ auswählst, werden dir alle anime bis zu einer TV-Freigabe von R15+ angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les classifications TV sont hiérarchisées. Selon la classification TV choisie, certaines séries peuvent être masquées.\n\nPar exemple, sélectionner R15+ t’affichera tous les anime jusqu’à une classification TV de R15+."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classificazioni TV sono suddivise in livelli. A seconda della classificazione TV scelta, alcune serie potrebbero essere nascoste.\n\nPer esempio, selezionando R15+ verranno mostrati tutti gli anime fino alla classificazione TV R15+."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TV 등급은 단계별로 나뉩니다. 선택한 TV 등급에 따라 일부 작품이 숨겨질 수 있습니다.\n\n예를 들어 R15+를 선택하면 R15+ 등급까지의 모든 anime를 볼 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasyfikacje TV są wielopoziomowe. W zależności od wybranej klasyfikacji TV niektóre tytuły mogą zostać ukryte.\n\nNa przykład wybranie R15+ pokaże wszystkie anime do klasyfikacji TV R15+."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возрастные рейтинги разделены по уровням. В зависимости от выбранного рейтинга некоторые тайтлы могут быть скрыты.\n\nНапример, при выборе R15+ вам будет показано всё anime с рейтингом до R15+ включительно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікові обмеження поділені на рівні. Залежно від вибраного обмеження деякі шоу можуть бути приховані.\n\nНаприклад, вибравши R15+, ви побачите все anime до вікового обмеження R15+ включно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电视分级分为不同等级。根据所选的电视分级，部分作品可能会被隐藏。\n\n例如，选择 R15+ 将向您显示所有电视分级最高至 R15+ 的 anime。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電視分級採分級制。視所選的電視分級而定，部分作品可能會被隱藏。\n\n例如，選擇 R15+ 將顯示所有電視分級在 R15+ 以下的 anime。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรตติ้งทีวีจะแบ่งเป็นระดับ ขึ้นอยู่กับเรตติ้งทีวีที่เลือก เรื่องบางเรื่องอาจถูกซ่อนไว้\n\nตัวอย่างเช่น การเลือก R15+ จะแสดง anime ทั้งหมดจนถึงเรตติ้งทีวี R15+"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV derecelendirmeleri kademelidir. Seçilen TV derecelendirmesine bağlı olarak bazı yapımlar gizlenebilir.\n\nÖrneğin R15+ seçildiğinde R15+ derecelendirmesine kadar olan tüm animeler gösterilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp hạng TV được phân theo cấp độ. Tùy thuộc vào xếp hạng TV đã chọn, một số phim có thể bị ẩn.\n\nVí dụ, chọn R15+ sẽ hiển thị tất cả anime có xếp hạng TV tới mức R15+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las clasificaciones TV están escalonadas. Según la clasificación TV elegida, es posible que algunas series queden ocultas.\n\nPor ejemplo, al seleccionar R15+ verás todo el anime hasta una clasificación TV de R15+."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-antas ang mga TV rating. Depende sa napiling TV rating, maaaring may mga show na itinatago.\n\nHalimbawa, kapag pinili ang R15+ ay ipapakita sa iyo ang lahat ng anime hanggang sa TV rating na R15+."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV रेटिंग स्तरबद्ध होती हैं। चुनी गई TV रेटिंग के आधार पर कुछ शोज़ छिपे हो सकते हैं।\n\nउदाहरण के लिए, R15+ चुनने पर आपको R15+ TV रेटिंग तक के सभी anime दिखाए जाएंगे।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رده‌بندی‌های سنی پلکانی هستند. بسته به رده‌بندی سنی انتخاب‌شده، ممکن است برخی نمایش‌ها پنهان شوند.\n\nبرای مثال، انتخاب R15+ تمام anime تا رده‌بندی سنی R15+ را به شما نشان می‌دهد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דירוגי הצפייה מדורגים. בהתאם לדירוג הצפייה הנבחר, ייתכן שחלק מהתוכן יוסתר.\n\nלדוגמה, בחירת R15+ תציג לך את כל ה־anime עד דירוג צפייה של R15+."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penarafan TV adalah berperingkat. Bergantung pada penarafan TV yang dipilih, sesetengah anime mungkin disembunyikan.\n\nSebagai contoh, memilih R15+ akan menunjukkan kepada anda semua anime sehingga penarafan TV R15+."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clasificările TV sunt pe niveluri. În funcție de clasificarea TV aleasă, unele seriale pot fi ascunse.\n\nDe exemplu, dacă selectezi R15+, vei vedea toate animeurile până la clasificarea TV R15+."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-klassificeringar är nivåindelade. Beroende på vald TV-klassificering kan vissa serier döljas.\n\nOm du till exempel väljer R15+ visas all anime upp till TV-klassificeringen R15+."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnocení TV jsou rozdělena do stupňů. V závislosti na zvoleném hodnocení TV mohou být některá anime skryta.\n\nNapříklad výběrem R15+ se vám zobrazí všechna anime až do hodnocení TV R15+."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ηλικιακές διαβαθμίσεις είναι κλιμακωτές. Ανάλογα με την επιλεγμένη διαβάθμιση, ορισμένες σειρές ενδέχεται να αποκρύπτονται.\n\nΓια παράδειγμα, επιλέγοντας R15+ θα εμφανίζεται κάθε anime έως τη διαβάθμιση R15+."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিভি রেটিং স্তরভিত্তিক। নির্বাচিত টিভি রেটিংয়ের উপর নির্ভর করে কিছু শো লুকানো থাকতে পারে।\n\nউদাহরণস্বরূপ, R15+ নির্বাচন করলে R15+ পর্যন্ত টিভি রেটিংয়ের সব anime আপনাকে দেখানো হবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TV மதிப்பீடுகள் அடுக்கு வாரியாக உள்ளன. தேர்ந்தெடுக்கப்பட்ட TV மதிப்பீட்டைப் பொறுத்து சில shows மறைக்கப்படலாம்.\n\nஉதாரணமாக, R15+ ஐத் தேர்ந்தெடுத்தால் R15+ வரையிலான அனைத்து anime-யையும் உங்களுக்குக் காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "TV రేటింగ్‌లు అంచెలవారీగా ఉంటాయి. ఎంచుకున్న TV రేటింగ్‌ను బట్టి కొన్ని షోలు దాచబడవచ్చు.\n\nఉదాహరణకు, R15+ ఎంచుకుంటే R15+ TV రేటింగ్ వరకు ఉన్న anime అన్నీ మీకు చూపిస్తుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-vurderinger er inddelt i niveauer. Afhængigt af den valgte TV-vurdering kan nogle shows være skjult.\n\nVælger du for eksempel R15+, får du vist al anime op til en TV-vurdering på R15+."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-ikärajat ovat porrastettuja. Valitun TV-ikärajan mukaan jotkin sarjat saattavat olla piilotettuna.\n\nEsimerkiksi R15+ valitsemalla näet kaikki animet TV-ikärajaan R15+ asti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korhatár-besorolások szintekbe vannak sorolva. A választott besorolástól függően egyes sorozatok rejtve maradhatnak.\n\nPéldául az R15+ kiválasztásával minden, legfeljebb R15+ besorolású anime látható lesz."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-aldersgrenser er inndelt i nivåer. Avhengig av valgt TV-aldersgrense kan enkelte serier være skjult.\n\nFor eksempel vil valg av R15+ vise deg all anime opp til en TV-aldersgrense på R15+."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As classificações etárias são escalonadas. Consoante a classificação escolhida, algumas séries poderão ficar ocultas.\n\nPor exemplo, ao selecionar R15+, verás todos os anime até à classificação R15+."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TV ریٹنگز درجہ بندی شدہ ہیں۔ منتخب کردہ TV ریٹنگ کے مطابق کچھ shows چھپ سکتے ہیں۔\n\nمثال کے طور پر، R15+ منتخب کرنے سے آپ کو R15+ تک کی تمام anime دکھائی دیں گی۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "TV վարկանիշները աստիճանակարգված են։ Կախված ընտրված TV վարկանիշից՝ որոշ ֆիլմեր կարող են թաքնված լինել։\n\nՕրինակ՝ R15+ ընտրելը ձեզ ցույց կտա բոլոր anime-ները մինչև R15+ TV վարկանիշը։"
          }
        }
      }
    },
    "Type": {
      "comment": "The column header for the item's media type in the library table layout.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        },
        "ar": {
          "stringUnit": {

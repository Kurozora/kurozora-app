          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু নিশ্চিত হতে, তুমি কি ‘%@’ চেয়েছিলে?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen pro potvrzení, chtěl jsi ‚%@‘?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare for at bekræfte, du mente ‘%@’?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur zur Sicherheit, du wolltest ‘%@’?"
          }

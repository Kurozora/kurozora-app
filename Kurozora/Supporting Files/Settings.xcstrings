    "Require authentication to unlock the app and choose how frequently you need to verify your identity.": {
      "comment": "A short description for the authentication settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereis verificatie om de app te ontgrendelen en kies hoe vaak u uw identiteit moet bevestigen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب المصادقة لإلغاء قفل التطبيق، واختر عدد مرات التحقق من هويتك."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere autenticación para desbloquear la app y elija con qué frecuencia debe verificar su identidad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajibkan autentikasi untuk membuka aplikasi dan pilih seberapa sering Anda perlu memverifikasi identitas Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのロック解除に認証を必要とし、本人確認の頻度を選択できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exija autenticação para desbloquear o app e escolha com que frequência você precisa verificar sua identidade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordern Sie eine Authentifizierung zum Entsperren der App und legen Sie fest, wie häufig Sie Ihre Identität bestätigen müssen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigez une authentification pour déverrouiller l’app et choisissez la fréquence à laquelle vous devez vérifier votre identité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi l'autenticazione per sbloccare l'app e scegli con quale frequenza è necessario verificare la propria identità."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잠금 해제 시 인증을 요구하고, 본인 확인이 필요한 빈도를 선택하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagaj uwierzytelnienia do odblokowania aplikacji i wybierz, jak często należy potwierdzać tożsamość."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуйте аутентификацию для разблокировки приложения и выберите, как часто нужно подтверждать вашу личность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求验证身份以解锁 App，并选择需要验证身份的频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求驗證以解鎖應用程式，並選擇需要驗證身分的頻率。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดให้ต้องยืนยันตัวตนเพื่อปลดล็อกแอป และเลือกความถี่ในการยืนยันตัวตนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın kilidini açmak için kimlik doğrulama gerektirin ve kimliğinizi ne sıklıkta doğrulamanız gerektiğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагайте автентифікацію для розблокування застосунку та оберіть, як часто потрібно підтверджувати свою особу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu xác thực để mở khóa ứng dụng và chọn tần suất bạn cần xác minh danh tính."
          }
        }
      }
    },
    "Restore Purchase": {
      "comment": "The string for the 'Restore Purchase' settings option.",
      "localizations": {
        "nl": {

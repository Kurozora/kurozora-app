        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere as preferências de notificações na app, incluindo sons, emblemas e a forma como as notificações são agrupadas."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կառավարիր հավելվածի ներսում ծանուցումների նախապատվությունները, ներառյալ ձայներն ու կրծքանշանները և այն, թե ինչպես են ծանուցումները խմբավորվում միմյանց հետ։"
          }
        }
      }
    },
    "Manage your app experience by clearing temporary files, downloaded content, and cached media used for faster loading and offline viewing.": {
      "comment": "A short description for the cache settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer je app-ervaring door tijdelijke bestanden, gedownloade inhoud en media in de cache te wissen die worden gebruikt voor sneller laden en offline kijken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر تجربتك في التطبيق عبر مسح الملفات المؤقتة والمحتوى المُنزّل والوسائط المخزّنة مؤقتًا المستخدمة لتحميل أسرع ومشاهدة دون اتصال."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra tu experiencia en la app borrando archivos temporales, contenido descargado y contenido en caché que se usa para cargar más rápido y ver sin conexión."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola pengalaman aplikasimu dengan membersihkan berkas sementara, konten yang diunduh, dan media tersimpan yang dipakai agar pemuatan lebih cepat dan dapat ditonton luring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みの高速化やオフライン視聴に使われる一時ファイル、ダウンロード済みコンテンツ、キャッシュされたメディアを消去して、アプリの使い心地を整えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie sua experiência no app limpando arquivos temporários, conteúdos baixados e mídias em cache usadas para carregar mais rápido e ver offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte dein App-Erlebnis, indem du temporäre Dateien, heruntergeladene Inhalte und zwischengespeicherte Medien löschst, die für schnelleres Laden und die Offline-Wiedergabe genutzt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gère ton expérience de l’app en effaçant les fichiers temporaires, le contenu téléchargé et les médias en cache utilisés pour un chargement plus rapide et une lecture hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci la tua esperienza nell'app cancellando i file temporanei, i contenuti scaricati e i media in cache usati per un caricamento più rapido e la visione offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠른 로딩과 오프라인 시청에 쓰이는 임시 파일, 다운로드한 콘텐츠, 캐시된 미디어를 지워 앱 사용 환경을 관리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj działaniem aplikacji, czyszcząc pliki tymczasowe, pobraną zawartość i zbuforowane media, które przyspieszają wczytywanie i umożliwiają przeglądanie offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляй работой приложения, очищая временные файлы, загруженный контент и кэшированные медиа, которые ускоряют загрузку и просмотр офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过清除临时文件、已下载内容以及用于加快加载和离线观看的缓存媒体，管理你的 App 体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除暫存檔案、已下載內容，以及用於加速載入與離線觀看的快取媒體，藉此管理你的應用程式使用體驗。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการประสบการณ์การใช้แอปด้วยการล้างไฟล์ชั่วคราว เนื้อหาที่ดาวน์โหลด และสื่อในแคชที่ใช้เพื่อให้โหลดเร็วขึ้นและดูแบบออฟไลน์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hızlı yükleme ve çevrimdışı izleme için kullanılan geçici dosyaları, indirilen içeriği ve önbelleğe alınmış medyayı temizleyerek uygulama deneyimini yönet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуй роботою застосунку, очищаючи тимчасові файли, завантажений вміст і кешовані медіа, що використовуються для швидшого завантаження й перегляду офлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý trải nghiệm ứng dụng bằng cách xóa tệp tạm, nội dung đã tải về và nội dung lưu đệm được dùng để tải nhanh hơn và xem ngoại tuyến."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona tu experiencia en la app borrando los archivos temporales, el contenido descargado y los medios en caché que se usan para cargar más rápido y ver sin conexión."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamahalaan ang iyong karanasan sa app sa pamamagitan ng pag-clear ng mga temporary file, downloaded content, at cached media na ginagamit para sa mas mabilis na pag-load at offline viewing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़ लोडिंग और ऑफ़लाइन देखने के लिए इस्तेमाल होने वाली अस्थायी फ़ाइलें, डाउनलोड किया गया कंटेंट और कैश की गई मीडिया को मिटाकर अपने ऐप अनुभव को प्रबंधित करो।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تجربهٔ برنامه‌ات را با پاک کردن فایل‌های موقت، محتوای دانلودشده و رسانهٔ ذخیره‌شده برای بارگذاری سریع‌تر و تماشای آفلاین مدیریت کن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נהל את חוויית האפליקציה שלך על ידי ניקוי קבצים זמניים, תוכן שהורד ומדיה במטמון המשמשים לטעינה מהירה יותר ולצפייה במצב לא מקוון."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus pengalaman apl anda dengan mengosongkan fail sementara, kandungan yang dimuat turun dan media cache yang digunakan untuk pemuatan lebih pantas dan tontonan luar talian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionează experiența aplicației ștergând fișierele temporare, conținutul descărcat și media din cache folosite pentru încărcare mai rapidă și vizionare offline."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera din appupplevelse genom att rensa tillfälliga filer, nedladdat innehåll och cachat material som används för snabbare inläsning och visning offline."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spravuj svůj zážitek z aplikace mazáním dočasných souborů, stažených dat a uložených médií, která slouží k rychlejšímu načítání a sledování offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαχειρίσου την εμπειρία της εφαρμογής σου διαγράφοντας προσωρινά αρχεία, ληφθέν περιεχόμενο και αποθηκευμένα μέσα που χρησιμοποιούνται για πιο γρήγορη φόρτωση και προβολή εκτός σύνδεσης."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত লোডিং ও অফলাইন ভিউয়িংয়ের জন্য ব্যবহৃত অস্থায়ী ফাইল, ডাউনলোড করা কনটেন্ট এবং ক্যাশ করা মিডিয়া মুছে ফেলে তোমার অ্যাপ অভিজ্ঞতা পরিচালনা করো।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேகமான ஏற்றுதல் மற்றும் ஆஃப்லைன் பார்வைக்காகப் பயன்படுத்தப்படும் தற்காலிக கோப்புகள், பதிவிறக்கிய உள்ளடக்கம் மற்றும் கேஷ் செய்யப்பட்ட மீடியாவை அழிப்பதன் மூலம் உங்கள் ஆப் அனுபவத்தை நிர்வகிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేగంగా లోడ్ అవ్వడానికి, ఆఫ్‌లైన్‌లో చూడటానికి వాడే తాత్కాలిక ఫైల్‌లు, డౌన్‌లోడ్ చేసిన కంటెంట్, కేష్ చేసిన మీడియాని క్లియర్ చేసి మీ యాప్ అనుభవాన్ని నిర్వహించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrér din appoplevelse ved at rydde midlertidige filer, downloadet indhold og cachede medier, der bruges til hurtigere indlæsning og offline-visning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse sovelluskokemustasi tyhjentämällä väliaikaiset tiedostot, ladatun sisällön ja välimuistiin tallennetun median, joita käytetään nopeampaan lataukseen ja offline-katseluun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezeld az app élményét az ideiglenes fájlok, a letöltött tartalmak és a gyorsabb betöltéshez és offline megtekintéshez tárolt média törlésével."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr appopplevelsen din ved å tømme midlertidige filer, nedlastet innhold og bufret media som brukes til raskere lasting og frakoblet visning."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عارضی فائلیں، ڈاؤن لوڈ شدہ مواد، اور تیز لوڈنگ اور آف لائن دیکھنے کے لیے استعمال ہونے والے کیش شدہ میڈیا کو صاف کر کے اپنے ایپ کے تجربے کا انتظام کرو۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere a tua experiência na app limpando ficheiros temporários, conteúdo transferido e ficheiros em cache usados para carregamentos mais rápidos e visualização offline."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կառավարիր հավելվածի աշխատանքը՝ մաքրելով ժամանակավոր ֆայլերը, ներբեռնված բովանդակությունն ու քեշավորված մեդիան, որոնք օգտագործվում են ավելի արագ բեռնման և անցանց դիտման համար։"
          }
        }
      }
    },

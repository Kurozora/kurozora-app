    "Reduce the intensity of animations, and motion effects throughout Kurozora.": {
      "comment": "The footer string for the 'Reduce Motion' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder de intensiteit van animaties en bewegingseffecten in heel Kurozora."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قلّل من شدة الرسوم المتحركة ومؤثرات الحركة في جميع أنحاء Kurozora."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la intensidad de las animaciones y los efectos de movimiento en todo Kurozora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangi intensitas animasi dan efek gerakan di seluruh Kurozora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora 全体のアニメーションや視差効果の強さを抑えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza a intensidade das animações e dos efeitos de movimento em todo o Kurozora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduziere die Intensität von Animationen und Bewegungseffekten in ganz Kurozora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit l’intensité des animations et des effets de mouvement dans tout Kurozora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci l'intensità delle animazioni e degli effetti di movimento in tutta Kurozora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora 전체의 애니메이션과 동작 효과의 강도를 줄여보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz intensywność animacji i efektów ruchu w całej aplikacji Kurozora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшай интенсивность анимаций и эффектов движения по всему Kurozora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱整个 Kurozora 中的动画和动态效果的强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "降低 Kurozora 中各處動畫與動態效果的強度。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดความเข้มข้นของแอนิเมชันและเอฟเฟกต์การเคลื่อนไหวทั่วทั้ง Kurozora"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora genelindeki animasyonların ve hareket efektlerinin yoğunluğunu azalt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшуй інтенсивність анімацій і ефектів руху по всьому Kurozora."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm cường độ hoạt ảnh và hiệu ứng chuyển động trong toàn bộ Kurozora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce la intensidad de las animaciones y los efectos de movimiento en todo Kurozora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawasan ang lakas ng mga animation, at motion effect sa buong Kurozora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे Kurozora में एनिमेशन और मोशन इफेक्ट्स की तीव्रता को कम करो।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شدت انیمیشن‌ها و جلوه‌های حرکتی را در سراسر Kurozora کاهش بده."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפחת את עוצמת האנימציות ואפקטי התנועה בכל Kurozora."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurangkan keamatan animasi dan kesan gerakan di seluruh Kurozora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce intensitatea animațiilor și a efectelor de mișcare din tot Kurozora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minska intensiteten på animationer och rörelseeffekter i hela Kurozora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sniž intenzitu animací a pohybových efektů v celé Kurozoře."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείωσε την ένταση των κινούμενων γραφικών και των εφέ κίνησης σε όλο το Kurozora."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora জুড়ে অ্যানিমেশন এবং মোশন এফেক্টের তীব্রতা কমাও।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora முழுவதும் உள்ள அனிமேஷன்கள் மற்றும் இயக்க விளைவுகளின் தீவிரத்தைக் குறைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora అంతటా యానిమేషన్‌లు, మోషన్ ఎఫెక్ట్‌ల తీవ్రతను తగ్గించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducér intensiteten af animationer og bevægelseseffekter i hele Kurozora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähennä animaatioiden ja liike-efektien voimakkuutta kaikkialla Kurozorassa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csökkentsd az animációk és a mozgáseffektek erősségét a Kurozorában."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduser intensiteten på animasjoner og bevegelseseffekter i hele Kurozora."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پورے Kurozora میں اینیمیشنز اور موشن ایفیکٹس کی شدت کم کرو۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz a intensidade das animações e dos efeitos de movimento em todo o Kurozora."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նվազեցրու անիմացիաների և շարժման էֆեկտների ինտենսիվությունը ողջ Kurozora-ում։"
          }
        }
      }
    },

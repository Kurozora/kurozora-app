    "Automatically transition appearance between light and dark based on time preference." : {
      "comment" : "The footer for the appearance schedule option.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل تلقائيًا بين المظهر الفاتح والداكن بناءً على تفضيل الوقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সময়ের পছন্দ অনুযায়ী লাইট ও ডার্কের মধ্যে অ্যাপিয়ারেন্স স্বয়ংক্রিয়ভাবে পরিবর্তন করো।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky přepínej vzhled mezi světlým a tmavým podle nastaveného času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift automatisk udseende mellem lyst og mørkt baseret på tidspræference."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle das Erscheinungsbild automatisch zwischen Hell und Dunkel je nach Zeiteinstellung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάζει αυτόματα την εμφάνιση μεταξύ φωτεινής και σκοτεινής με βάση την προτίμηση ώρας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia automáticamente entre apariencia clara y oscura según tu preferencia horaria."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia automáticamente la apariencia entre claro y oscuro según tu preferencia de horario."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظاهر را به‌صورت خودکار بر اساس ترجیح زمانی بین روشن و تیره تغییر بده."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda ulkoasua automaattisesti vaalean ja tumman välillä valitun ajan mukaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awtomatikong lumipat ang itsura sa pagitan ng light at dark batay sa napiling oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bascule automatiquement l’apparence entre clair et sombre selon ta préférence horaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעבר אוטומטי במראה בין בהיר לכהה לפי העדפת השעה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय की पसंद के आधार पर रूप-रंग को लाइट और डार्क के बीच अपने आप बदलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megjelenés automatikus váltása világos és sötét között az időbeállítás alapján."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ինքնաշխատ կերպով անցիր լուսավորից մութ տեսքի և հակառակը՝ ըստ ժամի նախապատվության։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatis beralih tampilan antara terang dan gelap berdasarkan preferensi waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa automaticamente l'aspetto tra chiaro e scuro in base alla preferenza oraria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間設定に応じて、ライトとダークの外観を自動で切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정한 시간에 따라 라이트와 다크 모드를 자동으로 전환합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beralih penampilan secara automatik antara cerah dan gelap berdasarkan keutamaan masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt automatisk mellom lyst og mørkt utseende basert på tidspreferansen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel automatisch tussen licht en donker op basis van je tijdsvoorkeur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie przełączaj wygląd między jasnym a ciemnym w zależności od ustawień czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne a aparência entre claro e escuro automaticamente conforme a preferência de horário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna automaticamente o aspeto entre claro e escuro consoante a preferência horária."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treci automat aspectul între luminos și întunecat în funcție de preferința de timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически переключай светлый и тёмный вид в зависимости от выбранного времени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Växla automatiskt utseende mellan ljust och mörkt baserat på tidsinställning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நேர விருப்பத்தின் அடிப்படையில் ஒளி மற்றும் இருளுக்கு இடையே தோற்றத்தைத் தானாகவே மாற்று."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సమయ ప్రాధాన్యత ఆధారంగా లైట్, డార్క్ మధ్య రూపాన్ని ఆటోమేటిక్‌గా మార్చుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สลับรูปลักษณ์ระหว่างสว่างและมืดโดยอัตโนมัติตามเวลาที่ตั้งไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünümü, zaman tercihine göre açık ve koyu arasında otomatik olarak geçir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично перемикай вигляд між світлим і темним залежно від часу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقت کی ترجیح کی بنیاد پر ظاہری شکل خود بخود روشن اور تاریک کے درمیان تبدیل کرو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động chuyển giao diện giữa sáng và tối dựa trên tùy chọn thời gian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据时间偏好在浅色与深色外观之间自动切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依時間偏好自動在淺色與深色外觀之間切換。"
          }
        }
      }
    },
    "Beginnings and endings of songs blend together seamlessly. Albums and some genres will still play without transitions. Unavailable while using AirPlay." : {
      "comment" : "The footer describing the song transitions setting.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تندمج بدايات الأغاني ونهاياتها معًا بسلاسة. ستظل الألبومات وبعض الأنواع تُشغَّل بدون انتقالات. غير متوفّر أثناء استخدام AirPlay."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গানের শুরু আর শেষ মসৃণভাবে একে অপরের সাথে মিশে যায়। অ্যালবাম আর কিছু ঘরানার গান তবুও ট্রানজিশন ছাড়াই বাজবে। AirPlay ব্যবহারের সময় এটি পাওয়া যাবে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začátky a konce skladeb se plynule prolínají. Alba a některé žánry se budou přehrávat bez přechodů. Nedostupné při použití AirPlay."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanges begyndelser og slutninger smelter problemfrit sammen. Album og nogle genrer afspilles stadig uden overgange. Ikke tilgængelig ved brug af AirPlay."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfänge und Enden von Songs gehen nahtlos ineinander über. Alben und einige Genres werden weiterhin ohne Übergänge abgespielt. Bei Verwendung von AirPlay nicht verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αρχές και τα τέλη των τραγουδιών αναμειγνύονται απρόσκοπτα. Τα άλμπουμ και ορισμένα είδη θα εξακολουθούν να παίζουν χωρίς μεταβάσεις. Μη διαθέσιμο κατά τη χρήση του AirPlay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los principios y los finales de las canciones se funden a la perfección. Los álbumes y algunos géneros se seguirán reproduciendo sin transiciones. No disponible al usar AirPlay."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los inicios y finales de las canciones se combinan sin interrupciones. Los álbumes y algunos géneros se seguirán reproduciendo sin transiciones. No disponible al usar AirPlay."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آغاز و پایان آهنگ‌ها به‌طور یکپارچه در هم محو می‌شوند. آلبوم‌ها و برخی ژانرها همچنان بدون گذار پخش می‌شوند. هنگام استفاده از AirPlay در دسترس نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kappaleiden alut ja loput sulautuvat saumattomasti yhteen. Albumit ja jotkin genret toistetaan silti ilman siirtymiä. Ei käytettävissä AirPlayta käytettäessä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang putol na nagsasama ang simula at dulo ng mga kanta. May mga album at ilang genre na tutugtog pa rin nang walang transition. Hindi available habang gumagamit ng AirPlay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le début et la fin des morceaux se fondent en douceur. Les albums et certains genres seront toujours lus sans transition. Indisponible lors de l'utilisation d'AirPlay."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתחלות והסיומים של השירים משתלבים זה בזה בצורה חלקה. אלבומים וחלק מהז'אנרים עדיין יושמעו ללא מעברים. לא זמין בזמן השימוש ב-AirPlay."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गानों की शुरुआत और अंत आपस में सहजता से घुल-मिल जाते हैं। एल्बम और कुछ शैलियाँ फिर भी बिना ट्रांज़िशन के चलेंगी। AirPlay इस्तेमाल करते समय उपलब्ध नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dalok eleje és vége zökkenőmentesen összeolvad. Az albumok és néhány műfaj továbbra is átmenetek nélkül szól. AirPlay használata közben nem érhető el."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Երգերի սկիզբն ու վերջը սահուն ձուլվում են իրար։ Ալբոմները և որոշ ժանրեր այնուամենայնիվ կնվագարկվեն առանց անցումների։ Անհասանելի է AirPlay-ն օգտագործելիս։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awal dan akhir lagu menyatu dengan mulus. Album dan beberapa genre tetap diputar tanpa transisi. Tidak tersedia saat menggunakan AirPlay."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inizio e la fine dei brani si fondono senza interruzioni. Gli album e alcuni generi verranno comunque riprodotti senza transizioni. Non disponibile durante l'uso di AirPlay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲の始まりと終わりが滑らかに重なり合います。アルバムや一部のジャンルではトランジションなしで再生されます。AirPlayの使用中は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노래의 시작과 끝이 자연스럽게 어우러져요. 앨범과 일부 장르는 전환 없이 재생돼요. AirPlay 사용 중에는 사용할 수 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permulaan dan penghujung lagu bergabung dengan lancar. Album dan sesetengah genre masih akan dimainkan tanpa peralihan. Tidak tersedia semasa menggunakan AirPlay."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynnelsen og slutten på sanger går sømløst over i hverandre. Album og noen sjangre spilles fortsatt uten overganger. Utilgjengelig når du bruker AirPlay."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin en einde van nummers vloeien naadloos in elkaar over. Albums en sommige genres worden nog steeds zonder overgang afgespeeld. Niet beschikbaar tijdens AirPlay."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Początki i końce utworów płynnie się przenikają. Albumy i niektóre gatunki będą nadal odtwarzane bez przejść. Niedostępne podczas korzystania z AirPlay."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os inícios e finais das músicas se misturam perfeitamente. Álbuns e alguns gêneros ainda serão reproduzidos sem transições. Indisponível ao usar o AirPlay."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O início e o fim das músicas fundem-se sem interrupções. Os álbuns e alguns géneros continuam a tocar sem transições. Indisponível ao utilizar o AirPlay."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Începuturile și sfârșiturile melodiilor se îmbină perfect. Albumele și unele genuri se vor reda în continuare fără tranziții. Indisponibil când folosești AirPlay."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало и конец песен плавно перетекают друг в друга. Альбомы и некоторые жанры всё равно воспроизводятся без переходов. Недоступно при использовании AirPlay."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Början och slut på låtar smälter samman sömlöst. Album och vissa genrer spelas fortfarande upp utan övergångar. Inte tillgängligt när du använder AirPlay."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாடல்களின் தொடக்கமும் முடிவும் தடையின்றி ஒன்றாகக் கலக்கும். ஆல்பங்களும் சில வகைகளும் இருப்பினும் மாற்றங்கள் இல்லாமல் இயங்கும். AirPlay பயன்படுத்தும்போது இது கிடைக்காது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పాటల మొదళ్లు, ముగింపులు సజావుగా ఒకదానితో ఒకటి కలిసిపోతాయి. ఆల్బమ్‌లు, కొన్ని శైలులు మాత్రం ట్రాన్సిషన్‌లు లేకుండానే ప్లే అవుతాయి. AirPlay ఉపయోగిస్తున్నప్పుడు అందుబాటులో ఉండదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จุดเริ่มต้นและจุดจบของเพลงจะผสมกลมกลืนกันอย่างไร้รอยต่อ อัลบั้มและบางแนวเพลงจะยังคงเล่นโดยไม่มีการเปลี่ยนผ่าน ใช้งานไม่ได้ขณะใช้ AirPlay"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarkıların başları ve sonları kusursuzca birbirine karışır. Albümler ve bazı türler yine de geçişsiz çalar. AirPlay kullanılırken kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Початок і кінець пісень плавно зливаються. Альбоми та деякі жанри все одно відтворюватимуться без переходів. Недоступно під час використання AirPlay."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گانوں کے آغاز اور اختتام بغیر کسی رکاوٹ کے آپس میں گھل مل جاتے ہیں۔ البمز اور کچھ اصناف پھر بھی بغیر ٹرانزیشن کے چلیں گے۔ AirPlay استعمال کرتے وقت دستیاب نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần đầu và phần cuối của các bài hát hòa quyện liền mạch vào nhau. Album và một số thể loại vẫn sẽ phát mà không có hiệu ứng chuyển tiếp. Không khả dụng khi dùng AirPlay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌曲的开头和结尾会无缝融合。专辑和部分风格仍会在没有过渡的情况下播放。使用 AirPlay 时不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌曲的開頭與結尾會無縫融合。專輯和部分類型仍會在沒有轉換效果的情況下播放。使用 AirPlay 時無法使用。"
          }
        }
      }
    },

        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کرو کہ اپنی Kurozora یاد دہانیوں کو کہاں سبسکرائب کرنا ہے۔ اگر منتخب شدہ ایپ انسٹال نہیں ہے تو لنک متبادل کے طور پر Safari میں کھلے گا۔"

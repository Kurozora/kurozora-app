    "Themes are not available at this moment. Please check back again later.": {
      "comment": "The empty-state detail shown when no themes are available in the theme store.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thema's zijn op dit moment niet beschikbaar. Kom later terug."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السمات غير متوفرة في الوقت الحالي. يُرجى المحاولة لاحقًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas no están disponibles en este momento. Vuelve a intentarlo más tarde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema tidak tersedia saat ini. Silakan periksa kembali nanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、利用できるテーマはありません。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas não estão disponíveis no momento. Volte a conferir mais tarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Themes sind derzeit nicht verfügbar. Schau später noch mal vorbei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les thèmes ne sont pas disponibles pour le moment. Reviens un peu plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi non sono disponibili al momento. Riprova più tardi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 사용할 수 있는 테마가 없습니다. 나중에 다시 확인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Motywy są w tej chwili niedostępne. Zajrzyj ponownie później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темы сейчас недоступны. Загляни попозже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前暂无可用主题，请稍后再来查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可用的佈景主題，請稍後再回來看看。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ยังไม่มีธีมให้ใช้งาน กรุณากลับมาตรวจสอบอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda tema mevcut değil. Lütfen daha sonra tekrar kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз теми недоступні. Будь ласка, зайди пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa có giao diện nào. Vui lòng quay lại sau nhé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas no están disponibles en este momento. Vuelve a comprobarlo más tarde."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang available na theme sa ngayon. Pakitingnan na lang muli mamaya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय कोई थीम उपलब्ध नहीं है। कृपया बाद में फिर देखें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوسته‌ها در حال حاضر در دسترس نیستند. لطفاً بعداً دوباره سر بزنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין ערכות נושא זמינות כרגע. נסו שוב מאוחר יותר."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema tidak tersedia buat masa ini. Sila semak semula kemudian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Temele nu sunt disponibile momentan. Te rugăm să revii mai târziu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga teman är tillgängliga just nu. Kom tillbaka senare."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Motivy nejsou momentálně k dispozici. Zkus to prosím později."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν διαθέσιμα θέματα αυτή τη στιγμή. Ξαναέλεγξε αργότερα."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে কোনো থিম পাওয়া যাচ্ছে না। অনুগ্রহ করে কিছুক্ষণ পরে আবার দেখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தருணத்தில் கருப்பொருள்கள் கிடைக்கவில்லை. தயவுசெய்து பிறகு மீண்டும் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం థీమ్‌లు అందుబాటులో లేవు. దయచేసి కాసేపటి తర్వాత మళ్ళీ చూడండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer er ikke tilgængelige lige nu. Kig forbi igen senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teemoja ei ole juuri nyt saatavilla. Tarkista tilanne myöhemmin uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A témák jelenleg nem érhetők el. Nézz vissza később."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Temaer er ikke tilgjengelige akkurat nå. Sjekk tilbake igjen senere."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت کوئی تھیم دستیاب نہیں ہے۔ براہِ کرم بعد میں دوبارہ دیکھیں۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas não estão disponíveis de momento. Volta a verificar mais tarde."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թեմաներն այս պահին հասանելի չեն։ Խնդրում ենք ստուգել ավելի ուշ։"
          }
        }
      }
    },
    "This will send you to Kurozora's privacy settings in the Settings app where you can adjust the app's permissions.": {
      "comment": "The footer for the privacy settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit brengt u naar de privacyinstellingen van Kurozora in de app Instellingen, waar u de machtigingen van de app kunt aanpassen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينقلك هذا إلى إعدادات خصوصية Kurozora في تطبيق الإعدادات حيث يمكنك تعديل أذونات التطبيق."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto te llevará a la configuración de privacidad de Kurozora en la app Configuración, donde puedes ajustar los permisos de la app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengarahkan Anda ke pengaturan privasi Kurozora di aplikasi Pengaturan, tempat Anda dapat menyesuaikan izin aplikasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」App内のKurozoraのプライバシー設定に移動します。そこでAppの権限を調整できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso levará você às configurações de privacidade do Kurozora no app Ajustes, onde você pode ajustar as permissões do app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies leitet Sie zu den Datenschutzeinstellungen von Kurozora in der App „Einstellungen“ weiter, wo Sie die Berechtigungen der App anpassen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez redirigé vers les réglages de confidentialité de Kurozora dans l’app Réglages, où vous pourrez ajuster les autorisations de l’application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrai indirizzato alle impostazioni sulla privacy di Kurozora nell'app Impostazioni, dove puoi modificare le autorizzazioni dell'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 앱의 Kurozora 개인정보 보호 설정으로 이동하며, 그곳에서 앱 권한을 조정할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to przejście do ustawień prywatności Kurozora w aplikacji Ustawienia, gdzie możesz dostosować uprawnienia aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроется раздел настроек конфиденциальности Kurozora в приложении «Настройки», где можно изменить разрешения приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将带你前往“设置”应用中 Kurozora 的隐私设置，你可以在那里调整应用的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會將您帶往「設定」App 中 Kurozora 的隱私權設定，您可以在此調整 App 的權限。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะนำคุณไปยังการตั้งค่าความเป็นส่วนตัวของ Kurozora ในแอปการตั้งค่า ซึ่งคุณสามารถปรับสิทธิ์การเข้าถึงของแอปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem sizi Ayarlar uygulamasındaki Kurozora gizlilik ayarlarına yönlendirir; burada uygulamanın izinlerini düzenleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відкриє налаштування конфіденційності Kurozora в застосунку «Параметри», де ви можете змінити дозволи застосунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ đưa bạn đến phần cài đặt quyền riêng tư của Kurozora trong ứng dụng Cài đặt, nơi bạn có thể điều chỉnh quyền của ứng dụng."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto te llevará a los ajustes de privacidad de Kurozora en la app Ajustes, donde puedes modificar los permisos de la app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadalhin ka nito sa privacy settings ng Kurozora sa Settings app kung saan maaari mong i-adjust ang mga pahintulot ng app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आप Settings ऐप में Kurozora की गोपनीयता सेटिंग्स पर पहुँच जाएँगे, जहाँ आप ऐप की अनुमतियाँ समायोजित कर सकते हैं।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار شما را به تنظیمات حریم خصوصی Kurozora در برنامهٔ تنظیمات می‌برد، جایی که می‌توانید مجوزهای برنامه را تنظیم کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תעביר אתכם אל הגדרות הפרטיות של Kurozora באפליקציית ההגדרות, שם תוכלו לשנות את ההרשאות של האפליקציה."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan membawa anda ke tetapan privasi Kurozora dalam aplikasi Tetapan, tempat anda boleh melaraskan kebenaran aplikasi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta vă va duce la setările de confidențialitate ale Kurozora din aplicația Setări, unde puteți ajusta permisiunile aplicației."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar dig till Kurozoras integritetsinställningar i appen Inställningar, där du kan justera appens behörigheter."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto přejdete do nastavení soukromí Kurozory v aplikaci Nastavení, kde můžete upravit oprávnění aplikace."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα μεταφερθείτε στις ρυθμίσεις απορρήτου του Kurozora στην εφαρμογή Ρυθμίσεις, όπου μπορείτε να προσαρμόσετε τα δικαιώματα της εφαρμογής."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনাকে Settings অ্যাপে Kurozora-এর প্রাইভেসি সেটিংসে নিয়ে যাবে, যেখানে আপনি অ্যাপের অনুমতিগুলো সমন্বয় করতে পারবেন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது உங்களை Settings ஆப்பில் உள்ள Kurozora-வின் தனியுரிமை அமைப்புகளுக்கு அழைத்துச் செல்லும், அங்கு நீங்கள் ஆப்பின் அனுமதிகளைச் சரிசெய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మిమ్మల్ని Settings యాప్‌లోని Kurozora గోప్యతా సెట్టింగ్‌లకు తీసుకువెళ్తుంది, అక్కడ మీరు యాప్ అనుమతులను సర్దుబాటు చేయవచ్చు."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sender dig til Kurozoras anonymitetsindstillinger i appen Indstillinger, hvor du kan justere appens tilladelser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vie sinut Kurozoran tietosuoja-asetuksiin Asetukset-sovelluksessa, jossa voit muuttaa sovelluksen käyttöoikeuksia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez átirányít a Kurozora adatvédelmi beállításaihoz a Beállítások appban, ahol módosíthatod az alkalmazás engedélyeit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sender deg til Kurozoras personverninnstillinger i Innstillinger-appen, der du kan justere appens tillatelser."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کو Settings ایپ میں Kurozora کی پرائیویسی سیٹنگز پر لے جائے گا جہاں آپ ایپ کی اجازتیں ایڈجسٹ کر سکتے ہیں۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto irá encaminhá-lo para as definições de privacidade da Kurozora na app Definições, onde poderá ajustar as permissões da app."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ձեզ կտանի Kurozora-ի գաղտնիության կարգավորումները՝ Կարգավորումներ հավելվածում, որտեղ կարող եք փոփոխել հավելվածի թույլտվությունները։"
          }
        }
      }
    },

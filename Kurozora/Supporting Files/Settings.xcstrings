    "Review your privacy settings, manage app permissions in the Settings app, manage blocked accounts, and access legal information.": {
      "comment": "A short description for the privacy settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk uw privacyinstellingen, beheer app-machtigingen in de app Instellingen, beheer geblokkeerde accounts en raadpleeg juridische informatie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع إعدادات الخصوصية الخاصة بك، وأدِر أذونات التطبيق في تطبيق الإعدادات، وأدِر الحسابات المحظورة، واطّلع على المعلومات القانونية."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise su configuración de privacidad, administre los permisos de la app en la app Ajustes, administre las cuentas bloqueadas y acceda a información legal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau pengaturan privasi Anda, kelola izin aplikasi di aplikasi Pengaturan, kelola akun yang diblokir, dan akses informasi hukum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー設定の確認、設定アプリでのアプリ権限の管理、ブロックしたアカウントの管理、法的情報の閲覧ができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise suas configurações de privacidade, gerencie as permissões do app no app Ajustes, gerencie contas bloqueadas e acesse informações legais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre Datenschutzeinstellungen, verwalten Sie App-Berechtigungen in der App „Einstellungen“, verwalten Sie blockierte Accounts und greifen Sie auf rechtliche Informationen zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez vos réglages de confidentialité, gérez les autorisations de l’app dans Réglages, gérez les comptes bloqués et accédez aux informations légales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi le tue impostazioni sulla privacy, gestisci le autorizzazioni dell'app nell'app Impostazioni, gestisci gli account bloccati e accedi alle informazioni legali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 설정을 확인하고, 설정 앱에서 앱 권한을 관리하며, 차단한 계정을 관리하고, 법적 정보를 확인하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj swoje ustawienia prywatności, zarządzaj uprawnieniami aplikacji w aplikacji Ustawienia, zarządzaj zablokowanymi kontami i uzyskaj dostęp do informacji prawnych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите настройки конфиденциальности, управляйте разрешениями приложения в приложении «Настройки», управляйте заблокированными аккаунтами и получите доступ к правовой информации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看你的隐私设置，在“设置”App 中管理 App 权限，管理已屏蔽的账户，并访问法律信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視你的隱私設定、在「設定」App 中管理應用程式權限、管理已封鎖的帳號，並查看法律資訊。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการตั้งค่าความเป็นส่วนตัวของคุณ จัดการสิทธิ์ของแอปในแอปการตั้งค่า จัดการบัญชีที่ถูกบล็อก และเข้าถึงข้อมูลทางกฎหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ayarlarınızı gözden geçirin, Ayarlar uygulamasında uygulama izinlerini yönetin, engellenen hesapları yönetin ve yasal bilgilere erişin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте налаштування конфіденційності, керуйте дозволами застосунку в застосунку Налаштування, керуйте заблокованими обліковими записами та отримуйте доступ до правової інформації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại cài đặt quyền riêng tư, quản lý quyền ứng dụng trong ứng dụng Cài đặt, quản lý các tài khoản bị chặn và truy cập thông tin pháp lý."
          }
        }
      }
    },
    "Rise and shine.": {
      "comment": "The string for day theme description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opstaan en stralen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيقظ وأشرق."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba y a brillar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun dan bersinar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さあ、起きよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorda, dorminhoco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufstehen, die Sonne lacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout, c’est l’heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveglia e in piedi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나 빛날 시간."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobudka!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подъём, солнышко."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床啦，迎接新一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起床囉。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตื่นได้แล้ว สดใสรับวันใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyan ve parla."
          }
        },
        "uk": {

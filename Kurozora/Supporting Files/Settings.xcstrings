    "Disable this option if you hate the large titles in the navigation bar #annoying #too_ugly_for_me": {
      "comment": "The footer for the large titles option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel deze optie uit als je de grote titels in de navigatiebalk haat #irritant #te_lelijk_voor_mij"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عطّل هذا الخيار إذا كنت تكره العناوين الكبيرة في شريط التنقل #مزعج #too_ugly_for_me"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva esta opción si odias los títulos grandes en la barra de navegación #molesto #demasiado_feo_para_mí"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan opsi ini kalau kamu benci judul besar di bilah navigasi #annoying #too_ugly_for_me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションバーの大きなタイトルが嫌いならこのオプションをオフにしてね #うざい #too_ugly_for_me"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative esta opção se você odeia os títulos grandes na barra de navegação #irritante #feio_demais_pra_mim"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere diese Option, wenn du die großen Titel in der Navigationsleiste hasst #nervig #too_ugly_for_me"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive cette option si tu détestes les grands titres dans la barre de navigation #agaçant #trop_moche_pour_moi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa opzione se odi i titoli grandi nella barra di navigazione #fastidioso #troppo_brutto_per_me"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내비게이션 바의 큰 제목이 싫다면 이 옵션을 꺼주세요 #짜증나 #too_ugly_for_me"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz tę opcję, jeśli nie znosisz dużych tytułów na pasku nawigacji #irytujące #zbyt_brzydkie_dla_mnie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключи эту опцию, если терпеть не можешь крупные заголовки в панели навигации #бесит #слишком_уродливо_для_меня"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你讨厌导航栏里的大标题，就关掉这个选项吧 #annoying #too_ugly_for_me"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你討厭導覽列上的大標題，就關掉這個選項吧 #annoying #too_ugly_for_me"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดตัวเลือกนี้ถ้าคุณเกลียดหัวข้อตัวใหญ่ในแถบนำทาง #annoying #too_ugly_for_me"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezinme çubuğundaki büyük başlıklardan nefret ediyorsan bu seçeneği kapat #rahatsız_edici #too_ugly_for_me"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкни цей параметр, якщо терпіти не можеш великі заголовки в панелі навігації #дратує #занадто_потворно_для_мене"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt tùy chọn này nếu bạn ghét tiêu đề lớn trên thanh điều hướng #annoying #too_ugly_for_me"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva esta opción si odias los títulos grandes de la barra de navegación #molesto #demasiado_feo_para_mí"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-disable ang opsyong ito kung galit ka sa malalaking title sa navigation bar #annoying #too_ugly_for_me"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर तुम्हें नेविगेशन बार में बड़े शीर्षक पसंद नहीं हैं तो इस विकल्प को बंद कर दो #annoying #too_ugly_for_me"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر از عنوان‌های بزرگ در نوار ناوبری بدت می‌آید این گزینه را غیرفعال کن #annoying #too_ugly_for_me"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבה את האפשרות הזו אם אתה שונא את הכותרות הגדולות בסרגל הניווט #מעצבן #מכוער_מדי_בשבילי"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan pilihan ini jika anda benci tajuk besar dalam bar navigasi #annoying #too_ugly_for_me"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivează această opțiune dacă urăști titlurile mari din bara de navigare #enervant #too_ugly_for_me"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av det här alternativet om du hatar de stora rubrikerna i navigeringsfältet #irriterande #too_ugly_for_me"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhle možnost vypni, jestli nesnášíš velké nadpisy v navigačním panelu #otravné #too_ugly_for_me"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποίησε αυτήν την επιλογή αν μισείς τους μεγάλους τίτλους στη μπάρα πλοήγησης #annoying #too_ugly_for_me"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেভিগেশন বারে বড় টাইটেল তোমার অপছন্দ হলে এই অপশনটি বন্ধ করে দাও #annoying #too_ugly_for_me"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழிசெலுத்தல் பட்டியில் உள்ள பெரிய தலைப்புகளை வெறுக்கிறீர்கள் எனில் இந்த விருப்பத்தை முடக்கவும் #annoying #too_ugly_for_me"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నావిగేషన్ బార్‌లోని పెద్ద టైటిల్స్ నచ్చకపోతే ఈ ఆప్షన్‌ని ఆఫ్ చేయండి #annoying #too_ugly_for_me"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå denne indstilling fra, hvis du hader de store titler i navigationslinjen #irriterende #too_ugly_for_me"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista tämä käytöstä, jos vihaat isoja otsikoita navigointipalkissa #ärsyttävää #liian_ruma_mun_makuun"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold ki ezt, ha utálod a nagy címeket a navigációs sávban #idegesítő #too_ugly_for_me"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av dette hvis du hater de store titlene i navigasjonslinjen #irriterende #too_ugly_for_me"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر تمہیں نیویگیشن بار میں بڑے ٹائٹلز سے نفرت ہے تو اس آپشن کو بند کر دو #annoying #too_ugly_for_me"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa esta opção se detestas os títulos grandes na barra de navegação #irritante #demasiado_feio_para_mim"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անջատիր այս տարբերակը, եթե ատում ես նավիգացիայի գոտու մեծ վերնագրերը #annoying #too_ugly_for_me"
          }
        }
      }
    },

        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβε ειδοποιήσεις μέσα στο Kurozora όσο χρησιμοποιείς την εφαρμογή. Αυτό είναι ξεχωριστό από τις ειδοποιήσεις του Kurozora σε επίπεδο συστήματος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

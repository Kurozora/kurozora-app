    "Built with lack of 😴, lots of 🍵 and 🌸 allergy by Kirito\nKurozora %@ (%@)": {
      "comment": "The about-section credit footer.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Built with lack of 😴, lots of 🍵 and 🌸 allergy by Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebouwd met te weinig 😴, veel 🍵 en 🌸-allergie door Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صُنع بقلة من 😴، وكثير من 🍵 وحساسية من 🌸 على يد Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho con falta de 😴, mucho 🍵 y alergia al 🌸 por Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat dengan kurang 😴, banyak 🍵 dan alergi 🌸 oleh Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 不足、たっぷりの 🍵、そして 🌸 アレルギーとともに Kirito が制作\nKurozora %1$@ (%2$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito com falta de 😴, muito 🍵 e alergia a 🌸 pelo Kirito\nKurozora %1$@ (%2$@)"

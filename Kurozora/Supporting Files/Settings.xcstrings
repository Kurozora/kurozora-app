        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کم 😴، بہت سارے 🍵 اور 🌸 سے الرجی کے ساتھ Kirito نے بنایا\nKurozora %1$@ (%2$@)"
          }

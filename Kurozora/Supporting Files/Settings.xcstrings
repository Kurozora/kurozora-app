    "Set a default browser for opening web links. If the selected app isn't installed, links open in Safari as a fallback." : {
      "comment" : "A short description for the browser settings header.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن متصفحًا افتراضيًا لفتح روابط الويب. إذا لم يكن التطبيق المحدد مثبتًا، فستُفتح الروابط في Safari كبديل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওয়েব লিঙ্ক খোলার জন্য একটি ডিফল্ট ব্রাউজার সেট করো। নির্বাচিত অ্যাপটি ইনস্টল করা না থাকলে লিঙ্কগুলো ফলব্যাক হিসেবে Safari-তে খোলে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav výchozí prohlížeč pro otevírání webových odkazů. Pokud vybranou aplikaci nemáš nainstalovanou, odkazy se náhradně otevřou v Safari."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil en standardbrowser til at åbne weblinks. Hvis den valgte app ikke er installeret, åbnes links i Safari i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege einen Standardbrowser zum Öffnen von Weblinks fest. Wenn die ausgewählte App nicht installiert ist, werden Links ersatzweise in Safari geöffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όρισε ένα προεπιλεγμένο πρόγραμμα περιήγησης για το άνοιγμα συνδέσμων. Αν η επιλεγμένη εφαρμογή δεν είναι εγκατεστημένη, οι σύνδεσμοι ανοίγουν στο Safari ως εναλλακτική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece un navegador predeterminado para abrir los enlaces web. Si la app seleccionada no está instalada, los enlaces se abren en Safari como alternativa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece un navegador predeterminado para abrir enlaces web. Si la app seleccionada no está instalada, los enlaces se abren en Safari como alternativa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک مرورگر پیش‌فرض برای باز کردن پیوندهای وب تنظیم کن. اگر برنامهٔ انتخاب‌شده نصب نباشد، پیوندها به‌عنوان جایگزین در Safari باز می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta oletusselain verkkolinkkien avaamiseen. Jos valittua sovellusta ei ole asennettu, linkit avautuvat varalta Safarissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magtakda ng default na browser para sa pagbukas ng mga web link. Kung hindi naka-install ang napiling app, bubukas ang mga link sa Safari bilang fallback."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définis un navigateur par défaut pour ouvrir les liens web. Si l’app sélectionnée n’est pas installée, les liens s’ouvrent dans Safari par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדר דפדפן ברירת מחדל לפתיחת קישורים לאינטרנט. אם האפליקציה שנבחרה אינה מותקנת, הקישורים ייפתחו ב-Safari כברירת מחדל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेब लिंक खोलने के लिए एक डिफ़ॉल्ट ब्राउज़र सेट करो। अगर चुना हुआ ऐप इंस्टॉल नहीं है, तो लिंक फ़ॉलबैक के तौर पर Safari में खुलते हैं।"

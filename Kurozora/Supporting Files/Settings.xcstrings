        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaut mit zu wenig 😴, viel 🍵 und 🌸-Allergie von Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçu avec un manque de 😴, beaucoup de 🍵 et une allergie au 🌸 par Kirito\nKurozora %1$@ (%2$@)"

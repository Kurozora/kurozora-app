    "Choose a default browser in which web links will be opened. If you don't have the app installed then the links will open inside Safari as a fallback.": {
      "comment": "The footer for the browser settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een standaardbrowser waarin weblinks worden geopend. Als je de app niet hebt geïnstalleerd, openen de links als terugval in Safari."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر متصفحًا افتراضيًا تُفتح فيه روابط الويب. إذا لم يكن التطبيق مثبتًا لديك، فستُفتح الروابط داخل Safari كبديل."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un navegador predeterminado en el que se abrirán los enlaces web. Si no tienes la app instalada, los enlaces se abrirán en Safari como alternativa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih peramban bawaan untuk membuka tautan web. Jika aplikasinya tidak terpasang, tautan akan dibuka di Safari sebagai cadangan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web リンクを開くデフォルトのブラウザを選びます。そのアプリがインストールされていない場合は、代わりに Safari でリンクが開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um navegador padrão para abrir os links da web. Se você não tiver o app instalado, os links abrirão no Safari como alternativa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Standardbrowser, in dem Weblinks geöffnet werden. Wenn die App nicht installiert ist, werden die Links ersatzweise in Safari geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un navigateur par défaut dans lequel les liens web s’ouvriront. Si l’app n’est pas installée, les liens s’ouvriront dans Safari par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un browser predefinito in cui aprire i link web. Se non hai l'app installata, i link si apriranno in Safari come ripiego."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 링크를 열 기본 브라우저를 선택하세요. 해당 앱이 설치되어 있지 않으면 링크는 대체 수단으로 Safari에서 열려요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz domyślną przeglądarkę, w której będą otwierane linki. Jeśli nie masz zainstalowanej tej aplikacji, linki otworzą się w Safari jako rozwiązanie zapasowe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери браузер по умолчанию для открытия веб-ссылок. Если приложение не установлено, ссылки будут открываться в Safari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择打开网页链接所用的默认浏览器。如果你未安装该 App，链接将退而在 Safari 中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇開啟網頁連結的預設瀏覽器。如果你尚未安裝該應用程式，連結將改以 Safari 開啟。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเบราว์เซอร์เริ่มต้นสำหรับเปิดลิงก์เว็บ ถ้าคุณยังไม่ได้ติดตั้งแอปนั้น ลิงก์จะเปิดใน Safari แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web bağlantılarının açılacağı varsayılan bir tarayıcı seç. Uygulama yüklü değilse bağlantılar yedek olarak Safari'de açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери браузер за замовчуванням, у якому відкриватимуться вебпосилання. Якщо застосунок не встановлено, посилання відкриватимуться в Safari як запасний варіант."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn trình duyệt mặc định để mở các liên kết web. Nếu bạn chưa cài ứng dụng đó thì liên kết sẽ mở trong Safari để thay thế."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un navegador predeterminado para abrir los enlaces web. Si no tienes la app instalada, los enlaces se abrirán en Safari como alternativa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng default na browser kung saan bubuksan ang mga web link. Kung wala kang naka-install na app, bubukas ang mga link sa loob ng Safari bilang fallback."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक डिफ़ॉल्ट ब्राउज़र चुनो जिसमें वेब लिंक खुलेंगे। अगर तुम्हारे पास वह ऐप इंस्टॉल नहीं है तो लिंक फ़ॉलबैक के तौर पर Safari में खुलेंगे।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک مرورگر پیش‌فرض برای باز کردن پیوندهای وب انتخاب کن. اگر برنامه را نصب نکرده باشی، پیوندها به‌عنوان جایگزین در Safari باز می‌شوند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר דפדפן ברירת מחדל שבו ייפתחו קישורים לאינטרנט. אם האפליקציה אינה מותקנת אצלך, הקישורים ייפתחו בתוך Safari כברירת מחדל."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pelayar lalai untuk membuka pautan web. Jika anda tiada apl tersebut dipasang, pautan akan dibuka dalam Safari sebagai sandaran."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un browser implicit în care se vor deschide linkurile web. Dacă nu ai aplicația instalată, linkurile se vor deschide în Safari ca soluție de rezervă."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en standardwebbläsare som webblänkar öppnas i. Om du inte har appen installerad öppnas länkarna i Safari som reservalternativ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber výchozí prohlížeč, ve kterém se budou otevírat webové odkazy. Pokud danou aplikaci nemáš nainstalovanou, odkazy se náhradně otevřou v Safari."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε ένα προεπιλεγμένο πρόγραμμα περιήγησης στο οποίο θα ανοίγουν οι σύνδεσμοι. Αν δεν έχεις εγκατεστημένη την εφαρμογή, οι σύνδεσμοι θα ανοίγουν στο Safari ως εναλλακτική."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়েব লিঙ্ক কোন ব্রাউজারে খুলবে তার জন্য একটি ডিফল্ট ব্রাউজার বেছে নাও। অ্যাপটি ইনস্টল করা না থাকলে লিঙ্কগুলো ফলব্যাক হিসেবে Safari-তে খুলবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வலை இணைப்புகள் எந்த இயல்புநிலை உலாவியில் திறக்கப்படும் என்பதைத் தேர்ந்தெடுக்கவும். ஆப் நிறுவப்படவில்லை எனில், மாற்றாக இணைப்புகள் Safari-இல் திறக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెబ్ లింక్‌లు ఏ బ్రౌజర్‌లో తెరవాలో డిఫాల్ట్ బ్రౌజర్‌ని ఎంచుకోండి. ఆ యాప్ ఇన్‌స్టాల్ చేయకపోతే లింక్‌లు ఫాల్‌బ్యాక్‌గా Safari లో తెరుచుకుంటాయి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en standardbrowser, som weblinks åbnes i. Hvis du ikke har appen installeret, åbnes linkene i Safari i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse oletusselain, jossa verkkolinkit avataan. Jos sovellusta ei ole asennettu, linkit avautuvat varalta Safarissa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy alapértelmezett böngészőt, amelyben a weblinkek megnyílnak. Ha az app nincs telepítve, a linkek tartalékként a Safariban nyílnak meg."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en standardnettleser som nettlenker skal åpnes i. Hvis du ikke har appen installert, åpnes lenkene i Safari i stedet."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ڈیفالٹ براؤزر منتخب کرو جس میں ویب لنکس کھلیں گے۔ اگر تمہارے پاس وہ ایپ انسٹال نہیں ہے تو لنکس متبادل کے طور پر Safari میں کھلیں گے۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o navegador predefinido onde os links serão abertos. Se não tiveres a app instalada, os links abrem no Safari como alternativa."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրիր կանխադրված դիտարկիչը, որով կբացվեն վեբ հղումները։ Եթե հավելվածը տեղադրված չէ, ապա հղումները կբացվեն Safari-ում՝ որպես այլընտրանք։"
          }
        }
      }
    },
    "Choose where to subscribe to your Kurozora reminders. If the selected app isn't installed, the link will open in Safari as a fallback.": {
      "comment": "The footer string for the reminder subscription picker.",
      "localizations": {
        "nl": {

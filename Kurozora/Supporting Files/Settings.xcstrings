        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygget med mangel på 😴, masser af 🍵 og 🌸-allergi af Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehnyt Kirito ilman 😴, paljon 🍵 kera ja 🌸 allergian voimin\nKurozora %1$@ (%2$@)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",

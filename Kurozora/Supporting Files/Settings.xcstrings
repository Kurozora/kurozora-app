        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato con poco 😴, tanto 🍵 e allergia ai 🌸 da Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부족한 😴, 넘치는 🍵 그리고 🌸 알레르기로 Kirito가 만들었어요\nKurozora %1$@ (%2$@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stworzone z brakiem 😴, mnóstwem 🍵 i alergią na 🌸 przez Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделано без 😴, с кучей 🍵 и аллергией на 🌸 — Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Kirito 在缺 😴、灌 🍵 和对 🌸 过敏的状态下打造\nKurozora %1$@ (%2$@)"

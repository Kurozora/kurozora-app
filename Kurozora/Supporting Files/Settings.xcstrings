    "Review your privacy settings, manage app permissions in the Settings app, manage blocked accounts, and access legal information." : {
      "comment" : "A short description for the privacy settings header.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع إعدادات الخصوصية الخاصة بك، وأدِر أذونات التطبيق في تطبيق الإعدادات، وأدِر الحسابات المحظورة، واطّلع على المعلومات القانونية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্রাইভেসি সেটিংস পর্যালোচনা করুন, Settings অ্যাপে অ্যাপের অনুমতি পরিচালনা করুন, ব্লক করা অ্যাকাউন্ট পরিচালনা করুন এবং আইনি তথ্য দেখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte svá nastavení soukromí, spravujte oprávnění aplikace v Nastavení, spravujte blokované účty a otevřete právní informace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå dine indstillinger for privatliv, administrér app-tilladelser i appen Indstillinger, administrér blokerede konti, og få adgang til juridiske oplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfen Sie Ihre Datenschutzeinstellungen, verwalten Sie App-Berechtigungen in der App „Einstellungen“, verwalten Sie blockierte Accounts und greifen Sie auf rechtliche Informationen zu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τις ρυθμίσεις απορρήτου σας, διαχειριστείτε τα δικαιώματα της εφαρμογής στις Ρυθμίσεις, διαχειριστείτε τους αποκλεισμένους λογαριασμούς και αποκτήστε πρόσβαση σε νομικές πληροφορίες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise sus ajustes de privacidad, gestione los permisos de la app en la app Ajustes, gestione las cuentas bloqueadas y acceda a la información legal."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise su configuración de privacidad, administre los permisos de la app en la app Ajustes, administre las cuentas bloqueadas y acceda a información legal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیمات حریم خصوصی خود را بررسی کنید، مجوزهای برنامه را در برنامهٔ تنظیمات مدیریت کنید، حساب‌های مسدودشده را مدیریت کنید و به اطلاعات حقوقی دسترسی پیدا کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkastele yksityisyysasetuksiasi, hallitse sovelluksen käyttöoikeuksia Asetukset-sovelluksessa, hallitse estettyjä tilejä ja avaa juridiset tiedot."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang iyong mga privacy setting, pamahalaan ang mga app permission sa Settings app, pamahalaan ang mga naka-block na account, at i-access ang legal na impormasyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez vos réglages de confidentialité, gérez les autorisations de l’app dans Réglages, gérez les comptes bloqués et accédez aux informations légales."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עיינו בהגדרות הפרטיות שלכם, נהלו הרשאות אפליקציה באפליקציית ההגדרות, נהלו חשבונות חסומים וגשו למידע משפטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी गोपनीयता सेटिंग्स की समीक्षा करें, सेटिंग्स ऐप में ऐप अनुमतियाँ प्रबंधित करें, अवरुद्ध खातों को प्रबंधित करें और कानूनी जानकारी तक पहुँचें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekintse át az adatvédelmi beállításait, kezelje az app engedélyeit a Beállítások appban, kezelje a letiltott fiókokat, és férjen hozzá a jogi információkhoz."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Վերանայեք Ձեր գաղտնիության կարգավորումները, կառավարեք հավելվածի թույլտվությունները Settings հավելվածում, կառավարեք արգելափակված հաշիվները և մուտք գործեք իրավական տեղեկատվություն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau pengaturan privasi Anda, kelola izin aplikasi di aplikasi Pengaturan, kelola akun yang diblokir, dan akses informasi hukum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivedi le tue impostazioni sulla privacy, gestisci le autorizzazioni dell'app nell'app Impostazioni, gestisci gli account bloccati e accedi alle informazioni legali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー設定の確認、設定アプリでのアプリ権限の管理、ブロックしたアカウントの管理、法的情報の閲覧ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 설정을 확인하고, 설정 앱에서 앱 권한을 관리하며, 차단한 계정을 관리하고, 법적 정보를 확인하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semak tetapan privasi anda, urus kebenaran apl dalam apl Tetapan, urus akaun yang disekat dan akses maklumat undang-undang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå gjennom personverninnstillingene dine, administrer apptillatelser i Innstillinger-appen, administrer blokkerte kontoer og få tilgang til juridisk informasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk uw privacyinstellingen, beheer app-machtigingen in de app Instellingen, beheer geblokkeerde accounts en raadpleeg juridische informatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzyj swoje ustawienia prywatności, zarządzaj uprawnieniami aplikacji w aplikacji Ustawienia, zarządzaj zablokowanymi kontami i uzyskaj dostęp do informacji prawnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise suas configurações de privacidade, gerencie as permissões do app no app Ajustes, gerencie contas bloqueadas e acesse informações legais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja as suas definições de privacidade, faça a gestão das permissões da aplicação na app Definições, faça a gestão das contas bloqueadas e aceda a informação legal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificați setările de confidențialitate, gestionați permisiunile aplicației în aplicația Setări, gestionați conturile blocate și accesați informațiile legale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотрите настройки конфиденциальности, управляйте разрешениями приложения в приложении «Настройки», управляйте заблокированными аккаунтами и получите доступ к правовой информации."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska dina integritetsinställningar, hantera apptillstånd i Inställningar-appen, hantera blockerade konton och få tillgång till juridisk information."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தனியுரிமை அமைப்புகளை மதிப்பாய்வு செய்யவும், அமைப்புகள் ஆப்பில் ஆப் அனுமதிகளை நிர்வகிக்கவும், தடுக்கப்பட்ட கணக்குகளை நிர்வகிக்கவும், மற்றும் சட்டத் தகவலை அணுகவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ గోప్యతా సెట్టింగ్‌లను సమీక్షించండి, Settings యాప్‌లో యాప్ అనుమతులను నిర్వహించండి, బ్లాక్ చేసిన ఖాతాలను నిర్వహించండి, చట్టపరమైన సమాచారాన్ని పొందండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบการตั้งค่าความเป็นส่วนตัวของคุณ จัดการสิทธิ์ของแอปในแอปการตั้งค่า จัดการบัญชีที่ถูกบล็อก และเข้าถึงข้อมูลทางกฎหมาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilik ayarlarınızı gözden geçirin, Ayarlar uygulamasında uygulama izinlerini yönetin, engellenen hesapları yönetin ve yasal bilgilere erişin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляньте налаштування конфіденційності, керуйте дозволами застосунку в застосунку Налаштування, керуйте заблокованими обліковими записами та отримуйте доступ до правової інформації."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی رازداری کی ترتیبات کا جائزہ لیں، Settings ایپ میں ایپ کی اجازتوں کا انتظام کریں، بلاک کیے گئے اکاؤنٹس کا انتظام کریں، اور قانونی معلومات تک رسائی حاصل کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại cài đặt quyền riêng tư, quản lý quyền ứng dụng trong ứng dụng Cài đặt, quản lý các tài khoản bị chặn và truy cập thông tin pháp lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看你的隐私设置，在“设置”App 中管理 App 权限，管理已屏蔽的账户，并访问法律信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視你的隱私設定、在「設定」App 中管理應用程式權限、管理已封鎖的帳號，並查看法律資訊。"
          }
        }
      }
    },

    "Pick a calendar app to subscribe to your Kurozora reminders, or copy the subscription link to use elsewhere.": {
      "comment": "A short description for the reminder subscription settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een agenda-app om je Kurozora-herinneringen te volgen, of kopieer de abonnementslink om elders te gebruiken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تطبيق تقويم للاشتراك بتذكيرات Kurozora الخاصة بك، أو انسخ رابط الاشتراك لاستخدامه في مكان آخر."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una app de calendario para suscribirte a tus recordatorios de Kurozora, o copia el enlace de suscripción para usarlo en otro lugar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih aplikasi kalender untuk berlangganan pengingat Kurozora kamu, atau salin tautan langganan untuk dipakai di tempat lain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora のリマインダーを購読するカレンダーアプリを選ぶか、購読リンクをコピーして別の場所で使えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um app de calendário para assinar seus lembretes do Kurozora ou copie o link de assinatura para usar em outro lugar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Kalender-App, um deine Kurozora-Erinnerungen zu abonnieren, oder kopiere den Abo-Link, um ihn anderswo zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une app de calendrier pour t’abonner à tes rappels Kurozora, ou copie le lien d’abonnement pour l’utiliser ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un'app calendario per iscriverti ai tuoi promemoria Kurozora, oppure copia il link di iscrizione per usarlo altrove."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora 리마인더를 구독할 캘린더 앱을 고르거나, 다른 곳에서 쓸 수 있도록 구독 링크를 복사하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację kalendarza, aby subskrybować swoje przypomnienia Kurozora, lub skopiuj link subskrypcji, aby użyć go gdzie indziej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери приложение календаря, чтобы подписаться на напоминания Kurozora, или скопируй ссылку подписки для использования в другом месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个日历 App 订阅你的 Kurozora 提醒，或拷贝订阅链接以便在其他地方使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑選一個行事曆應用程式來訂閱你的 Kurozora 提醒，或複製訂閱連結在其他地方使用。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแอปปฏิทินเพื่อติดตามการเตือนความจำของ Kurozora หรือคัดลอกลิงก์การติดตามไปใช้ที่อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora hatırlatıcılarına abone olmak için bir takvim uygulaması seç ya da başka bir yerde kullanmak için abonelik bağlantısını kopyala."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери застосунок календаря, щоб підписатися на свої нагадування Kurozora, або скопіюй посилання на підписку для використання деінде."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một ứng dụng lịch để đăng ký các lời nhắc Kurozora của bạn, hoặc sao chép liên kết đăng ký để dùng ở nơi khác."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una app de calendario para suscribirte a tus recordatorios de Kurozora, o copia el enlace de suscripción para usarlo en otro sitio."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng calendar app para mag-subscribe sa iyong mga Kurozora reminder, o kopyahin ang subscription link para gamitin sa ibang lugar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Kurozora रिमाइंडर्स को सब्सक्राइब करने के लिए एक कैलेंडर ऐप चुनो, या कहीं और इस्तेमाल करने के लिए सब्सक्रिप्शन लिंक कॉपी करो।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک برنامهٔ تقویم انتخاب کن تا یادآورهای Kurozora را دنبال کنی، یا پیوند اشتراک را برای استفاده در جای دیگر کپی کن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אפליקציית לוח שנה כדי להירשם לתזכורות Kurozora שלך, או העתק את קישור המינוי לשימוש במקום אחר."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apl kalendar untuk melanggan peringatan Kurozora anda, atau salin pautan langganan untuk digunakan di tempat lain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o aplicație de calendar pentru a te abona la mementourile tale Kurozora sau copiază linkul de abonare ca să-l folosești în altă parte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en kalenderapp att prenumerera på dina Kurozora-påminnelser med, eller kopiera prenumerationslänken för att använda någon annanstans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber kalendářovou aplikaci pro odběr svých Kurozora připomínek, nebo si zkopíruj odkaz na odběr pro použití jinde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε μια εφαρμογή ημερολογίου για να εγγραφείς στις υπενθυμίσεις του Kurozora ή αντίγραψε τον σύνδεσμο εγγραφής για χρήση αλλού."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার Kurozora রিমাইন্ডারে সাবস্ক্রাইব করতে একটি ক্যালেন্ডার অ্যাপ বেছে নাও, অথবা অন্য কোথাও ব্যবহারের জন্য সাবস্ক্রিপশন লিঙ্কটি কপি করো।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Kurozora நினைவூட்டல்களுக்குக் குழுசேர ஒரு நாள்காட்டி ஆப்பைத் தேர்ந்தெடுக்கவும், அல்லது வேறு இடத்தில் பயன்படுத்த குழுசேர் இணைப்பை நகலெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Kurozora రిమైండర్‌లకు సబ్‌స్క్రైబ్ చేయడానికి ఒక క్యాలెండర్ యాప్‌ను ఎంచుకోండి, లేదా వేరే చోట వాడటానికి సబ్‌స్క్రిప్షన్ లింక్‌ను కాపీ చేయండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en kalenderapp til at abonnere på dine Kurozora-påmindelser, eller kopiér abonnementslinket for at bruge det andetsteds."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kalenterisovellus, jossa tilaat Kurozora-muistutuksesi, tai kopioi tilauslinkki käytettäväksi muualla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy naptáralkalmazást a Kurozora emlékeztetőidre való feliratkozáshoz, vagy másold ki a feliratkozási linket máshol való felhasználásra."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en kalenderapp for å abonnere på Kurozora-påminnelsene dine, eller kopier abonnementslenken for å bruke den andre steder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی Kurozora یاد دہانیوں کو سبسکرائب کرنے کے لیے ایک کیلنڈر ایپ منتخب کرو، یا کہیں اور استعمال کے لیے سبسکرپشن لنک کاپی کر لو۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe uma app de calendário para subscrever os teus lembretes do Kurozora, ou copia o link de subscrição para usar noutro lado."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրիր օրացույցի հավելված՝ քո Kurozora-ի հիշեցումներին բաժանորդագրվելու համար, կամ պատճենիր բաժանորդագրության հղումը՝ այլ տեղ օգտագործելու համար։"
          }
        }
      }
    },

    "Manage in-app notification preferences including sounds, badges, and how notifications are grouped together.": {
      "comment": "A short description for the notifications settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer de meldingsvoorkeuren in de app, waaronder geluiden, badges en hoe meldingen worden gegroepeerd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر تفضيلات الإشعارات داخل التطبيق، بما في ذلك الأصوات والشارات وكيفية تجميع الإشعارات معًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra las preferencias de notificaciones dentro de la app, incluidos los sonidos, los distintivos y cómo se agrupan las notificaciones."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola preferensi notifikasi dalam aplikasi termasuk suara, lencana, dan cara notifikasi dikelompokkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンド、バッジ、通知のグループ化方法など、アプリ内通知の設定を管理できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie as preferências de notificações no app, incluindo sons, selos e como as notificações são agrupadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte die In-App-Mitteilungseinstellungen, einschließlich Töne, Badges und der Gruppierung von Mitteilungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gère les préférences de notifications dans l’app, y compris les sons, les pastilles et le regroupement des notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le preferenze delle notifiche nell'app, inclusi suoni, badge e come vengono raggruppate le notifiche."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리, 배지, 알림 묶음 방식을 포함한 앱 내 알림 환경설정을 관리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj ustawieniami powiadomień w aplikacji, w tym dźwiękami, plakietkami i sposobem grupowania powiadomień."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настрой параметры уведомлений в приложении, включая звуки, значки и группировку уведомлений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理 App 内通知偏好，包括声音、标记以及通知的分组方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理應用程式內的通知偏好，包括音效、標記，以及通知的分組方式。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการการตั้งค่าการแจ้งเตือนในแอป รวมถึงเสียง ป้ายตัวเลข และวิธีจัดกลุ่มการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesler, rozetler ve bildirimlerin nasıl gruplandığı dahil olmak üzere uygulama içi bildirim tercihlerini yönet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуй налаштуваннями сповіщень у застосунку, зокрема звуками, значками та способом групування сповіщень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý tùy chọn thông báo trong ứng dụng bao gồm âm thanh, huy hiệu và cách nhóm các thông báo lại với nhau."
          }
        }
      }
    },
    "Manage your app experience by clearing temporary files, downloaded content, and cached media used for faster loading and offline viewing.": {
      "comment": "A short description for the cache settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer je app-ervaring door tijdelijke bestanden, gedownloade inhoud en media in de cache te wissen die worden gebruikt voor sneller laden en offline kijken."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر تجربتك في التطبيق عبر مسح الملفات المؤقتة والمحتوى المُنزّل والوسائط المخزّنة مؤقتًا المستخدمة لتحميل أسرع ومشاهدة دون اتصال."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra tu experiencia en la app borrando archivos temporales, contenido descargado y contenido en caché que se usa para cargar más rápido y ver sin conexión."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola pengalaman aplikasimu dengan membersihkan berkas sementara, konten yang diunduh, dan media tersimpan yang dipakai agar pemuatan lebih cepat dan dapat ditonton luring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みの高速化やオフライン視聴に使われる一時ファイル、ダウンロード済みコンテンツ、キャッシュされたメディアを消去して、アプリの使い心地を整えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie sua experiência no app limpando arquivos temporários, conteúdos baixados e mídias em cache usadas para carregar mais rápido e ver offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte dein App-Erlebnis, indem du temporäre Dateien, heruntergeladene Inhalte und zwischengespeicherte Medien löschst, die für schnelleres Laden und die Offline-Wiedergabe genutzt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gère ton expérience de l’app en effaçant les fichiers temporaires, le contenu téléchargé et les médias en cache utilisés pour un chargement plus rapide et une lecture hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci la tua esperienza nell'app cancellando i file temporanei, i contenuti scaricati e i media in cache usati per un caricamento più rapido e la visione offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠른 로딩과 오프라인 시청에 쓰이는 임시 파일, 다운로드한 콘텐츠, 캐시된 미디어를 지워 앱 사용 환경을 관리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj działaniem aplikacji, czyszcząc pliki tymczasowe, pobraną zawartość i zbuforowane media, które przyspieszają wczytywanie i umożliwiają przeglądanie offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляй работой приложения, очищая временные файлы, загруженный контент и кэшированные медиа, которые ускоряют загрузку и просмотр офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过清除临时文件、已下载内容以及用于加快加载和离线观看的缓存媒体，管理你的 App 体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除暫存檔案、已下載內容，以及用於加速載入與離線觀看的快取媒體，藉此管理你的應用程式使用體驗。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการประสบการณ์การใช้แอปด้วยการล้างไฟล์ชั่วคราว เนื้อหาที่ดาวน์โหลด และสื่อในแคชที่ใช้เพื่อให้โหลดเร็วขึ้นและดูแบบออฟไลน์ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hızlı yükleme ve çevrimdışı izleme için kullanılan geçici dosyaları, indirilen içeriği ve önbelleğe alınmış medyayı temizleyerek uygulama deneyimini yönet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуй роботою застосунку, очищаючи тимчасові файли, завантажений вміст і кешовані медіа, що використовуються для швидшого завантаження й перегляду офлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý trải nghiệm ứng dụng bằng cách xóa tệp tạm, nội dung đã tải về và nội dung lưu đệm được dùng để tải nhanh hơn và xem ngoại tuyến."
          }
        }
      }
    },

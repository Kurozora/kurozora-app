      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheek verwijderen"
          }
        }
      }
    },
    "Disable this option if you hate the large titles in the navigation bar #annoying #too_ugly_for_me": {
      "comment": "The footer for the large titles option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel deze optie uit als je de grote titels in de navigatiebalk haat #irritant #te_lelijk_voor_mij"
          }
        }
      }
    },
    "Display & Blindness": {
      "comment": "The string for the 'Display & Blindness' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergave en blindheid"
          }
        }
      }
    },
    "Easy on the eyes.": {
      "comment": "The string for night theme description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prettig voor de ogen."
          }
        }
      }
    },
    "Enable this option if you prefer a darker black color. Or if you value your eyes' health while using the app in the dark. Or those precious battery juices. Or or or…": {
      "comment": "The footer for the true black option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel deze optie in als je liever een donkerder zwart hebt. Of als je je ogen wilt sparen terwijl je de app in het donker gebruikt. Of die kostbare batterijsappen. Of of of…"
          }
        }
      }
    },
    "Face ID & Passcode": {
      "comment": "The string for the 'Face ID & Passcode' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID en toegangscode"
          }
        }

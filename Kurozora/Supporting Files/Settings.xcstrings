        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनो कि अपने Kurozora रिमाइंडर्स को कहाँ सब्सक्राइब करना है। अगर चुना हुआ ऐप इंस्टॉल नहीं है, तो लिंक फ़ॉलबैक के तौर पर Safari में खुलेगा।"

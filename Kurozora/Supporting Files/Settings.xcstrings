    "Control animations and visual effects throughout the app, including the splash screen animation and reduced motion preferences." : {
      "comment" : "A short description for the motion settings header.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحكّم في الرسوم المتحركة والمؤثرات البصرية في جميع أنحاء التطبيق، بما في ذلك رسوم شاشة البدء وتفضيلات تقليل الحركة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্প্ল্যাশ স্ক্রিন অ্যানিমেশন ও মোশন কমানোর পছন্দসহ অ্যাপ জুড়ে অ্যানিমেশন এবং ভিজ্যুয়াল এফেক্ট নিয়ন্ত্রণ করো।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládej animace a vizuální efekty v celé aplikaci, včetně animace úvodní obrazovky a předvoleb omezeného pohybu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr animationer og visuelle effekter i hele appen, herunder splash screen-animationen og indstillinger for reduceret bevægelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuere Animationen und visuelle Effekte in der gesamten App, einschließlich der Splash-Screen-Animation und der Einstellungen zur Bewegungsreduzierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλεγξε τα κινούμενα γραφικά και τα οπτικά εφέ σε όλη την εφαρμογή, μαζί με την κίνηση της οθόνης εκκίνησης και τις προτιμήσεις μειωμένης κίνησης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla las animaciones y los efectos visuales de toda la app, incluida la animación de la pantalla de inicio y las preferencias de movimiento reducido."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla las animaciones y los efectos visuales en toda la app, incluida la animación de la pantalla de presentación y las preferencias de movimiento reducido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انیمیشن‌ها و جلوه‌های بصری در سراسر برنامه، از جمله انیمیشن صفحهٔ آغازین و ترجیحات کاهش حرکت را کنترل کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallitse animaatioita ja visuaalisia tehosteita kaikkialla sovelluksessa, mukaan lukien aloitusruudun animaatio ja liikkeen vähennyksen asetukset."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolin ang mga animation at visual effect sa buong app, kasama ang splash screen animation at reduced motion preferences."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôle les animations et les effets visuels dans toute l’app, y compris l’animation de l’écran de démarrage et les préférences de réduction des animations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלוט באנימציות ובאפקטים החזותיים בכל האפליקציה, כולל אנימציית מסך הפתיחה והעדפות הפחתת התנועה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्प्लैश स्क्रीन एनिमेशन और रिड्यूस्ड मोशन प्राथमिकताओं समेत पूरे ऐप में एनिमेशन और विज़ुअल इफेक्ट्स को नियंत्रित करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szabályozd az animációkat és vizuális effekteket az egész appban, beleértve a nyitóképernyő animációját és a csökkentett mozgás beállításait."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կառավարիր անիմացիաներն ու վիզուալ էֆեկտները ողջ հավելվածում, ներառյալ մեկնարկային էկրանի անիմացիան և շարժման նվազեցման նախապատվությունները։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrol animasi dan efek visual di seluruh aplikasi, termasuk animasi layar pembuka dan preferensi kurangi gerakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla le animazioni e gli effetti visivi in tutta l'app, inclusa l'animazione della schermata iniziale e le preferenze di riduzione del movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スプラッシュ画面のアニメーションや視差効果を減らす設定など、アプリ全体のアニメーションと視覚効果を管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스플래시 화면 애니메이션과 동작 줄이기 설정을 포함해 앱 전체의 애니메이션과 시각 효과를 제어하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kawal animasi dan kesan visual di seluruh apl, termasuk animasi skrin permulaan dan keutamaan gerakan dikurangkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr animasjoner og visuelle effekter i hele appen, inkludert oppstartsanimasjonen og preferanser for redusert bevegelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheer animaties en visuele effecten in de hele app, waaronder de startschermanimatie en de voorkeuren voor verminderde beweging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steruj animacjami i efektami wizualnymi w całej aplikacji, w tym animacją ekranu startowego oraz ustawieniami ograniczania ruchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle as animações e os efeitos visuais em todo o app, incluindo a animação da tela de abertura e as preferências de movimento reduzido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla as animações e os efeitos visuais em toda a app, incluindo a animação do ecrã de arranque e as preferências de movimento reduzido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlează animațiile și efectele vizuale din toată aplicația, inclusiv animația ecranului de pornire și preferințele de mișcare redusă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляй анимациями и визуальными эффектами по всему приложению, включая анимацию заставки и настройку уменьшения движения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr animationer och visuella effekter i hela appen, inklusive startskärmens animation och inställningar för reducerad rörelse."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஸ்பிளாஷ் திரை அனிமேஷன் மற்றும் குறைந்த இயக்க விருப்பங்கள் உட்பட, ஆப் முழுவதும் உள்ள அனிமேஷன்கள் மற்றும் காட்சி விளைவுகளைக் கட்டுப்படுத்து."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్ప్లాష్ స్క్రీన్ యానిమేషన్, రెడ్యూస్ మోషన్ ప్రాధాన్యతలతో సహా యాప్ అంతటా యానిమేషన్‌లు, విజువల్ ఎఫెక్ట్‌లను నియంత్రించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ควบคุมแอนิเมชันและเอฟเฟกต์ภาพทั่วทั้งแอป รวมถึงแอนิเมชันหน้าจอเปิดและการตั้งค่าลดการเคลื่อนไหว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılış ekranı animasyonu ve hareket azaltma tercihleri dahil olmak üzere uygulama genelindeki animasyonları ve görsel efektleri denetle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керуй анімаціями та візуальними ефектами по всьому застосунку, зокрема анімацією заставки й налаштуваннями зменшення руху."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پوری ایپ میں اینیمیشنز اور بصری اثرات کو کنٹرول کرو، بشمول اسپلیش اسکرین اینیمیشن اور کم حرکت کی ترجیحات۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm soát hoạt ảnh và hiệu ứng hình ảnh trong toàn bộ ứng dụng, bao gồm hoạt ảnh màn hình chờ và tùy chọn giảm chuyển động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制整个 App 中的动画和视觉效果，包括启动画面动画和减弱动态偏好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制整個應用程式中的動畫與視覺效果，包括啟動畫面動畫與減少動態偏好。"
          }
        }
      }
    },

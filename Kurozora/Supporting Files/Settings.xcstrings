    "Receive notifications inside Kurozora while using the app. This is separate from systemwide notifications for Kurozora.": {
      "comment": "The footer for the in-app notifications option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang meldingen in Kurozora terwijl je de app gebruikt. Dit staat los van systeembrede meldingen voor Kurozora."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقَّ الإشعارات داخل Kurozora أثناء استخدام التطبيق. هذا منفصل عن إشعارات Kurozora على مستوى النظام."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe notificaciones dentro de Kurozora mientras usas la app. Esto es independiente de las notificaciones del sistema para Kurozora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima notifikasi di dalam Kurozora saat memakai aplikasi. Ini terpisah dari notifikasi seluruh sistem untuk Kurozora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの使用中に Kurozora 内で通知を受け取ります。これは Kurozora のシステム全体の通知とは別です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba notificações dentro do Kurozora enquanto usa o app. Isso é separado das notificações do sistema para o Kurozora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Mitteilungen innerhalb von Kurozora, während du die App nutzt. Das ist getrennt von den systemweiten Mitteilungen für Kurozora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reçois des notifications dans Kurozora pendant que tu utilises l’app. Ce réglage est distinct des notifications système de Kurozora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi notifiche dentro Kurozora mentre usi l'app. Questo è separato dalle notifiche di sistema per Kurozora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 사용하는 동안 Kurozora 안에서 알림을 받습니다. 이는 Kurozora의 시스템 전체 알림과는 별개입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienia w Kurozora podczas korzystania z aplikacji. Jest to niezależne od powiadomień systemowych dla Kurozora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получай уведомления внутри Kurozora во время использования приложения. Это отдельно от системных уведомлений Kurozora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 App 时在 Kurozora 内接收通知。这与 Kurozora 的系统级通知相互独立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用應用程式時於 Kurozora 內接收通知。此設定與 Kurozora 的系統通知各自獨立。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับการแจ้งเตือนภายใน Kurozora ขณะใช้งานแอป ซึ่งแยกจากการแจ้งเตือนทั่วทั้งระบบของ Kurozora"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı kullanırken Kurozora içinde bildirim al. Bu, Kurozora için sistem genelindeki bildirimlerden ayrıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуй сповіщення всередині Kurozora під час користування застосунком. Це окремо від загальносистемних сповіщень для Kurozora."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo bên trong Kurozora khi đang dùng ứng dụng. Điều này tách biệt với thông báo toàn hệ thống của Kurozora."
          }
        }
      }
    },

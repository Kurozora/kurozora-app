    "Manage in-app notification preferences including sounds, badges, and how notifications are grouped together." : {
      "comment" : "A short description for the notifications settings header.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدِر تفضيلات الإشعارات داخل التطبيق، بما في ذلك الأصوات والشارات وكيفية تجميع الإشعارات معًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাউন্ড, ব্যাজ এবং নোটিফিকেশন কীভাবে একসাথে গ্রুপ করা হয় তা সহ অ্যাপের ভেতরের নোটিফিকেশন পছন্দ পরিচালনা করো।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spravuj předvolby oznámení v aplikaci včetně zvuků, odznaků a způsobu, jak se oznámení seskupují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrér indstillinger for notifikationer i appen, herunder lyde, badges, og hvordan notifikationer grupperes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalte die In-App-Mitteilungseinstellungen, einschließlich Töne, Badges und der Gruppierung von Mitteilungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαχειρίσου τις προτιμήσεις ειδοποιήσεων εντός της εφαρμογής, μαζί με τους ήχους, τα σήματα και τον τρόπο ομαδοποίησης των ειδοποιήσεων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona las preferencias de notificaciones en la app, incluidos los sonidos, los globos y cómo se agrupan las notificaciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administra las preferencias de notificaciones dentro de la app, incluidos los sonidos, los distintivos y cómo se agrupan las notificaciones."
          }
        },
        "fa" : {

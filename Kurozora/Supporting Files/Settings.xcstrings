    "Built with lack of 😴, lots of 🍵 and 🌸 allergy by Kirito\nKurozora %@ (%@)": {
      "comment": "The about-section credit footer.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Built with lack of 😴, lots of 🍵 and 🌸 allergy by Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebouwd met te weinig 😴, veel 🍵 en 🌸-allergie door Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صُنع بقلة من 😴، وكثير من 🍵 وحساسية من 🌸 على يد Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho con falta de 😴, mucho 🍵 y alergia al 🌸 por Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat dengan kurang 😴, banyak 🍵 dan alergi 🌸 oleh Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "😴 不足、たっぷりの 🍵、そして 🌸 アレルギーとともに Kirito が制作\nKurozora %1$@ (%2$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito com falta de 😴, muito 🍵 e alergia a 🌸 pelo Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaut mit zu wenig 😴, viel 🍵 und 🌸-Allergie von Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçu avec un manque de 😴, beaucoup de 🍵 et une allergie au 🌸 par Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato con poco 😴, tanto 🍵 e allergia ai 🌸 da Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부족한 😴, 넘치는 🍵 그리고 🌸 알레르기로 Kirito가 만들었어요\nKurozora %1$@ (%2$@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stworzone z brakiem 😴, mnóstwem 🍵 i alergią na 🌸 przez Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделано без 😴, с кучей 🍵 и аллергией на 🌸 — Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Kirito 在缺 😴、灌 🍵 和对 🌸 过敏的状态下打造\nKurozora %1$@ (%2$@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在缺乏 😴、大量 🍵 與 🌸 過敏之中，由 Kirito 打造\nKurozora %1$@ (%2$@)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างด้วยการอด 😴 ดื่ม 🍵 เยอะ ๆ และอาการแพ้ 🌸 โดย Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirito tarafından az 😴, bol 🍵 ve 🌸 alerjisiyle yapıldı\nKurozora %1$@ (%2$@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зроблено з браком 😴, купою 🍵 і алергією на 🌸 від Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được làm ra với sự thiếu ngủ 😴, rất nhiều 🍵 và dị ứng 🌸 bởi Kirito\nKurozora %1$@ (%2$@)"
          }
        }
      }
    },

    "Disable this option if you hate the large titles in the navigation bar #annoying #too_ugly_for_me": {
      "comment": "The footer for the large titles option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel deze optie uit als je de grote titels in de navigatiebalk haat #irritant #te_lelijk_voor_mij"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عطّل هذا الخيار إذا كنت تكره العناوين الكبيرة في شريط التنقل #مزعج #too_ugly_for_me"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva esta opción si odias los títulos grandes en la barra de navegación #molesto #demasiado_feo_para_mí"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan opsi ini kalau kamu benci judul besar di bilah navigasi #annoying #too_ugly_for_me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションバーの大きなタイトルが嫌いならこのオプションをオフにしてね #うざい #too_ugly_for_me"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative esta opção se você odeia os títulos grandes na barra de navegação #irritante #feio_demais_pra_mim"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere diese Option, wenn du die großen Titel in der Navigationsleiste hasst #nervig #too_ugly_for_me"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive cette option si tu détestes les grands titres dans la barre de navigation #agaçant #trop_moche_pour_moi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa opzione se odi i titoli grandi nella barra di navigazione #fastidioso #troppo_brutto_per_me"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내비게이션 바의 큰 제목이 싫다면 이 옵션을 꺼주세요 #짜증나 #too_ugly_for_me"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz tę opcję, jeśli nie znosisz dużych tytułów na pasku nawigacji #irytujące #zbyt_brzydkie_dla_mnie"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключи эту опцию, если терпеть не можешь крупные заголовки в панели навигации #бесит #слишком_уродливо_для_меня"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你讨厌导航栏里的大标题，就关掉这个选项吧 #annoying #too_ugly_for_me"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你討厭導覽列上的大標題，就關掉這個選項吧 #annoying #too_ugly_for_me"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดตัวเลือกนี้ถ้าคุณเกลียดหัวข้อตัวใหญ่ในแถบนำทาง #annoying #too_ugly_for_me"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezinme çubuğundaki büyük başlıklardan nefret ediyorsan bu seçeneği kapat #rahatsız_edici #too_ugly_for_me"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкни цей параметр, якщо терпіти не можеш великі заголовки в панелі навігації #дратує #занадто_потворно_для_мене"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt tùy chọn này nếu bạn ghét tiêu đề lớn trên thanh điều hướng #annoying #too_ugly_for_me"
          }
        }
      }
    },

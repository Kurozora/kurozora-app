        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویب لنکس کھولنے کے لیے ایک ڈیفالٹ براؤزر مقرر کرو۔ اگر منتخب شدہ ایپ انسٹال نہیں ہے تو لنکس متبادل کے طور پر Safari میں کھلتے ہیں۔"

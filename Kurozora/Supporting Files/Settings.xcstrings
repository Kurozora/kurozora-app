        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona las preferencias de notificaciones en la app, incluidos los sonidos, los globos y cómo se agrupan las notificaciones."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamahalaan ang mga in-app notification preference kasama ang mga tunog, badge, at kung paano pinagsasama-sama ang mga abiso."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साउंड, बैज और नोटिफिकेशन कैसे समूहित किए जाते हैं समेत ऐप के अंदर की नोटिफिकेशन प्राथमिकताओं को प्रबंधित करें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجیحات اعلان‌های درون‌برنامه‌ای از جمله صداها، نشان‌ها و نحوهٔ گروه‌بندی اعلان‌ها را مدیریت کن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נהל את העדפות ההתראות בתוך האפליקציה, כולל צלילים, תגיות וכיצד ההתראות מקובצות יחד."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus keutamaan pemberitahuan dalam apl termasuk bunyi, lencana dan cara pemberitahuan dikumpulkan bersama."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionează preferințele pentru notificările din aplicație, inclusiv sunetele, insignele și modul de grupare a notificărilor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera inställningar för aviseringar i appen, inklusive ljud, märken och hur aviseringar grupperas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spravuj předvolby oznámení v aplikaci včetně zvuků, odznaků a způsobu, jak se oznámení seskupují."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαχειρίσου τις προτιμήσεις ειδοποιήσεων εντός της εφαρμογής, μαζί με τους ήχους, τα σήματα και τον τρόπο ομαδοποίησης των ειδοποιήσεων."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাউন্ড, ব্যাজ এবং নোটিফিকেশন কীভাবে একসাথে গ্রুপ করা হয় তা সহ অ্যাপের ভেতরের নোটিফিকেশন পছন্দ পরিচালনা করো।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலிகள், பேட்ஜ்கள் மற்றும் அறிவிப்புகள் எப்படிக் குழுவாக்கப்படுகின்றன என்பது உட்பட, ஆப்-உள் அறிவிப்பு விருப்பங்களை நிர்வகிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సౌండ్‌లు, బ్యాడ్జ్‌లు, నోటిఫికేషన్‌లు ఎలా గ్రూప్ చేయబడతాయో సహా యాప్‌లోని నోటిఫికేషన్ ప్రాధాన్యతలను నిర్వహించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrér indstillinger for notifikationer i appen, herunder lyde, badges, og hvordan notifikationer grupperes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse sovelluksen sisäisiä ilmoitusasetuksia, kuten ääniä, merkkejä ja ilmoitusten ryhmittelyä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezeld az appon belüli értesítési beállításokat, köztük a hangokat, a jelvényeket és azt, hogyan csoportosulnak az értesítések."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer varselpreferanser i appen, inkludert lyder, merker og hvordan varsler grupperes."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان ایپ اطلاعات کی ترجیحات کا انتظام کرو، بشمول آوازیں، بیجز، اور اطلاعات کو کس طرح گروپ کیا جاتا ہے۔"
          }

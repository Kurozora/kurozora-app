    "Adjust the startup chime, UI sound effects, and haptic feedback to personalize how the app sounds and feels." : {
      "comment" : "A short description for the sounds and haptics settings header.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط نغمة البدء ومؤثرات واجهة المستخدم الصوتية والاستجابة اللمسية لتخصيص صوت التطبيق وإحساسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ কেমন শোনায় ও অনুভূত হয় তা নিজের মতো করতে স্টার্টআপ চাইম, UI সাউন্ড এফেক্ট এবং হ্যাপটিক ফিডব্যাক সামঞ্জস্য করো।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprav úvodní zvonkohru, zvukové efekty rozhraní a haptickou odezvu, aby aplikace zněla a působila přesně podle tebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justér startlyden, UI-lydeffekter og haptisk feedback for at personliggøre, hvordan appen lyder og føles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe den Startklang, die UI-Soundeffekte und das haptische Feedback an, um zu bestimmen, wie sich die App anhört und anfühlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρύθμισε τον ήχο εκκίνησης, τα ηχητικά εφέ του περιβάλλοντος και την απτική ανατροφοδότηση για να εξατομικεύσεις πώς ακούγεται και πώς αισθάνεσαι την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el sonido de inicio, los efectos de sonido de la interfaz y la respuesta háptica para personalizar cómo suena y se siente la app."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el sonido de inicio, los efectos de sonido de la interfaz y la respuesta háptica para personalizar cómo suena y se siente la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدای راه‌اندازی، جلوه‌های صوتی رابط کاربری و بازخورد لمسی را تنظیم کن تا حس و صدای برنامه را شخصی‌سازی کنی."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä käynnistysääntä, käyttöliittymän äänitehosteita ja haptista palautetta ja personoi sovelluksen ääni ja tuntuma."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-adjust ang startup chime, UI sound effects, at haptic feedback para i-personalize kung paano tumunog at madama ang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste le carillon de démarrage, les effets sonores de l’interface et le retour haptique pour personnaliser le son et les sensations de l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כוונן את צליל הפתיחה, אפקטי הקול של הממשק והמשוב המישושי כדי להתאים אישית איך האפליקציה נשמעת ומרגישה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टार्टअप चाइम, UI साउंड इफेक्ट्स और हैप्टिक फीडबैक को एडजस्ट करें ताकि ऐप की आवाज़ और एहसास को अपने हिसाब से बना सको।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsd be az indítóhangot, a felület hangeffektjeit és a rezgő visszajelzést, hogy testreszabd, hogyan szól és hogyan érződik az app."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կարգավորիր գործարկման մեղեդին, ինտերֆեյսի ձայնային էֆեկտներն ու հապտիկ արձագանքը՝ անհատականացնելու համար, թե ինչպես է հնչում ու զգացվում հավելվածը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur nada pembuka, efek suara UI, dan umpan balik haptik untuk menyesuaikan bagaimana aplikasi terdengar dan terasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola il suono di avvio, gli effetti sonori dell'interfaccia e il feedback aptico per personalizzare il suono e le sensazioni dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動音、UI の効果音、触覚フィードバックを調整して、アプリの音や感触を自分好みにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작 차임, UI 음향 효과, 햅틱 피드백을 조정해 앱의 소리와 느낌을 나만의 방식으로 설정하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laraskan bunyi permulaan, kesan bunyi UI dan maklum balas haptik untuk memperibadikan cara apl berbunyi dan terasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster oppstartslyden, lydeffekter i grensesnittet og haptisk respons for å tilpasse hvordan appen høres ut og føles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas het startgeluid, de geluidseffecten en de haptische feedback aan om te bepalen hoe de app klinkt en aanvoelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj dźwięk powitalny, efekty dźwiękowe interfejsu oraz wibracje, aby spersonalizować to, jak aplikacja brzmi i reaguje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o som de abertura, os efeitos sonoros da interface e o retorno tátil para personalizar como o app soa e responde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta o som de arranque, os efeitos sonoros da interface e o feedback tátil para personalizar como a app soa e reage."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reglează sunetul de pornire, efectele sonore ale interfeței și feedbackul haptic pentru a personaliza cum sună și cum se simte aplicația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настрой звук запуска, звуковые эффекты интерфейса и тактильную отдачу, чтобы выбрать, как приложение звучит и ощущается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera startljudet, ljudeffekterna i gränssnittet och den haptiska återkopplingen för att anpassa hur appen låter och känns."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆப் எப்படி ஒலிக்கிறது மற்றும் உணரப்படுகிறது என்பதைத் தனிப்பயனாக்க, தொடக்க ஒலி, UI ஒலி விளைவுகள் மற்றும் ஹாப்டிக் பின்னூட்டத்தைச் சரிசெய்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "యాప్ ఎలా వినిపిస్తుందో, ఎలా అనిపిస్తుందో మీకు నచ్చినట్టు మార్చుకోవడానికి స్టార్టప్ చైమ్, UI సౌండ్ ఎఫెక్ట్‌లు, హాప్టిక్ ఫీడ్‌బ్యాక్‌ని సర్దుబాటు చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับเสียงต้อนรับตอนเปิดแอป เอฟเฟกต์เสียง UI และการสั่นตอบสนอง เพื่อปรับแต่งเสียงและสัมผัสของแอปในแบบของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılış sesini, arayüz ses efektlerini ve dokunsal geri bildirimi ayarlayarak uygulamanın nasıl çaldığını ve hissettirdiğini kişiselleştir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуй звук запуску, звукові ефекти інтерфейсу та тактильний відгук, щоб персоналізувати звучання й відчуття від застосунку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسٹارٹ اپ کی چائم، UI ساؤنڈ ایفیکٹس، اور ہیپٹک فیڈ بیک کو ایڈجسٹ کرو تاکہ ایپ کی آواز اور احساس کو اپنے مطابق بنا سکو۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh âm báo khởi động, hiệu ứng âm thanh giao diện và phản hồi rung để cá nhân hóa cách ứng dụng nghe và cảm nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整启动提示音、界面音效和触感反馈，自定义 App 的声音与手感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整啟動鈴聲、介面音效與觸覺回饋，打造專屬的應用程式聲音與手感。"
          }
        }
      }
    },

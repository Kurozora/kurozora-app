        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állíts be egy alapértelmezett böngészőt a weblinkek megnyitásához. Ha a kiválasztott app nincs telepítve, a linkek tartalékként a Safariban nyílnak meg."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սահմանիր կանխադրված դիտարկիչ՝ վեբ հղումներ բացելու համար։ Եթե ընտրված հավելվածը տեղադրված չէ, հղումները կբացվեն Safari-ում՝ որպես այլընտրանք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur peramban bawaan untuk membuka tautan web. Jika aplikasi yang dipilih tidak terpasang, tautan dibuka di Safari sebagai cadangan."

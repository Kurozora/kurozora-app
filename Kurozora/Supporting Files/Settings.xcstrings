{
  "sourceLanguage": "en",
  "strings": {
    "Add Sticker to Signal": {
      "comment": "The string for the 'Add Sticker to Signal' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker toevoegen aan Signal"
          }
        }
      }
    },
    "Add Sticker to Telegram": {
      "comment": "The string for the 'Add Sticker to Telegram' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker toevoegen aan Telegram"
          }
        }
      }
    },
    "Add Sticker to WhatsApp": {
      "comment": "The string for the 'Add Sticker to WhatsApp' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sticker toevoegen aan WhatsApp"
          }
        }
      }
    },
    "Adjust the startup chime, UI sound effects, and haptic feedback to personalize how the app sounds and feels.": {
      "comment": "A short description for the sounds and haptics settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas het startgeluid, de geluidseffecten en de haptische feedback aan om te bepalen hoe de app klinkt en aanvoelt."
          }
        }
      }
    },
    "All keychain entries have been removed.": {
      "comment": "The empty-state detail for the debug keychain list when no keys remain.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle sleutelhangeritems zijn verwijderd."
          }
        }
      }
    },
    "Allow Notifications": {
      "comment": "The title string for the 'Allow Notifications' settings.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen toestaan"
          }
        }
      }
    },
    "Animations": {
      "comment": "The string for the 'Animations' settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animaties"
          }
        }
      }
    },
    "App Icon": {
      "comment": "The title string for the 'App Icon' settings.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App-symbool"
          }
        }
      }
    },
    "Appearance": {
      "comment": "The 'Appearance' settings section header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergave"
          }
        }
      }
    },
    "Appearance Schedule": {
      "comment": "The title of the appearance schedule screen.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergaveschema"
          }
        }
      }
    },
    "Apply Theme": {
      "comment": "The menu button for applying a downloaded theme.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thema toepassen"
          }
        }
      }
    },
    "Automatically transition appearance between light and dark based on time preference.": {
      "comment": "The footer for the appearance schedule option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel automatisch tussen licht en donker op basis van je tijdsvoorkeur."
          }
        }
      }
    },
    "Blindness": {
      "comment": "The 'Blindness' settings section header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blindheid"
          }
        }
      }
    },
    "Built with lack of 😴, lots of 🍵 and 🌸 allergy by Kirito\nKurozora %@ (%@)": {
      "comment": "The about-section credit footer.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Built with lack of 😴, lots of 🍵 and 🌸 allergy by Kirito\nKurozora %1$@ (%2$@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebouwd met te weinig 😴, veel 🍵 en 🌸-allergie door Kirito\nKurozora %1$@ (%2$@)"
          }
        }
      }
    },
    "Chime & Sound Effects": {
      "comment": "The string for the 'Chime & Sound Effects' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Startgeluid en geluidseffecten"
          }
        }
      }
    },
    "Chime on Startup": {
      "comment": "The string for the 'Chime on Startup' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Startgeluid bij opstarten"
          }
        }
      }
    },
    "Chime Sound": {
      "comment": "The string for the 'Chime Sound' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Startgeluid"
          }
        }
      }
    },
    "Choose a default browser in which web links will be opened. If you don't have the app installed then the links will open inside Safari as a fallback.": {
      "comment": "The footer for the browser settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een standaardbrowser waarin weblinks worden geopend. Als je de app niet hebt geïnstalleerd, openen de links als terugval in Safari."
          }
        }
      }
    },
    "Choose where to subscribe to your Kurozora reminders. If the selected app isn't installed, the link will open in Safari as a fallback.": {
      "comment": "The footer string for the reminder subscription picker.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies waar je je Kurozora-herinneringen wilt volgen. Als de gekozen app niet is geïnstalleerd, opent de link als terugval in Safari."
          }
        }
      }
    },
    "Clear All": {
      "comment": "The title string for the 'Clear All' destructive button.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wis alles"
          }
        }
      }
    },
    "Clear all Cache?": {
      "comment": "The title string for the 'Clear all Cache?' alert.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle cache wissen?"
          }
        }
      }
    },
    "Cloudless.": {
      "comment": "The string for sky theme description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbewolkt."
          }
        }
      }
    },
    "Control animations and visual effects throughout the app, including the splash screen animation and reduced motion preferences.": {
      "comment": "A short description for the motion settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer animaties en visuele effecten in de hele app, waaronder de startschermanimatie en de voorkeuren voor verminderde beweging."
          }
        }
      }
    },
    "Copy Subscription Link": {
      "comment": "The string for the 'Copy Subscription Link' calendar picker option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementslink kopiëren"
          }
        }
      }
    },
    "Couldn’t Add Sticker Pack": {
      "comment": "The title of the alert shown when adding the WhatsApp sticker pack fails.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stickerpakket niet toevoegen"
          }
        }
      }
    },
    "Customize how your library is organized by setting the default sort order for each tracking status and media type.": {
      "comment": "A short description for the library settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal hoe je bibliotheek is geordend door de standaardsortering per volgstatus en mediatype in te stellen."
          }
        }
      }
    },
    "Dark": {
      "comment": "The 'Dark' appearance option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Donker"
          }
        }
      }
    },
    "Dark Until %@": {
      "comment": "The appearance schedule value for dark until a specific time.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Donker tot %@"
          }
        }
      }
    },
    "Dark Until Sunrise": {
      "comment": "The appearance schedule value for dark until sunrise.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Donker tot zonsopgang"
          }
        }
      }

    "Require authentication to unlock the app and choose how frequently you need to verify your identity.": {
      "comment": "A short description for the authentication settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereis verificatie om de app te ontgrendelen en kies hoe vaak u uw identiteit moet bevestigen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب المصادقة لإلغاء قفل التطبيق، واختر عدد مرات التحقق من هويتك."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere autenticación para desbloquear la app y elija con qué frecuencia debe verificar su identidad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajibkan autentikasi untuk membuka aplikasi dan pilih seberapa sering Anda perlu memverifikasi identitas Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのロック解除に認証を必要とし、本人確認の頻度を選択できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exija autenticação para desbloquear o app e escolha com que frequência você precisa verificar sua identidade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordern Sie eine Authentifizierung zum Entsperren der App und legen Sie fest, wie häufig Sie Ihre Identität bestätigen müssen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigez une authentification pour déverrouiller l’app et choisissez la fréquence à laquelle vous devez vérifier votre identité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi l'autenticazione per sbloccare l'app e scegli con quale frequenza è necessario verificare la propria identità."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잠금 해제 시 인증을 요구하고, 본인 확인이 필요한 빈도를 선택하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagaj uwierzytelnienia do odblokowania aplikacji i wybierz, jak często należy potwierdzać tożsamość."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуйте аутентификацию для разблокировки приложения и выберите, как часто нужно подтверждать вашу личность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求验证身份以解锁 App，并选择需要验证身份的频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求驗證以解鎖應用程式，並選擇需要驗證身分的頻率。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดให้ต้องยืนยันตัวตนเพื่อปลดล็อกแอป และเลือกความถี่ในการยืนยันตัวตนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın kilidini açmak için kimlik doğrulama gerektirin ve kimliğinizi ne sıklıkta doğrulamanız gerektiğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагайте автентифікацію для розблокування застосунку та оберіть, як часто потрібно підтверджувати свою особу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu xác thực để mở khóa ứng dụng và chọn tần suất bạn cần xác minh danh tính."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiera autenticación para desbloquear la app y elija con qué frecuencia debe verificar su identidad."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilingin ang authentication para i-unlock ang app at piliin kung gaano kadalas kailangang i-verify ang iyong pagkakakilanlan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप अनलॉक करने के लिए प्रमाणीकरण आवश्यक करें और चुनें कि आपको कितनी बार अपनी पहचान सत्यापित करनी है।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای باز کردن قفل برنامه احراز هویت را الزامی کنید و انتخاب کنید هر چند وقت یک‌بار باید هویت خود را تأیید کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דרשו אימות כדי לבטל את נעילת האפליקציה ובחרו באיזו תדירות יש לאמת את זהותכם."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan pengesahan untuk membuka kunci apl dan pilih kekerapan anda perlu mengesahkan identiti anda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitați autentificarea pentru deblocarea aplicației și alegeți cât de des trebuie să vă verificați identitatea."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräv autentisering för att låsa upp appen och välj hur ofta du behöver verifiera din identitet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžadovat ověření pro odemčení aplikace a zvolit, jak často je nutné potvrdit vaši totožnost."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτήστε ταυτοποίηση για το ξεκλείδωμα της εφαρμογής και επιλέξτε πόσο συχνά χρειάζεται να επιβεβαιώνετε την ταυτότητά σας."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ আনলক করতে প্রমাণীকরণ আবশ্যক করুন এবং কত ঘন ঘন আপনাকে নিজের পরিচয় যাচাই করতে হবে তা নির্বাচন করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்பைத் திறக்க அங்கீகாரத்தைக் கோரவும், மேலும் உங்கள் அடையாளத்தை எவ்வளவு அடிக்கடி சரிபார்க்க வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌ను అన్‌లాక్ చేయడానికి ప్రామాణీకరణ అవసరం అని సెట్ చేయండి, మీ గుర్తింపును ఎంత తరచుగా ధృవీకరించాలో ఎంచుకోండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv godkendelse for at låse appen op, og vælg, hvor ofte du skal bekræfte din identitet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaadi todennus sovelluksen avaamiseksi ja valitse, kuinka usein henkilöllisyytesi on vahvistettava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app feloldásához hitelesítés szükséges, és kiválaszthatja, milyen gyakran kell igazolnia a személyazonosságát."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Krev autentisering for å låse opp appen, og velg hvor ofte du må bekrefte identiteten din."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کو ان لاک کرنے کے لیے توثیق لازمی کریں اور منتخب کریں کہ آپ کو کتنی بار اپنی شناخت کی تصدیق کرنی ہے۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exija autenticação para desbloquear a aplicação e escolha com que frequência precisa de verificar a sua identidade."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահանջեք նույնականացում՝ հավելվածն ապակողպելու համար, և ընտրեք, թե որքան հաճախ պետք է հաստատեք Ձեր ինքնությունը։"
          }
        }
      }
    },

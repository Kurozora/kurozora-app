    "Automatically transition appearance between light and dark based on time preference.": {
      "comment": "The footer for the appearance schedule option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel automatisch tussen licht en donker op basis van je tijdsvoorkeur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل تلقائيًا بين المظهر الفاتح والداكن بناءً على تفضيل الوقت."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia automáticamente la apariencia entre claro y oscuro según tu preferencia de horario."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatis beralih tampilan antara terang dan gelap berdasarkan preferensi waktu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間設定に応じて、ライトとダークの外観を自動で切り替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne a aparência entre claro e escuro automaticamente conforme a preferência de horário."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle das Erscheinungsbild automatisch zwischen Hell und Dunkel je nach Zeiteinstellung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule automatiquement l’apparence entre clair et sombre selon ta préférence horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa automaticamente l'aspetto tra chiaro e scuro in base alla preferenza oraria."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 시간에 따라 라이트와 다크 모드를 자동으로 전환합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie przełączaj wygląd między jasnym a ciemnym w zależności od ustawień czasu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически переключай светлый и тёмный вид в зависимости от выбранного времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据时间偏好在浅色与深色外观之间自动切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依時間偏好自動在淺色與深色外觀之間切換。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับรูปลักษณ์ระหว่างสว่างและมืดโดยอัตโนมัติตามเวลาที่ตั้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünümü, zaman tercihine göre açık ve koyu arasında otomatik olarak geçir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично перемикай вигляд між світлим і темним залежно від часу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động chuyển giao diện giữa sáng và tối dựa trên tùy chọn thời gian."
          }
        }
      }
    },

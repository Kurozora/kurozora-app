      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht"
          }
        }
      }
    },
    "Light Until %@": {
      "comment": "The appearance schedule value for light until a specific time.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht tot %@"
          }
        }
      }
    },
    "Light Until Sunset": {
      "comment": "The appearance schedule value for light until sunset.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht tot zonsondergang"
          }
        }
      }
    },
    "Manage Active Sessions": {
      "comment": "The title string for the 'Manage Active Sessions' settings.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve sessies beheren"
          }
        }
      }
    },
    "Manage in-app notification preferences including sounds, badges, and how notifications are grouped together.": {
      "comment": "A short description for the notifications settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer de meldingsvoorkeuren in de app, waaronder geluiden, badges en hoe meldingen worden gegroepeerd."
          }
        }
      }
    },
    "Manage your app experience by clearing temporary files, downloaded content, and cached media used for faster loading and offline viewing.": {
      "comment": "A short description for the cache settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer je app-ervaring door tijdelijke bestanden, gedownloade inhoud en media in de cache te wissen die worden gebruikt voor sneller laden en offline kijken."
          }
        }
      }
    },
    "Mention": {
      "comment": "The string for the 'mention' notification type.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermelding"
          }
        }
      }
    },
    "Moderation": {
      "comment": "The string for the 'moderation' notification type",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderatie"
          }
        }
      }
    },
    "New Session": {
      "comment": "The string for the 'new session' notification type",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe sessie"
          }
        }
      }
    },
    "No Keys": {
      "comment": "The empty-state title for the debug keychain list when no keys remain.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen sleutels"
          }
        }
      }
    },
    "Notification Grouping": {
      "comment": "The title string for the 'Notification Grouping' settings.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen groeperen"
          }
        }
      }
    },
    "Optic ID & Passcode": {
      "comment": "The string for the 'Optic ID & Passcode' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optic ID en toegangscode"
          }
        }
      }
    },
    "Pick a calendar app to subscribe to your Kurozora reminders, or copy the subscription link to use elsewhere.": {
      "comment": "A short description for the reminder subscription settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een agenda-app om je Kurozora-herinneringen te volgen, of kopieer de abonnementslink om elders te gebruiken."
          }
        }
      }
    },
    "Rate us on App Store": {
      "comment": "The string for the 'Rate us on App Store' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeel ons in de App Store"
          }
        }
      }
    },
    "Receive notifications inside Kurozora while using the app. This is separate from systemwide notifications for Kurozora.": {
      "comment": "The footer for the in-app notifications option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang meldingen in Kurozora terwijl je de app gebruikt. Dit staat los van systeembrede meldingen voor Kurozora."
          }
        }
      }
    },
    "Redownload Theme": {
      "comment": "The action sheet button for redownloading an already-purchased theme.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thema opnieuw downloaden"
          }
        }
      }
    },
    "Reduce Motion": {
      "comment": "The string for the 'Reduce Motion' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder beweging"
          }
        }
      }
    },
    "Reduce the intensity of animations, and motion effects throughout Kurozora.": {
      "comment": "The footer string for the 'Reduce Motion' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verminder de intensiteit van animaties en bewegingseffecten in heel Kurozora."
          }
        }
      }
    },
    "Remove Theme": {
      "comment": "The destructive action sheet button for removing a downloaded theme.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thema verwijderen"
          }
        }
      }
    },
    "Request Refund": {
      "comment": "The string for the 'Request Refund' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugbetaling aanvragen"
          }
        }
      }
    },
    "Require authentication to unlock the app and choose how frequently you need to verify your identity.": {
      "comment": "A short description for the authentication settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereis verificatie om de app te ontgrendelen en kies hoe vaak u uw identiteit moet bevestigen."
          }
        }
      }
    },
    "Restore Purchase": {
      "comment": "The string for the 'Restore Purchase' settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen herstellen"
          }
        }
      }
    },
    "Review your privacy settings, manage app permissions in the Settings app, manage blocked accounts, and access legal information.": {
      "comment": "A short description for the privacy settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk uw privacyinstellingen, beheer app-machtigingen in de app Instellingen, beheer geblokkeerde accounts en raadpleeg juridische informatie."
          }
        }
      }
    },
    "Rise and shine.": {
      "comment": "The string for day theme description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opstaan en stralen."
          }
        }
      }
    },
    "Select library": {
      "comment": "The placeholder shown before a library kind is chosen on the delete library screen.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheek selecteren"
          }
        }
      }
    },
    "Set a default browser for opening web links. If the selected app isn't installed, links open in Safari as a fallback.": {
      "comment": "A short description for the browser settings header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een standaardbrowser in voor het openen van weblinks. Als de gekozen app niet is geïnstalleerd, openen links als terugval in Safari."
          }
        }
      }
    },
    "Setup Kurozora Account and more.": {
      "comment": "The sub-headline string for the account settings option when not signed in.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je Kurozora-account in en meer."
          }
        }
      }
    },
    "Sign In": {
      "comment": "The string for the 'sign in' action.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen"
          }
        }
      }
    },
    "Sign in to your Kurozora account": {
      "comment": "The headline string for the account settings option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in op je Kurozora-account"
          }
        }
      }
    },
    "Sign in with Apple": {
      "comment": "The title string for the 'Sign in with Apple' settings.",
      "localizations": {

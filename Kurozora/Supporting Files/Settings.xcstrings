        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ստացիր ծանուցումներ Kurozora-ի ներսում՝ հավելվածն օգտագործելու ընթացքում։ Սա առանձին է Kurozora-ի համակարգային ծանուցումներից։"

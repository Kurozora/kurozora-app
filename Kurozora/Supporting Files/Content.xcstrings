          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld deel"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld delen"
                }
              }
            }
          }
        }
      }

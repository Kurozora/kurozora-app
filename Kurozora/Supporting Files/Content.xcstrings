        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când vei avea notificări, le vei vedea aici!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du har aviseringar visas de här!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až budeš mít nějaká oznámení, uvidíš je tady!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν έχεις ειδοποιήσεις, θα τις βλέπεις εδώ!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যখন আপনার নোটিফিকেশন থাকবে, আপনি সেগুলো এখানে দেখতে পাবেন!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்கு அறிவிப்புகள் இருக்கும்போது, அவற்றை இங்கே பார்ப்பீர்கள்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు నోటిఫికేషన్‌లు వచ్చినప్పుడు, వాటిని ఇక్కడ చూస్తారు!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har notifikationer, kan du se dem her!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun sinulla on ilmoituksia, näet ne täällä!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amint értesítéseid lesznek, itt fognak megjelenni!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har varsler, vil du se dem her!"

    "Welcome to Kurozora! Introduce yourself to get started (^_^)/" : {
      "comment" : "The new-user badge description shown on your own profile.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا بك في Kurozora! عرّف بنفسك للبدء (^_^)/"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurozora-তে স্বাগতম! শুরু করতে নিজের পরিচয় দিন (^_^)/"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vítej na Kurozoře! Začni tím, že se představíš (^_^)/"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen til Kurozora! Præsentér dig selv for at komme i gang (^_^)/"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei Kurozora! Stell dich vor, um loszulegen (^_^)/"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καλώς ήρθες στο Kurozora! Σύστησε τον εαυτό σου για να ξεκινήσεις (^_^)/"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

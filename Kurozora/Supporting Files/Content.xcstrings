        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày phát hành vẫn chưa được công bố."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha anunciado una fecha de estreno."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa naipapahayag ang petsa ng paglabas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ की तारीख़ अभी घोषित होनी बाकी है।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ انتشار هنوز اعلام نشده است."

    "Library is currently available to registered Kurozora users only." : {
      "comment" : "The library empty-state detail shown when signed out.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكتبة متاحة حالياً لمستخدمي Kurozora المسجلين فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইব্রেরি বর্তমানে শুধুমাত্র নিবন্ধিত Kurozora ব্যবহারকারীদের জন্য উপলব্ধ।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovna je momentálně dostupná pouze registrovaným uživatelům Kurozora."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteket er i øjeblikket kun tilgængeligt for registrerede Kurozora-brugere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bibliothek ist derzeit nur für registrierte Kurozora-Nutzer verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η βιβλιοθήκη είναι προς το παρόν διαθέσιμη μόνο σε εγγεγραμμένους χρήστες του Kurozora."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biblioteca solo está disponible por ahora para usuarios registrados de Kurozora."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora, la biblioteca solo está disponible para usuarios registrados de Kurozora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کتابخانه در حال حاضر فقط برای کاربران ثبت‌نام‌شدهٔ Kurozora در دسترس است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjasto on tällä hetkellä käytettävissä vain rekisteröityneille Kurozora-käyttäjille."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",

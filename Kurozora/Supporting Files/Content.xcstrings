    "Thank you for helping keep the community safe.": {
      "comment": "The subheadline string for the report message pop-up\nThe subheadline string for the report review pop-up",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt dat je de community veilig helpt houden."
          }
        },
        "ar": {
          "stringUnit": {

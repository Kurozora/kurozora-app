        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι βαθμολογίες και οι κριτικές που υποβάλλεις θα εμφανίζονται εδώ. "
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি যেসব রেটিং ও রিভিউ জমা দেবে তা এখানে দেখা যাবে। "
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சமர்ப்பிக்கும் மதிப்பீடுகளும் விமர்சனங்களும் இங்கே தோன்றும். "
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇచ్చే రేటింగ్‌లు, రివ్యూలు ఇక్కడ కనిపిస్తాయి. "
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedømmelser og anmeldelser, du sender ind, vises her. "
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antamasi arvosanat ja arvostelut näkyvät täällä. "
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad beküldött értékelések és vélemények itt jelennek meg. "
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurderinger og anmeldelser du sender inn, vises her. "
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی جمع کرائی گئی درجہ بندیاں اور جائزے یہاں ظاہر ہوں گے۔ "
          }
        },
        "pt-PT": {

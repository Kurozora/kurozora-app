    "Your rating and review will be removed.": {
      "comment": "The body string for the confirmation dialog when the user clears their rating or deletes their review.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beoordeling en recensie worden verwijderd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف تقييمك ومراجعتك."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tu calificación y tu reseña."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rating dan ulasanmu akan dihapus."
          }
        },
        "ja": {

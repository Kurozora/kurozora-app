    "Add a %@ to your %@ list and it will show up here." : {
      "comment" : "The library empty-state prompt to add an item to a list.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف %1$@ إلى قائمة %2$@ وسيظهر هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার %2$@ তালিকায় একটি %1$@ যোগ করুন, তাহলে তা এখানে দেখা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidej %1$@ do seznamu %2$@ a objeví se tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en %1$@ til din %2$@-liste, så vises den her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein %1$@ zu deiner %2$@-Liste hinzu, und es erscheint hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε ένα %1$@ στη λίστα %2$@ και θα εμφανιστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add a %1$@ to your %2$@ list and it will show up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un %1$@ a tu lista de %2$@ y aparecerá aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega un %1$@ a tu lista de %2$@ y aparecerá aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏یک %1$@ به فهرست %2$@ خود اضافه کن تا اینجا نمایش داده شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kohde %1$@ listallesi %2$@, niin se näkyy täällä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng %1$@ sa iyong %2$@ list at lalabas ito dito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un %1$@ à ta liste %2$@ et il apparaîtra ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפו %1$@ לרשימת ה-%2$@ שלכם והוא יופיע כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी %2$@ सूची में कोई %1$@ जोड़ें और वह यहाँ दिखाई देगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj hozzá egy %1$@ a(z) %2$@ listádhoz, és itt fog megjelenni."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ավելացրեք %1$@ ձեր %2$@ ցանկում, և այն կհայտնվի այստեղ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan %1$@ ke daftar %2$@ kamu dan akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un %1$@ alla tua lista %2$@ e comparirà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を%2$@リストに追加すると、ここに表示されます。"

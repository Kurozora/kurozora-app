            "state": "translated",
            "value": "Սա «որտեղ դիտել» հարց է՞"
          }
        }
      }
    },
    "It looks like we don't have an evaluation for this category yet.": {
      "comment": "The Parental Guide empty-category message.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lijkt erop dat we voor deze categorie nog geen beoordeling hebben."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنه ليس لدينا تقييم لهذه الفئة بعد."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que aún no tenemos una evaluación para esta categoría."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya kami belum punya penilaian untuk kategori ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカテゴリーの評価はまだないようです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que ainda não temos uma avaliação para esta categoria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anscheinend haben wir für diese Kategorie noch keine Bewertung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble que nous n’ayons pas encore d’évaluation pour cette catégorie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che non ci sia ancora una valutazione per questa categoria."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이 카테고리에 대한 평가가 없는 것 같아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że nie mamy jeszcze oceny dla tej kategorii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, по этой категории у нас пока нет оценки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看起来我们还没有针对此类别的评估。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看來我們還沒有這個類別的評估。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนว่าเรายังไม่มีการประเมินสำหรับหมวดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüşe göre bu kategori için henüz bir değerlendirmemiz yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, для цієї категорії ще немає оцінки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có vẻ như chúng tôi chưa có đánh giá cho hạng mục này."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que aún no tenemos una valoración para esta categoría."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang wala pa kaming ebalwasyon para sa kategoryang ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा लगता है कि इस श्रेणी के लिए हमारे पास अभी तक कोई मूल्यांकन नहीं है।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá to, že pro tuto kategorii zatím nemáme hodnocení."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر می‌رسد هنوز ارزیابی‌ای برای این دسته نداریم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שעדיין אין לנו הערכה לקטגוריה זו."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nampaknya kami belum mempunyai penilaian untuk kategori ini lagi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că încă nu avem o evaluare pentru această categorie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det verkar som att vi inte har någon bedömning för den här kategorin än."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαίνεται πως δεν έχουμε ακόμα αξιολόγηση για αυτή την κατηγορία."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মনে হচ্ছে এই বিভাগের জন্য আমাদের কাছে এখনও কোনো মূল্যায়ন নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வகைக்கான மதிப்பீடு இன்னும் எங்களிடம் இல்லை போலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ కేటగిరీకి మా వద్ద ఇంకా మూల్యాంకనం లేనట్టుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ud til, at vi endnu ikke har en vurdering for denne kategori."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää siltä, ettei tälle kategorialle ole vielä arviota."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik, ehhez a kategóriához még nincs értékelésünk."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ut til at vi ikke har en vurdering for denne kategorien ennå."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que ainda não temos uma avaliação para esta categoria."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",

    "You can view public posts from %@, but you are blocked from engaging with them. You also cannot follow or message %@.": {
      "comment": "Subheadline explaining what is restricted when the auth user has been blocked by another user. Both arguments are the @username of the blocking user.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You can view public posts from %1$@, but you are blocked from engaging with them. You also cannot follow or message %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt openbare berichten van %1$@ bekijken, maar je mag er niet mee interacteren. Je kunt %2$@ ook niet volgen of een bericht sturen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك عرض المنشورات العامة من %1$@، لكنك محظور من التفاعل معها. كما لا يمكنك متابعة %2$@ أو مراسلته."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ver las publicaciones públicas de %1$@, pero tienes bloqueada la interacción con ellas. Tampoco puedes seguir a %2$@ ni enviarle mensajes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat melihat postingan publik dari %1$@, tetapi Anda diblokir untuk berinteraksi dengannya. Anda juga tidak dapat mengikuti atau mengirim pesan kepada %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ さんの公開投稿は閲覧できますが、それらへの反応はブロックされています。また、%2$@ さんをフォローしたりメッセージを送ったりすることもできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ver as publicações públicas de %1$@, mas está bloqueado para interagir com elas. Você também não pode seguir nem enviar mensagens para %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können öffentliche Beiträge von %1$@ sehen, aber Sie sind von der Interaktion mit ihnen ausgeschlossen. Sie können %2$@ auch nicht folgen oder Nachrichten senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez voir les posts publics de %1$@, mais vous ne pouvez pas interagir avec eux. Vous ne pouvez pas non plus suivre %2$@ ni lui envoyer de message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi vedere i post pubblici di %1$@, ma sei stato bloccato e non puoi interagirvi. Inoltre non puoi seguire né inviare messaggi a %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 공개 게시물은 볼 수 있지만, 게시물에 반응하는 것은 차단되어 있습니다. 또한 %2$@을(를) 팔로우하거나 메시지를 보낼 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyświetlać publiczne posty użytkownika %1$@, ale interakcje z nimi są dla Ciebie zablokowane. Nie możesz również obserwować użytkownika %2$@ ani wysyłać mu wiadomości."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете просматривать публичные посты пользователя %1$@, но вам запрещено взаимодействовать с ними. Вы также не можете подписаться на пользователя %2$@ или написать ему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以查看 %1$@ 的公开帖子，但已被禁止与之互动。你也无法关注 %2$@ 或向其发送消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以查看 %1$@ 的公開貼文，但您已被封鎖而無法與其互動。您也無法追蹤 %2$@ 或傳送訊息給對方。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถดูโพสต์สาธารณะจาก %1$@ ได้ แต่คุณถูกบล็อกไม่ให้มีปฏิสัมพันธ์กับโพสต์เหล่านั้น คุณยังไม่สามารถติดตามหรือส่งข้อความถึง %2$@ ได้อีกด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kullanıcısının herkese açık gönderilerini görüntüleyebilirsiniz, ancak onlarla etkileşime girmeniz engellenmiştir. Ayrıca %2$@ kullanıcısını takip edemez veya ona mesaj gönderemezsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете переглядати публічні дописи від %1$@, але вам заблоковано взаємодію з ними. Ви також не можете підписатися на %2$@ чи надіслати повідомлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem các bài đăng công khai từ %1$@, nhưng bạn bị chặn không được tương tác với chúng. Bạn cũng không thể theo dõi hoặc nhắn tin cho %2$@."
          }
        }
      }
    },
    "You have exceeded the character limit for a message.": {
      "comment": "The subheadline string for the character limit reached error pop-up",

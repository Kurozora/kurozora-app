    "Can't get %@ list. Please refresh the page or restart the app and check your WiFi connection.": {
      "comment": "The empty-state detail shown when a list could not be fetched, asking to refresh.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de lijst met %@ niet ophalen. Ververs de pagina of herstart de app en controleer je wifiverbinding."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحصول على قائمة %@. يُرجى تحديث الصفحة أو إعادة تشغيل التطبيق والتحقق من اتصال WiFi."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la lista de %@. Actualiza la página o reinicia la app y revisa tu conexión WiFi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa memuat daftar %@. Segarkan halaman atau mulai ulang aplikasi dan periksa koneksi WiFi kamu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@リストを取得できません。ページを更新するかアプリを再起動して、WiFi接続を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a lista de %@. Atualize a página ou reinicie o app e verifique sua conexão WiFi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Liste kann nicht geladen werden. Bitte aktualisiere die Seite oder starte die App neu und überprüfe deine WLAN-Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir la liste %@. Actualise la page ou redémarre l'app et vérifie ta connexion WiFi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recuperare la lista %@. Aggiorna la pagina o riavvia l'app e controlla la tua connessione WiFi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 목록을 가져올 수 없어요. 페이지를 새로고침하거나 앱을 다시 시작하고 WiFi 연결을 확인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można pobrać listy %@. Odśwież stronę lub uruchom ponownie aplikację i sprawdź połączenie WiFi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить список «%@». Обнови страницу или перезапусти приложение и проверь подключение к Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取%@列表。请刷新页面或重启应用，并检查你的 WiFi 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得%@清單。請重新整理頁面或重新啟動 app，並檢查你的 WiFi 連線。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถดึงลิสต์ %@ ได้ กรุณารีเฟรชหน้านี้หรือเปิดแอปใหม่ และตรวจสอบการเชื่อมต่อ WiFi ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ listesi alınamıyor. Lütfen sayfayı yenile veya uygulamayı yeniden başlat ve WiFi bağlantını kontrol et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати список «%@». Оновіть сторінку або перезапустіть застосунок і перевірте з’єднання WiFi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lấy danh sách %@. Vui lòng làm mới trang hoặc khởi động lại ứng dụng và kiểm tra kết nối WiFi của bạn."
          }
        }
      }
    },
    "Can't get %@ list. Please reload the page or restart the app and check your WiFi connection.": {

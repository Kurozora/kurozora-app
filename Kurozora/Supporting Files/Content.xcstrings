    "Are you sure you want to delete this entry?" : {
      "comment" : "The confirmation message shown before deleting a Parental Guide entry.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد من رغبتك في حذف هذا الإدخال؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কি নিশ্চিতভাবে এই এন্ট্রিটি মুছে ফেলতে চান?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu chcete tento záznam smazat?"

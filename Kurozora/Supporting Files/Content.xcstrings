    "Are you sure you want to delete this entry?": {
      "comment": "The confirmation message shown before deleting a Parental Guide entry.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je dit item wilt verwijderen?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من رغبتك في حذف هذا الإدخال؟"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar esta entrada?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus entri ini?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエントリーを削除してもよろしいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir esta entrada?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie diesen Eintrag wirklich löschen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer cette entrée ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero eliminare questa voce?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목을 삭제하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć ten wpis?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить эту запись?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要删除此条目吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要刪除這個項目嗎？"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการลบรายการนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu girişi silmek istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити цей запис?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa mục này không?"
          }
        }
      }
    },
    "Are you sure you want to view these posts? Viewing posts won’t unblock %@.": {
      "comment": "Subheadline prompting the auth user to opt in to viewing a blocked user's posts. The argument is the @username of the blocked user.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze berichten wilt bekijken? Berichten bekijken deblokkeert %@ niet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من رغبتك في عرض هذه المنشورات؟ عرض المنشورات لن يؤدي إلى إلغاء حظر %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas ver estas publicaciones? Verlas no desbloqueará a %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin melihat kiriman ini? Melihat kiriman tidak akan membatalkan blokir %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの投稿を表示してもよろしいですか？投稿を表示しても%@さんのブロックは解除されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja ver estes posts? Vê-los não desbloqueará %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie diese Beiträge wirklich ansehen? Das Ansehen der Beiträge hebt die Blockierung von %@ nicht auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment voir ces posts ? Les consulter ne débloquera pas %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero visualizzare questi post? Visualizzarli non sbloccherà %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게시물을 보시겠습니까? 게시물을 보더라도 %@님의 차단이 해제되지는 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz zobaczyć te posty? Wyświetlenie postów nie odblokuje użytkownika %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите просмотреть эти посты? Просмотр постов не разблокирует %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要查看这些帖子吗？查看帖子不会解除对 %@ 的屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要查看這些貼文嗎？查看貼文並不會解除對 %@ 的封鎖。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการดูโพสต์เหล่านี้ การดูโพสต์จะไม่เป็นการเลิกบล็อก %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gönderileri görüntülemek istediğinizden emin misiniz? Gönderileri görüntülemek %@ kullanıcısının engelini kaldırmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете переглянути ці дописи? Перегляд дописів не розблокує %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xem những bài viết này không? Việc xem bài viết sẽ không bỏ chặn %@."
          }
        }
      }
    },

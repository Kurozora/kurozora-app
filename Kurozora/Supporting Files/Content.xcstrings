        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Találd ki a rejtett szót hat próbálkozásból. Minden válasz öt betűből áll, és közvetlenül a Kurozora katalógusából származik: anime-, manga-, játék- és dalcímek, valamint karakterek, személyek és stúdiók."
          }
        },
        "hy" : {

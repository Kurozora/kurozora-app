    "%lldd": {
      "comment": "The compact day count in a broadcast countdown.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldd"
          }
        }
      }
    },
    "%lldh": {
      "comment": "The compact hour count in a broadcast countdown.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldu"
          }
        }
      }
    },
    "%lldm": {
      "comment": "The compact minute count in a broadcast countdown.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldm"
          }
        }
      }
    },
    "%lldM": {
      "comment": "The compact month count in a broadcast countdown.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldmnd"
          }
        }
      }
    },
    "%llds": {
      "comment": "The compact second count in a broadcast countdown.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%llds"
          }
        }
      }
    },
    "＋ Follow": {
      "comment": "The user-cell follow button title when the current user is not yet following the target user.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ Volgen"
          }
        }
      }
    },
    "＋ Follow %@": {
      "comment": "The empty-state action button shown on another user's empty followers list. '%@' is the target user's display name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ %@ volgen"
          }
        }
      }
    },
    "+%lld More Languages": {
      "comment": "The label shown when several more languages are available.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld meer talen"
          }
        }
      }
    },
    "+1 More Language": {
      "comment": "The label shown when one more language is available.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "+1 meer taal"
          }
        }
      }
    },
    "✓ Following": {
      "comment": "The user-cell follow button title when the current user is following the target user.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ Volgend"
          }
        }
      }
    },
    "4-Koma Manga": {
      "comment": "The display value '4-Koma Manga'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "4-koma-manga"
          }
        }
      }
    },
    "A release date has yet to be announced.": {
      "comment": "The footnote shown when an episode's release date is unannounced.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er moet nog een releasedatum worden aangekondigd."
          }
        }
      }
    },
    "Achievements you earn show up here.": {
      "comment": "Empty-state detail for the achievements list when viewing your own profile.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaties die je verdient, verschijnen hier."
          }
        }
      }
    },
    "Across %@.": {
      "comment": "The footnote summarizing how content is spread across units, as in 'Across 5 seasons.'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verspreid over %@."
          }
        }
      }
    },
    "Act": {
      "comment": "The display value 'Act'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Act"
          }
        }
      }
    },
    "Active Developer": {
      "comment": "The title shown on the developer profile badge.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve ontwikkelaar"
          }
        }
      }
    },
    "Add %@": {
      "comment": "Title of the editor when adding a new entry for a category. The argument is the category display name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toevoegen"
          }
        }
      }
    },
    "Add a %@ to your %@ list and it will show up here.": {
      "comment": "The library empty-state prompt to add an item to a list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Add a %1$@ to your %2$@ list and it will show up here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een %1$@ toe aan je %2$@-lijst en hij verschijnt hier."
          }
        }
      }
    },
    "Add to Apple Music": {
      "comment": "The menu action that adds a song to the Apple Music library.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toevoegen aan Apple Music"
          }
        }
      }
    },
    "Add your take when sharing someone else's post and it'll show up here.": {
      "comment": "The empty-state subheadline for the Quotes tab on the post activity screen.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je eigen woorden toe wanneer je het bericht van iemand anders deelt, dan verschijnt het hier."
          }
        }
      }
    },
    "Address": {
      "comment": "The 'Address' search filter label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres"
          }
        }
      }
    },
    "Adults Only": {
      "comment": "The descriptive label for the 'Adults Only' TV rating.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen volwassenen"
          }
        }
      }
    },
    "Advanced Search": {
      "comment": "The string for the 'advanced search' browse option.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geavanceerd zoeken"
          }
        }
      }
    },
    "Age (years)": {
      "comment": "The 'Age (years)' search filter label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeftijd (jaren)"
          }
        }
      }
    },
    "Air Day": {

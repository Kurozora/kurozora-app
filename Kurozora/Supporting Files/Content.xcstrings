            "state": "translated",
            "value": "Вашу оцінку та відгук буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá và bài nhận xét của bạn sẽ bị xóa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tu valoración y tu reseña."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin ang iyong rating at review."
          }

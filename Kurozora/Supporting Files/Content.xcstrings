    "Kotodama keeps your streak and stats on your account." : {
      "comment" : "The description shown when Kotodama is opened without being signed in.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Kotodama سلسلتك وإحصاءاتك في حسابك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotodama তোমার স্ট্রিক আর স্ট্যাটস তোমার অ্যাকাউন্টে রাখে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotodama ukládá tvou sérii a statistiky k tvému účtu."

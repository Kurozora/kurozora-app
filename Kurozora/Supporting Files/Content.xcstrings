    "This will appear at the top of your profile and replace any previously pinned message. Are you sure?": {
      "comment": "The subheadline string for the pin message pop-up",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verschijnt boven aan je profiel en vervangt een eerder vastgemaakt bericht. Weet je het zeker?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر هذا في أعلى ملفك الشخصي ويستبدل أي رسالة مثبتة سابقًا. هل أنت متأكد؟"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto aparecerá en la parte superior de tu perfil y reemplazará cualquier mensaje fijado anteriormente. ¿Estás seguro?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan muncul di bagian atas profilmu dan menggantikan pesan apa pun yang sebelumnya disematkan. Apakah kamu yakin?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはプロフィールの一番上に表示され、以前にピン留めしたメッセージと置き換えられます。よろしいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto aparecerá no topo do seu perfil e substituirá qualquer mensagem fixada anteriormente. Tem certeza?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies erscheint oben in deinem Profil und ersetzt jede zuvor angeheftete Nachricht. Bist du sicher?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci apparaîtra en haut de ton profil et remplacera tout message épinglé précédemment. Es-tu sûr ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparirà in cima al tuo profilo e sostituirà qualsiasi messaggio fissato in precedenza. Vuoi continuare?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지가 프로필 상단에 표시되며 이전에 고정된 메시지를 대체합니다. 계속하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się to na górze Twojego profilu i zastąpi wcześniej przypiętą wiadomość. Czy na pewno?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно появится вверху вашего профиля и заменит ранее закреплённое сообщение. Вы уверены?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容将显示在你个人资料的顶部，并替换之前置顶的任何消息。确定吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則訊息將顯示在您個人檔案的頂端，並取代先前釘選的訊息。確定要繼續嗎？"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความนี้จะแสดงที่ด้านบนสุดของโปรไฟล์ของคุณและแทนที่ข้อความที่ปักหมุดไว้ก่อนหน้านี้ คุณแน่ใจหรือไม่?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, profilinin en üstünde görünecek ve daha önce sabitlenmiş mesajların yerini alacak. Emin misin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це з'явиться вгорі вашого профілю та замінить будь-яке раніше закріплене повідомлення. Ви впевнені?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn này sẽ hiển thị ở đầu hồ sơ của bạn và thay thế tin nhắn đã ghim trước đó. Bạn có chắc không?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto aparecerá en la parte superior de tu perfil y reemplazará cualquier mensaje fijado anteriormente. ¿Seguro?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas ito sa itaas ng iyong profile at papalitan ang anumang dating naka-pin na mensahe. Sigurado ka ba?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी प्रोफ़ाइल के सबसे ऊपर दिखेगा और पहले से पिन किए गए किसी भी संदेश की जगह ले लेगा। क्या आप निश्चित हैं?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این در بالای نمایه‌ی شما نمایش داده می‌شود و جایگزین هر پیام سنجاق‌شده‌ی قبلی خواهد شد. مطمئنی؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה יופיע בראש הפרופיל שלך ויחליף כל הודעה שננעצה בעבר. האם אתה בטוח?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan dipaparkan di bahagian atas profil anda dan menggantikan mana-mana mesej yang disematkan sebelum ini. Adakah anda pasti?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta va apărea în partea de sus a profilului tău și va înlocui orice mesaj fixat anterior. Ești sigur?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här visas högst upp på din profil och ersätter eventuella tidigare fästa meddelanden. Är du säker?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí se v horní části tvého profilu a nahradí dříve připnutou zprávu. Opravdu chceš pokračovat?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα εμφανιστεί στην κορυφή του προφίλ σου και θα αντικαταστήσει όποιο μήνυμα είχες καρφιτσώσει πριν. Είσαι σίγουρος/η;"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার প্রোফাইলের শীর্ষে দেখানো হবে এবং পূর্বে পিন করা যেকোনো মেসেজ প্রতিস্থাপন করবে। আপনি কি নিশ্চিত?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது உங்கள் சுயவிவரத்தின் மேலே தோன்றும், முன்பு பின் செய்த எந்தச் செய்தியையும் மாற்றும். நிச்சயமாகவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మీ ప్రొఫైల్ పైభాగంలో కనిపిస్తుంది మరియు ఇంతకుముందు పిన్ చేసిన ఏ సందేశాన్నైనా భర్తీ చేస్తుంది. మీరు ఖచ్చితంగా ఉన్నారా?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil blive vist øverst på din profil og erstatte enhver tidligere fastgjort besked. Er du sikker?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä näkyy profiilisi yläosassa ja korvaa aiemmin kiinnitetyn viestin. Haluatko varmasti jatkaa?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a profilod tetején fog megjelenni, és lecseréli a korábban kitűzött üzenetet. Biztos vagy benne?"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vises øverst på profilen din og erstatter en eventuell tidligere festet melding. Er du sikker?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai aparecer no topo do teu perfil e substituir qualquer mensagem afixada anteriormente. Tens a certeza?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کے پروفائل کے اوپر ظاہر ہوگا اور پہلے سے پن کیے گئے کسی بھی پیغام کی جگہ لے لے گا۔ کیا آپ کو یقین ہے؟"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա կհայտնվի քո պրոֆիլի վերևում և կփոխարինի նախկինում ամրացված ցանկացած հաղորդագրության։ Վստա՞հ ես։"
          }
        }
      }
    },

    "Puzzles join the archive the day after they run." : {
      "comment" : "The description shown when the Kotodama archive is empty.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنضم الألغاز إلى الأرشيف في اليوم التالي لظهورها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাজলগুলো চলার পরদিন আর্কাইভে যোগ হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hádanky se do archivu přidají den po svém vydání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgaver kommer i arkivet dagen efter, de har kørt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rätsel landen am Tag nach ihrem Erscheinen im Archiv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα παζλ μπαίνουν στο αρχείο την επόμενη μέρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puzles pasan al archivo el día después de publicarse."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los acertijos pasan al archivo el día después de publicarse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معماها یک روز بعد از انتشار به آرشیو اضافه می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulmat siirtyvät arkistoon julkaisuaan seuraavana päivänä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napapasama sa archive ang mga puzzle kinabukasan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les énigmes rejoignent les archives le lendemain de leur parution."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פאזלים מצטרפים לארכיון ביום שלאחר פרסומם."
          }
        },

          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque n'est actuellement disponible que pour les utilisateurs Kurozora inscrits."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הספרייה זמינה כרגע למשתמשי Kurozora רשומים בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइब्रेरी फ़िलहाल केवल रजिस्टर्ड Kurozora उपयोगकर्ताओं के लिए उपलब्ध है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A könyvtár jelenleg csak regisztrált Kurozora-felhasználók számára érhető el."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գրադարանն այս պահին հասանելի է միայն գրանցված Kurozora օգտատերերին։"
          }
        },
        "id" : {
          "stringUnit" : {

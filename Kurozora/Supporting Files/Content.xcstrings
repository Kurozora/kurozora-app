        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలి సహకారం అందించేవారు అవ్వండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær den første til at bidrage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole ensimmäinen, joka osallistuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Légy az első, aki hozzájárul."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli den første til å bidra."
          }
        },

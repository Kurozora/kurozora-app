    "What stands out?": {
      "comment": "Placeholder for the reason text view in the Parental Guide editor.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat valt op?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي يلفت الانتباه؟"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué destaca?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang menonjol?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

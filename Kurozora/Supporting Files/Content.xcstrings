    "This will appear at the top of your profile and replace any previously pinned message. Are you sure?" : {
      "comment" : "The subheadline string for the pin message pop-up",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيظهر هذا في أعلى ملفك الشخصي ويستبدل أي رسالة مثبتة سابقًا. هل أنت متأكد؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি আপনার প্রোফাইলের শীর্ষে দেখানো হবে এবং পূর্বে পিন করা যেকোনো মেসেজ প্রতিস্থাপন করবে। আপনি কি নিশ্চিত?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí se v horní části tvého profilu a nahradí dříve připnutou zprávu. Opravdu chceš pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil blive vist øverst på din profil og erstatte enhver tidligere fastgjort besked. Er du sikker?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies erscheint oben in deinem Profil und ersetzt jede zuvor angeheftete Nachricht. Bist du sicher?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα εμφανιστεί στην κορυφή του προφίλ σου και θα αντικαταστήσει όποιο μήνυμα είχες καρφιτσώσει πριν. Είσαι σίγουρος/η;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto aparecerá en la parte superior de tu perfil y reemplazará cualquier mensaje fijado anteriormente. ¿Seguro?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto aparecerá en la parte superior de tu perfil y reemplazará cualquier mensaje fijado anteriormente. ¿Estás seguro?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این در بالای نمایه‌ی شما نمایش داده می‌شود و جایگزین هر پیام سنجاق‌شده‌ی قبلی خواهد شد. مطمئنی؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä näkyy profiilisi yläosassa ja korvaa aiemmin kiinnitetyn viestin. Haluatko varmasti jatkaa?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalabas ito sa itaas ng iyong profile at papalitan ang anumang dating naka-pin na mensahe. Sigurado ka ba?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci apparaîtra en haut de ton profil et remplacera tout message épinglé précédemment. Es-tu sûr ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה יופיע בראש הפרופיל שלך ויחליף כל הודעה שננעצה בעבר. האם אתה בטוח?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपकी प्रोफ़ाइल के सबसे ऊपर दिखेगा और पहले से पिन किए गए किसी भी संदेश की जगह ले लेगा। क्या आप निश्चित हैं?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a profilod tetején fog megjelenni, és lecseréli a korábban kitűzött üzenetet. Biztos vagy benne?"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սա կհայտնվի քո պրոֆիլի վերևում և կփոխարինի նախկինում ամրացված ցանկացած հաղորդագրության։ Վստա՞հ ես։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan muncul di bagian atas profilmu dan menggantikan pesan apa pun yang sebelumnya disematkan. Apakah kamu yakin?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparirà in cima al tuo profilo e sostituirà qualsiasi messaggio fissato in precedenza. Vuoi continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはプロフィールの一番上に表示され、以前にピン留めしたメッセージと置き換えられます。よろしいですか？"

    "Content is translated on this device, so nothing is sent anywhere." : {
      "comment" : "The subtitle of the translation settings sheet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم الترجمة على هذا الجهاز، فلا يُرسل أي شيء إلى أي مكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসেই অনুবাদ হয়, তাই কিছুই কোথাও পাঠানো হয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překlad probíhá v tomto zařízení, takže se nic nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indhold oversættes på denne enhed, så intet sendes nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhalte werden auf diesem Gerät übersetzt. Es wird nichts gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το περιεχόμενο μεταφράζεται σε αυτή τη συσκευή, οπότε δεν αποστέλλεται τίποτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido se traduce en este dispositivo, así que no se envía nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido se traduce en este dispositivo, así que no se envía nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محتوا روی همین دستگاه ترجمه می‌شود، بنابراین چیزی ارسال نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisältö käännetään tällä laitteella, joten mitään ei lähetetä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isinasalin ang nilalaman sa device na ito, kaya walang ipinapadala kahit saan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu est traduit sur cet appareil, rien n'est envoyé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התוכן מתורגם במכשיר הזה, ולכן שום דבר לא נשלח לשום מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री का अनुवाद इसी डिवाइस पर होता है, इसलिए कुछ भी कहीं नहीं भेजा जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tartalom fordítása ezen az eszközön történik, így semmi sem kerül elküldésre."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բովանդակությունը թարգմանվում է այս սարքում, ուստի ոչինչ չի ուղարկվում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten diterjemahkan di perangkat ini, jadi tidak ada yang dikirim ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contenuti vengono tradotti su questo dispositivo, quindi non viene inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳はこのデバイス上で行われ、どこにも送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "콘텐츠는 이 기기에서 번역되며 어디에도 전송되지 않아요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kandungan diterjemah pada peranti ini, jadi tiada apa-apa yang dihantar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innhold oversettes på denne enheten, så ingenting sendes noe sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhoud wordt op dit apparaat vertaald, er wordt niets verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treści są tłumaczone na tym urządzeniu, więc nic nie jest nigdzie wysyłane."

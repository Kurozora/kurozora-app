            "state": "translated",
            "value": "Je zat dit jaar in de top %1$@%% van %2$@."
          }
        }
      }
    },
    "You, followed by you!": {
      "comment": "The user-cell secondary line for your own profile when you have no followers yet.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij, gevolgd door jou!"
          }
        }
      }

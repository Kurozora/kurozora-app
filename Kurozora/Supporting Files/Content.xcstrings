    "Notifications are only available to registered Kurozora users.": {
      "comment": "The notifications empty-state detail when signed out.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn alleen beschikbaar voor geregistreerde Kurozora-gebruikers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متاحة لمستخدمي Kurozora المسجلين فقط."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones solo están disponibles para usuarios registrados de Kurozora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi hanya tersedia untuk pengguna Kurozora yang terdaftar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は登録済みの Kurozora ユーザーのみご利用いただけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão disponíveis apenas para usuários registrados da Kurozora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind nur für registrierte Kurozora-Nutzer verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont disponibles que pour les utilisateurs Kurozora inscrits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disponibili solo per gli utenti Kurozora registrati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 가입한 Kurozora 사용자만 이용할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są dostępne tylko dla zarejestrowanych użytkowników Kurozora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления доступны только зарегистрированным пользователям Kurozora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知仅向已注册的 Kurozora 用户开放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知僅供已註冊的 Kurozora 使用者使用。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนเปิดให้ใช้งานเฉพาะผู้ใช้ Kurozora ที่ลงทะเบียนแล้วเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler yalnızca kayıtlı Kurozora kullanıcılarına açıktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення доступні лише зареєстрованим користувачам Kurozora."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo chỉ dành cho người dùng Kurozora đã đăng ký."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones solo están disponibles para usuarios registrados de Kurozora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga abiso ay magagamit lang para sa mga rehistradong user ng Kurozora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ केवल रजिस्टर्ड Kurozora उपयोगकर्ताओं के लिए उपलब्ध हैं।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلان‌ها فقط برای کاربران ثبت‌نام‌شدهٔ Kurozora در دسترس هستند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות זמינות למשתמשי Kurozora רשומים בלבד."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan hanya tersedia untuk pengguna Kurozora yang berdaftar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt disponibile doar pentru utilizatorii Kurozora înregistrați."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar är endast tillgängliga för registrerade Kurozora-användare."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou dostupná pouze registrovaným uživatelům Kurozora."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις είναι διαθέσιμες μόνο σε εγγεγραμμένους χρήστες του Kurozora."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন শুধুমাত্র নিবন্ধিত Kurozora ব্যবহারকারীদের জন্য উপলব্ধ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் பதிவுசெய்த Kurozora பயனர்களுக்கு மட்டுமே கிடைக்கின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్‌లు రిజిస్టర్ అయిన Kurozora వినియోగదారులకు మాత్రమే అందుబాటులో ఉన్నాయి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er kun tilgængelige for registrerede Kurozora-brugere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset ovat käytettävissä vain rekisteröityneille Kurozora-käyttäjille."
          }
        },
        "hu": {
          "stringUnit": {

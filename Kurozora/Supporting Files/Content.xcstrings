    "Re:CAP is still in progress. Check back early next month.": {
      "comment": "The generic ReCap in-progress header.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP is nog bezig. Kom begin volgende maand terug."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP لا يزال قيد الإعداد. تحقق مجددًا في بداية الشهر القادم."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP aún está en proceso. Vuelve a principios del próximo mes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP masih berlangsung. Cek lagi awal bulan depan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAPはまだ作成中です。来月の初めにまた確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Re:CAP ainda está em andamento. Volte no início do próximo mês."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP wird noch erstellt. Schau Anfang nächsten Monats wieder vorbei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Re:CAP est encore en cours. Reviens au début du mois prochain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP è ancora in corso. Torna a inizio del mese prossimo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP가 아직 준비 중이에요. 다음 달 초에 다시 확인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP jest jeszcze w toku. Zajrzyj ponownie na początku przyszłego miesiąca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP ещё готовится. Загляните в начале следующего месяца."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP 仍在生成中，请于下月初再来查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP 仍在製作中，下個月初再回來看看吧。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP ยังอยู่ระหว่างดำเนินการ กลับมาดูอีกครั้งช่วงต้นเดือนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP hâlâ hazırlanıyor. Gelecek ayın başında tekrar uğra."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP ще готується. Зазирни на початку наступного місяця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP vẫn đang được xử lý. Hãy quay lại vào đầu tháng sau nhé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP aún está en preparación. Vuelve a principios del mes que viene."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Patuloy pa ang Re:CAP. Bumalik ka sa simula ng susunod na buwan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP अभी भी जारी है। अगले महीने की शुरुआत में फिर देखें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP هنوز در حال آماده‌سازی است. اوایل ماه آینده دوباره سر بزن."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP עדיין בתהליך. חזרו לבדוק בתחילת החודש הבא."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP masih dalam proses. Semak semula awal bulan depan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP este încă în lucru. Revino la începutul lunii viitoare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP pågår fortfarande. Kom tillbaka i början av nästa månad."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP se stále připravuje. Vrať se na začátku příštího měsíce."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Re:CAP είναι ακόμη σε εξέλιξη. Ξανατσέκαρε στις αρχές του επόμενου μήνα."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP এখনও তৈরি হচ্ছে। আগামী মাসের শুরুতে আবার দেখো।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP இன்னும் நடந்துகொண்டிருக்கிறது. அடுத்த மாத தொடக்கத்தில் மீண்டும் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP ఇంకా జరుగుతోంది. వచ్చే నెల మొదట్లో మళ్ళీ చూడండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP er stadig i gang. Kig forbi igen i begyndelsen af næste måned."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP on vielä työn alla. Tarkista uudelleen ensi kuun alussa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Re:CAP még készül. Nézz vissza a jövő hónap elején."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP er fortsatt under arbeid. Stikk innom igjen tidlig neste måned."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP ابھی جاری ہے۔ اگلے مہینے کے شروع میں دوبارہ دیکھیں۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Re:CAP ainda está em curso. Volta no início do próximo mês."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Re:CAP-ը դեռ պատրաստվում է։ Վերադարձիր հաջորդ ամսվա սկզբին։"
          }
        }
      }
    },

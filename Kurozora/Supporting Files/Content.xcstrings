    "Thank you for helping keep the community safe.": {
      "comment": "The subheadline string for the report message pop-up\nThe subheadline string for the report review pop-up",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt dat je de community veilig helpt houden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لمساعدتك في الحفاظ على أمان المجتمع."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por ayudar a mantener segura a la comunidad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih telah membantu menjaga keamanan komunitas."

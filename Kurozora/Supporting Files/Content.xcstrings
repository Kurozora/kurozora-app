    "Streaks appear once players start solving dailies." : {
      "comment" : "The description shown when no player has a Kotodama streak.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر السلاسل بمجرد أن يبدأ اللاعبون بحل الألغاز اليومية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "খেলোয়াড়রা ডেইলি সমাধান শুরু করলেই স্ট্রিক দেখা যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Série se zobrazí, až hráči začnou řešit denní hádanky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaks vises, når spillerne begynder at løse de daglige opgaver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serien erscheinen, sobald Spieler anfangen, Dailies zu lösen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σερί εμφανίζονται μόλις οι παίκτες αρχίσουν να λύνουν τα ημερήσια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rachas aparecen cuando los jugadores empiezan a resolver los diarios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rachas aparecen cuando los jugadores empiezan a resolver los diarios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زنجیره‌ها به‌محض اینکه بازیکنان حل معماهای روزانه را شروع کنند نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putket näkyvät, kun pelaajat alkavat ratkaista päivän pulmia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalabas ang mga streak kapag nagsimula nang magsolusyon ng daily ang mga player."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séries apparaissent dès que les joueurs commencent à résoudre les énigmes du jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רצפים יופיעו ברגע שהשחקנים יתחילו לפתור את הפאזלים היומיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसे ही खिलाड़ी डेली पहेलियाँ हल करना शुरू करेंगे, स्ट्रीक दिखने लगेंगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sorozatok akkor jelennek meg, ha a játékosok elkezdik megoldani a napi feladványokat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Շարքերը կհայտնվեն, հենց խաղացողները սկսեն լուծել օրվա հանելուկները։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streak muncul setelah para pemain mulai memecahkan puzzle harian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serie compaiono quando i giocatori iniziano a risolvere i giornalieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイヤーがデイリーを解き始めると連続記録が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어들이 데일리를 풀기 시작하면 연속 기록이 나타나요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streak muncul apabila pemain mula menyelesaikan puzzle harian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekker vises når spillerne begynner å løse de daglige puslespillene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reeksen verschijnen zodra spelers de dagelijkse puzzels beginnen op te lossen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serie pojawią się, gdy gracze zaczną rozwiązywać zagadki dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sequências aparecem quando os jogadores começam a resolver os diários."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sequências aparecem quando os jogadores começarem a resolver os diários."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seriile apar când jucătorii încep să rezolve puzzle-urile zilnice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серии появятся, когда игроки начнут решать ежедневные головоломки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sviter visas när spelarna börjar lösa de dagliga pusslen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வீரர்கள் தினசரி புதிர்களைத் தீர்க்கத் தொடங்கியதும் தொடர்கள் தோன்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఆటగాళ్లు డైలీలను పరిష్కరించడం మొదలుపెట్టిన తర్వాత స్ట్రీక్‌లు కనిపిస్తాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สตรีคจะปรากฏเมื่อผู้เล่นเริ่มแก้ปริศนารายวัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyuncular günlükleri çözmeye başladığında seriler görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серії з’являться, коли гравці почнуть розв’язувати щоденні головоломки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جیسے ہی کھلاڑی روزانہ کی پہیلیاں حل کرنا شروع کریں گے، اسٹریکس نظر آنے لگیں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuỗi sẽ xuất hiện khi người chơi bắt đầu giải câu đố hằng ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当玩家开始解每日谜题后，连胜就会出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當玩家開始解每日謎題後，連勝就會出現。"
          }
        }
      }
    },

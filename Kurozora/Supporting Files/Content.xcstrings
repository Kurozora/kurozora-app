        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteket är för närvarande endast tillgängligt för registrerade Kurozora-användare."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Library தற்போது பதிவுசெய்த Kurozora பயனர்களுக்கு மட்டுமே கிடைக்கிறது."

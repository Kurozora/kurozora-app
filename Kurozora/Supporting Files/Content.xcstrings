        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las valoraciones y reseñas que envíes aparecerán aquí. "
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga rating at review na isusumite mo. "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा सबमिट की गई रेटिंग और समीक्षाएँ यहाँ दिखाई देंगी। "
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امتیازها و نقدهایی که ثبت می‌کنی اینجا نمایش داده می‌شوند. "
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דירוגים וביקורות שתשלחו יופיעו כאן. "
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penilaian dan ulasan yang anda hantar akan muncul di sini. "
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notele și recenziile pe care le trimiți vor apărea aici. "
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betyg och recensioner du skickar in visas här. "
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnocení a recenze, které přidáš, se zobrazí tady. "

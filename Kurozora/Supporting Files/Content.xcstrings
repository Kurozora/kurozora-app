            "value": "כשיהיו לך התראות, תראה אותן כאן!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda mempunyai pemberitahuan, anda akan melihatnya di sini!"

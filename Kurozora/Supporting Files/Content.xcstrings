        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kövess be más felhasználókat, hogy ők is visszakövessenek. Ki tudja, lehet, hogy itt találod a következő legjobb barátodat!"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հետևիր այլ օգտատերերի, որպեսզի նրանք էլ քեզ հետևեն։ Ո՞վ գիտի, գուցե հանդիպես քո հաջորդ ամենամոտ ընկերոջը։"

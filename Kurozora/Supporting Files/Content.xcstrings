        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లైబ్రరీ ప్రస్తుతం రిజిస్టర్ అయిన Kurozora వినియోగదారులకు మాత్రమే అందుబాటులో ఉంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะนี้คลังเปิดให้ใช้งานเฉพาะผู้ใช้ Kurozora ที่ลงทะเบียนแล้วเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "Welcome to Kurozora! Introduce yourself to get started (^_^)/": {
      "comment": "The new-user badge description shown on your own profile.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom bij Kurozora! Stel jezelf voor om te beginnen (^_^)/"
          }
        }
      }
    },
    "What stands out?": {
      "comment": "Placeholder for the reason text view in the Parental Guide editor.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat valt op?"
          }
        }
      }
    },
    "What’s on your mind?": {
      "comment": "The placeholder string for creating a new feed message.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar denk je aan?"
          }
        }
      }
    },
    "When you block someone, they will be able to see your public messages, but will no longer be able to engage with them. They will also not be able to follow or message you, and you will not see notifications from them.": {
      "comment": "The intro string shown above the blocked users list",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je iemand blokkeert, kan diegene je openbare berichten zien, maar kan er niet meer mee interacteren. Ook kan diegene je niet meer volgen of een bericht sturen, en je ziet geen meldingen meer van diegene."
          }
        }
      }
    },
    "When you have notifications, you will see them here!": {
      "comment": "The notifications empty-state detail when signed in.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je meldingen hebt, zie je ze hier!"
          }
        }
      }
    },
    "With a total of %@.": {
      "comment": "The footnote stating the total duration of a title.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een totaal van %@."
          }
        }
      }
    },
    "Write a comment…": {
      "comment": "The placeholder string for creating a new comment.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf een reactie…"
          }
        }
      }
    },
    "Write a Review": {
      "comment": "The string for the word 'write a review'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf een recensie"
          }
        }
      }
    },
    "Yes, view profile": {
      "comment": "The label for the opt-in button to view a blocked user's profile",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, bekijk profiel"
          }
        }
      }
    },
    "You can view public posts from %@, but you are blocked from engaging with them. You also cannot follow or message %@.": {
      "comment": "Subheadline explaining what is restricted when the auth user has been blocked by another user. Both arguments are the @username of the blocking user.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You can view public posts from %1$@, but you are blocked from engaging with them. You also cannot follow or message %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt openbare berichten van %1$@ bekijken, maar je mag er niet mee interacteren. Je kunt %2$@ ook niet volgen of een bericht sturen."
          }
        }
      }
    },
    "You have exceeded the character limit for a message.": {
      "comment": "The subheadline string for the character limit reached error pop-up",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de tekenlimiet voor een bericht overschreden."
          }
        }
      }
    },
    "You re-shared": {
      "comment": "The string for the auth user's re-share attribution row.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij hebt opnieuw gedeeld"
          }
        }
      }
    },
    "You reposted this": {
      "comment": "The re-share attribution for your own repost.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij hebt dit gerepost"
          }
        }
      }
    },
    "You should check out \"%@\" via @KurozoraApp": {
      "comment": "The share text for a character, where the placeholder is the name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet \"%@\" eens bekijken via @KurozoraApp"
          }
        }
      }
    },
    "You should watch \"%@\" season via @KurozoraApp": {
      "comment": "The share text for a season, where the placeholder is the title.",

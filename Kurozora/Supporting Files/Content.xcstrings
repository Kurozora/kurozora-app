    "There are no characters matching your search. Please try a different query or check your WiFi connection.": {
      "comment": "The empty-state detail for a character search with no results.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen personages die overeenkomen met je zoekopdracht. Probeer een andere zoekterm of controleer je wifiverbinding."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد شخصيات تطابق بحثك. يُرجى تجربة استعلام مختلف أو التحقق من اتصال WiFi."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay personajes que coincidan con tu búsqueda. Prueba con otra consulta o revisa tu conexión WiFi."

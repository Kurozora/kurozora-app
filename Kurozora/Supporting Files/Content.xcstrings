          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du hilfst, die Community sicher zu halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de nous aider à garder la communauté sûre."
          }

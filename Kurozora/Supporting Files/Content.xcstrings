            "value": "Коли у тебе з'являться сповіщення, ти побачиш їх тут!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn có thông báo, bạn sẽ thấy chúng ở đây!"
          }
        },
        "es": {

            "state": "translated",
            "value": "Waterman"
          }
        }
      }
    },
    "Are you sure you want to delete this entry?": {
      "comment": "The confirmation message shown before deleting a Parental Guide entry.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je dit item wilt verwijderen?"
          }
        }
      }
    },
    "Are you sure you want to view these posts? Viewing posts won’t unblock %@.": {
      "comment": "Subheadline prompting the auth user to opt in to viewing a blocked user's posts. The argument is the @username of the blocked user.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze berichten wilt bekijken? Berichten bekijken deblokkeert %@ niet."
          }
        }
      }
    },
    "Are you sure?": {
      "comment": "The subheadline string for the unpin message pop-up",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je het zeker?"
          }
        }
      }
    },
    "Aries": {
      "comment": "The display value 'Aries'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ram"
          }
        }
      }
    },
    "as %@": {
      "comment": "The label naming the character a cast member voices.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "als %@"
          }
        }
      }
    },
    "Astrological Sign": {
      "comment": "The 'Astrological Sign' search filter label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterrenbeeld"
          }
        }
      }
    },
    "Be the first to contribute.": {
      "comment": "The empty-state body on the Parental Guide screen when no entries exist yet.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees de eerste die bijdraagt."
          }
        }
      }
    },
    "Be the first to follow %@!": {
      "comment": "The empty-state detail shown on another user's followers list when nobody follows them yet. '%@' is the target user's display name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees de eerste die %@ volgt!"
          }
        }
      }
    },
    "Be the first to follow!": {
      "comment": "The user-cell secondary line for another user when nobody follows them yet.",

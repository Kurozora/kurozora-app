    "%@ is verified because they are notable in animators, voice actors, entertainment studios, or another designated category.": {
      "comment": "The verified badge description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is geverifieerd omdat hij of zij opvalt onder animators, stemacteurs, entertainmentstudio's of een andere aangewezen categorie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم توثيق %@ لأنه شخصية بارزة في مجال الرسوم المتحركة أو ممثلي الأداء الصوتي أو استوديوهات الترفيه أو فئة أخرى معتمدة."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está verificado por ser destacado entre animadores, actores de voz, estudios de entretenimiento u otra categoría designada."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terverifikasi karena dikenal sebagai animator, pengisi suara, studio hiburan, atau kategori lain yang ditetapkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんは、アニメーター、声優、エンタメスタジオ、その他指定のカテゴリーで著名なため認証されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é verificado por ser uma figura notável entre animadores, dubladores, estúdios de entretenimento ou outra categoria designada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verifiziert, weil die Person als Animator, Synchronsprecher, Unterhaltungsstudio oder in einer anderen festgelegten Kategorie bekannt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est vérifié parce qu'il est reconnu parmi les animateurs, les seiyuu, les studios de divertissement ou une autre catégorie désignée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è verificato perché è una figura di rilievo tra animatori, doppiatori, studi di intrattenimento o un'altra categoria designata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님은 애니메이터, 성우, 엔터테인먼트 스튜디오 또는 기타 지정된 분야에서 주목할 만한 인물이기에 인증되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma zweryfikowane konto, ponieważ jest osobą znaną w gronie animatorów, aktorów głosowych, studiów rozrywkowych lub w innej wyznaczonej kategorii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ верифицирован, потому что известен как аниматор, актёр озвучивания, представитель студии или относится к другой признанной категории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 因在动画师、配音演员、娱乐制作公司或其他指定类别中具有知名度而通过认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已通過驗證，因為他們是動畫師、配音員、娛樂工作室或其他指定類別中的知名人士。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ได้รับการยืนยันตัวตนเพราะเป็นบุคคลที่มีชื่อเสียงในวงการแอนิเมเตอร์ นักพากย์ สตูดิโอบันเทิง หรือหมวดหมู่อื่นที่กำหนดไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, animatörler, seslendirme sanatçıları, eğlence stüdyoları veya belirlenmiş başka bir kategoride öne çıktığı için doğrulandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ підтверджений, оскільки є відомою постаттю серед аніматорів, акторів озвучення, розважальних студій чи в іншій визначеній категорії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ được xác minh vì là người nổi bật trong giới animator, seiyuu, studio giải trí hoặc một lĩnh vực được chỉ định khác."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está verificado por ser una figura destacada entre animadores, actores de doblaje, estudios de entretenimiento u otra categoría designada."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified si %@ dahil kilala sila sa larangan ng animators, voice actors, entertainment studios, o iba pang itinakdang kategorya."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वेरिफ़ाइड हैं क्योंकि वे एनिमेटर, voice actor, मनोरंजन studio, या किसी अन्य निर्दिष्ट श्रेणी में उल्लेखनीय हैं।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ تأیید شده است چون در میان انیماتورها، صداپیشه‌ها، استودیوهای سرگرمی یا دسته‌ای دیگر از چهره‌های شناخته‌شده است."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מאומת מפני שהוא בעל שם בקרב אנימטורים, מדובבים, אולפני בידור או קטגוריה מיועדת אחרת."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disahkan kerana mereka terkenal dalam bidang animator, pelakon suara, studio hiburan, atau kategori lain yang ditetapkan."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este verificat pentru că este o persoană notabilă printre animatori, actori vocali, studiouri de divertisment sau o altă categorie desemnată."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är verifierad eftersom personen är framstående bland animatörer, röstskådespelare, underhållningsstudior eller någon annan utvald kategori."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je ověřen(a), protože je významnou osobností mezi animátory, seiyuu, zábavními studii nebo v jiné určené kategorii."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο %@ είναι επαληθευμένος επειδή ξεχωρίζει στους animators, στους ηθοποιούς φωνής, στα στούντιο ψυχαγωγίας ή σε κάποια άλλη καθορισμένη κατηγορία."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ভেরিফায়েড কারণ তিনি animator, voice actor, বিনোদন স্টুডিও, কিংবা অন্য কোনো নির্ধারিত বিভাগে উল্লেখযোগ্য।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ animators, voice actors, entertainment studios அல்லது வேறு குறிப்பிட்ட பிரிவில் குறிப்பிடத்தக்கவராக இருப்பதால் சரிபார்க்கப்பட்டுள்ளார்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యానిమేటర్లు, voice actors, ఎంటర్‌టైన్‌మెంట్ studios లేదా మరో నిర్దేశిత వర్గంలో ప్రముఖులు కావడం వల్ల %@ verified అయ్యారు."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er verificeret, fordi vedkommende er kendt inden for animatorer, stemmeskuespillere, underholdningsstudier eller en anden udvalgt kategori."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on vahvistettu, koska hän on merkittävä animaattorina, seiyuuna, viihdestudiona tai jollakin muulla nimetyllä alalla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hitelesítve van, mert kiemelkedő az animátorok, seiyuuk, szórakoztató stúdiók vagy egy másik kijelölt kategória területén."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er verifisert fordi de er kjente innen animatorer, stemmeskuespillere, underholdningsstudioer eller en annen utvalgt kategori."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está verificado por ser uma figura notável entre animadores, dobradores, estúdios de entretenimento ou outra categoria designada."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تصدیق شدہ ہیں کیونکہ وہ animators، voice actors، تفریحی اسٹوڈیوز، یا کسی اور مقررہ زمرے میں نمایاں ہیں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ը հաստատված է, քանի որ նա ճանաչված է անիմատորների, ձայնային դերասանների, ժամանցի ստուդիաների կամ այլ նշանակված կատեգորիայի շրջանում։"
          }
        }
      }
    },

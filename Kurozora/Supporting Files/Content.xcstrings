          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تصدیق شدہ ہیں کیونکہ وہ animators، voice actors، تفریحی اسٹوڈیوز، یا کسی اور مقررہ زمرے میں نمایاں ہیں۔"

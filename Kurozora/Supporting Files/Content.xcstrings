    "You, followed by you!": {
      "comment": "The user-cell secondary line for your own profile when you have no followers yet.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij, gevolgd door jou!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت، يتابعك أنت!"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Tú, seguido por ti!"

    "There are no characters matching your search. Please try a different query or check your WiFi connection." : {
      "comment" : "The empty-state detail for a character search with no results.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد شخصيات تطابق بحثك. يُرجى تجربة استعلام مختلف أو التحقق من اتصال WiFi."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার সার্চের সঙ্গে মেলে এমন কোনো চরিত্র নেই। অন্য কিছু খুঁজে দেখো বা তোমার WiFi সংযোগ পরীক্ষা করো।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné postavy neodpovídají tvému hledání. Zkus jiný dotaz nebo zkontroluj připojení k WiFi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen karakterer, der matcher din søgning. Prøv en anden søgning, eller tjek din WiFi-forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Charaktere, die zu deiner Suche passen. Versuche eine andere Suchanfrage oder überprüfe deine WLAN-Verbindung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν χαρακτήρες που να ταιριάζουν με την αναζήτησή σου. Δοκίμασε διαφορετική αναζήτηση ή έλεγξε τη σύνδεση WiFi σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay personajes que coincidan con tu búsqueda. Prueba con otra búsqueda o comprueba tu conexión WiFi."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay personajes que coincidan con tu búsqueda. Prueba con otra consulta o revisa tu conexión WiFi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ شخصیتی مطابق با جستجوی تو پیدا نشد. لطفاً عبارت دیگری را امتحان کن یا اتصال WiFi خود را بررسی کن."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakuasi vastaavia hahmoja ei löytynyt. Kokeile toista hakua tai tarkista WiFi-yhteytesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang karakter na tumutugma sa iyong paghahanap. Subukan ang ibang query o tingnan ang iyong koneksyon sa WiFi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun personnage ne correspond à ta recherche. Essaie une autre requête ou vérifie ta connexion WiFi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין דמויות שתואמות לחיפוש שלכם. נסו חיפוש אחר או בדקו את חיבור ה-WiFi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी खोज से मेल खाता कोई किरदार नहीं है। कृपया कोई दूसरी खोज आज़माएँ या अपना WiFi कनेक्शन जाँचें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs a keresésednek megfelelő karakter. Próbálj másik keresést, vagy ellenőrizd a WiFi-kapcsolatodat."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Քո որոնմանը համապատասխանող կերպար չկա։ Փորձիր այլ հարցում կամ ստուգիր քո WiFi կապը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada karakter yang cocok dengan pencarianmu. Coba kata kunci lain atau periksa koneksi WiFi-mu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun personaggio corrisponde alla tua ricerca. Prova con un'altra ricerca o controlla la tua connessione WiFi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索に一致するキャラクターはありません。別のキーワードで試すか、WiFi接続を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색과 일치하는 캐릭터가 없어요. 다른 검색어를 시도하거나 WiFi 연결을 확인해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada watak yang sepadan dengan carian anda. Sila cuba carian lain atau semak sambungan WiFi anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen karakterer samsvarer med søket ditt. Prøv et annet søk, eller sjekk WiFi-tilkoblingen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn geen personages die overeenkomen met je zoekopdracht. Probeer een andere zoekterm of controleer je wifiverbinding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak postaci pasujących do twojego wyszukiwania. Spróbuj innego zapytania lub sprawdź połączenie WiFi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum personagem corresponde à sua busca. Tente uma busca diferente ou verifique sua conexão WiFi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há personagens que correspondam à tua pesquisa. Tenta uma pesquisa diferente ou verifica a tua ligação WiFi."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niciun personaj nu corespunde căutării tale. Încearcă o altă căutare sau verifică-ți conexiunea WiFi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет персонажей, соответствующих вашему запросу. Попробуйте другой запрос или проверьте подключение к Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inga karaktärer som matchar din sökning. Prova en annan sökning eller kontrollera din WiFi-anslutning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தேடலுக்குப் பொருந்தும் கதாபாத்திரங்கள் இல்லை. வேறொரு தேடலை முயற்சிக்கவும் அல்லது உங்கள் WiFi இணைப்பைச் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ సెర్చ్‌కి సరిపోయే క్యారెక్టర్‌లు ఏవీ లేవు. వేరే క్వెరీ ప్రయత్నించండి లేదా మీ WiFi కనెక్షన్ చెక్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบตัวละครที่ตรงกับการค้นหาของคุณ กรุณาลองคำค้นอื่นหรือตรวจสอบการเชื่อมต่อ WiFi ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aramanla eşleşen karakter yok. Lütfen farklı bir arama dene ya da WiFi bağlantını kontrol et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає персонажів за твоїм запитом. Спробуй інший запит або перевір з’єднання WiFi."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی تلاش سے ملتا جلتا کوئی کردار نہیں ہے۔ براہ کرم کوئی مختلف اصطلاح آزمائیں یا اپنا WiFi کنکشن چیک کریں۔"

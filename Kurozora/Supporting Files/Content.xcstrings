    "Track your playing progress of \"%@\" via @KurozoraApp": {
      "comment": "The share text for a game, where the placeholder is the title.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je speelvoortgang van \"%@\" via @KurozoraApp"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع تقدمك في لعب \"%@\" عبر ‎@KurozoraApp"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tu progreso de juego de \"%@\" vía @KurozoraApp"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak progres bermainmu untuk \"%@\" via @KurozoraApp"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のプレイ進行状況を記録しよう via @KurozoraApp"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe seu progresso de jogo em \"%@\" via @KurozoraApp"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deinen Spielfortschritt von „%@“ via @KurozoraApp"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis ta progression de jeu de « %@ » via @KurozoraApp"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia dei tuoi progressi di gioco di \"%@\" via @KurozoraApp"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"의 플레이 진행 상황을 기록하세요 via @KurozoraApp"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź swój postęp w grze „%@” za pośrednictwem @KurozoraApp"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживай свой прогресс прохождения «%@» через @KurozoraApp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 @KurozoraApp 追踪你游玩《%@》的进度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 @KurozoraApp 追蹤你玩「%@」的進度"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามความคืบหน้าการเล่น \"%@\" ของคุณผ่าน @KurozoraApp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" oyununda ilerlemeni @KurozoraApp ile takip et"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте свій прогрес у грі «%@» через @KurozoraApp"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi tiến trình chơi của bạn cho \"%@\" qua @KurozoraApp"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tu progreso de juego de «%@» vía @KurozoraApp"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Subaybayan ang iyong progreso sa paglalaro ng \"%@\" via @KurozoraApp"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" खेलने की अपनी प्रगति ट्रैक करें @KurozoraApp के ज़रिए"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشرفت بازی‌ات در «%@» را دنبال کن، از طریق @KurozoraApp"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקוב אחר התקדמות המשחק שלך ב\"%@\" דרך @KurozoraApp"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejak kemajuan permainan anda untuk \"%@\" melalui @KurozoraApp"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește-ți progresul jocului la „%@” via @KurozoraApp"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ dina spelframsteg för \"%@\" via @KurozoraApp"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj svůj postup ve hraní „%@“ přes @KurozoraApp"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολούθησε την πρόοδό σου στο παιχνίδι «%@» μέσω @KurozoraApp"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "@KurozoraApp-এর মাধ্যমে \"%@\"-এর খেলার অগ্রগতি ট্র্যাক করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" இன் உங்கள் விளையாட்டு முன்னேற்றத்தை @KurozoraApp வழியாக கண்காணியுங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ఆడే మీ పురోగతిని @KurozoraApp ద్వారా ట్రాక్ చేయండి"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg din spilfremgang i \"%@\" via @KurozoraApp"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa pelaamisesi etenemistä teoksessa ”%@” – @KurozoraApp"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd nyomon a játékmenetedet itt: „%@” a(z) @KurozoraApp segítségével"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg spillefremdriften din for «%@» via @KurozoraApp"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha o teu progresso de jogo de \"%@\" via @KurozoraApp"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" کھیلنے کی اپنی پیش رفت کو ٹریک کریں بذریعہ @KurozoraApp"
          }
        },
        "hy": {
          "stringUnit": {

    "Add a %@ to your %@ list and it will show up here.": {
      "comment": "The library empty-state prompt to add an item to a list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Add a %1$@ to your %2$@ list and it will show up here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een %1$@ toe aan je %2$@-lijst en hij verschijnt hier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف %1$@ إلى قائمة %2$@ وسيظهر هنا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un %1$@ a tu lista de %2$@ y aparecerá aquí."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan %1$@ ke daftar %2$@ kamu dan akan muncul di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を%2$@リストに追加すると、ここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um %1$@ à sua lista de %2$@ e ele aparecerá aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein %1$@ zu deiner %2$@-Liste hinzu, und es erscheint hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un %1$@ à ta liste %2$@ et il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un %1$@ alla tua lista %2$@ e comparirà qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 목록에 %1$@을(를) 추가하면 여기에 표시돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj pozycję typu %1$@ do listy %2$@, a pojawi się tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь %1$@ в список «%2$@», и он появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把%1$@添加到你的%2$@列表，它就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將%1$@加入你的%2$@清單，它就會顯示在這裡。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม %1$@ ลงในลิสต์ %2$@ ของคุณ แล้วมันจะแสดงที่นี่"

        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հնարավոր չէ ստանալ օգտատերերի ցանկը։ Վերաբեռնեք էջը կամ վերագործարկեք հավելվածը և ստուգեք ձեր WiFi կապը։"

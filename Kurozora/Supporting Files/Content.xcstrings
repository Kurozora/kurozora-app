    "This will appear at the top of your profile and replace any previously pinned message. Are you sure?": {
      "comment": "The subheadline string for the pin message pop-up",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verschijnt boven aan je profiel en vervangt een eerder vastgemaakt bericht. Weet je het zeker?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر هذا في أعلى ملفك الشخصي ويستبدل أي رسالة مثبتة سابقًا. هل أنت متأكد؟"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto aparecerá en la parte superior de tu perfil y reemplazará cualquier mensaje fijado anteriormente. ¿Estás seguro?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan muncul di bagian atas profilmu dan menggantikan pesan apa pun yang sebelumnya disematkan. Apakah kamu yakin?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはプロフィールの一番上に表示され、以前にピン留めしたメッセージと置き換えられます。よろしいですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto aparecerá no topo do seu perfil e substituirá qualquer mensagem fixada anteriormente. Tem certeza?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies erscheint oben in deinem Profil und ersetzt jede zuvor angeheftete Nachricht. Bist du sicher?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci apparaîtra en haut de ton profil et remplacera tout message épinglé précédemment. Es-tu sûr ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparirà in cima al tuo profilo e sostituirà qualsiasi messaggio fissato in precedenza. Vuoi continuare?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지가 프로필 상단에 표시되며 이전에 고정된 메시지를 대체합니다. 계속하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się to na górze Twojego profilu i zastąpi wcześniej przypiętą wiadomość. Czy na pewno?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно появится вверху вашего профиля и заменит ранее закреплённое сообщение. Вы уверены?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容将显示在你个人资料的顶部，并替换之前置顶的任何消息。确定吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則訊息將顯示在您個人檔案的頂端，並取代先前釘選的訊息。確定要繼續嗎？"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความนี้จะแสดงที่ด้านบนสุดของโปรไฟล์ของคุณและแทนที่ข้อความที่ปักหมุดไว้ก่อนหน้านี้ คุณแน่ใจหรือไม่?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, profilinin en üstünde görünecek ve daha önce sabitlenmiş mesajların yerini alacak. Emin misin?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це з'явиться вгорі вашого профілю та замінить будь-яке раніше закріплене повідомлення. Ви впевнені?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn này sẽ hiển thị ở đầu hồ sơ của bạn và thay thế tin nhắn đã ghim trước đó. Bạn có chắc không?"
          }
        }
      }
    },
    "TIL, %@ is the voice actor of %@ via @KurozoraApp": {

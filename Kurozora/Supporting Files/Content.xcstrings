          "stringUnit": {
            "state": "translated",
            "value": "Je moet het seizoen van \"%@\" eens kijken via @KurozoraApp"
          }
        }
      }
    },
    "You were in the top %@%% of %@ this year.": {
      "comment": "The milestone label for a user's top percentile in a category.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",

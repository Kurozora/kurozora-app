          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ได้รับการยืนยันตัวตนเพราะเป็นบุคคลที่มีชื่อเสียงในวงการแอนิเมเตอร์ นักพากย์ สตูดิโอบันเทิง หรือหมวดหมู่อื่นที่กำหนดไว้"

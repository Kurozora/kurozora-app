    "Achievements you earn show up here.": {
      "comment": "Empty-state detail for the achievements list when viewing your own profile.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaties die je verdient, verschijnen hier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا الإنجازات التي تحققها."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logros que consigas aparecerán aquí."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencapaian yang kamu raih muncul di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得したアチーブメントがここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conquistas que você obtiver aparecem aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Errungenschaften, die du freischaltest, erscheinen hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les succès que tu débloques apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli obiettivi che ottieni compaiono qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "획득한 업적이 여기에 표시돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdobyte osiągnięcia pojawią się tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достижения, которые ты получишь, появятся здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你获得的成就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你獲得的成就會顯示在這裡。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสำเร็จที่คุณปลดล็อกจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazandığın başarımlar burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являтимуться зароблені тобою досягнення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những thành tích bạn đạt được sẽ hiện ở đây."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logros que consigas aparecen aquí."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lalabas dito ang mga achievement na makukuha mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो उपलब्धियाँ कमाते हैं वे यहाँ दिखती हैं।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستاوردهایی که کسب می‌کنی اینجا نمایش داده می‌شوند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הישגים שתשיגו יופיעו כאן."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencapaian yang anda peroleh akan muncul di sini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizările pe care le obții apar aici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestationer du låser upp dyker upp här."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úspěchy, které získáš, se objeví tady."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα επιτεύγματα που κερδίζεις εμφανίζονται εδώ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেসব অ্যাচিভমেন্ট অর্জন করবেন তা এখানে দেখা যাবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பெறும் சாதனைகள் இங்கே காண்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సంపాదించిన అచీవ్‌మెంట్‌లు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De præstationer, du optjener, vises her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansaitsemasi saavutukset näkyvät täällä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általad szerzett teljesítmények itt jelennek meg."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestasjoner du opptjener, dukker opp her."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As conquistas que ganhas aparecem aqui."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جو کارنامے حاصل کرتے ہیں وہ یہاں ظاہر ہوتے ہیں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր վաստակած նվաճումները հայտնվում են այստեղ։"
          }
        }
      }
    },

        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag may mga notipikasyon ka, makikita mo ang mga ito rito!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपके पास सूचनाएं होंगी, तो वे यहां दिखेंगी!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی اعلانی داشته باشی، اینجا می‌بینیش!"
          }
        },
        "he": {
          "stringUnit": {

    "Can't get %@ list. Please refresh the page or restart the app and check your WiFi connection." : {
      "comment" : "The empty-state detail shown when a list could not be fetched, asking to refresh.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الحصول على قائمة %@. يُرجى تحديث الصفحة أو إعادة تشغيل التطبيق والتحقق من اتصال WiFi."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ তালিকা পাওয়া যাচ্ছে না। অনুগ্রহ করে পেজটি রিফ্রেশ করুন বা অ্যাপটি পুনরায় চালু করুন এবং আপনার WiFi সংযোগ দেখে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze načíst seznam %@. Obnov stránku nebo restartuj aplikaci a zkontroluj připojení k WiFi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke hente %@-listen. Opdater siden eller genstart appen, og tjek din WiFi-forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Liste kann nicht geladen werden. Bitte aktualisiere die Seite oder starte die App neu und überprüfe deine WLAN-Verbindung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η λήψη της λίστας %@. Ανανέωσε τη σελίδα ή επανεκκίνησε την εφαρμογή και έλεγξε τη σύνδεση WiFi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede obtener la lista de %@. Actualiza la página o reinicia la app y comprueba tu conexión WiFi."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo obtener la lista de %@. Actualiza la página o reinicia la app y revisa tu conexión WiFi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏دریافت فهرست %@ ممکن نشد. لطفاً صفحه را تازه‌سازی کنید یا برنامه را دوباره راه‌اندازی کنید و اتصال WiFi خود را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listaa %@ ei saatu. Päivitä sivu tai käynnistä sovellus uudelleen ja tarkista WiFi-yhteytesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi makuha ang %@ list. Paki-refresh ang page o i-restart ang app at suriin ang iyong WiFi connection."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'obtenir la liste %@. Actualise la page ou redémarre l'app et vérifie ta connexion WiFi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לקבל את רשימת ה-%@. אנא רעננו את העמוד או הפעילו מחדש את האפליקציה ובדקו את חיבור ה-WiFi שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ सूची नहीं मिल सकी। कृपया पेज रिफ़्रेश करें या ऐप दोबारा शुरू करें और अपना WiFi कनेक्शन जाँचें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült betölteni a(z) %@ listát. Frissítsd az oldalt, vagy indítsd újra az appot, és ellenőrizd a WiFi-kapcsolatot."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հնարավոր չէ ստանալ %@ ցանկը։ Թարմացրեք էջը կամ վերագործարկեք հավելվածը և ստուգեք ձեր WiFi կապը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa memuat daftar %@. Segarkan halaman atau mulai ulang aplikasi dan periksa koneksi WiFi kamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile recuperare la lista %@. Aggiorna la pagina o riavvia l'app e controlla la tua connessione WiFi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@リストを取得できません。ページを更新するかアプリを再起動して、WiFi接続を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 목록을 가져올 수 없어요. 페이지를 새로고침하거나 앱을 다시 시작하고 WiFi 연결을 확인해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mendapatkan senarai %@. Sila muat semula halaman atau mulakan semula aplikasi dan semak sambungan WiFi anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke hente %@-listen. Oppdater siden eller start appen på nytt og sjekk WiFi-tilkoblingen din."

    "Library is currently available to registered Kurozora users only.": {
      "comment": "The library empty-state detail shown when signed out.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bibliotheek is momenteel alleen beschikbaar voor geregistreerde Kurozora-gebruikers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكتبة متاحة حالياً لمستخدمي Kurozora المسجلين فقط."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, la biblioteca solo está disponible para usuarios registrados de Kurozora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka saat ini hanya tersedia untuk pengguna Kurozora yang terdaftar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリは現在、登録済みの Kurozora ユーザーのみご利用いただけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca está disponível apenas para usuários registrados da Kurozora no momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek ist derzeit nur für registrierte Kurozora-Nutzer verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque n'est actuellement disponible que pour les utilisateurs Kurozora inscrits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria è attualmente disponibile solo per gli utenti Kurozora registrati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리는 현재 가입한 Kurozora 사용자만 이용할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka jest obecnie dostępna tylko dla zarejestrowanych użytkowników Kurozora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека сейчас доступна только зарегистрированным пользователям Kurozora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库目前仅向已注册的 Kurozora 用户开放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "書庫目前僅供已註冊的 Kurozora 使用者使用。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้คลังเปิดให้ใช้งานเฉพาะผู้ใช้ Kurozora ที่ลงทะเบียนแล้วเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphane şu anda yalnızca kayıtlı Kurozora kullanıcılarına açıktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бібліотека наразі доступна лише зареєстрованим користувачам Kurozora."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện hiện chỉ dành cho người dùng Kurozora đã đăng ký."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca solo está disponible por ahora para usuarios registrados de Kurozora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa kasalukuyan ay magagamit lang ang library para sa mga rehistradong user ng Kurozora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी फ़िलहाल केवल रजिस्टर्ड Kurozora उपयोगकर्ताओं के लिए उपलब्ध है।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کتابخانه در حال حاضر فقط برای کاربران ثبت‌نام‌شدهٔ Kurozora در دسترس است."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הספרייה זמינה כרגע למשתמשי Kurozora רשומים בלבד."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka buat masa ini hanya tersedia untuk pengguna Kurozora yang berdaftar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca este disponibilă momentan doar pentru utilizatorii Kurozora înregistrați."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket är för närvarande endast tillgängligt för registrerade Kurozora-användare."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knihovna je momentálně dostupná pouze registrovaným uživatelům Kurozora."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βιβλιοθήκη είναι προς το παρόν διαθέσιμη μόνο σε εγγεγραμμένους χρήστες του Kurozora."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইব্রেরি বর্তমানে শুধুমাত্র নিবন্ধিত Kurozora ব্যবহারকারীদের জন্য উপলব্ধ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Library தற்போது பதிவுசெய்த Kurozora பயனர்களுக்கு மட்டுமே கிடைக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైబ్రరీ ప్రస్తుతం రిజిస్టర్ అయిన Kurozora వినియోగదారులకు మాత్రమే అందుబాటులో ఉంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket er i øjeblikket kun tilgængeligt for registrerede Kurozora-brugere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjasto on tällä hetkellä käytettävissä vain rekisteröityneille Kurozora-käyttäjille."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyvtár jelenleg csak regisztrált Kurozora-felhasználók számára érhető el."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteket er for øyeblikket kun tilgjengelig for registrerte Kurozora-brukere."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائبریری فی الحال صرف رجسٹرڈ Kurozora صارفین کے لیے دستیاب ہے۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca está, de momento, disponível apenas para utilizadores registados do Kurozora."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրադարանն այս պահին հասանելի է միայն գրանցված Kurozora օգտատերերին։"
          }
        }
      }
    },

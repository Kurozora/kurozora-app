          "stringUnit": {
            "state": "translated",
            "value": "আজ জানলাম, %1$@ হলেন %2$@-এর ভয়েস অ্যাক্টর, @KurozoraApp-এর মাধ্যমে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TIL, %1$@ என்பவர் %2$@ இன் voice actor @KurozoraApp வழியாக"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇవాళ తెలిసింది, %1$@ అనేది %2$@కి వాయిస్ యాక్టర్ అని @KurozoraApp ద్వారా"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidste du, at %1$@ er stemmeskuespilleren bag %2$@? Via @KurozoraApp"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänään opin, että %1$@ on hahmon %2$@ ääninäyttelijä – @KurozoraApp"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most tudtam meg, hogy %1$@ %2$@ szinkronhangja a(z) @KurozoraApp segítségével"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Visste du at %1$@ er stemmeskuespilleren til %2$@ via @KurozoraApp"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje descobri que %1$@ é o voice actor de %2$@ via @KurozoraApp"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج معلوم ہوا، %1$@ ہی %2$@ کا voice actor ہے بذریعہ @KurozoraApp"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հենց նոր իմացա, որ %1$@-ն %2$@-ի դերասան-հնչյունավորողն է՝ @KurozoraApp-ի միջոցով"
          }
        }
      }
    },

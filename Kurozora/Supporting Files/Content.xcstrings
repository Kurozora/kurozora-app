            "value": "Quando tiveres notificações, vais vê-las aqui!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کے پاس اطلاعات ہوں گی، تو آپ انہیں یہاں دیکھیں گے!"

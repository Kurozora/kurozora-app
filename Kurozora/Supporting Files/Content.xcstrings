    "Add a %@ to your %@ list and it will show up here.": {
      "comment": "The library empty-state prompt to add an item to a list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Add a %1$@ to your %2$@ list and it will show up here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een %1$@ toe aan je %2$@-lijst en hij verschijnt hier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف %1$@ إلى قائمة %2$@ وسيظهر هنا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un %1$@ a tu lista de %2$@ y aparecerá aquí."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan %1$@ ke daftar %2$@ kamu dan akan muncul di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を%2$@リストに追加すると、ここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um %1$@ à sua lista de %2$@ e ele aparecerá aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein %1$@ zu deiner %2$@-Liste hinzu, und es erscheint hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un %1$@ à ta liste %2$@ et il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un %1$@ alla tua lista %2$@ e comparirà qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 목록에 %1$@을(를) 추가하면 여기에 표시돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj pozycję typu %1$@ do listy %2$@, a pojawi się tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь %1$@ в список «%2$@», и он появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把%1$@添加到你的%2$@列表，它就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將%1$@加入你的%2$@清單，它就會顯示在這裡。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม %1$@ ลงในลิสต์ %2$@ ของคุณ แล้วมันจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ listene bir %1$@ ekle, burada görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай %1$@ до свого списку «%2$@», і він з’явиться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm %1$@ vào danh sách %2$@ của bạn và nó sẽ hiện ở đây."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un %1$@ a tu lista de %2$@ y aparecerá aquí."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng %1$@ sa iyong %2$@ list at lalabas ito dito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी %2$@ सूची में कोई %1$@ जोड़ें और वह यहाँ दिखाई देगा।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "‏یک %1$@ به فهرست %2$@ خود اضافه کن تا اینجا نمایش داده شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו %1$@ לרשימת ה-%2$@ שלכם והוא יופיע כאן."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan %1$@ ke senarai %2$@ anda dan ia akan muncul di sini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un %1$@ în lista ta %2$@ și va apărea aici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en %1$@ i din %2$@-lista så dyker den upp här."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej %1$@ do seznamu %2$@ a objeví se tady."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε ένα %1$@ στη λίστα %2$@ και θα εμφανιστεί εδώ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার %2$@ তালিকায় একটি %1$@ যোগ করুন, তাহলে তা এখানে দেখা যাবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் %2$@ பட்டியலில் ஒரு %1$@-ஐச் சேர்த்தால் அது இங்கே காண்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ %2$@ జాబితాకు ఒక %1$@ జోడించండి, అది ఇక్కడ కనిపిస్తుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en %1$@ til din %2$@-liste, så vises den her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kohde %1$@ listallesi %2$@, niin se näkyy täällä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy %1$@ a(z) %2$@ listádhoz, és itt fog megjelenni."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en %1$@ i %2$@-listen din, så dukker den opp her."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um %1$@ à tua lista de %2$@ e aparecerá aqui."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی %2$@ فہرست میں کوئی %1$@ شامل کریں اور یہ یہاں ظاہر ہو جائے گا۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրեք %1$@ ձեր %2$@ ցանկում, և այն կհայտնվի այստեղ։"
          }
        }
      }
    },

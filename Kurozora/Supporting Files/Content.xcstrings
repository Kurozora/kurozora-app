    "%lld TV · %lld Movie · %lld OVA · %lld Music/ONA/Specials": {
      "comment": "The library media-type breakdown line.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld TV · %2$lld Movie · %3$lld OVA · %4$lld Music/ONA/Specials"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld TV · %2$lld Film · %3$lld OVA · %4$lld Muziek/ONA/Specials"
          }
        }
      }
    },
    "%lld volumes": {
      "comment": "The volume count shown in a media information line.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld volume"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld volumes"
                }
              }
            }
          }
        },

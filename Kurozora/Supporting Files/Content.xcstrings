          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لائبریری فی الحال صرف رجسٹرڈ Kurozora صارفین کے لیے دستیاب ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",

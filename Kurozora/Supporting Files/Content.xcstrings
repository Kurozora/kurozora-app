          "stringUnit": {
            "state": "translated",
            "value": "Sua nota e sua avaliação serão removidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bewertung und Rezension werden entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta note et ta critique seront supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Sua valutazione e la Sua recensione verranno rimosse."

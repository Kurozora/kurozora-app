{
  "sourceLanguage": "en",
  "strings": {
    "#%lld in the current season.": {
      "comment": "The footnote showing an episode's position in the current season.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "#%lld in het huidige seizoen."
          }
        }
      }
    },
    "%@ ago": {
      "comment": "A broadcast countdown that already started, where the placeholder is the elapsed duration.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geleden"
          }
        }
      }
    },
    "%@ at %@": {
      "comment": "A broadcast or publication schedule line pairing a weekday with a time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ at %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ om %2$@"
          }
        }
      }
    },
    "%@ from now": {
      "comment": "A broadcast countdown ending in the future, where the placeholder is the remaining duration.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "over %@"
          }
        }
      }
    },
    "%@ has blocked you": {
      "comment": "The headline shown when the auth user has been blocked by another user. The argument is the @username of the blocking user.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft je geblokkeerd"
          }
        }
      }
    },
    "%@ has no %@ in their %@ list.": {
      "comment": "The library empty-state detail for another user's empty list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ has no %2$@ in their %3$@ list."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft geen %2$@ in zijn of haar %3$@-lijst."
          }
        }
      }
    },
    "%@ has not submitted any reviews yet. Check back later.": {
      "comment": "The reviews empty-state detail for another user's profile.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft nog geen recensies geplaatst. Kom later terug."
          }
        }
      }
    },
    "%@ hasn't favorited %@ yet.": {
      "comment": "The favorites empty-state detail for another user's profile.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ hasn't favorited %2$@ yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft nog geen %2$@ als favoriet."
          }
        }
      }
    },
    "%@ is a Kurozora+ subscriber since %@.": {
      "comment": "The subscriber badge description.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is a Kurozora+ subscriber since %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is sinds %2$@ Kurozora+-abonnee."
          }
        }
      }
    },
    "%@ is a Pro user.": {
      "comment": "The Pro badge description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een Pro-gebruiker."
          }
        }
      }
    },
    "%@ is a staff member.": {
      "comment": "The staff badge description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een stafmedewerker."
          }
        }
      }
    },
    "%@ is an active developer.": {
      "comment": "The developer badge description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een actieve ontwikkelaar."
          }
        }
      }
    },
    "%@ is an early supporter of Kurozora.": {
      "comment": "The early-supporter badge description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een vroege supporter van Kurozora."
          }
        }
      }
    },
    "%@ is blocked": {
      "comment": "The headline shown when the auth user has blocked the profile's user. The argument is the @username of the blocked user.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is geblokkeerd"
          }
        }
      }
    },
    "%@ is new to Kurozora. Say hi to them (^o^)/": {
      "comment": "The new-user badge description shown on another user's profile.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is nieuw bij Kurozora. Zeg eens hallo (^o^)/"
          }
        }
      }
    },
    "%@ is not following anyone yet.": {
      "comment": "The empty-state detail shown on another user's following list when they don't follow anyone yet. '%@' is the target user's display name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ volgt nog niemand."
          }
        }
      }
    },
    "%@ is verified because they are notable in animators, voice actors, entertainment studios, or another designated category.": {
      "comment": "The verified badge description.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is geverifieerd omdat hij of zij opvalt onder animators, stemacteurs, entertainmentstudio's of een andere aangewezen categorie."
          }
        }
      }
    },
    "%@ Re:CAP is still in progress. Check back in a week.": {
      "comment": "The ReCap in-progress header shown in December.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Re:CAP is nog bezig. Kom over een week terug."
          }
        }
      }
    },
    "%@ Re:CAP is still in progress. Check back in early %@.": {
      "comment": "The ReCap in-progress header for a given month.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Re:CAP is still in progress. Check back in early %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Re:CAP is nog bezig. Kom begin %2$@ terug."
          }
        }
      }
    },
    "%@ reposted this": {
      "comment": "The re-share attribution for another user's repost.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft dit gerepost"
          }
        }
      }
    },
    "%@ tag detected": {
      "comment": "The alert title shown when a hashtag is detected.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-tag gedetecteerd"
          }
        }
      }
    },
    "%1$@ is rated %2$@ for %3$@": {
      "comment": "Title-line format for sharing a Parental Guide entry. %1 is the media title, %2 the severity rating, %3 the category name.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is beoordeeld als %2$@ voor %3$@"
          }
        }
      }
    },
    "%1$d of %2$d found this %3$@.": {
      "comment": "Sentiment subtitle under each Parental Guide category section header. %1$d is matching count, %2$d is total count, %3$@ is the lowercased rating phrase.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d van %2$d vond dit %3$@."
          }
        }
      }
    },
    "%lld editions": {
      "comment": "The edition count shown in a media information line.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld edition"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld editions"
                }
              }
            }
          }
        },

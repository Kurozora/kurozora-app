          }
        }
      }
    },
    "All Ages": {
      "comment": "The descriptive label for the 'All Ages' TV rating.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle leeftijden"
          }
        }
      }
    },
    "Amplify posts you like": {
      "comment": "The empty-state headline for the Re-shares tab on the post activity screen.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versterk berichten die je leuk vindt"
          }

    "What’s on your mind?": {
      "comment": "The placeholder string for creating a new feed message.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar denk je aan?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",

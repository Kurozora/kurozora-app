    "Ratings and reviews you submit will appear here. ": {
      "comment": "The reviews empty-state detail for your own profile.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordelingen en recensies die je plaatst, verschijnen hier. "
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا التقييمات والمراجعات التي ترسلها. "
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calificaciones y reseñas que envíes aparecerán aquí. "
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penilaian dan ulasan yang kamu kirim akan muncul di sini. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが投稿した評価とレビューはここに表示されます。 "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As avaliações e resenhas que você enviar vão aparecer aqui. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewertungen und Rezensionen, die du abgibst, erscheinen hier. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes et avis que tu publies apparaîtront ici. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le valutazioni e le recensioni che invii appariranno qui. "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 남긴 평점과 리뷰가 여기에 표시돼요. "
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oceny i recenzje, które dodasz, pojawią się tutaj. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся ваши оценки и отзывы. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你提交的评分和评论会显示在这里。 "
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你送出的評分與評論會顯示在這裡。 "
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนนและรีวิวที่คุณส่งจะแสดงที่นี่ "
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderdiğin puanlar ve incelemeler burada görünür. "
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінки та відгуки, які ти залишиш, з’являться тут. "
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đánh giá và nhận xét bạn gửi sẽ xuất hiện ở đây. "
          }
        }
      }
    },

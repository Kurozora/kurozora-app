            "state": "translated",
            "value": "Sua nota e sua avaliação serão removidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bewertung und Rezension werden entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta note et ta critique seront supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Sua valutazione e la Sua recensione verranno rimosse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회원님의 평점과 리뷰가 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja ocena i recenzja zostaną usunięte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша оценка и отзыв будут удалены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的评分和评价将被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的評分與評論將會被移除。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนนและรีวิวของคุณจะถูกลบออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

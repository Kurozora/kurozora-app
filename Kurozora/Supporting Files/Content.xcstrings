    "%@ has not submitted any reviews yet. Check back later.": {
      "comment": "The reviews empty-state detail for another user's profile.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft nog geen recensies geplaatst. Kom later terug."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقدّم %@ أي مراجعات بعد. عُد لاحقًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no ha publicado ninguna reseña. Vuelve más tarde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum mengirimkan ulasan apa pun. Cek lagi nanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんはまだレビューを投稿していません。またあとで見てみてね。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda não publicou nenhuma avaliação. Volte mais tarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat noch keine Reviews abgegeben. Schau später wieder vorbei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas encore publié d'avis. Reviens plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha ancora pubblicato nessuna recensione. Riprova più tardi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 아직 리뷰를 남기지 않았어요. 나중에 다시 확인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie dodał(a) jeszcze żadnych recenzji. Zajrzyj później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ пока не оставил ни одного отзыва. Загляни позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 还没有发表任何评价。稍后再来看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 還沒有發表任何評論。請稍後再來看看。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังไม่ได้เขียนรีวิวเลย ลองกลับมาดูใหม่ภายหลังนะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henüz bir değerlendirme paylaşmadı. Daha sonra tekrar bak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще не залишив жодного відгуку. Загляньте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chưa đăng bài đánh giá nào. Hãy quay lại sau nhé."
          }
        }
      }
    },

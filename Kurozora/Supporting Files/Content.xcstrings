        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось получить список «%@». Обнови страницу или перезапусти приложение и проверь подключение к Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att hämta %@-listan. Uppdatera sidan eller starta om appen och kontrollera din WiFi-anslutning."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ பட்டியலைப் பெற முடியவில்லை. பக்கத்தைப் புதுப்பிக்கவும் அல்லது ஆப்பை மறுதொடக்கம் செய்து உங்கள் WiFi இணைப்பைச் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ జాబితాను పొందలేకపోయాం. దయచేసి పేజీని రిఫ్రెష్ చేయండి లేదా యాప్‌ను రీస్టార్ట్ చేసి, మీ WiFi కనెక్షన్‌ను తనిఖీ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถดึงลิสต์ %@ ได้ กรุณารีเฟรชหน้านี้หรือเปิดแอปใหม่ และตรวจสอบการเชื่อมต่อ WiFi ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ listesi alınamıyor. Lütfen sayfayı yenile veya uygulamayı yeniden başlat ve WiFi bağlantını kontrol et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося отримати список «%@». Оновіть сторінку або перезапустіть застосунок і перевірте з’єднання WiFi."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ فہرست حاصل نہیں ہو سکی۔ براہِ کرم صفحہ ریفریش کریں یا ایپ دوبارہ شروع کریں اور اپنا WiFi کنکشن چیک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể lấy danh sách %@. Vui lòng làm mới trang hoặc khởi động lại ứng dụng và kiểm tra kết nối WiFi của bạn."

    "Add your take when sharing someone else's post and it'll show up here.": {
      "comment": "The empty-state subheadline for the Quotes tab on the post activity screen.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je eigen woorden toe wanneer je het bericht van iemand anders deelt, dan verschijnt het hier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف رأيك عند مشاركة منشور لشخص آخر وسيظهر هنا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega tu comentario al compartir la publicación de alguien más y aparecerá aquí."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pendapatmu saat membagikan kiriman orang lain dan akan muncul di sini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かの投稿をシェアするときにひとこと添えると、ここに表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seu comentário ao compartilhar o post de outra pessoa e ele aparecerá aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib beim Teilen eines fremden Beitrags deinen Senf dazu, und er erscheint hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ton avis quand tu partages le post de quelqu'un d'autre et il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un tuo commento quando condividi il post di qualcun altro e comparirà qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 게시물을 공유할 때 의견을 덧붙이면 여기에 표시돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj swój komentarz, udostępniając cudzy post, a pojawi się tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь своё мнение, когда делишься чужим постом, и оно появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在转发别人的帖子时加上你的想法，它就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在分享別人的貼文時加上你的想法，就會顯示在這裡。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มความเห็นของคุณตอนแชร์โพสต์ของคนอื่น แล้วมันจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başkasının gönderisini paylaşırken kendi yorumunu ekle, burada görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавай свій коментар, коли ділишся чужим дописом, і він з’явиться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm cảm nghĩ của bạn khi chia sẻ bài viết của người khác và nó sẽ hiện ở đây."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aporta tu comentario al compartir la publicación de otra persona y aparecerá aquí."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idagdag ang iyong saloobin kapag nagbabahagi ng post ng iba at lalabas ito dito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी और की पोस्ट शेयर करते समय अपनी राय जोड़ें और वह यहाँ दिखाई देगी।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی پست کسی دیگر را به اشتراک می‌گذاری نظرت را اضافه کن تا اینجا نمایش داده شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו את דעתכם כששיתפתם פוסט של מישהו אחר וזה יופיע כאן."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pendapat anda apabila berkongsi pos orang lain dan ia akan muncul di sini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă-ți părerea când distribui postarea altcuiva și va apărea aici."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till din egen kommentar när du delar någon annans inlägg så dyker det upp här."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připoj svůj komentář, když budeš sdílet cizí příspěvek, a objeví se tady."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε τη δική σου άποψη όταν μοιράζεσαι την ανάρτηση κάποιου άλλου και θα εμφανιστεί εδώ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য কারো পোস্ট শেয়ার করার সময় নিজের মন্তব্য যোগ করুন, তাহলে তা এখানে দেখা যাবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறொருவரின் பதிவைப் பகிரும்போது உங்கள் கருத்தைச் சேர்த்தால் அது இங்கே காண்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరిదైనా పోస్ట్‌ను షేర్ చేస్తున్నప్పుడు మీ అభిప్రాయం జోడించండి, అది ఇక్కడ కనిపిస్తుంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj din egen kommentar, når du deler en andens opslag, så vises den her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää oma kommenttisi, kun jaat jonkun toisen julkaisun, niin se näkyy täällä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd hozzá a véleményed, amikor megosztod valaki más bejegyzését, és itt fog megjelenni."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til din mening når du deler andres innlegg, så dukker det opp her."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá a tua opinião ao partilhares a publicação de outra pessoa e aparecerá aqui."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی اور کی پوسٹ شیئر کرتے وقت اپنی رائے شامل کریں اور یہ یہاں ظاہر ہو جائے گی۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կիսվելիս ուրիշի գրառմամբ ավելացրեք ձեր կարծիքը, և այն կհայտնվի այստեղ։"
          }
        }
      }
    },

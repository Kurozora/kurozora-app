          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En udgivelsesdato er endnu ikke annonceret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaisupäivää ei ole vielä ilmoitettu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megjelenési dátumot még nem jelentették be."

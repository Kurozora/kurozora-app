        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotodama gemmer din streak og dine statistikker på din konto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kotodama speichert deine Serie und Statistiken in deinem Account."
          }

    "See who solved it fastest." : {
      "comment" : "The description of the Kotodama leaderboards.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد من حلّه بأسرع وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কে সবচেয়ে দ্রুত সমাধান করেছে দেখো।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívej se, kdo ji vyřešil nejrychleji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, hvem der løste den hurtigst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wer am schnellsten gelöst hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες ποιος το έλυσε πιο γρήγορα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira quién lo resolvió más rápido."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira quién lo resolvió más rápido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ببین چه کسی سریع‌تر از همه حلش کرده."

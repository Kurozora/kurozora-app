    "Follow a user and they will show up here!": {
      "comment": "The empty-state detail shown on your own following list when you don't follow anyone yet.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg een gebruiker en die verschijnt hier!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابِع مستخدمًا وسيظهر هنا!"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Sigue a un usuario y aparecerá aquí!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti seorang pengguna dan mereka akan muncul di sini!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーをフォローすると、ここに表示されるよ！"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga um usuário e ele vai aparecer aqui!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge jemandem und die Person erscheint hier!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis un utilisateur et il apparaîtra ici !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui un utente e comparirà qui!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자를 팔로우하면 여기에 표시돼요!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaobserwuj użytkownika, a pojawi się tutaj!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпишись на пользователя, и он появится здесь!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注一位用户，他们就会显示在这里！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤某位使用者，他就會顯示在這裡！"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามผู้ใช้สักคน แล้วพวกเขาจะปรากฏที่นี่!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kullanıcıyı takip et, burada görünsün!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпишись на користувача, і він з’явиться тут!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi một người dùng và họ sẽ hiện ở đây!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Sigue a un usuario y aparecerá aquí!"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-follow ng isang user at lalabas sila rito!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी उपयोगकर्ता को फ़ॉलो करो और वे यहाँ दिखाई देंगे!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začni někoho sledovat a objeví se tady!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کاربری را دنبال کن تا اینجا نمایش داده شود!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחר משתמש והוא יופיע כאן!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti seorang pengguna dan mereka akan muncul di sini!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește un utilizator și va apărea aici!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ en användare så dyker de upp här!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολούθησε έναν χρήστη και θα εμφανιστεί εδώ!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ইউজারকে ফলো করো, তারা এখানে দেখা যাবে!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பயனரைப் பின்தொடருங்கள், அவர்கள் இங்கே காண்பிக்கப்படுவார்கள்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎవరైనా యూజర్‌ను ఫాలో అవ్వు, వాళ్ళు ఇక్కడ కనిపిస్తారు!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg en bruger, så vises de her!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa käyttäjää, niin hän näkyy täällä!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövess be egy felhasználót, és itt fog megjelenni!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg en bruker, så vises de her!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue um utilizador e ele vai aparecer aqui!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی صارف کو فالو کریں اور وہ یہاں نظر آئے گا!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հետևիր մի օգտատիրոջ, և նա կհայտնվի այստեղ։"
          }
        }
      }
    },
    "Follow other users so they will follow you back. Who knows, you might meet your next BFF!": {
      "comment": "The empty-state detail shown on your own followers list when you have none.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg andere gebruikers, dan volgen ze jou terug. Wie weet ontmoet je je volgende beste vriend(in)!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابِع مستخدمين آخرين ليتابعوك بالمقابل. من يدري، قد تلتقي بصديقك المقرّب القادم!"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a otros usuarios para que ellos te sigan a ti. ¡Quién sabe, quizá conozcas a tu próximo mejor amigo!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti pengguna lain supaya mereka ikut balik. Siapa tahu, kamu ketemu BFF barumu!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のユーザーをフォローすれば、フォローを返してくれるかも。次の親友に出会えるかもしれないよ！"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga outros usuários para que eles te sigam de volta. Quem sabe você encontra seu próximo BFF!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge anderen, damit sie dir zurückfolgen. Wer weiß, vielleicht triffst du hier deine neue beste Freundin oder deinen neuen besten Freund!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis d’autres utilisateurs pour qu’ils te suivent en retour. Qui sait, tu vas peut-être rencontrer ton ou ta meilleur·e ami·e !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui altri utenti così ti seguiranno a loro volta. Chissà, potresti incontrare il tuo prossimo BFF!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자를 팔로우하면 그들도 맞팔해 줄 거예요. 어쩌면 평생 친구를 만날지도 몰라요!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj innych, a oni zaobserwują ciebie. Kto wie, może spotkasz swojego nowego najlepszego kumpla!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписывайся на других, и они подпишутся в ответ. Кто знает, может, ты встретишь нового лучшего друга!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注其他用户，他们就会回关你。说不定，你还能遇到你的下一个挚友呢！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤其他使用者，他們也會回追你。說不定你會遇到下一個摯友呢！"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามผู้ใช้คนอื่น ๆ แล้วพวกเขาจะติดตามคุณกลับ ใครจะรู้ คุณอาจได้เจอเพื่อนซี้คนใหม่ก็ได้!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka kullanıcıları takip et ki onlar da seni takip etsin. Kim bilir, belki bir sonraki can dostunla tanışırsın!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписуйся на інших користувачів, щоб вони підписалися на тебе у відповідь. Хтозна, можливо, ти знайдеш свого найкращого друга!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi những người dùng khác để họ theo dõi lại bạn. Biết đâu bạn lại gặp được người bạn thân tiếp theo của mình!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a otros usuarios para que te sigan de vuelta. ¡Quién sabe, igual conoces a tu próximo mejor amigo!"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-follow ng ibang user para i-follow ka rin nila pabalik. Sino'ng nakakaalam, baka makilala mo ang susunod mong BFF!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे उपयोगकर्ताओं को फ़ॉलो करो ताकि वे भी तुम्हें वापस फ़ॉलो करें। कौन जाने, शायद तुम्हारा अगला BFF यहीं मिल जाए!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj ostatní uživatele, aby tě sledovali zpět. Kdo ví, třeba potkáš svého příštího nejlepšího kámoše!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کاربران دیگر را دنبال کن تا آن‌ها هم تو را دنبال کنند. کی می‌داند، شاید رفیق فابریک بعدی‌ات را پیدا کنی!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחר משתמשים אחרים כדי שיעקבו אחריכם בחזרה. מי יודע, אולי תכירו את ה‑BFF הבא שלכם!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti pengguna lain supaya mereka mengikuti kamu balik. Siapa tahu, kamu mungkin jumpa BFF baharu kamu!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește alți utilizatori ca să te urmărească și ei. Cine știe, poate îți întâlnești următorul BFF!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ andra användare så följer de dig tillbaka. Vem vet, du kanske träffar din nästa BFF!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολούθησε άλλους χρήστες για να σε ακολουθήσουν κι αυτοί. Ποιος ξέρει, μπορεί να γνωρίσεις την επόμενή σου κολλητή παρέα!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ইউজারদের ফলো করো যাতে তারাও তোমাকে ফলো করে। কে জানে, হয়তো তোমার পরের BFF-এর সাথে দেখা হয়ে যাবে!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற பயனர்களைப் பின்தொடருங்கள், அவர்களும் உங்களைப் பின்தொடர்வார்கள். யாருக்குத் தெரியும், உங்கள் அடுத்த BFF ஐ நீங்கள் சந்திக்கலாம்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర యూజర్లను ఫాలో అవ్వు, వాళ్ళూ నిన్ను తిరిగి ఫాలో అవుతారు. ఏమో, నీ తదుపరి BFFని కలవచ్చు!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg andre brugere, så de følger dig tilbage. Hvem ved, måske møder du din næste BFF!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa muita käyttäjiä, niin he seuraavat sinua takaisin. Ehkä löydät seuraavan parhaan ystäväsi!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövess be más felhasználókat, hogy ők is visszakövessenek. Ki tudja, lehet, hogy itt találod a következő legjobb barátodat!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg andre brukere, så følger de deg kanskje tilbake. Hvem vet, du møter kanskje din neste BFF!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue outros utilizadores para que também te sigam. Quem sabe, podes conhecer o teu próximo melhor amigo!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرے صارفین کو فالو کریں تاکہ وہ بھی آپ کو فالو کریں۔ کیا پتا، آپ کو اپنا اگلا پکا دوست مل جائے!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հետևիր այլ օգտատերերի, որպեսզի նրանք էլ քեզ հետևեն։ Ո՞վ գիտի, գուցե հանդիպես քո հաջորդ ամենամոտ ընկերոջը։"
          }
        }
      }
    },

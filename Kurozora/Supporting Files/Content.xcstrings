    "Be the first to contribute.": {
      "comment": "The empty-state body on the Parental Guide screen when no entries exist yet.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees de eerste die bijdraagt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كن أول من يساهم."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en contribuir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadilah yang pertama berkontribusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に投稿してみよう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja o primeiro a contribuir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei der Erste, der etwas beiträgt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à contribuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii il primo a contribuire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 먼저 기여해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bądź pierwszą osobą, która coś doda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стань первым, кто внесёт вклад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成为第一个贡献者吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成為第一個貢獻的人。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาเป็นคนแรกที่ร่วมแบ่งปันกันสิ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkıda bulunan ilk kişi ol."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стань першим, хто зробить внесок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy là người đầu tiên đóng góp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en contribuir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maging una sa pag-ambag."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योगदान देने वाले पहले व्यक्ति बनें।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اولین نفری باش که مشارکت می‌کند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היו הראשונים לתרום."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadilah yang pertama menyumbang."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fii primul care contribuie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bli den första att bidra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Buď první, kdo přispěje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γίνε ο πρώτος που θα συνεισφέρει."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবদান রাখার ক্ষেত্রে প্রথম হন।"

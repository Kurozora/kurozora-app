        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült betölteni a felhasználók listáját. Töltsd újra az oldalt, vagy indítsd újra az appot, és ellenőrizd a WiFi-kapcsolatot."

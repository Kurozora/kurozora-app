    "A release date has yet to be announced.": {
      "comment": "The footnote shown when an episode's release date is unannounced.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er moet nog een releasedatum worden aangekondigd."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعلَن بعد عن تاريخ الإصدار."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha anunciado una fecha de lanzamiento."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal rilis belum diumumkan."

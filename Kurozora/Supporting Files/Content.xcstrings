    "Is this a 'where to watch' question?": {
      "comment": "The headline string for the off-topic content warning pop-up.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is dit een 'waar te kijken'-vraag?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل هذا سؤال عن 'أين تشاهد'؟"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es esta una pregunta de 'dónde ver'?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah ini pertanyaan 'di mana menonton'?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは「どこで見られるか」という質問ですか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é uma pergunta sobre 'onde assistir'?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das eine Frage nach dem 'Wo kann ich es sehen'?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Est-ce une question du type « où regarder » ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una domanda su 'dove guardare'?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'어디서 볼 수 있나요' 질문인가요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy to pytanie typu „gdzie obejrzeć”?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это вопрос «где посмотреть»?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一个“在哪里观看”的问题吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是「在哪裡觀看」的問題嗎？"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่เป็นคำถามแนว 'ดูได้ที่ไหน' ใช่ไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir 'nereden izlenir' sorusu mu?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це питання «де подивитися»?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây có phải câu hỏi 'xem ở đâu' không?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Es una pregunta sobre «dónde ver»?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanong ba ito tungkol sa 'saan manonood'?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या यह 'कहाँ देखें' से जुड़ा सवाल है?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to dotaz typu „kde to sledovat“?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این یک پرسش «کجا تماشا کنم» است؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם זו שאלת 'איפה לצפות'?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah ini soalan 'di mana untuk menonton'?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este o întrebare de tip „unde pot viziona”?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är det här en fråga om var man kan titta?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι ερώτηση τύπου «πού να το δω»;"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কি 'কোথায় দেখব' সংক্রান্ত প্রশ্ন?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது 'எங்கே பார்ப்பது' என்ற கேள்வியா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది 'ఎక్కడ చూడాలి' అనే ప్రశ్నా?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er dette et 'hvor kan man se det'-spørgsmål?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko tämä ”mistä katsoa” -kysymys?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy „hol nézhető meg” kérdés?"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Er dette et «hvor kan jeg se»-spørsmål?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma pergunta sobre 'onde ver'?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا یہ 'کہاں دیکھیں' کا سوال ہے؟"
          }
        },
        "hy": {

    "Pull to refresh the %@.": {
      "comment": "Pull-to-refresh title for a user list variant. '%@' is the list kind, e.g. 'followers', 'following'.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek om de %@ te vernieuwen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتحديث %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para actualizar los %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik untuk menyegarkan %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引っ張って%@を更新"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para atualizar %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aktualisieren der %@ ziehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire pour actualiser les %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per aggiornare i %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당겨서 %@을(를) 새로고침하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociągnij, aby odświeżyć %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните, чтобы обновить %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉刷新%@。"
          }

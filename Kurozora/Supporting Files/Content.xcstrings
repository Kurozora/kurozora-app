    "%@ is verified because they are notable in animators, voice actors, entertainment studios, or another designated category." : {
      "comment" : "The verified badge description.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم توثيق %@ لأنه شخصية بارزة في مجال الرسوم المتحركة أو ممثلي الأداء الصوتي أو استوديوهات الترفيه أو فئة أخرى معتمدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ভেরিফায়েড কারণ তিনি animator, voice actor, বিনোদন স্টুডিও, কিংবা অন্য কোনো নির্ধারিত বিভাগে উল্লেখযোগ্য।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je ověřen(a), protože je významnou osobností mezi animátory, seiyuu, zábavními studii nebo v jiné určené kategorii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er verificeret, fordi vedkommende er kendt inden for animatorer, stemmeskuespillere, underholdningsstudier eller en anden udvalgt kategori."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist verifiziert, weil die Person als Animator, Synchronsprecher, Unterhaltungsstudio oder in einer anderen festgelegten Kategorie bekannt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %@ είναι επαληθευμένος επειδή ξεχωρίζει στους animators, στους ηθοποιούς φωνής, στα στούντιο ψυχαγωγίας ή σε κάποια άλλη καθορισμένη κατηγορία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está verificado por ser una figura destacada entre animadores, actores de doblaje, estudios de entretenimiento u otra categoría designada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está verificado por ser destacado entre animadores, actores de voz, estudios de entretenimiento u otra categoría designada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ تأیید شده است چون در میان انیماتورها، صداپیشه‌ها، استودیوهای سرگرمی یا دسته‌ای دیگر از چهره‌های شناخته‌شده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on vahvistettu, koska hän on merkittävä animaattorina, seiyuuna, viihdestudiona tai jollakin muulla nimetyllä alalla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verified si %@ dahil kilala sila sa larangan ng animators, voice actors, entertainment studios, o iba pang itinakdang kategorya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est vérifié parce qu'il est reconnu parmi les animateurs, les seiyuu, les studios de divertissement ou une autre catégorie désignée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ מאומת מפני שהוא בעל שם בקרב אנימטורים, מדובבים, אולפני בידור או קטגוריה מיועדת אחרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ वेरिफ़ाइड हैं क्योंकि वे एनिमेटर, voice actor, मनोरंजन studio, या किसी अन्य निर्दिष्ट श्रेणी में उल्लेखनीय हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hitelesítve van, mert kiemelkedő az animátorok, seiyuuk, szórakoztató stúdiók vagy egy másik kijelölt kategória területén."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-ը հաստատված է, քանի որ նա ճանաչված է անիմատորների, ձայնային դերասանների, ժամանցի ստուդիաների կամ այլ նշանակված կատեգորիայի շրջանում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terverifikasi karena dikenal sebagai animator, pengisi suara, studio hiburan, atau kategori lain yang ditetapkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è verificato perché è una figura di rilievo tra animatori, doppiatori, studi di intrattenimento o un'altra categoria designata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さんは、アニメーター、声優、エンタメスタジオ、その他指定のカテゴリーで著名なため認証されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님은 애니메이터, 성우, 엔터테인먼트 스튜디오 또는 기타 지정된 분야에서 주목할 만한 인물이기에 인증되었습니다."
          }
        },
        "ms" : {

    "%@ is currently suspended.": {
      "comment": "Admin headline for a temporary suspension.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is momenteel geschorst."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موقوف حاليًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está suspendido actualmente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saat ini ditangguhkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は現在停止されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está suspenso no momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist derzeit gesperrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est actuellement suspendu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è attualmente sospeso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님은 현재 정지된 상태입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest obecnie zawieszony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ временно заблокирован."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ наразі заблоковано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当前处于封禁状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前已遭停權。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ถูกระงับการใช้งานอยู่ในขณะนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ şu anda askıya alınmış durumda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hiện đang bị đình chỉ."
          }
        }
      }
    },

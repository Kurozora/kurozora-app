    },
    "This lifts the suspension immediately. The user will be able to post, rate, and engage again.": {
      "comment": "Alert body for revoking a user's active timeout.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit heft de schorsing direct op. De gebruiker kan weer plaatsen, beoordelen en deelnemen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى رفع الإيقاف فورًا. سيتمكن المستخدم من النشر والتقييم والتفاعل مجددًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto levanta la suspensión de inmediato. El usuario podrá volver a publicar, calificar e interactuar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini mencabut penangguhan dengan segera. Pengguna akan dapat mengirim, memberi nilai, dan berinteraksi kembali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより停止が直ちに解除されます。ユーザーは再び投稿、評価、交流ができるようになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto revoga a suspensão imediatamente. O usuário poderá publicar, avaliar e interagir novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Sperre sofort aufgehoben. Die Person kann dann wieder posten, bewerten und interagieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela lève la suspension immédiatement. L'utilisateur pourra de nouveau publier, noter et interagir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione revoca immediatamente la sospensione. L'utente potrà di nuovo pubblicare, valutare e interagire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 정지를 즉시 해제합니다. 사용자는 다시 게시, 평가, 참여할 수 있게 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to natychmiastowe zniesienie zawieszenia. Użytkownik znów będzie mógł publikować, oceniać i wchodzić w interakcje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это немедленно снимет блокировку. Пользователь снова сможет публиковать, оценивать и взаимодействовать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це негайно скасує блокування. Користувач знову зможе публікувати, оцінювати та взаємодіяти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作将立即解除封禁。该用户将可再次发帖、评分及参与互动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作將立即解除停權。該使用者將能再次發佈內容、評分與互動。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะยกเลิกการระงับการใช้งานทันที ผู้ใช้จะสามารถโพสต์ ให้คะแนน และมีส่วนร่วมได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem askıyı hemen kaldırır. Kullanıcı yeniden gönderi paylaşabilir, puan verebilir ve etkileşime geçebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ gỡ bỏ việc đình chỉ ngay lập tức. Người dùng sẽ có thể đăng bài, đánh giá và tương tác trở lại."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto levanta la suspensión de inmediato. El usuario podrá volver a publicar, valorar e interactuar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin nito ang suspensyon kaagad. Makakapag-post, makakapagbigay ng rating, at makakapakipag-ugnayan muli ang user."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे निलंबन तुरंत हट जाएगा। उपयोगकर्ता फिर से पोस्ट करने, रेटिंग देने और सहभागिता करने में सक्षम होंगे।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار تعلیق را بی‌درنگ برمی‌دارد. کاربر دوباره می‌تواند پست بگذارد، امتیاز دهد و مشارکت کند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה את ההשעיה באופן מיידי. המשתמש יוכל לפרסם, לדרג ולקחת חלק שוב."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menarik balik penggantungan dengan serta-merta. Pengguna akan dapat menyiar, menilai dan berinteraksi semula."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune ridică suspendarea imediat. Utilizatorul va putea din nou să posteze, să evalueze și să interacționeze."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta häver avstängningen omedelbart. Användaren kommer åter att kunna publicera, betygsätta och interagera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se pozastavení okamžitě zruší. Uživatel bude moci opět přispívat, hodnotit a zapojovat se."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτή την ενέργεια η αναστολή αίρεται άμεσα. Ο χρήστης θα μπορεί ξανά να δημοσιεύει, να βαθμολογεί και να συμμετέχει."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি অবিলম্বে স্থগিতাদেশ প্রত্যাহার করে। ব্যবহারকারী আবার পোস্ট করতে, রেটিং দিতে এবং অংশগ্রহণ করতে পারবেন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இடைநிறுத்தத்தை உடனடியாக நீக்குகிறது. பயனர் மீண்டும் இடுகையிட, மதிப்பிட மற்றும் பங்கேற்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది సస్పెన్షన్‌ను వెంటనే ఎత్తివేస్తుంది. వినియోగదారు మళ్లీ పోస్ట్ చేయడం, రేటింగ్ ఇవ్వడం, పాల్గొనడం చేయగలరు."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette ophæver suspenderingen med det samme. Brugeren vil igen kunne dele opslag, bedømme og deltage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa jäädytyksen välittömästi. Käyttäjä voi jälleen julkaista, arvioida ja osallistua."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez azonnal feloldja a felfüggesztést. A felhasználó újra tud majd bejegyzést közzétenni, értékelni és tevékenykedni."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette opphever utestengelsen umiddelbart. Brukeren vil kunne publisere, vurdere og delta igjen."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے معطلی فوری طور پر ختم ہو جائے گی۔ صارف دوبارہ پوسٹ کرنے، درجہ بندی کرنے اور شرکت کرنے کے قابل ہو جائے گا۔"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto levanta a suspensão de imediato. O utilizador poderá voltar a publicar, avaliar e interagir."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա անմիջապես հանում է կասեցումը։ Օգտատերը կրկին կկարողանա հրապարակել, գնահատել և մասնակցել։"
          }
        }
      }
    },

            "value": "Utestengelsen slutter"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "معطلی ختم ہو رہی ہے"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspensão a terminar"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կասեցումն ավարտվում է"

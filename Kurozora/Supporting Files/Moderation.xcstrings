        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schorsing eindigt"
          }
        }
      }
    },
    "This lifts the suspension immediately. The user will be able to post, rate, and engage again.": {
      "comment": "Alert body for revoking a user's active timeout.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit heft de schorsing direct op. De gebruiker kan weer plaatsen, beoordelen en deelnemen."
          }
        }
      }
    },
    "Timeout": {
      "comment": "Section header grouping the duration and reason pickers on the moderator issue-timeout view.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Time-out"
          }
        }
      }
    },
    "Update Appeal": {
      "comment": "Submit button on the appeal compose view when updating an existing appeal.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezwaar bijwerken"
          }
        }
      }
    },

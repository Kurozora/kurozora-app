    "%@ is currently suspended.": {
      "comment": "Admin headline for a temporary suspension.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is momenteel geschorst."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موقوف حاليًا."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está suspendido actualmente."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saat ini ditangguhkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は現在停止されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está suspenso no momento."
          }
        },

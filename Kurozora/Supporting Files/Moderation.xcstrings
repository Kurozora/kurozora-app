      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf uw bezwaar"
          }
        }
      }
    },
    "Your account is permanently suspended.": {
      "comment": "Heading on the suspension details view for a permanent ban.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw account is permanent geschorst."
          }
        }
      }
    },
    "Your account is temporarily suspended.": {
      "comment": "Heading on the suspension details view for a temporary suspension.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw account is tijdelijk geschorst."
          }
        }
      }
    },
    "Your appeal": {
      "comment": "Section header for the suspended user's own appeal.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bezwaar"
          }
        }
      }
    },
    "Your appeal must be at least 10 characters long.": {
      "comment": "Error shown when the appeal message is too short.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw bezwaar moet minstens 10 tekens lang zijn."
          }
        }
      }
    }
  },
  "version": "1.0"
}

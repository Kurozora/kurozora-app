{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@)": {
      "comment": "Expiry value for a temporary suspension, showing absolute date and relative countdown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ is currently suspended.": {
      "comment": "Admin headline for a temporary suspension.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is momenteel geschorst."
          }
        }
      }
    },
    "%@ is permanently suspended.": {
      "comment": "Admin headline for a permanent suspension.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is permanent geschorst."
          }
        }
      }
    },
    "1 hour": {
      "comment": "Timeout duration label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 uur"
          }
        }
      }
    },
    "3 days": {
      "comment": "Timeout duration label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dagen"
          }
        }
      }
    },
    "7 days": {
      "comment": "Timeout duration label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagen"
          }
        }
      }
    },
    "24 hours": {
      "comment": "Timeout duration label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "24 uur"
          }
        }
      }
    },
    "30 days": {
      "comment": "Timeout duration label.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "30 dagen"
          }
        }
      }
    },
    "Account Suspended": {
      "comment": "Title of the suspension details view as seen by the suspended user.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Account geschorst"
          }
        }
      }
    },
    "Add a content warning": {
      "comment": "The title of the content warning self-label sheet.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhoudswaarschuwing toevoegen"
          }
        }
      }
    },
    "Appeal from %@": {
      "comment": "Section header for the suspended user's appeal as seen by a moderator.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezwaar van %@"
          }
        }
      }
    },
    "Choose Duration": {
      "comment": "Menu title for the duration picker.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies duur"
          }
        }
      }
    },
    "Choose Reason": {
      "comment": "Menu title for the reason picker.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies reden"
          }
        }
      }
    },
    "Choose self-labels that are applicable for the media you are posting. If none are selected, this post is suitable for all audiences.": {
      "comment": "The subtitle of the content warning self-label sheet.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de zelflabels die van toepassing zijn op de media die je plaatst. Als er niets is geselecteerd, is dit bericht geschikt voor alle doelgroepen."
          }
        }
      }
    },
    "Community Guidelines": {
      "comment": "Button on the suspension details view that opens the community guidelines.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Communityrichtlijnen"
          }
        }
      }
    },
    "Contest Suspension": {
      "comment": "Title of the appeal compose view.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schorsing aanvechten"
          }
        }
      }
    },
    "Contest this suspension": {
      "comment": "Primary action on the user-facing suspension details view.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecht deze schorsing aan"
          }
        }
      }
    },
    "Duration": {
      "comment": "Leading row title for the duration picker on the moderator issue-timeout view.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duur"
          }
        }
      }
    },
    "Edit appeal": {
      "comment": "Primary action on the user-facing suspension details view when an appeal has already been filed.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezwaar bewerken"
          }
        }
      }
    },
    "Edit Appeal": {
      "comment": "Title of the appeal compose view when editing an existing appeal.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezwaar bewerken"
          }
        }
      }
    },
    "Ends": {

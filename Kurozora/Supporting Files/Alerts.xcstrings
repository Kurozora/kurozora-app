    "Well, this is awkward.": {
      "comment": "The alert title shown when no camera is available to scan a code.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tja, dit is ongemakkelijk."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Bueno, esto es incómodo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسنًا، هذا محرج بعض الشيء."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wah, ini canggung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ええと、ちょっと気まずいですね。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem, que situação constrangedora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tja, das ist jetzt unangenehm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eh bien, c'est gênant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Beh, che imbarazzo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이런, 좀 곤란하네요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "No cóż, niezręczna sytuacja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, неловко вышло."
          }
        },
        "uk": {

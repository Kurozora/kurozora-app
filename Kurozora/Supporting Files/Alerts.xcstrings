            "value": "Não foi possível adicionar à sua biblioteca 😔"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen zur Bibliothek fehlgeschlagen 😔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ajouter à ta bibliothèque 😔"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiungere alla tua libreria 😔"
          }
        },
        "ko": {

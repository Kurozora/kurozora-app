    "Well, this is awkward.": {
      "comment": "The alert title shown when no camera is available to scan a code.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tja, dit is ongemakkelijk."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Bueno, esto es incómodo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسنًا، هذا محرج بعض الشيء."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wah, ini canggung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ええと、ちょっと気まずいですね。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem, que situação constrangedora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tja, das ist jetzt unangenehm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eh bien, c'est gênant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Beh, che imbarazzo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이런, 좀 곤란하네요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "No cóż, niezręczna sytuacja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, неловко вышло."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що ж, незручно вийшло."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗯，这有点尴尬。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗯，這有點尷尬。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอ่อ... กระอักกระอ่วนจัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu biraz tuhaf oldu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ồ, hơi ngại đây."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaya, qué situación más incómoda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aba, nakakahiya naman ito."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अरे, यह तो थोड़ा अजीब है।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "No, tohle je trapné."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خب، اوضاع کمی عجیب شد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוב, זה קצת מביך."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aduh, janggal pula rasanya."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei bine, e cam jenant."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här blev lite pinsamt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λοιπόν, αυτό είναι κάπως άβολο."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আহা, এটা একটু অস্বস্তিকর।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரி, இது சற்று சங்கடமாக உள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అరె, ఇది కొంచెం ఇబ్బందిగా ఉంది."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå, det her er lidt akavet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "No, tämäpä noloa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hát, ez kínos."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vel, dette ble litt pinlig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem, isto é constrangedor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوہو، یہ تو ذرا عجیب ہو گیا۔"

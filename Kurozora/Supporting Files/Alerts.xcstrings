          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można dodać do biblioteki 😔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось добавить в библиотеку 😔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося додати до вашої бібліотеки 😔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法添加到你的资料库 😔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加入你的書庫 😔"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มลงในคลังไม่ได้ 😔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphanene Eklenemedi 😔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thêm vào Thư viện 😔"
          }
        }
      }
    },

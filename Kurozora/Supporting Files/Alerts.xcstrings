    "You must connect to a Wi-Fi network or have a cellular data plan to use Kurozora.": {
      "comment": "The string for the no signal warning message.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet verbonden zijn met een wifinetwerk of een mobiel data-abonnement hebben om Kurozora te gebruiken."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes conectarte a una red Wi-Fi o tener un plan de datos móviles para usar Kurozora."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب الاتصال بشبكة Wi-Fi أو امتلاك باقة بيانات خلوية لاستخدام Kurozora."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda harus terhubung ke jaringan Wi-Fi atau memiliki paket data seluler untuk menggunakan Kurozora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozoraをご利用いただくには、Wi-Fiネットワークに接続するか、モバイルデータ通信プランが必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisa se conectar a uma rede Wi-Fi ou ter um plano de dados móveis para usar o Kurozora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst mit einem WLAN verbunden sein oder über einen Mobilfunktarif verfügen, um Kurozora zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez vous connecter à un réseau Wi-Fi ou disposer d'un forfait de données cellulaires pour utiliser Kurozora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare Kurozora è necessario connettersi a una rete Wi-Fi o disporre di un piano dati cellulare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora를 사용하려면 Wi-Fi 네트워크에 연결하거나 셀룰러 데이터 요금제가 있어야 해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby korzystać z aplikacji Kurozora, musisz połączyć się z siecią Wi-Fi lub mieć aktywny pakiet danych komórkowych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для использования Kurozora необходимо подключиться к сети Wi-Fi или иметь тарифный план мобильной передачи данных."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб користуватися Kurozora, вам необхідно під'єднатися до мережі Wi-Fi або мати тарифний план мобільного зв'язку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你必须连接 Wi-Fi 网络或拥有蜂窝数据套餐才能使用 Kurozora。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您必須連接 Wi-Fi 網路或使用行動數據方案，才能使用 Kurozora。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องเชื่อมต่อกับเครือข่าย Wi-Fi หรือมีแพ็กเกจข้อมูลมือถือเพื่อใช้งาน Kurozora"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora'yı kullanmak için bir Wi-Fi ağına bağlanmanız veya bir hücresel veri planınızın olması gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải kết nối mạng Wi-Fi hoặc có gói dữ liệu di động để sử dụng Kurozora."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes conectarte a una red Wi-Fi o tener un plan de datos móviles para usar Kurozora."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ninyong kumonekta sa isang Wi-Fi network o magkaroon ng cellular data plan upang magamit ang Kurozora."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora का उपयोग करने के लिए आपको किसी Wi-Fi नेटवर्क से जुड़ना होगा या सेलुलर डेटा प्लान होना चाहिए।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro používání Kurozora se musíš připojit k Wi-Fi síti nebo mít k dispozici mobilní data."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده از Kurozora باید به یک شبکهٔ Wi-Fi متصل شوی یا یک طرح دادهٔ همراه داشته باشی."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש ב‑Kurozora עליך להתחבר לרשת Wi‑Fi או להחזיק בחבילת גלישה סלולרית."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda mesti menyambung ke rangkaian Wi-Fi atau mempunyai pelan data selular untuk menggunakan Kurozora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trebuie să te conectezi la o rețea Wi-Fi sau să ai un abonament de date mobile pentru a folosi Kurozora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste ansluta till ett Wi-Fi-nätverk eller ha ett mobildataabonnemang för att använda Kurozora."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να συνδεθείς σε ένα δίκτυο Wi-Fi ή να έχεις πρόγραμμα δεδομένων κινητής για να χρησιμοποιήσεις το Kurozora."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora ব্যবহার করতে আপনাকে অবশ্যই একটি Wi-Fi নেটওয়ার্কে সংযুক্ত হতে হবে অথবা একটি সেলুলার ডেটা প্ল্যান থাকতে হবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora ஐப் பயன்படுத்த, நீங்கள் Wi-Fi நெட்வொர்க்குடன் இணைக்க வேண்டும் அல்லது செல்லுலார் தரவுத் திட்டம் வைத்திருக்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora ను ఉపయోగించడానికి మీరు తప్పనిసరిగా Wi-Fi నెట్‌వర్క్‌కు కనెక్ట్ అవ్వాలి లేదా సెల్యులార్ డేటా ప్లాన్ కలిగి ఉండాలి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal oprette forbindelse til et Wi-Fi-netværk eller have et mobildataabonnement for at bruge Kurozora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozoran käyttäminen edellyttää yhteyttä Wi-Fi-verkkoon tai mobiilidatasopimusta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kurozora használatához Wi-Fi-hálózathoz kell csatlakoznod, vagy mobiladat-előfizetéssel kell rendelkezned."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må koble til et Wi-Fi-nettverk eller ha et mobildataabonnement for å bruke Kurozora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem de ligar-se a uma rede Wi-Fi ou ter um plano de dados móveis para utilizar o Kurozora."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora استعمال کرنے کے لیے آپ کو کسی Wi-Fi نیٹ ورک سے منسلک ہونا ہوگا یا سیلولر ڈیٹا پلان رکھنا ہوگا۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurozora-ից օգտվելու համար պետք է միանաք Wi-Fi ցանցի կամ ունենաք բջջային ինտերնետի սակագին։"
          }
        }
      }
    },
    "Your purchase could not be verified by App Store. If this continues to happen, please contact the developer.": {
      "comment": "The alert message shown when a purchase cannot be verified by the App Store.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw aankoop kon niet worden geverifieerd door de App Store. Als dit zich blijft voordoen, neem dan contact op met de ontwikkelaar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no pudo verificar su compra. Si esto sigue ocurriendo, comuníquese con el desarrollador."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على App Store التحقق من عملية الشراء. إذا استمر حدوث ذلك، فيُرجى التواصل مع المطوّر."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian Anda tidak dapat diverifikasi oleh App Store. Jika hal ini terus terjadi, silakan hubungi pengembang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入をApp Storeで確認できませんでした。この問題が続く場合は、開発者までお問い合わせください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar sua compra na App Store. Se isso continuar acontecendo, entre em contato com o desenvolvedor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Kauf konnte vom App Store nicht verifiziert werden. Falls dies weiterhin auftritt, wenden Sie sich bitte an den Entwickler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat n'a pas pu être vérifié par l'App Store. Si le problème persiste, veuillez contacter le développeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare l'acquisto tramite l'App Store. Se il problema persiste, la preghiamo di contattare lo sviluppatore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 구매를 확인할 수 없습니다. 이 문제가 계속 발생하면 개발자에게 문의해 주십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować zakupu w App Store. Jeśli problem będzie się powtarzał, skontaktuj się z deweloperem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашу покупку не удалось подтвердить в App Store. Если это повторяется, пожалуйста, свяжитесь с разработчиком."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store не вдалося підтвердити вашу покупку. Якщо це повторюватиметься, будь ласка, зверніться до розробника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无法验证你的购买。如果此情况持续发生，请联系开发者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 無法驗證您的購買項目。若此情形持續發生，請聯絡開發者。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถตรวจสอบการซื้อของคุณกับ App Store ได้ หากยังคงเกิดเหตุการณ์นี้ขึ้นอีก โปรดติดต่อผู้พัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma işleminiz App Store tarafından doğrulanamadı. Bu durum devam ederse, lütfen geliştiriciyle iletişime geçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store không thể xác minh giao dịch mua hàng của bạn. Nếu tình trạng này tiếp tục xảy ra, vui lòng liên hệ nhà phát triển."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store no ha podido verificar tu compra. Si esto sigue ocurriendo, ponte en contacto con el desarrollador."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-verify ng App Store ang inyong pagbili. Kung magpapatuloy ang problemang ito, mangyaring makipag-ugnayan sa developer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खरीद को App Store द्वारा सत्यापित नहीं किया जा सका। यदि ऐसा होता रहे, तो कृपया डेवलपर से संपर्क करें।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš nákup se nepodařilo ověřit v App Store. Pokud se to bude opakovat, kontaktujte prosím vývojáře."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خرید شما توسط App Store قابل تأیید نبود. اگر این مشکل ادامه پیدا کرد، لطفاً با توسعه‌دهنده تماس بگیرید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לאמת את הרכישה שלך מול App Store. אם הבעיה חוזרת על עצמה, יש לפנות למפתח."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian anda tidak dapat disahkan oleh App Store. Jika perkara ini terus berlaku, sila hubungi pembangun."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția dvs. nu a putut fi verificată de App Store. Dacă problema persistă, vă rugăm să contactați dezvoltatorul."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp kunde inte verifieras av App Store. Om detta fortsätter att hända, kontakta utvecklaren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σας δεν ήταν δυνατό να επαληθευτεί από το App Store. Αν αυτό συνεχίσει να συμβαίνει, παρακαλούμε επικοινωνήστε με τον προγραμματιστή."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store আপনার ক্রয় যাচাই করতে পারেনি। যদি এটি বারবার ঘটতে থাকে, অনুগ্রহ করে ডেভেলপারের সঙ্গে যোগাযোগ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கொள்முதலை App Store ஆல் சரிபார்க்க முடியவில்லை. இது தொடர்ந்து நிகழ்ந்தால், தயவுசெய்து டெவலப்பரைத் தொடர்பு கொள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కొనుగోలును App Store ధృవీకరించలేకపోయింది. ఇది మళ్లీ జరుగుతూ ఉంటే, దయచేసి డెవలపర్‌ను సంప్రదించండి."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb kunne ikke bekræftes af App Store. Hvis dette fortsætter, bedes du kontakte udvikleren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ei voinut vahvistaa ostoasi. Jos tämä toistuu, ota yhteyttä kehittäjään."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az App Store nem tudta ellenőrizni a vásárlását. Ha ez továbbra is előfordul, kérjük, vegye fel a kapcsolatot a fejlesztővel."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt kunne ikke verifiseres av App Store. Hvis dette fortsetter å skje, vennligst kontakt utvikleren."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a sua compra na App Store. Se isto continuar a acontecer, contacte o programador."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store آپ کی خریداری کی توثیق نہیں کر سکا۔ اگر ایسا بار بار ہوتا رہے، تو براہِ کرم ڈویلپر سے رابطہ کریں۔"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր գնումը չհաջողվեց հաստատել App Store-ի կողմից։ Եթե սա շարունակվի, խնդրում ենք կապ հաստատել մշակողի հետ։"
          }
        }
      }
    }
  },
  "version": "1.0"
}

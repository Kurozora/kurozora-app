{
  "sourceLanguage": "en",
  "strings": {
    "Can't Add to Your Library 😔": {
      "comment": "The alert title shown when adding an item to the library fails.",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet aan je bibliotheek toevoegen 😔"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo agregar a tu biblioteca 😔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت الإضافة إلى مكتبتك 😔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak Bisa Menambahkan ke Library Kamu 😔"

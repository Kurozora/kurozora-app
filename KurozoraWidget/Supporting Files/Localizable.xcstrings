    "Keep up with your upcoming episodes." : {
      "comment" : "The description of the Up Next widget in the widget gallery.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع حلقاتك القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার আসন্ন পর্বগুলোর খোঁজ রাখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mějte přehled o svých nadcházejících epizodách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold styr på dine kommende afsnit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib bei deinen kommenden Folgen auf dem Laufenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μείνετε ενημερωμένοι για τα επόμενα επεισόδιά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantente al día con tus próximos episodios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
